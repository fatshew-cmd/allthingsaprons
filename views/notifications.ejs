<%- include('partials/appStart', { title: title, activePage: 'notifications' }) %>

<%
function fmtNotifTime(d) {
  if (!d) return '';
  const now = new Date();
  const dt  = new Date(d);
  const diffMs  = now - dt;
  const diffMin = Math.floor(diffMs / 60000);
  const diffH   = Math.floor(diffMs / 3600000);
  const diffD   = Math.floor(diffMs / 86400000);
  if (diffMin < 1)  return 'Just now';
  if (diffMin < 60) return diffMin + 'm';
  if (diffH   < 24) return diffH   + 'h';
  if (diffD   <  7) return diffD   + 'd';
  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function userLabel(displayName, handle) {
  var dn = displayName || handle || 'Someone';
  if (handle) {
    return dn + ' <span class="font-normal text-white/40">- @' + handle + '</span>';
  }
  return dn;
}

function actorLabel(p) {
  return userLabel(p.actorDisplayName || p.actorUsername, p.actorHandle || p.actorUsername);
}

function notifText(n) {
  const p = n.payload || {};
  switch (n.type) {
    case 'comment':
      return '<strong>' + actorLabel(p) + '</strong> commented on your entry';
    case 'reply':
      return '<strong>' + actorLabel(p) + '</strong> replied to your comment';
    case 'nomination_received':
      return '<strong>' + actorLabel(p) + '</strong> challenged you to a head-to-head';
    case 'contest_started':
      return '<strong>' + actorLabel(p) + '</strong> started a new head-to-head contest';
    case 'nominee_accepted':
      return p.contestIsLive
        ? '<strong>' + actorLabel(p) + '</strong> accepted — the contest is now live'
        : '<strong>' + actorLabel(p) + '</strong> submitted their entry — waiting on the other nominee';
    case 'nominee_declined':
      return '<strong>' + actorLabel(p) + '</strong> declined the challenge';
    case 'contest_forfeited':
      return '<strong>' + actorLabel(p) + '</strong> forfeited the contest';
    case 'contest_closed':
      if (p.isParticipant) {
        var opp = '<strong>' + userLabel(p.opponentDisplayName || p.opponentUsername, p.opponentUsername) + '</strong>';
        return p.won
          ? 'You won your contest against ' + opp
          : 'Your contest against ' + opp + ' ended';
      }
      return 'A contest you\'re looped in on has ended';
    case 'contest_voided':
      return p.isParticipant
        ? 'Your contest was voided — the opponent didn\'t respond in time'
        : 'A contest you\'re looped in on was voided';
    case 'viewer_nomination': {
      var vnOpponent = p.opponentHandle
        ? ' against <strong>' + userLabel(p.opponentDisplayName || p.opponentHandle, p.opponentHandle) + '</strong>'
        : '';
      return '<strong>' + actorLabel(p) + '</strong> nominated you for a head-to-head' + vnOpponent;
    }
    case 'take_on_received':
      return '<strong>' + actorLabel(p) + '</strong> requested a take-on';
    case 'take_on_accepted':
      return '<strong>' + actorLabel(p) + '</strong> accepted your take-on — the contest is live';
    case 'contest_contribution': {
      var ccAmt = p.amountCHL ? p.amountCHL.toLocaleString() : '0';
      return '<strong>' + actorLabel(p) + '</strong> contributed <strong>' + ccAmt + ' 🌶️</strong> to your entry';
    }
    case 'payout_reminder': {
      var prAmt = p.amountCHL ? p.amountCHL.toLocaleString() : '0';
      return '<strong>' + prAmt + ' 🌶️</strong> auto-payout fires in 5 days — tap to hold until the 15th';
    }
    case 'payout_processed': {
      var ppAmt  = p.amountCHL ? p.amountCHL.toLocaleString() : '0';
      var ppType = p.paidBy === 'makeup_15d' ? 'makeup payout' : 'auto-payout';
      return '<strong>' + ppAmt + ' 🌶️</strong> ' + ppType + ' has been processed';
    }
    case 'contest_payout_available': {
      var cpaAmt = p.amountCHL ? p.amountCHL.toLocaleString() : '0';
      return 'Your contest earned <strong>' + cpaAmt + ' 🌶️</strong> — added to your balance';
    }
    case 'comment_removed':
      return 'Your comment was removed for violating our community guidelines';
    case 'report_reviewed': {
      var rrSnip = p.snippet ? ' — “' + p.snippet + '”' : '';
      return p.outcome === 'approved'
        ? 'Comment removed' + rrSnip
        : 'No violation found' + rrSnip;
    }
    case 'contest_stalled':
      return 'Your contest has been paused while a reported entry is under review';
    case 'contest_resumed':
      return 'Your contest has resumed — the voting deadline has been extended';
    case 'entry_reported':
      return 'Your entry has been flagged for review and is temporarily hidden';
    case 'entry_removed': {
      var erTitle = p.entryTitle ? '"' + p.entryTitle + '"' : 'Your entry';
      return erTitle + ' was removed for violating our community guidelines';
    }
    case 'tournament_jury_invite':
      return 'You\'ve been asked to serve as jury for <strong>' + (p.tournamentName || 'a tournament') + '</strong>';
    case 'tournament_jury_declined':
      return 'A jury member declined for <strong>' + (p.tournamentName || 'your tournament') + '</strong> — pick a replacement';
    case 'tournament_cooldown_started':
      return 'Review your tournament\'s candidates before cooldown ends';
    case 'tournament_canceled': {
      var tcReason = p.reason === 'insufficient_jury' ? 'not enough jurors accepted'
                   : p.reason === 'insufficient_candidates' ? 'not enough candidates applied'
                   : p.reason === 'cooldown_incomplete' ? 'candidate review wasn\'t finished in time'
                   : 'it was canceled';
      return 'Tournament canceled — ' + tcReason;
    }
    case 'tournament_entry_removed':
      return 'You no longer meet the updated eligibility criteria for <strong>' + (p.tournamentName || 'a tournament') + '</strong> and have been removed';
    case 'tournament_entry_submitted':
      return '<strong>' + actorLabel(p) + '</strong> has submitted an entry to <strong>' + (p.tournamentName || 'your tournament') + '</strong>';
    case 'tournament_entry_approved':
      return 'Your entry was approved for <strong>' + (p.tournamentName || 'a tournament') + '</strong>';
    case 'tournament_entry_rejected': {
      var terNote = p.note ? ' — “' + p.note + '”' : '';
      return 'Your entry wasn\'t selected for <strong>' + (p.tournamentName || 'a tournament') + '</strong>' + terNote;
    }
    default:
      return 'New notification';
  }
}

function notifIcon(type) {
  switch (type) {
    case 'comment':             return 'boxicons:message';
    case 'reply':               return 'boxicons:reply';
    case 'nomination_received':
    case 'viewer_nomination':
    case 'contest_started':     return 'boxicons:trophy';
    case 'take_on_received':
    case 'take_on_accepted':    return 'boxicons:git-compare';
    case 'nominee_accepted':    return 'boxicons:check-circle';
    case 'nominee_declined':    return 'boxicons:x-circle';
    case 'contest_forfeited':   return 'boxicons:error-circle';
    case 'contest_closed':      return 'boxicons:check-circle';
    case 'contest_voided':           return 'boxicons:x-circle';
    case 'payout_reminder':          return 'boxicons:time';
    case 'payout_processed':         return 'boxicons:money';
    case 'contest_contribution':     return 'boxicons:coin';
    case 'contest_payout_available': return 'boxicons:wallet';
    case 'comment_removed':          return 'boxicons:x-circle';
    case 'entry_removed':            return 'boxicons:x-circle';
    case 'report_reviewed':          return 'boxicons:check-circle';
    case 'contest_stalled':          return 'boxicons:pause-circle';
    case 'contest_resumed':          return 'boxicons:play-circle';
    case 'entry_reported':           return 'boxicons:flag';
    case 'tournament_jury_invite':      return 'boxicons:medal';
    case 'tournament_jury_declined':    return 'boxicons:error-circle';
    case 'tournament_cooldown_started': return 'boxicons:time';
    case 'tournament_canceled':         return 'boxicons:x-circle';
    case 'tournament_entry_removed':    return 'boxicons:x-circle';
    case 'tournament_entry_submitted':  return 'boxicons:trophy';
    case 'tournament_entry_approved':   return 'boxicons:check-circle';
    case 'tournament_entry_rejected':   return 'boxicons:x-circle';
    default:                         return 'boxicons:bell';
  }
}
%>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm flex items-center justify-between">
    <h1 class="font-black text-xl tracking-tight">Notifications</h1>
    <% if (notifications.length > 0) { %>
    <button id="mark-all-btn" class="text-xs text-white/40 hover:text-charm-400 transition-colors">
      Mark all as read
    </button>
    <% } %>
  </header>

  <% if (!notifications.length) { %>
  <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
    <div class="w-16 h-16 rounded-md bg-white/5 flex items-center justify-center mb-4">
      <iconify-icon icon="boxicons:bell" width="32" height="32" class="text-white/20"></iconify-icon>
    </div>
    <p class="text-white/40 text-sm">No notifications yet</p>
    <p class="text-white/20 text-xs mt-1">You'll see contest updates, comments, and mentions here</p>
  </div>
  <% } else { %>

  <ul id="notif-list" class="divide-y divide-white/5">
    <% notifications.forEach(function(n) { %>
    <% var p = n.payload || {}; %>
    <% var isTakeOnReceived = n.type === 'take_on_received' && p.nominationId; %>
    <% var isRemovalNotif   = n.type === 'comment_removed' || n.type === 'entry_removed'; %>
    <% var isTournamentEntrySubmitted = n.type === 'tournament_entry_submitted' && p.entryUrl; %>
    <li data-id="<%= n._id %>" data-url="<%= p.url || '/notifications' %>"
        class="notif-item px-5 py-4 cursor-pointer transition-colors hover:bg-white/4 <%= n.read ? '' : 'bg-charm-500/8' %> <%= (isTakeOnReceived || isRemovalNotif || isTournamentEntrySubmitted) ? 'flex flex-col gap-3' : 'flex items-start gap-3' %>">

      <% if (isTakeOnReceived) { %>

      <!-- Take-on received: header row -->
      <div class="flex items-start gap-3">
        <div class="shrink-0 mt-0.5">
          <% if (p.actorAvatar) { %>
          <img src="<%= p.actorAvatar %>" alt="" class="w-9 h-9 rounded-full object-cover">
          <% } else { %>
          <div class="w-9 h-9 rounded-full bg-white/8 flex items-center justify-center">
            <iconify-icon icon="boxicons:git-compare" width="18" class="text-charm-400"></iconify-icon>
          </div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-white/80 leading-snug"><%- notifText(n) %></p>
          <p class="text-xs text-white/25 mt-1"><%= fmtNotifTime(n.createdAt) %></p>
        </div>
        <div class="shrink-0 mt-2">
          <% if (!n.read) { %><span class="unread-dot w-2 h-2 rounded-full bg-charm-400 block"></span><% } else { %><span class="w-2 h-2 block"></span><% } %>
        </div>
      </div>

      <!-- Entry thumbnails -->
      <div class="flex items-center gap-2">
        <div class="flex-1 aspect-square rounded-md overflow-hidden bg-shark-900">
          <% if (p.challengerEntryUrl) { %>
            <% if (p.challengerEntryType === 'video') { %>
            <video src="<%= p.challengerEntryUrl %>" class="w-full h-full object-cover pointer-events-none" muted preload="none"></video>
            <% } else { %>
            <img src="<%= p.challengerEntryUrl %>" alt="" class="w-full h-full object-cover">
            <% } %>
          <% } %>
        </div>
        <span class="text-[10px] font-black text-white/20 tracking-widest shrink-0">VS</span>
        <div class="flex-1 aspect-square rounded-md overflow-hidden bg-shark-900">
          <% if (p.nomineeEntryUrl) { %>
            <% if (p.nomineeEntryType === 'video') { %>
            <video src="<%= p.nomineeEntryUrl %>" class="w-full h-full object-cover pointer-events-none" muted preload="none"></video>
            <% } else { %>
            <img src="<%= p.nomineeEntryUrl %>" alt="" class="w-full h-full object-cover">
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- Accept / Decline buttons -->
      <div class="flex gap-2">
        <button type="button"
          class="notif-takeon-accept flex-1 bg-charm-600 hover:bg-charm-500 text-white font-bold rounded-md py-2 text-sm transition-colors cursor-pointer"
          data-nom-id="<%= p.nominationId %>" data-contest-id="<%= p.contestId %>">
          Accept
        </button>
        <button type="button"
          class="notif-takeon-decline flex-1 border border-white/15 text-white/50 hover:border-white/30 hover:text-white/70 font-semibold rounded-md py-2 text-sm transition-colors cursor-pointer"
          data-nom-id="<%= p.nominationId %>" data-contest-id="<%= p.contestId %>">
          Decline
        </button>
      </div>

      <% } else if (isTournamentEntrySubmitted) { %>

      <!-- Tournament entry submitted: header row + entry thumbnail -->
      <div class="flex items-start gap-3">
        <div class="shrink-0 mt-0.5">
          <% if (p.actorAvatar) { %>
          <img src="<%= p.actorAvatar %>" alt="" class="w-9 h-9 rounded-full object-cover">
          <% } else { %>
          <div class="w-9 h-9 rounded-full bg-white/8 flex items-center justify-center">
            <iconify-icon icon="boxicons:trophy" width="18" class="text-charm-400"></iconify-icon>
          </div>
          <% } %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-white/80 leading-snug"><%- notifText(n) %></p>
          <p class="text-xs text-white/25 mt-1"><%= fmtNotifTime(n.createdAt) %></p>
        </div>
        <div class="shrink-0 mt-2">
          <% if (!n.read) { %><span class="unread-dot w-2 h-2 rounded-full bg-charm-400 block"></span><% } else { %><span class="w-2 h-2 block"></span><% } %>
        </div>
      </div>

      <div class="pl-12">
        <div class="w-24 aspect-square rounded-md overflow-hidden bg-shark-900">
          <% if (p.entryType === 'video') { %>
          <video src="<%= p.entryUrl %>" class="w-full h-full object-cover pointer-events-none" muted preload="none"></video>
          <% } else { %>
          <img src="<%= p.entryUrl %>" alt="" class="w-full h-full object-cover">
          <% } %>
        </div>
      </div>

      <% } else if (isRemovalNotif) { %>

      <!-- Removal notification: text row + policy/dispute row -->
      <div class="flex items-start gap-3">
        <div class="shrink-0 mt-0.5">
          <div class="w-9 h-9 rounded-full bg-red-500/10 flex items-center justify-center">
            <iconify-icon icon="boxicons:x-circle" width="18" class="text-red-400"></iconify-icon>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-white/80 leading-snug"><%- notifText(n) %></p>
          <p class="text-xs text-white/25 mt-1"><%= fmtNotifTime(n.createdAt) %></p>
        </div>
        <div class="shrink-0 mt-2">
          <% if (!n.read) { %><span class="unread-dot w-2 h-2 rounded-full bg-charm-400 block"></span><% } else { %><span class="w-2 h-2 block"></span><% } %>
        </div>
      </div>
      <div class="flex items-center gap-3 pl-12">
        <a href="/guidelines" class="text-xs text-white/35 hover:text-white/60 transition-colors no-underline">Community guidelines</a>
        <span class="text-white/15 text-xs">·</span>
        <a href="/contact/new?topic=moderation&contentType=<%= n.type === 'entry_removed' ? 'entry' : 'comment' %>" class="text-xs text-charm-400 hover:text-charm-300 font-semibold transition-colors no-underline">Dispute this decision</a>
      </div>

      <% } else { %>

      <!-- Standard notification -->
      <div class="shrink-0 mt-0.5">
        <% if (p.actorAvatar) { %>
        <img src="<%= p.actorAvatar %>" alt="" class="w-9 h-9 rounded-full object-cover">
        <% } else { %>
        <div class="w-9 h-9 rounded-full bg-white/8 flex items-center justify-center">
          <iconify-icon icon="<%= notifIcon(n.type) %>" width="18" class="text-charm-400"></iconify-icon>
        </div>
        <% } %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm text-white/80 leading-snug"><%- notifText(n) %></p>
        <% if (p.preview) { %>
        <p class="text-xs text-white/35 mt-1 truncate">"<%= p.preview %>"</p>
        <% } %>
        <p class="text-xs text-white/25 mt-1"><%= fmtNotifTime(n.createdAt) %></p>
      </div>
      <div class="shrink-0 mt-2">
        <% if (!n.read) { %>
        <span class="unread-dot w-2 h-2 rounded-full bg-charm-400 block"></span>
        <% } else { %>
        <span class="w-2 h-2 block"></span>
        <% } %>
      </div>

      <% } %>
    </li>
    <% }) %>
  </ul>

  <% if (hasMore) { %>
  <div class="px-5 py-6 text-center">
    <a href="/notifications?page=<%= page + 1 %>" class="text-sm text-white/40 hover:text-charm-400 transition-colors">
      Load older notifications
    </a>
  </div>
  <% } %>

  <% } %>
</div>

<script>
(function () {
  async function markRead(id) {
    const res = await fetch('/notifications/' + id + '/read', { method: 'POST' });
    if (!res.ok) return null;
    return res.json();
  }

  document.querySelectorAll('.notif-item').forEach(function (item) {
    item.addEventListener('click', async function () {
      const id  = item.dataset.id;
      const url = item.dataset.url;
      const dot = item.querySelector('.unread-dot');
      if (dot) {
        await markRead(id);
        dot.remove();
        item.classList.remove('bg-charm-500/8');
        // Update badge
        const badge = document.getElementById('notif-badge');
        if (badge) {
          const count = parseInt(badge.textContent, 10) - 1;
          if (count <= 0) badge.remove();
          else badge.textContent = count > 99 ? '99+' : count;
        }
      }
      window.location.href = url;
    });
  });

  // ── Take-on Accept / Decline ────────────────────────────────────
  document.querySelectorAll('.notif-takeon-accept, .notif-takeon-decline').forEach(function (btn) {
    btn.addEventListener('click', async function (e) {
      e.stopPropagation();
      var nomId     = btn.dataset.nomId;
      var contestId = btn.dataset.contestId;
      var isAccept  = btn.classList.contains('notif-takeon-accept');
      var sibling   = btn.closest('.flex').querySelector(isAccept ? '.notif-takeon-decline' : '.notif-takeon-accept');
      btn.disabled = true;
      if (sibling) sibling.disabled = true;
      btn.textContent = isAccept ? 'Accepting…' : 'Declining…';
      try {
        var endpoint = isAccept ? '/api/nominations/' + nomId + '/take-on-accept' : '/api/nominations/' + nomId + '/decline';
        var r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed');
        window.location.href = '/contest/' + contestId;
      } catch (err) {
        btn.disabled = false;
        if (sibling) sibling.disabled = false;
        btn.textContent = isAccept ? 'Accept' : 'Decline';
        if (window.showToast) window.showToast(err.message || 'Something went wrong.', 'error');
      }
    });
  });

  const markAllBtn = document.getElementById('mark-all-btn');
  if (markAllBtn) {
    markAllBtn.addEventListener('click', async function () {
      await fetch('/notifications/read-all', { method: 'POST' });
      document.querySelectorAll('.unread-dot').forEach(function (dot) { dot.remove(); });
      document.querySelectorAll('.notif-item').forEach(function (item) {
        item.classList.remove('bg-charm-500/8');
      });
      const badge = document.getElementById('notif-badge');
      if (badge) badge.remove();
      markAllBtn.remove();
    });
  }
})();
</script>

<%- include('partials/appEnd') %>
