<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="min-h-screen bg-shark-950 text-white">

  <!-- Top bar -->
  <header class="sticky top-0 z-10 bg-shark-950/95 backdrop-blur border-b border-white/5 px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-gochi text-charm-500 text-2xl leading-none" style="-webkit-text-stroke: 1px currentColor">AllThingsAprons</a>
    <div class="flex items-center gap-1.5 text-sm">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">1</div>
        <span class="text-white/45 hidden lg:inline">Profile Creation</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">2</div>
        <span class="text-white/45 hidden lg:inline">Email Verification</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">3</div>
        <span class="text-white/45 hidden lg:inline">Identity Verification</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600 text-white text-xs font-bold flex items-center justify-center">4</div>
        <span class="text-white/60 hidden lg:inline">Entry Submission</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-shark-700 text-white/35 text-xs font-bold flex items-center justify-center">5</div>
        <span class="text-white/30 hidden lg:inline">Pending Approval</span>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <button type="button" id="header-cancel-btn" class="text-xs text-white capitalize hover:text-white/70 transition-colors cursor-pointer">Cancel sign up</button>
      <form action="/logout" method="POST">
        <button type="submit" class="text-sm text-white capitalize hover:text-white/70 transition-colors cursor-pointer">Sign out</button>
      </form>
    </div>
  </header>

  <div class="flex justify-center px-4 py-10 pb-20">
    <div class="w-full max-w-4xl">

      <div class="mb-8">

        <!-- Profile summary badge -->
        <div class="flex items-center gap-3.5 bg-shark-900 border border-white/8 rounded-md px-4 py-3 mb-5">
          <div class="shrink-0 w-11 h-11 rounded-full overflow-hidden bg-shark-800 flex items-center justify-center">
            <% if (profileUser.avatar) { %>
            <img src="<%= profileUser.avatar %>" alt="" class="w-full h-full object-cover">
            <% } else { %>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="text-white/25">
              <path d="M0 0h24v24H0z" fill="none" />
              <path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1" />
            </svg>
            <% } %>
          </div>
          <div class="min-w-0 flex-1 flex flex-col gap-0.5">
            <p class="text-sm font-bold leading-tight">@<%= profileUser.username %></p>
            <p class="text-xs text-white/45 truncate"><%= profileUser.email %></p>
            <% var details = []; %>
            <% if (profileUser.age)         details.push(profileUser.age + ' y/o'); %>
            <% if (profileUser.sex)         details.push(profileUser.sex); %>
            <% if (profileUser.orientation) details.push(profileUser.orientation); %>
            <% if (details.length) { %>
            <p class="text-xs text-white/30"><%= details.join(' · ') %></p>
            <% } %>
          </div>
          <div class="shrink-0 flex flex-col items-end gap-2 pl-2">
            <a href="/signup"
              class="text-xs text-white/45 hover:text-white/80 transition-colors flex items-center gap-1.5 cursor-pointer">
              <iconify-icon icon="boxicons:pencil" width="11"></iconify-icon>
              Edit
            </a>
            <button type="button" id="cancel-signup-btn"
              class="text-xs text-red-400/60 hover:text-red-400 transition-colors flex items-center gap-1.5 cursor-pointer">
              <iconify-icon icon="boxicons:x" width="11"></iconify-icon>
              Cancel sign up
            </button>
          </div>
        </div>
        <form id="cancel-signup-form" action="/onboarding/cancel" method="POST" class="hidden"></form>

        <h1 class="text-2xl font-black">
          <% if (wasRejected) { %>Your previous entry was rejected.<br>Submit a new one to try again.<% } else { %>Submit your first ever entry to validate your account<% } %>
        </h1>
        <p class="text-white/40 mt-2 text-sm leading-relaxed">
          Membership is earned through competition. Submit an entry to one of the open tournaments below — once an organizer approves it, you'll have full access.
        </p>
      </div>

      <% if (error) { %>
      <div class="flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-6">
        <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
        <%= error %>
      </div>
      <% } %>

      <% if (!tournaments || !tournaments.length) { %>

      <!-- Holding screen -->
      <div class="flex flex-col items-center justify-center py-20 text-center bg-shark-900 border border-white/8 rounded-md">
        <iconify-icon icon="boxicons:time" width="40" class="text-white/15 mb-4"></iconify-icon>
        <h2 class="text-lg font-bold mb-2">No tournaments open right now</h2>
        <p class="text-white/40 text-sm max-w-xs leading-relaxed">
          No tournament is accepting entries at the moment. Check back later — new tournaments open regularly.
        </p>
      </div>

      <% } else { %>

      <form action="/onboarding/submit" method="POST" enctype="multipart/form-data" novalidate id="onboarding-form">
        <input type="hidden" name="tournamentId" id="tournamentId" value="">

        <!-- Tournament selection -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-bold text-white/40 uppercase tracking-wider">Open Tournaments</h2>
            <span class="text-xs text-white/30"><%= tournaments.length %> open</span>
          </div>
          <div class="relative mb-4">
            <iconify-icon icon="boxicons:search" width="14" class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 pointer-events-none"></iconify-icon>
            <input id="tournament-search" type="text" placeholder="Search tournaments…"
              class="w-full h-10 bg-shark-900 border border-white/10 rounded-md pl-8 pr-3 text-sm text-white placeholder:text-white/25 focus:outline-none focus:border-charm-600/40 transition-colors" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tournament-list">
            <% tournaments.forEach(function(t, idx) { %>
            <div class="tournament-card cursor-pointer bg-shark-900 border border-white/10 rounded-md overflow-hidden hover:bg-shark-800 transition-colors"
                 data-id="<%= t._id %>" data-name="<%= t.name %>" data-index="<%= idx %>">

              <!-- Cover (square, placeholder) -->
              <div class="aspect-square flex items-center justify-center <%= t.type === 'platform' ? 'bg-charm-600/8' : 'bg-blue-600/8' %>">
                <iconify-icon icon="boxicons:trophy" width="56" class="<%= t.type === 'platform' ? 'text-charm-400/20' : 'text-blue-400/20' %>"></iconify-icon>
              </div>

              <!-- Body -->
              <div class="p-4 flex flex-col gap-2.5">
                <p class="font-bold text-sm leading-snug" style="-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden"><%= t.name %></p>
                <% if (t.description) { %>
                <div>
                  <p class="desc-text text-xs text-white/40 leading-relaxed" style="-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden"><%= t.description %></p>
                  <button type="button" class="read-more-btn hidden text-xs text-charm-400/70 hover:text-charm-400 mt-1 transition-colors cursor-pointer">Read more</button>
                </div>
                <% } %>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  <span class="text-xs <%= t.type === 'platform' ? 'text-charm-400/70' : 'text-blue-400/70' %>">#<%= t.type === 'platform' ? 'platform' : 'community' %></span>
                </div>

                <!-- Stats -->
                <div class="flex items-center gap-2 text-xs text-white/35">
                  <% if (t.timeLeft) { %>
                  <span class="flex items-center gap-1">
                    <iconify-icon icon="boxicons:time" width="12"></iconify-icon>
                    <%= t.timeLeft %>
                  </span>
                  <span class="text-white/20">—</span>
                  <% } %>
                  <span><%= t.entryCount %> <%= t.entryCount === 1 ? 'entry' : 'entries' %></span>
                </div>

                <!-- Organizer -->
                <div class="flex items-center gap-1.5 text-xs text-white/30 border-t border-white/6 pt-2.5">
                  <span class="text-white/45">by @<%= t.createdBy && t.createdBy.username ? t.createdBy.username : 'admin' %></span>
                  <span class="text-white/20">—</span>
                  <span><%= t.organizerCount %> <%= t.organizerCount === 1 ? 'tournament' : 'tournaments' %></span>
                </div>

                <!-- Participate -->
                <button type="button"
                  class="participate-btn w-full mt-1 h-10 bg-charm-600 hover:bg-charm-500 text-white text-xs font-bold rounded-md transition-colors cursor-pointer"
                  data-id="<%= t._id %>" data-name="<%= t.name %>">
                  Participate
                </button>

              </div>
            </div>
            <% }); %>
          </div>
          <p id="tournament-error" class="text-xs text-red-400 hidden mt-2"></p>
          <div id="search-empty" class="hidden py-14 text-center text-white/30 text-sm">No tournaments match your search.</div>

          <!-- Load More -->
          <div id="load-more-wrap" class="mt-6 flex justify-center">
            <button type="button" id="load-more-btn"
              class="px-6 py-2.5 bg-shark-900 border border-white/10 rounded-md text-sm text-white/60 hover:text-white hover:bg-shark-800 transition-colors cursor-pointer">
              Load More
            </button>
          </div>
        </div>

        <!-- Participate modal -->
        <div id="participate-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div class="w-full max-w-lg bg-shark-900 border border-white/10 rounded-md p-6 flex flex-col gap-5">

            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold text-white/40 uppercase tracking-wide mb-1">Submitting to</p>
                <h3 class="font-bold text-base leading-snug" id="modal-tournament-name"></h3>
              </div>
              <button type="button" id="close-modal"
                class="shrink-0 text-white/35 hover:text-white/70 transition-colors cursor-pointer mt-0.5">
                <iconify-icon icon="boxicons:x" width="20"></iconify-icon>
              </button>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Entry Photo <span class="text-charm-500">*</span>
              </label>
              <label id="entry-upload-zone" class="cursor-pointer block">
                <div id="entry-placeholder"
                  class="border-2 border-dashed border-white/12 rounded-md p-10 flex flex-col items-center gap-3 text-white/35 hover:border-charm-600/40 hover:text-white/55 transition-colors">
                  <iconify-icon icon="boxicons:image-add" width="40"></iconify-icon>
                  <div class="text-center">
                    <p class="text-sm font-medium">Click to upload or drag &amp; drop</p>
                    <p class="text-xs mt-0.5 text-white/25">PNG, JPG, WEBP — max 10 MB</p>
                  </div>
                </div>
                <div id="entry-preview-container" class="hidden relative rounded-md overflow-hidden">
                  <img id="entry-preview-img" src="" alt="Entry preview" class="w-full max-h-72 object-cover rounded-md">
                  <div class="absolute top-2 right-2 bg-shark-950/80 rounded-md px-2 py-1 text-xs text-white/60 flex items-center gap-1 pointer-events-none">
                    <iconify-icon icon="boxicons:pencil" width="11"></iconify-icon>
                    Change
                  </div>
                </div>
                <input type="file" name="entryPhoto" id="entry-input" accept="image/*" class="hidden">
              </label>
              <p id="entry-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="caption" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Caption <span class="text-white/25 font-normal normal-case">(optional)</span>
              </label>
              <textarea id="caption" name="caption" rows="3"
                placeholder="Describe your design, materials, inspiration..."
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"></textarea>
            </div>

            <button type="submit" id="submit-btn"
              class="w-full bg-charm-600 hover:bg-charm-500 disabled:opacity-50 text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
              Submit Entry for Review
            </button>

          </div>
        </div>

      </form>

      <% } %>

    </div>
  </div>

<script>
(function () {
  var PAGE_SIZE   = 6;
  var visibleLimit = PAGE_SIZE;
  var allCards    = Array.from(document.querySelectorAll('.tournament-card'));
  var totalCards  = allCards.length;
  var searching   = false;

  // ── Pagination ─────────────────────────────────────────────
  function applyPageLimit() {
    allCards.forEach(function (card) {
      var idx = parseInt(card.dataset.index, 10);
      card.style.display = idx < visibleLimit ? '' : 'none';
    });
    var wrap = document.getElementById('load-more-wrap');
    if (wrap) wrap.style.display = visibleLimit >= totalCards ? 'none' : '';
  }

  applyPageLimit();

  var loadMoreBtn = document.getElementById('load-more-btn');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function () {
      visibleLimit += PAGE_SIZE;
      applyPageLimit();
    });
  }

  // ── Read more ──────────────────────────────────────────────
  allCards.forEach(function (card) {
    var desc = card.querySelector('.desc-text');
    var btn  = card.querySelector('.read-more-btn');
    if (!desc || !btn) return;
    if (desc.scrollHeight > desc.clientHeight) {
      btn.classList.remove('hidden');
    }
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      desc.style.webkitLineClamp = '';
      desc.style.webkitBoxOrient = '';
      desc.style.display         = '';
      desc.style.overflow        = '';
      btn.classList.add('hidden');
    });
  });

  // ── Modal helpers ──────────────────────────────────────────
  var modal = document.getElementById('participate-modal');

  function openModal(id, name) {
    document.getElementById('tournamentId').value = id;
    document.getElementById('modal-tournament-name').textContent = name;

    allCards.forEach(function (c) {
      c.classList.remove('border-charm-600', 'bg-charm-600/5');
    });
    var card = document.querySelector('.tournament-card[data-id="' + id + '"]');
    if (card) card.classList.add('border-charm-600', 'bg-charm-600/5');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // ── Participate buttons ─────────────────────────────────────
  document.querySelectorAll('.participate-btn').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      openModal(this.dataset.id, this.dataset.name);
    });
  });

  document.getElementById('close-modal').addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  // ── Entry photo preview ────────────────────────────────────
  document.getElementById('entry-input') && document.getElementById('entry-input').addEventListener('change', function () {
    if (!this.files[0]) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      document.getElementById('entry-preview-img').src = e.target.result;
      document.getElementById('entry-placeholder').classList.add('hidden');
      document.getElementById('entry-preview-container').classList.remove('hidden');
    };
    reader.readAsDataURL(this.files[0]);
  });

  // ── Form submit ────────────────────────────────────────────
  document.getElementById('onboarding-form') && document.getElementById('onboarding-form').addEventListener('submit', function (e) {
    var inp = document.getElementById('entry-input');
    if (!inp.files || !inp.files[0]) {
      e.preventDefault();
      var err = document.getElementById('entry-error');
      err.textContent = 'Please upload your entry photo.';
      err.classList.remove('hidden');
      return;
    }
    var btn = document.getElementById('submit-btn');
    btn.disabled    = true;
    btn.textContent = 'Submitting…';
  });

  // ── Tournament search ──────────────────────────────────────
  var searchInput = document.getElementById('tournament-search');
  if (searchInput) {
    searchInput.addEventListener('input', function () {
      var q    = this.value.trim().toLowerCase();
      var wrap = document.getElementById('load-more-wrap');
      var shown = 0;

      if (q) {
        searching = true;
        allCards.forEach(function (card) {
          var match = card.textContent.toLowerCase().includes(q);
          card.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        if (wrap) wrap.style.display = 'none';
      } else {
        searching = false;
        applyPageLimit();
        shown = Math.min(visibleLimit, totalCards);
      }

      var empty = document.getElementById('search-empty');
      if (empty) empty.classList.toggle('hidden', shown > 0);
    });
  }

  // ── Cancel sign up ─────────────────────────────────────────
  function confirmCancel() {
    if (confirm('Cancel your sign up? Your account will be permanently deleted and you\'ll need to start over.')) {
      document.getElementById('cancel-signup-form').submit();
    }
  }
  var cancelBtn = document.getElementById('cancel-signup-btn');
  if (cancelBtn) cancelBtn.addEventListener('click', confirmCancel);
  var headerCancelBtn = document.getElementById('header-cancel-btn');
  if (headerCancelBtn) headerCancelBtn.addEventListener('click', confirmCancel);
}());
</script>

</body>
</html>
