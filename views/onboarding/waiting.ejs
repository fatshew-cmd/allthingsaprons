<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-shark-950 text-white">

  <!-- Top bar -->
  <header class="sticky top-0 z-10 bg-shark-950/95 backdrop-blur border-b border-white/5 px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-gochi text-charm-500 text-2xl leading-none" style="-webkit-text-stroke: 1px currentColor">AllThingsAprons</a>
    <div class="flex items-center gap-1.5 text-sm">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">1</div>
        <span class="text-white/45 hidden lg:inline">Profile Creation</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">2</div>
        <span class="text-white/45 hidden lg:inline">Email Verification</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">3</div>
        <span class="text-white/45 hidden lg:inline">Identity Verification</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600/40 text-charm-400 text-xs font-bold flex items-center justify-center">4</div>
        <span class="text-white/45 hidden lg:inline">Entry Submission</span>
      </div>
      <div class="w-6 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-charm-600 text-white text-xs font-bold flex items-center justify-center">5</div>
        <span class="text-white/60 hidden lg:inline">Pending Approval</span>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <button type="button" id="cancel-signup-btn" class="text-xs text-white capitalize hover:text-white/70 transition-colors cursor-pointer">Cancel sign up</button>
      <form action="/logout" method="POST">
        <button type="submit" class="text-sm text-white capitalize hover:text-white/70 transition-colors cursor-pointer">Sign out</button>
      </form>
    </div>
  </header>
  <form id="cancel-signup-form" action="/onboarding/cancel" method="POST" class="hidden"></form>

  <div class="flex flex-col items-center justify-center min-h-[calc(100vh-3.5rem)] px-4 text-center">
    <div class="max-w-sm">

      <div class="w-16 h-16 rounded-md bg-amber-400/10 flex items-center justify-center mx-auto mb-6">
        <iconify-icon icon="boxicons:hourglass" width="32" class="text-amber-400"></iconify-icon>
      </div>

      <h1 class="text-2xl font-black mb-3">Your entry is under review</h1>
      <p class="text-white/40 text-sm leading-relaxed mb-8">
        <% if (username) { %><span class="text-white/70">@<%= username %></span>, your<% } else { %>Your<% } %>
        submission is waiting for organizer approval.
        Once approved, you'll have full access to the platform.
      </p>

      <div class="bg-shark-900 border border-white/8 rounded-md p-5 text-left flex flex-col gap-3 mb-8">
        <div class="flex items-center gap-3 text-sm">
          <div class="w-6 h-6 rounded-md bg-green-400/15 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:check" width="13" class="text-green-400"></iconify-icon>
          </div>
          <span class="text-white/60">Account created</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <div class="w-6 h-6 rounded-md bg-green-400/15 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:check" width="13" class="text-green-400"></iconify-icon>
          </div>
          <span class="text-white/60">Identity verified</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <div class="w-6 h-6 rounded-md bg-green-400/15 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:check" width="13" class="text-green-400"></iconify-icon>
          </div>
          <span class="text-white/60">Entry submitted</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <div class="w-6 h-6 rounded-md bg-amber-400/15 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:time" width="13" class="text-amber-400"></iconify-icon>
          </div>
          <span class="text-white/80 font-medium">Waiting for approval</span>
        </div>
        <div class="flex items-center gap-3 text-sm opacity-35">
          <div class="w-6 h-6 rounded-md bg-white/5 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:lock" width="13" class="text-white/40"></iconify-icon>
          </div>
          <span>Platform access</span>
        </div>
      </div>

      <button type="button" onclick="window.location.reload()"
        class="w-full flex items-center justify-center gap-2 h-10 bg-shark-900 border border-white/10 rounded-md text-sm text-white/50 hover:text-white hover:bg-shark-800 transition-colors cursor-pointer">
        <iconify-icon icon="boxicons:refresh" width="15"></iconify-icon>
        Refresh
      </button>

    </div>
  </div>

<script>
document.getElementById('cancel-signup-btn').addEventListener('click', function () {
  if (confirm('Cancel your sign up? Your account will be permanently deleted and you\'ll need to start over.')) {
    document.getElementById('cancel-signup-form').submit();
  }
});
</script>

</body>
</html>
