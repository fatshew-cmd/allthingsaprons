<%- include('partials/appStart', { title: 'Feed', activePage: 'feed' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <% if (locals.feedEntries && feedEntries.length > 0) { %>
    <% feedEntries.forEach(function(fe) { %>
      <%- include('partials/entryCard', {
        entry:         fe,
        owner:         fe.owner,
        currentUserId: currentUser._id.toString(),
        isFollowing:   false,
        userRating:    fe.userRating,
        nominees:      nomineesMap[fe._id.toString()] || [],
        contestInfo:   contestInfoMap[fe._id.toString()] || null,
      }) %>
    <% }) %>
  <% } else { %>
  <div class="flex flex-col items-center justify-center py-20 gap-3 text-center">
    <iconify-icon icon="boxicons:photo-album" width="40" class="text-white/15"></iconify-icon>
    <p class="text-sm text-white/30">No entries to rate yet.</p>
  </div>
  <% } %>

</div>

<%- include('partials/appEnd') %>
