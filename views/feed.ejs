<%- include('partials/appStart', { title: title, activePage: 'feed' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Sticky header -->
  <header class="sticky top-0 z-10 flex items-center justify-center border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <button id="tab-rate"    onclick="switchMode('rate')"
            class="tab-btn tab-active text-sm font-semibold px-6 py-4 transition-all">Rating</button>
    <button id="tab-compare" onclick="switchMode('compare')"
            class="tab-btn tab-inactive text-sm font-semibold px-6 py-4 transition-all">Head To Head</button>
  </header>

  <!-- ── Rate Mode ── -->
  <div id="mode-rate" class="flex flex-col px-4 py-4 gap-4 max-w-sm mx-auto w-full">

    <!-- Card -->
    <div id="rate-card" class="card-enter relative rounded-md overflow-hidden bg-white/5 border border-white/10" style="aspect-ratio: 4/5;">
      <img id="rate-img" src="" class="w-full h-full object-cover" alt="item" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p id="rate-tag" class="text-xs font-semibold text-charm-400 uppercase tracking-widest mb-1 truncate"></p>
            <h2 id="rate-title" class="text-xl font-bold leading-tight"></h2>
            <p id="rate-author" class="text-sm text-white/60 mt-1"></p>
          </div>
          <span id="rate-counter" class="bg-white/10 backdrop-blur-sm text-xs px-3 py-1.5 rounded-md font-medium shrink-0"></span>
        </div>
      </div>
      <button onclick="skipCard()"
              class="absolute top-4 right-4 bg-black/40 backdrop-blur-sm text-white/60 text-xs px-3 py-1.5 rounded-md hover:text-white transition-colors">
        Skip
      </button>
    </div>

    <!-- Star rating -->
    <div class="bg-white/5 rounded-md border border-white/10 p-5">
      <p class="text-sm text-white/50 text-center mb-4">How would you rate this?</p>
      <div class="flex items-center justify-center gap-2 mb-5">
        <button class="star-btn text-4xl text-white/20" onclick="rateStar(1)">★</button>
        <button class="star-btn text-4xl text-white/20" onclick="rateStar(2)">★</button>
        <button class="star-btn text-4xl text-white/20" onclick="rateStar(3)">★</button>
        <button class="star-btn text-4xl text-white/20" onclick="rateStar(4)">★</button>
        <button class="star-btn text-4xl text-white/20" onclick="rateStar(5)">★</button>
      </div>
      <p id="star-label" class="text-center text-sm text-white/40 mb-5">Tap a star to rate</p>
      <button id="submit-btn" onclick="submitRating()" disabled
              class="w-full py-3 rounded-md font-semibold text-sm bg-charm-600 text-white transition-all disabled:opacity-30 disabled:cursor-not-allowed">
        Submit Rating
      </button>
    </div>

    <!-- Community average -->
    <div class="bg-white/5 rounded-md border border-white/10 px-4 py-3 flex items-center gap-3">
      <span class="text-xs text-white/40 shrink-0">Community avg</span>
      <div class="flex-1 h-2 bg-white/10 rounded-md overflow-hidden">
        <div id="community-bar" class="h-full bg-charm-500 rounded-md transition-all duration-500" style="width: 0%;"></div>
      </div>
      <span id="community-score" class="text-sm font-bold text-charm-400 shrink-0">—</span>
    </div>

  </div>

  <!-- ── Compare Mode ── -->
  <div id="mode-compare" class="hidden flex-col px-4 py-4 gap-4 max-w-sm mx-auto w-full">

    <p class="text-sm text-white/40 text-center">Which do you prefer?</p>

    <div class="flex items-center gap-3">

      <!-- Card A -->
      <div id="compare-a" class="compare-card relative rounded-md overflow-hidden flex-1 border border-white/10 cursor-pointer"
           style="aspect-ratio: 3/4;" onclick="pickWinner('a')">
        <img id="compare-img-a" src="" class="w-full h-full object-cover" alt="A" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-3">
          <p class="text-xs font-semibold text-charm-400 uppercase tracking-wider mb-0.5">Style A</p>
          <p id="compare-name-a" class="text-sm font-bold leading-tight"></p>
        </div>
        <div id="winner-a" class="hidden absolute inset-0 bg-charm-500/15 border-2 border-charm-500 rounded-md">
          <div class="flex items-center justify-center h-full">
            <div class="text-center">
              <span class="text-3xl">✓</span>
              <p class="text-xs font-bold text-charm-400 mt-1">Your Pick</p>
            </div>
          </div>
        </div>
      </div>

      <div class="vs-badge shrink-0">VS</div>

      <!-- Card B -->
      <div id="compare-b" class="compare-card relative rounded-md overflow-hidden flex-1 border border-white/10 cursor-pointer"
           style="aspect-ratio: 3/4;" onclick="pickWinner('b')">
        <img id="compare-img-b" src="" class="w-full h-full object-cover" alt="B" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-3">
          <p class="text-xs font-semibold text-charm-400 uppercase tracking-wider mb-0.5">Style B</p>
          <p id="compare-name-b" class="text-sm font-bold leading-tight"></p>
        </div>
        <div id="winner-b" class="hidden absolute inset-0 bg-charm-500/15 border-2 border-charm-500 rounded-md">
          <div class="flex items-center justify-center h-full">
            <div class="text-center">
              <span class="text-3xl">✓</span>
              <p class="text-xs font-bold text-charm-400 mt-1">Your Pick</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Result reveal -->
    <div id="compare-result" class="hidden bg-white/5 rounded-md border border-white/10 p-5">
      <p class="text-sm text-white/50 text-center mb-4">Community said…</p>
      <div class="flex items-center gap-3 mb-2">
        <span id="result-name-a" class="text-xs text-white/60 w-16 text-right truncate"></span>
        <div class="flex-1 h-3 bg-white/10 rounded-md overflow-hidden">
          <div id="bar-a" class="h-full bg-charm-500 rounded-l-full transition-all duration-500" style="width: 0%;"></div>
        </div>
        <span id="pct-a" class="text-xs font-bold text-charm-400 w-8">0%</span>
      </div>
      <div class="flex items-center gap-3 mb-5">
        <span id="result-name-b" class="text-xs text-white/60 w-16 text-right truncate"></span>
        <div class="flex-1 h-3 bg-white/10 rounded-md overflow-hidden">
          <div id="bar-b" class="h-full bg-blue-400 rounded-l-full transition-all duration-500" style="width: 0%;"></div>
        </div>
        <span id="pct-b" class="text-xs font-bold text-blue-400 w-8">0%</span>
      </div>
      <button onclick="nextPair()" class="w-full py-3 rounded-md bg-charm-600 text-white font-bold text-sm">
        Next Pair →
      </button>
    </div>

    <button onclick="nextPair()" class="text-sm text-white/30 text-center py-1 hover:text-white/60 transition-colors">
      Too close to call — skip
    </button>

  </div>

</div>

<!-- Toast -->
<div id="toast"
     class="hidden fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-green-500 text-white text-sm font-semibold px-5 py-3 rounded-md shadow-lg whitespace-nowrap"></div>

<style>
  .card-enter { animation: cardEnter 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes cardEnter {
    from { opacity: 0; transform: scale(0.92) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .card-exit-left  { animation: exitLeft  0.3s ease-in both; }
  .card-exit-right { animation: exitRight 0.3s ease-in both; }
  @keyframes exitLeft  { to { opacity: 0; transform: translateX(-120%) rotate(-8deg); } }
  @keyframes exitRight { to { opacity: 0; transform: translateX( 120%) rotate( 8deg); } }
  .star-btn { transition: transform 0.1s, color 0.1s; cursor: pointer; }
  .star-btn:hover { transform: scale(1.3); }
  .tab-active   { color: #ffffff; border-bottom: 2px solid #dd6890; margin-bottom: -1px; }
  .tab-inactive { color: rgba(255,255,255,0.35); border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .vs-badge {
    background: linear-gradient(135deg, #dd6890, #ac2a4c);
    border-radius: 50%;
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 14px; letter-spacing: 1px;
    box-shadow: 0 0 20px rgba(199, 59, 100, 0.4);
  }
  .compare-card { transition: transform 0.15s, box-shadow 0.15s; }
  .compare-card:hover { transform: scale(1.02); box-shadow: 0 0 30px rgba(199, 59, 100, 0.25); }
  .compare-card:active { transform: scale(0.98); }
</style>

<script>
  const items = <%- JSON.stringify(items) %>;
  const pairs = <%- JSON.stringify(pairs) %>;

  let cardIndex = 0;
  let pairIndex = 0;
  let selectedStar = 0;

  const starLabels = ['', 'Terrible', 'Not great', 'OK, decent', 'Really good', 'Love it!'];

  function loadCard(idx) {
    const item = items[idx];
    document.getElementById('rate-img').src       = item.mediaUrl;
    document.getElementById('rate-tag').textContent    = item.tags[0] || '';
    document.getElementById('rate-title').textContent  = item.title;
    document.getElementById('rate-author').textContent = 'by ' + (item.authorName || 'unknown');
    document.getElementById('rate-counter').textContent = (idx + 1) + ' of ' + items.length;
    const pct = (item.ratingScore / 5) * 100;
    document.getElementById('community-bar').style.width = pct + '%';
    document.getElementById('community-score').textContent = item.ratingScore.toFixed(1) + '★';
    updateRightPanel(item);
  }

  function loadPair(idx) {
    const pair = pairs[idx % pairs.length];
    document.getElementById('compare-img-a').src       = pair.a.mediaUrl;
    document.getElementById('compare-name-a').textContent = pair.a.title;
    document.getElementById('compare-img-b').src       = pair.b.mediaUrl;
    document.getElementById('compare-name-b').textContent = pair.b.title;
    document.getElementById('result-name-a').textContent  = pair.a.title;
    document.getElementById('result-name-b').textContent  = pair.b.title;
  }

  function updateRightPanel(item) {
    const panel = document.getElementById('panel-item-detail');
    if (!panel) return;
    panel.classList.remove('hidden');
    const pct = (item.ratingScore / 5) * 100;
    document.getElementById('detail-score').textContent = item.ratingScore.toFixed(1) + '★';
    document.getElementById('detail-bar').style.width   = pct + '%';
    document.getElementById('detail-count').textContent = item.ratingCount + ' ratings';
  }

  function switchMode(mode) {
    const rateEl    = document.getElementById('mode-rate');
    const compareEl = document.getElementById('mode-compare');
    rateEl.classList.toggle('hidden', mode !== 'rate');
    rateEl.classList.toggle('flex',   mode === 'rate');
    compareEl.classList.toggle('hidden', mode !== 'compare');
    compareEl.classList.toggle('flex',   mode === 'compare');
    document.getElementById('tab-rate').className    = 'tab-btn text-sm font-semibold px-6 py-4 transition-all ' + (mode === 'rate'    ? 'tab-active' : 'tab-inactive');
    document.getElementById('tab-compare').className = 'tab-btn text-sm font-semibold px-6 py-4 transition-all ' + (mode === 'compare' ? 'tab-active' : 'tab-inactive');
  }

  function rateStar(val) {
    selectedStar = val;
    document.querySelectorAll('.star-btn').forEach((s, i) => {
      s.style.color = i < val ? '#dd6890' : 'rgba(255,255,255,0.2)';
    });
    document.getElementById('star-label').textContent = starLabels[val];
    document.getElementById('star-label').style.color = '#dd6890';
    document.getElementById('submit-btn').disabled = false;
  }

  function submitRating() {
    const card = document.getElementById('rate-card');
    card.classList.add('card-exit-right');
    showToast('Rated ' + selectedStar + '★ — nice!');
    setTimeout(() => { card.classList.remove('card-exit-right'); advanceCard(); }, 300);
  }

  function skipCard() {
    const card = document.getElementById('rate-card');
    card.classList.add('card-exit-left');
    setTimeout(() => { card.classList.remove('card-exit-left'); advanceCard(); }, 300);
  }

  function advanceCard() {
    cardIndex = (cardIndex + 1) % items.length;
    selectedStar = 0;
    document.querySelectorAll('.star-btn').forEach(s => s.style.color = 'rgba(255,255,255,0.2)');
    document.getElementById('star-label').textContent = 'Tap a star to rate';
    document.getElementById('star-label').style.color = '';
    document.getElementById('submit-btn').disabled = true;
    loadCard(cardIndex);
    const card = document.getElementById('rate-card');
    card.classList.remove('card-enter');
    void card.offsetWidth;
    card.classList.add('card-enter');
  }

  function pickWinner(side) {
    document.getElementById('compare-result').classList.remove('hidden');
    ['a', 'b'].forEach(s => {
      const el = document.getElementById('compare-' + s);
      el.classList.remove('compare-card');
      el.style.cursor = 'default';
      el.onclick = null;
    });
    document.getElementById('winner-' + side).classList.remove('hidden');
    const pair = pairs[pairIndex % pairs.length];
    const pA = pair.pctA, pB = 100 - pA;
    setTimeout(() => {
      document.getElementById('bar-a').style.width = pA + '%';
      document.getElementById('bar-b').style.width = pB + '%';
      document.getElementById('pct-a').textContent = pA + '%';
      document.getElementById('pct-b').textContent = pB + '%';
    }, 100);
    showToast('Vote counted!');
  }

  function nextPair() {
    pairIndex = (pairIndex + 1) % pairs.length;
    ['a', 'b'].forEach(s => {
      document.getElementById('winner-' + s).classList.add('hidden');
      const el = document.getElementById('compare-' + s);
      el.classList.add('compare-card');
      el.style.cursor = 'pointer';
      el.onclick = () => pickWinner(s);
    });
    document.getElementById('compare-result').classList.add('hidden');
    document.getElementById('bar-a').style.width = '0%';
    document.getElementById('bar-b').style.width = '0%';
    document.getElementById('pct-a').textContent = '0%';
    document.getElementById('pct-b').textContent = '0%';
    loadPair(pairIndex);
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.remove('hidden');
    setTimeout(() => t.classList.add('hidden'), 2000);
  }

  // Init
  loadCard(0);
  loadPair(0);
</script>

<%- include('partials/appEnd') %>
