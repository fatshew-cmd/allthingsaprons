<%- include('partials/appStart', { title: title, activePage: activePage }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Banner + avatar + action row -->
  <div class="relative shrink-0">
    <div class="relative h-32 sm:h-40 bg-shark-800 overflow-hidden">
      <% if (profileUser.banner) { %>
        <img src="<%= profileUser.banner %>" alt="" class="w-full h-full object-cover">
      <% } %>
      <div class="absolute inset-0 bg-linear-to-t from-shark-950/70 via-shark-950/20 to-transparent pointer-events-none"></div>
    </div>
    <div class="h-20 px-5 bg-shark-950 flex items-center justify-end">
      <% if (isOwn) { %>
      <button type="button" id="profile-edit-open" class="inline-flex items-center gap-2 px-4 py-2 border border-white/35 rounded-md text-sm font-semibold text-white hover:bg-white/8 transition-colors cursor-pointer">
        <iconify-icon icon="boxicons:pencil" width="14"></iconify-icon>
        Edit profile
      </button>
      <% } %>
    </div>
    <!-- Avatar pinned between banner and action row -->
    <div class="absolute left-5 bottom-5 z-10 w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden bg-charm-950 flex items-center justify-center border-[4px] border-shark-950 shadow-[0_0_0_1px_rgba(255,255,255,0.1)]">
      <% if (profileUser.avatar) { %>
        <img src="<%= profileUser.avatar %>" alt="<%= profileUser.username %>" class="w-full h-full object-cover" />
      <% } else { %>
        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 24 24" class="text-charm-400">
          <path d="M0 0h24v24H0z" fill="none" />
          <path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1" />
        </svg>
      <% } %>
    </div>
  </div>

  <!-- Profile section -->
  <div class="px-5 pt-6 pb-3">

    <!-- Name -->
    <div class="<%= isOwn ? '' : 'mt-1' %>">
      <% if (profileUser.displayName) { %>
        <p class="font-bold text-base leading-tight"><%= profileUser.displayName %></p>
        <p class="text-sm text-white/40 mt-0.5">@<%= profileUser.username %></p>
      <% } else { %>
        <p class="font-bold text-base leading-tight">@<%= profileUser.username %></p>
      <% } %>
    </div>

    <!-- Bio -->
    <div class="mt-3">
      <p id="profile-bio-text" class="text-sm leading-relaxed line-clamp-2 <%= profileUser.bio ? 'text-white/60' : 'text-white/25 italic' %>">
        <%= profileUser.bio || 'No bio yet.' %>
      </p>
      <% if (profileUser.bio) { %>
      <button id="profile-bio-toggle" class="hidden mt-1 text-xs text-white/40 hover:text-white transition-colors">Read more</button>
      <% } %>
    </div>

    <!-- Meta: age · sex · location · url -->
    <%
      let age = null;
      let birthdateLabel = null;
      if (profileUser.birthdate) {
        const now = new Date();
        const b   = new Date(profileUser.birthdate);
        age = now.getFullYear() - b.getFullYear();
        if (now < new Date(now.getFullYear(), b.getMonth(), b.getDate())) age--;
        const day   = b.getDate();
        const month = b.toLocaleString('en-US', { month: 'long' });
        const year  = b.getFullYear();
        birthdateLabel = `${month} ${day}, ${year} · ${age} y.o`;
      }
      const sexLabel = { male: 'Male', female: 'Female', other: 'Other' }[profileUser.sex] || null;
    %>
    <% if (birthdateLabel || sexLabel || profileUser.location || profileUser.url) { %>
    <div class="mt-3 flex flex-col gap-2">
      <% if (birthdateLabel || sexLabel || profileUser.location) { %>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <% if (birthdateLabel) { %>
        <span class="flex items-center gap-1.5 text-sm text-white/40">
          <iconify-icon icon="boxicons:birthday-cake" width="14"></iconify-icon>
          <%= birthdateLabel %>
        </span>
        <% } %>
        <% if (sexLabel) { %>
        <span class="flex items-center gap-1.5 text-sm text-white/40">
          <iconify-icon icon="boxicons:user" width="14"></iconify-icon>
          <%= sexLabel %>
        </span>
        <% } %>
        <% if (profileUser.location) { %>
        <span class="flex items-center gap-1.5 text-sm text-white/40">
          <iconify-icon icon="boxicons:location-alt" width="14"></iconify-icon>
          <%= profileUser.location %>
        </span>
        <% } %>
      </div>
      <% } %>
      <% if (profileUser.url) { %>
      <%
        const href = /^https?:\/\//i.test(profileUser.url) ? profileUser.url : 'https://' + profileUser.url;
        const display = profileUser.url.replace(/^https?:\/\//i, '').replace(/\/$/, '');
      %>
      <a href="<%= href %>" target="_blank" rel="noopener noreferrer"
         class="flex items-center gap-1.5 text-sm text-charm-400 hover:text-charm-300 transition-colors w-fit">
        <iconify-icon icon="boxicons:link" width="14"></iconify-icon>
        <%= display %>
      </a>
      <% } %>
    </div>
    <% } %>

  </div>

  <!-- Stats row -->
  <%
    function formatStat(n) {
      if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 10000)   return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
      return n.toLocaleString();
    }
  %>
  <div class="px-5 pt-2 pb-4 border-b border-white/10 flex flex-wrap gap-x-7 gap-y-3">

    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(entries.length) %></span>
      <span class="text-xs text-white/40 mt-0.5">Entries</span>
    </div>

    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(followerCount) %></span>
      <span class="text-xs text-white/40 mt-0.5">Followers</span>
    </div>

    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(followingCount) %></span>
      <span class="text-xs text-white/40 mt-0.5">Following</span>
    </div>

    <% if (overallRank) { %>
    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= overallRank %><span class="text-sm text-white/30 font-normal"> /10</span></span>
      <span class="text-xs text-white/40 mt-0.5">Avg Rating</span>
    </div>
    <% } %>

    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(nominationsAccepted) %></span>
      <span class="text-xs text-white/40 mt-0.5">Nominations</span>
    </div>

    <% if (firstPrizes > 0) { %>
    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(firstPrizes) %></span>
      <span class="text-xs text-white/40 mt-0.5">1st Place</span>
    </div>
    <% } %>

    <% if (secondPrizes > 0) { %>
    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(secondPrizes) %></span>
      <span class="text-xs text-white/40 mt-0.5">2nd Place</span>
    </div>
    <% } %>

    <% if (thirdPrizes > 0) { %>
    <div class="flex flex-col items-center">
      <span class="text-xl font-bold leading-tight"><%= formatStat(thirdPrizes) %></span>
      <span class="text-xs text-white/40 mt-0.5">3rd Place</span>
    </div>
    <% } %>

  </div>

  <%
    function formatRelativeDate(d) {
      const ms = Date.now() - new Date(d).getTime();
      const s = Math.floor(ms / 1000);
      if (s < 60) return 'just now';
      const m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
      const h = Math.floor(m / 60); if (h < 24) return h + 'h ago';
      const dy = Math.floor(h / 24); if (dy < 7) return dy + 'd ago';
      return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }
  %>

  <!-- Tab bar -->
  <div class="border-b border-white/10 flex sticky top-0 bg-shark-950 z-20 mb-4">
    <button data-tab="entries" class="tab-btn flex-1 py-3 px-2 text-sm font-semibold border-b-2 transition-colors text-white border-charm-500">
      Entries
    </button>
    <button data-tab="h2h" class="tab-btn flex-1 py-3 px-2 text-sm font-semibold border-b-2 transition-colors text-white/45 border-transparent">
      Head to Head
    </button>
    <button data-tab="tournaments" class="tab-btn flex-1 py-3 px-2 text-sm font-semibold border-b-2 transition-colors text-white/45 border-transparent">
      Tournaments
    </button>
  </div>

  <!-- Entries panel -->
  <div id="tab-entries" class="tab-panel">
    <% if (!entries || !entries.length) { %>
    <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
      <iconify-icon icon="boxicons:image" width="36" class="text-white/15 mb-3"></iconify-icon>
      <p class="text-white/40 text-sm">No entries yet</p>
    </div>
    <% } else { %>
    <div id="entries-grid" class="grid grid-cols-1 gap-3 px-3 pb-3">
      <% entries.slice(0, 12).forEach(function(entry) { %>
      <%- include('partials/entryCard', { entry: entry, owner: profileUser, currentUserId: currentUser ? currentUser._id.toString() : null, isFollowing: isFollowing }) %>
      <% }); %>
    </div>
    <div id="entries-sentinel"></div>
    <div id="entries-spinner" class="justify-center py-6" style="display:none">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" class="text-charm-400">
        <path d="M0 0h24v24H0z" fill="none" />
        <path fill="currentColor" d="M12,1A11,11,0,1,0,23,12,11,11,0,0,0,12,1Zm0,19a8,8,0,1,1,8-8A8,8,0,0,1,12,20Z" opacity=".25" />
        <path fill="currentColor" d="M12,4a8,8,0,0,1,7.89,6.7A1.53,1.53,0,0,0,21.38,12h0a1.5,1.5,0,0,0,1.48-1.75,11,11,0,0,0-21.72,0A1.5,1.5,0,0,0,2.62,12h0a1.53,1.53,0,0,0,1.49-1.3A8,8,0,0,1,12,4Z">
          <animateTransform attributeName="transform" dur="0.75s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12" />
        </path>
      </svg>
    </div>
    <% } %>
  </div>

  <!-- Head to Head panel -->
  <div id="tab-h2h" class="tab-panel hidden">
    <% if (!userContests || !userContests.length) { %>
    <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
      <iconify-icon icon="boxicons:git-compare" width="36" class="text-white/15 mb-3"></iconify-icon>
      <p class="text-white/40 text-sm">No head to head contests yet</p>
    </div>
    <% } else { %>
    <% userContests.forEach(function(contest) { %>
    <%
      const myEntry  = contest.entries.find(function(e) { return e.userId && e.userId.toString() === profileUser._id.toString(); });
      const oppEntry = contest.entries.find(function(e) { return !e.userId || e.userId.toString() !== profileUser._id.toString(); });
      const statusLabel = { pending: 'Pending', active: 'Active', void: 'Void', closed: 'Closed' }[contest.status] || contest.status;
      const statusClass = {
        pending: 'bg-amber-500/15 text-amber-400',
        active:  'bg-green-500/15 text-green-400',
        void:    'bg-white/10 text-white/40',
        closed:  'bg-white/10 text-white/50',
      }[contest.status] || 'bg-white/10 text-white/40';
      const myEntryId  = myEntry  && myEntry.entryId  ? myEntry.entryId._id.toString()  : null;
      const oppEntryId = oppEntry && oppEntry.entryId ? oppEntry.entryId._id.toString() : null;
      const winnerId   = contest.winnerEntryId ? contest.winnerEntryId.toString() : null;
      const iWon  = !!(winnerId && myEntryId  && winnerId === myEntryId);
      const iLost = !!(winnerId && oppEntryId && winnerId === oppEntryId);
    %>
    <div class="border-b border-white/10 last:border-0">
      <div class="flex h-36">
        <!-- My entry -->
        <div class="flex-1 relative overflow-hidden bg-shark-900">
          <% if (myEntry && myEntry.entryId && myEntry.entryId.mediaUrl) { %>
          <img src="<%= myEntry.entryId.mediaUrl %>" alt="" class="w-full h-full object-cover">
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-white/15">
            <iconify-icon icon="bx:image" width="28"></iconify-icon>
          </div>
          <% } %>
          <% if (iWon) { %>
          <div class="absolute inset-0 ring-2 ring-inset ring-charm-500 pointer-events-none"></div>
          <div class="absolute top-1.5 left-1.5 bg-charm-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-md">W</div>
          <% } else if (iLost) { %>
          <div class="absolute inset-0 bg-shark-950/40 pointer-events-none"></div>
          <% } %>
        </div>
        <!-- VS divider -->
        <div class="w-9 flex items-center justify-center bg-shark-950 shrink-0">
          <span class="text-[10px] font-bold text-white/25 tracking-widest">VS</span>
        </div>
        <!-- Opponent's entry -->
        <div class="flex-1 relative overflow-hidden bg-shark-900">
          <% if (oppEntry && oppEntry.entryId && oppEntry.entryId.mediaUrl) { %>
          <img src="<%= oppEntry.entryId.mediaUrl %>" alt="" class="w-full h-full object-cover">
          <% } else if (contest.status === 'pending') { %>
          <div class="w-full h-full flex flex-col items-center justify-center text-white/15 gap-1.5">
            <iconify-icon icon="bx:user-plus" width="24"></iconify-icon>
            <span class="text-xs text-white/20">Awaiting</span>
          </div>
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-white/15">
            <iconify-icon icon="bx:image" width="28"></iconify-icon>
          </div>
          <% } %>
          <% if (iLost) { %>
          <div class="absolute inset-0 ring-2 ring-inset ring-charm-500 pointer-events-none"></div>
          <div class="absolute top-1.5 right-1.5 bg-charm-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-md">W</div>
          <% } else if (iWon) { %>
          <div class="absolute inset-0 bg-shark-950/40 pointer-events-none"></div>
          <% } %>
        </div>
      </div>
      <!-- Meta row -->
      <div class="px-4 py-2.5 flex items-center justify-between">
        <span class="text-xs font-semibold px-2 py-0.5 rounded-md <%= statusClass %>"><%= statusLabel %></span>
        <span class="text-xs text-white/30"><%= formatRelativeDate(contest.createdAt) %></span>
      </div>
    </div>
    <% }); %>
    <% } %>
  </div>

  <!-- Tournaments panel -->
  <div id="tab-tournaments" class="tab-panel hidden">
    <% if (!userTournamentEntries || !userTournamentEntries.length) { %>
    <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
      <iconify-icon icon="boxicons:trophy" width="36" class="text-white/15 mb-3"></iconify-icon>
      <p class="text-white/40 text-sm">No tournaments yet</p>
    </div>
    <% } else { %>
    <% userTournamentEntries.forEach(function(te) { %>
    <%
      const tourn = te.tournamentId;
      const tEntryId = te.entryId ? te.entryId._id.toString() : null;
      let prizePlace = null;
      if (tourn && tourn.status === 'closed' && tEntryId) {
        if (tourn.prizes.first.entryId && tourn.prizes.first.entryId.toString() === tEntryId) prizePlace = 1;
        else if (tourn.prizes.second.entryId && tourn.prizes.second.entryId.toString() === tEntryId) prizePlace = 2;
        else if (tourn.prizes.third.entryId && tourn.prizes.third.entryId.toString() === tEntryId) prizePlace = 3;
      }
      const tStatus = tourn ? tourn.status : '';
      const tStatusLabel = { open: 'Open', cooldown: 'Cooldown', active: 'Active', closed: 'Closed', canceled: 'Canceled', pending_funds: 'Pending', pending_review: 'Pending' }[tStatus] || tStatus;
      const tStatusClass = {
        open:           'bg-green-500/15 text-green-400',
        cooldown:       'bg-amber-500/15 text-amber-400',
        active:         'bg-blue-500/15 text-blue-400',
        closed:         'bg-white/10 text-white/50',
        canceled:       'bg-red-500/15 text-red-400',
        pending_funds:  'bg-white/10 text-white/40',
        pending_review: 'bg-white/10 text-white/40',
      }[tStatus] || 'bg-white/10 text-white/40';
      const approvalLabel = { pending: 'Pending Review', approved: 'Approved', rejected: 'Rejected', timed_out: 'Timed Out' }[te.approvalStatus] || te.approvalStatus;
      const approvalClass = {
        pending:   'text-amber-400/70',
        approved:  'text-green-400/70',
        rejected:  'text-red-400/70',
        timed_out: 'text-white/40',
      }[te.approvalStatus] || 'text-white/40';
    %>
    <div class="flex items-center gap-3 px-4 py-3 border-b border-white/10 last:border-0">
      <!-- Entry thumbnail -->
      <div class="w-14 h-14 rounded-md overflow-hidden bg-shark-900 shrink-0">
        <% if (te.entryId && te.entryId.mediaUrl) { %>
        <img src="<%= te.entryId.mediaUrl %>" alt="" class="w-full h-full object-cover">
        <% } else { %>
        <div class="w-full h-full flex items-center justify-center text-white/15">
          <iconify-icon icon="bx:image" width="20"></iconify-icon>
        </div>
        <% } %>
      </div>
      <!-- Info -->
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-white truncate"><%= tourn ? tourn.name : 'Unknown Tournament' %></p>
        <% if (tourn) { %>
        <p class="text-xs text-white/40 mt-0.5"><%= tourn.type === 'platform' ? 'Platform' : 'User Organized' %></p>
        <% } %>
        <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
          <% if (tourn) { %>
          <span class="text-xs font-semibold px-1.5 py-0.5 rounded-md <%= tStatusClass %>"><%= tStatusLabel %></span>
          <% } %>
          <span class="text-xs <%= approvalClass %>"><%= approvalLabel %></span>
        </div>
      </div>
      <!-- Prize indicator -->
      <% if (prizePlace) { %>
      <div class="shrink-0 text-right">
        <% if (prizePlace === 1) { %>
        <span class="text-xs font-bold text-amber-400">1st Place</span>
        <p class="text-xs text-white/40 mt-0.5">$1,000</p>
        <% } else if (prizePlace === 2) { %>
        <span class="text-xs font-bold text-white/60">2nd Place</span>
        <p class="text-xs text-white/40 mt-0.5">$400</p>
        <% } else { %>
        <span class="text-xs font-bold text-amber-600/80">3rd Place</span>
        <p class="text-xs text-white/40 mt-0.5">$100</p>
        <% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% } %>
  </div>

  <% if (isOwn) { %>
  <%
    const birthdateInputValue = profileUser.birthdate
      ? new Date(profileUser.birthdate).toISOString().split('T')[0]
      : '';
  %>
  <div id="profile-edit-modal" class="fixed inset-0 z-50 hidden items-start justify-center p-4 sm:p-8">
    <div data-close-modal class="absolute inset-0 bg-black/70 backdrop-blur-[2px]"></div>

    <form action="/settings/profile" method="POST" enctype="multipart/form-data"
      class="relative z-10 w-full max-w-2xl max-h-[92vh] overflow-y-auto rounded-md bg-shark-950 border border-white/10 shadow-2xl">
      <input type="hidden" name="returnTo" value="/<%= profileUser.username %>">
      <input type="hidden" name="bannerRemove" id="profile-edit-banner-remove" value="0">
      <input type="hidden" name="avatarRemove" id="profile-edit-avatar-remove" value="0">

      <div class="sticky top-0 z-10 flex items-center justify-between bg-shark-950/95 backdrop-blur-sm border-b border-white/10 px-4 py-3">
        <button type="button" id="profile-edit-close" class="inline-flex w-8 h-8 items-center justify-center rounded-md text-white/75 hover:bg-white/10 hover:text-white transition-colors cursor-pointer">
          <iconify-icon icon="bx:x" width="22"></iconify-icon>
        </button>
        <h2 class="text-xl font-bold">Edit profile</h2>
        <button type="submit" class="inline-flex items-center justify-center rounded-md bg-charm-600 hover:bg-charm-500 px-4 py-1.5 text-sm font-bold text-white transition-colors cursor-pointer">
          Save
        </button>
      </div>

      <div class="p-4 sm:p-5">
        <div class="relative rounded-md overflow-hidden bg-shark-900 border border-white/10">
          <div class="h-44 sm:h-52">
            <img id="profile-edit-banner-preview" src="<%= profileUser.banner || '' %>" alt="Banner preview"
              class="w-full h-full object-cover <%= profileUser.banner ? '' : 'hidden' %>" />
            <div id="profile-edit-banner-empty"
              class="w-full h-full flex items-center justify-center text-white/25 <%= profileUser.banner ? 'hidden' : '' %>">
              <iconify-icon icon="bx:image-add" width="30"></iconify-icon>
            </div>
          </div>
          <div class="absolute inset-x-0 top-3 flex items-center justify-center gap-2">
            <label class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-black/55 text-white border border-white/25 hover:bg-black/70 transition-colors cursor-pointer">
              <iconify-icon icon="boxicons:image-plus" width="18"></iconify-icon>
              <input type="file" name="banner" id="profile-edit-banner-input" accept="image/*" class="hidden">
            </label>
            <button type="button" id="profile-edit-banner-clear"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-black/55 text-white border border-white/25 hover:bg-black/70 transition-colors cursor-pointer">
              <iconify-icon icon="boxicons:trash-filled" width="16"></iconify-icon>
            </button>
          </div>
        </div>

        <div class="flex flex-col items-center -mt-16 mb-5 relative z-10">
          <div class="w-32 h-32 rounded-full border-4 border-shark-950 overflow-hidden bg-charm-900 flex items-center justify-center">
            <img id="profile-edit-avatar-preview" src="<%= profileUser.avatar || '' %>" alt="Avatar preview"
              class="w-full h-full object-cover <%= profileUser.avatar ? '' : 'hidden' %>">
            <div id="profile-edit-avatar-empty" class="<%= profileUser.avatar ? 'hidden' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" class="text-charm-400">
                <path d="M0 0h24v24H0z" fill="none" />
                <path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1" />
              </svg>
            </div>
            <input type="file" name="avatar" id="profile-edit-avatar-input" accept="image/*" class="hidden">
          </div>
          <div class="flex items-center gap-3 mt-3">
            <label for="profile-edit-avatar-input" class="text-sm font-semibold text-white/60 hover:text-white cursor-pointer transition-colors">Change Picture</label>
            <span class="text-white/20 text-sm select-none">·</span>
            <button type="button" id="profile-edit-avatar-clear"
              class="text-sm font-semibold text-red-400/70 hover:text-red-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed disabled:hover:text-red-400/70"
              <%= profileUser.avatar ? '' : 'disabled' %>>Delete Picture</button>
          </div>
        </div>

        <div class="space-y-4">
          <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
            <label for="profile-edit-display-name" class="block text-xs text-white/50">Name</label>
            <input id="profile-edit-display-name" name="displayName" type="text" maxlength="50"
              value="<%= profileUser.displayName || '' %>"
              class="mt-1 w-full bg-transparent text-base leading-tight text-white placeholder:text-white/25 focus:outline-none"
              placeholder="Your name">
          </div>

          <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
            <div class="flex items-center justify-between">
              <label for="profile-edit-bio" class="block text-xs text-white/50">Bio</label>
              <span id="profile-edit-bio-counter" class="text-xs text-white/35"><%= profileUser.bio ? profileUser.bio.length : 0 %> / 220</span>
            </div>
            <textarea id="profile-edit-bio" name="bio" rows="4" maxlength="220"
              class="mt-1 w-full resize-none bg-transparent text-base leading-relaxed text-white placeholder:text-white/25 focus:outline-none"
              placeholder="Tell people about yourself"><%= profileUser.bio || '' %></textarea>
          </div>

          <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
            <label for="profile-edit-location" class="block text-xs text-white/50">Location</label>
            <input id="profile-edit-location" name="location" type="text" maxlength="120"
              value="<%= profileUser.location || '' %>"
              class="mt-1 w-full bg-transparent text-base leading-tight text-white placeholder:text-white/25 focus:outline-none"
              placeholder="City, State">
          </div>

          <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
            <label for="profile-edit-url" class="block text-xs text-white/50">Website</label>
            <input id="profile-edit-url" name="url" type="text" maxlength="200"
              value="<%= profileUser.url || '' %>"
              class="mt-1 w-full bg-transparent text-base leading-tight text-white placeholder:text-white/25 focus:outline-none"
              placeholder="example.com">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
              <label for="profile-edit-username" class="block text-xs text-white/50">Username</label>
              <div class="mt-1 flex items-center">
                <span class="text-white/40 text-base">@</span>
                <input id="profile-edit-username" name="username" type="text" maxlength="15"
                  value="<%= profileUser.username || '' %>"
                  class="ml-1 w-full bg-transparent text-base leading-tight text-white placeholder:text-white/25 focus:outline-none"
                  placeholder="username">
              </div>
            </div>

            <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5">
              <label for="profile-edit-sex" class="block text-xs text-white/50">Sex</label>
              <select id="profile-edit-sex" name="sex"
                class="mt-1 w-full bg-transparent text-base leading-tight text-white focus:outline-none">
                <option value="" <%= !profileUser.sex ? 'selected' : '' %>>Not set</option>
                <option value="male" <%= profileUser.sex === 'male' ? 'selected' : '' %>>Male</option>
                <option value="female" <%= profileUser.sex === 'female' ? 'selected' : '' %>>Female</option>
                <option value="other" <%= profileUser.sex === 'other' ? 'selected' : '' %>>Other</option>
                <option value="prefer-not-to-say" <%= profileUser.sex === 'prefer-not-to-say' ? 'selected' : '' %>>Prefer not to say</option>
              </select>
            </div>

            <div class="rounded-md border border-white/10 bg-shark-900 px-3 py-2.5 sm:col-span-2">
              <label for="profile-edit-birthdate" class="block text-xs text-white/50">Birthdate</label>
              <input id="profile-edit-birthdate" name="birthdate" type="date"
                value="<%= birthdateInputValue %>"
                class="mt-1 w-full bg-transparent text-base leading-tight text-white focus:outline-none">
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <% } %>

</div>

<script>
(function () {
  var bioText   = document.getElementById('profile-bio-text');
  var bioToggle = document.getElementById('profile-bio-toggle');
  if (!bioText || !bioToggle) return;

  if (bioText.scrollHeight > bioText.clientHeight) {
    bioToggle.classList.remove('hidden');
  }

  var expanded = false;
  bioToggle.addEventListener('click', function () {
    expanded = !expanded;
    bioText.classList.toggle('line-clamp-2', !expanded);
    bioToggle.textContent = expanded ? 'Show less' : 'Read more';
  });
}());
</script>

<% if (isOwn) { %>
<script>
(function () {
  var openBtn = document.getElementById('profile-edit-open');
  var closeBtn = document.getElementById('profile-edit-close');
  var modal = document.getElementById('profile-edit-modal');
  if (!openBtn || !closeBtn || !modal) return;

  var body = document.body;
  var bannerInput = document.getElementById('profile-edit-banner-input');
  var avatarInput = document.getElementById('profile-edit-avatar-input');
  var bannerPreview = document.getElementById('profile-edit-banner-preview');
  var avatarPreview = document.getElementById('profile-edit-avatar-preview');
  var bannerEmpty = document.getElementById('profile-edit-banner-empty');
  var avatarEmpty = document.getElementById('profile-edit-avatar-empty');
  var bannerClearBtn = document.getElementById('profile-edit-banner-clear');
  var avatarClearBtn = document.getElementById('profile-edit-avatar-clear');
  var bioInput = document.getElementById('profile-edit-bio');
  var bioCounter = document.getElementById('profile-edit-bio-counter');
  var bannerRemoveInput = document.getElementById('profile-edit-banner-remove');
  var avatarRemoveInput = document.getElementById('profile-edit-avatar-remove');

  function openModal() {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    body.classList.add('overflow-hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    body.classList.remove('overflow-hidden');
  }

  function previewFile(input, preview, emptyState) {
    var file = input.files && input.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (event) {
      preview.src = event.target.result;
      preview.classList.remove('hidden');
      emptyState.classList.add('hidden');
    };
    reader.readAsDataURL(file);
  }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (event) {
    if (event.target.hasAttribute('data-close-modal')) closeModal();
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });

  if (bannerInput) {
    bannerInput.addEventListener('change', function () {
      previewFile(bannerInput, bannerPreview, bannerEmpty);
      if (bannerRemoveInput) bannerRemoveInput.value = '0';
    });
  }
  if (avatarInput) {
    avatarInput.addEventListener('change', function () {
      previewFile(avatarInput, avatarPreview, avatarEmpty);
      if (avatarRemoveInput) avatarRemoveInput.value = '0';
      if (avatarClearBtn) avatarClearBtn.disabled = false;
    });
  }
  if (avatarClearBtn) {
    avatarClearBtn.addEventListener('click', function () {
      avatarInput.value = '';
      avatarPreview.src = '';
      avatarPreview.classList.add('hidden');
      avatarEmpty.classList.remove('hidden');
      if (avatarRemoveInput) avatarRemoveInput.value = '1';
      avatarClearBtn.disabled = true;
    });
  }
  if (bannerClearBtn && bannerInput) {
    bannerClearBtn.addEventListener('click', function () {
      bannerInput.value = '';
      bannerPreview.src = '';
      bannerPreview.classList.add('hidden');
      bannerEmpty.classList.remove('hidden');
      if (bannerRemoveInput) bannerRemoveInput.value = '1';
    });
  }
  if (bioInput && bioCounter) {
    bioInput.addEventListener('input', function () {
      bioCounter.textContent = bioInput.value.length + ' / 220';
    });
  }

  var params = new URLSearchParams(window.location.search);
  if (params.get('editError')) {
    openModal();
    if (window.showToast) window.showToast(params.get('editError'), 'error');
    params.delete('editError');
    history.replaceState(null, '', window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash);
  }
}());
</script>
<% } %>

<script>
(function () {
  var tabs   = document.querySelectorAll('.tab-btn');
  var panels = document.querySelectorAll('.tab-panel');
  var validTabs = ['entries', 'h2h', 'tournaments'];

  function activate(tabId) {
    tabs.forEach(function (btn) {
      var active = btn.dataset.tab === tabId;
      btn.classList.toggle('text-white',       active);
      btn.classList.toggle('border-charm-500', active);
      btn.classList.toggle('text-white/45',    !active);
      btn.classList.toggle('border-transparent', !active);
    });
    panels.forEach(function (panel) {
      panel.classList.toggle('hidden', panel.id !== 'tab-' + tabId);
    });
    try { history.replaceState(null, '', window.location.pathname + '#' + tabId); } catch (e) {}
  }

  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () { activate(btn.dataset.tab); });
  });

  var hash = window.location.hash.slice(1);
  activate(validTabs.includes(hash) ? hash : 'entries');
}());
</script>

<script>
(function () {
  var grid     = document.getElementById('entries-grid');
  var sentinel = document.getElementById('entries-sentinel');
  var spinner  = document.getElementById('entries-spinner');
  if (!grid || !sentinel || !spinner) return;

  var page    = 1;
  var loading = false;
  var hasMore = <%= entries && entries.length > 12 ? 'true' : 'false' %>;
  var username = <%- JSON.stringify(profileUser.username) %>;

  if (!hasMore) { sentinel.remove(); return; }

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function buildCard(entry) {
    var mediaSrc = esc(entry.mediaUrl);
    var mediaHtml = entry.mediaType === 'video'
      ? '<video src="' + mediaSrc + '" class="w-full h-full object-cover" muted preload="none"></video>' +
        '<div class="absolute inset-0 flex items-center justify-center">' +
          '<iconify-icon icon="bx:play-circle" width="30" class="text-white/80 drop-shadow-md"></iconify-icon>' +
        '</div>'
      : '<img src="' + mediaSrc + '" alt="" class="w-full h-full object-cover">';

    var ratingHtml = '';
    if (entry.ratingCount > 0) {
      ratingHtml = '<div class="absolute bottom-1.5 left-1.5 flex items-center gap-0.5 bg-shark-950/80 rounded-md px-1.5 py-0.5">' +
        '<iconify-icon icon="boxicons:star-filled" width="10" class="text-amber-400"></iconify-icon>' +
        '<span class="text-xs font-semibold text-white ml-0.5">' + esc(entry.ratingAvg.toFixed(1)) + '</span>' +
        '</div>';
    }

    var captionHtml = entry.caption
      ? '<p class="text-sm leading-relaxed text-white/65 line-clamp-2">' + esc(entry.caption) + '</p>'
      : '';

    var tagsHtml = '';
    if (entry.tags && entry.tags.length > 0) {
      tagsHtml = '<div class="flex flex-wrap gap-x-1.5 gap-y-0.5">' +
        entry.tags.map(function (t) { return '<span class="text-xs text-charm-400/80">#' + esc(t) + '</span>'; }).join('') +
        '</div>';
    }

    var card = document.createElement('a');
    card.href = '/entry/' + entry._id;
    card.className = 'bg-shark-900 flex flex-col overflow-hidden';
    card.innerHTML =
      '<div class="relative aspect-video overflow-hidden bg-shark-950">' +
        mediaHtml + ratingHtml +
      '</div>' +
      '<div class="px-2 pt-2 pb-2.5 flex flex-col gap-1">' +
        captionHtml + tagsHtml +
      '</div>';
    return card;
  }

  function loadMore() {
    if (loading || !hasMore) return;
    loading = true;
    spinner.style.display = 'flex';
    page++;

    fetch('/api/profile/' + username + '/entries?page=' + page + '&limit=12')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        data.entries.forEach(function (entry) { grid.appendChild(buildCard(entry)); });
        hasMore = data.hasMore;
        if (!hasMore) sentinel.remove();
      })
      .catch(function () {})
      .finally(function () {
        loading = false;
        spinner.style.display = 'none';
      });
  }

  var observer = new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '300px' });

  observer.observe(sentinel);
}());
</script>

<%- include('partials/appEnd') %>
