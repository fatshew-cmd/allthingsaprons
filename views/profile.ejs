<% if (isOwn) { %>
<script>
(function () {
  var pan        = document.getElementById('profile-edit-banner-pan');
  var img        = document.getElementById('profile-edit-banner-preview');
  var frame      = document.getElementById('profile-edit-banner-frame');
  var posXInput  = document.getElementById('profile-edit-banner-pos-x');
  var posYInput  = document.getElementById('profile-edit-banner-pos-y');
  var zoomInput  = document.getElementById('profile-edit-banner-zoom-val');
  var zoomLabel  = document.getElementById('profile-edit-banner-zoom-label');
  var zoomInBtn  = document.getElementById('profile-edit-banner-zoom-in');
  var zoomOutBtn = document.getElementById('profile-edit-banner-zoom-out');
  if (!pan || !img || !posXInput || !posYInput || !zoomInput) return;

  var MIN_ZOOM = 1, MAX_ZOOM = 8, ZOOM_STEP = 0.25;

  var s = { active: false, startX: 0, startY: 0, snapL: 0, snapT: 0,
            imgL: 0, imgT: 0, rendW: 0, rendH: 0,
            baseW: 0, baseH: 0, zoom: 1,
            gL: 0, gT: 0, gW: 0, gH: 0 };

  var pinch = { active: false, startDist: 0, startZoom: 1 };

  function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }

  function clientXY(e) {
    return e.touches ? { x: e.touches[0].clientX, y: e.touches[0].clientY }
                     : { x: e.clientX, y: e.clientY };
  }

  function touchDist(e) {
    var dx = e.touches[0].clientX - e.touches[1].clientX;
    var dy = e.touches[0].clientY - e.touches[1].clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function ghostGeom() {
    if (frame) {
      var fr = frame.getBoundingClientRect();
      var pr = pan.getBoundingClientRect();
      return { l: fr.left - pr.left, t: fr.top - pr.top, w: fr.width, h: fr.height };
    }
    return { l: 0, t: 32, w: pan.offsetWidth, h: pan.offsetHeight - 64 };
  }

  function setZoomLabel(z) {
    if (zoomLabel) zoomLabel.textContent = (z % 1 === 0 ? z.toFixed(0) : z.toFixed(1)) + '×';
  }

  // Constrain a target (wantL, wantT) within the ghost frame.
  // When the rendered image is smaller than the ghost in a dimension, center it.
  function constrain(rendW, rendH, wantL, wantT) {
    var imgL = rendW >= s.gW
      ? clamp(wantL, s.gL + s.gW - rendW, s.gL)
      : s.gL + (s.gW - rendW) / 2;
    var imgT = rendH >= s.gH
      ? clamp(wantT, s.gT + s.gH - rendH, s.gT)
      : s.gT + (s.gH - rendH) / 2;
    return { l: imgL, t: imgT };
  }

  function applyPosition(rendW, rendH, imgL, imgT) {
    img.style.width  = rendW + 'px';
    img.style.height = rendH + 'px';
    img.style.left   = imgL  + 'px';
    img.style.top    = imgT  + 'px';
    s.rendW = rendW; s.rendH = rendH;
    s.imgL  = imgL;  s.imgT  = imgT;
    posXInput.value = ((s.gL + s.gW / 2 - imgL) / rendW).toFixed(5);
    posYInput.value = ((s.gT + s.gH / 2 - imgT) / rendH).toFixed(5);
    zoomInput.value = s.zoom.toFixed(5);
  }

  function applyZoom(newZoom) {
    newZoom = clamp(newZoom, MIN_ZOOM, MAX_ZOOM);
    var cx    = s.gL + s.gW / 2;
    var cy    = s.gT + s.gH / 2;
    var fracX = s.rendW > 0 ? (cx - s.imgL) / s.rendW : 0.5;
    var fracY = s.rendH > 0 ? (cy - s.imgT) / s.rendH : 0.5;
    var newW  = s.baseW * newZoom;
    var newH  = s.baseH * newZoom;
    var pos   = constrain(newW, newH, cx - fracX * newW, cy - fracY * newH);
    s.zoom = newZoom;
    setZoomLabel(newZoom);
    applyPosition(newW, newH, pos.l, pos.t);
  }

  function initImage() {
    if (img.classList.contains('hidden') || !img.naturalWidth) return;
    var g  = ghostGeom();
    // getBoundingClientRect returns zeros when the modal is display:none — bail out
    // without touching the inputs so the DB-loaded values are not overwritten.
    if (g.h <= 0) return;
    var nW = img.naturalWidth;
    var nH = img.naturalHeight;
    // Always base on ghost HEIGHT so baseH is the same as the profile container height.
    // This makes posX/posY/zoom portable regardless of modal vs profile page width.
    var baseH = g.h;
    var baseW = nW * g.h / nH;
    s.baseW = baseW; s.baseH = baseH;
    s.gL = g.l; s.gT = g.t; s.gW = g.w; s.gH = g.h;

    // Use isNaN so a saved value of exactly 0 is not replaced by the fallback
    // (parseFloat('0') || fallback incorrectly returns fallback).
    function pf(v, fb) { var n = parseFloat(v); return isNaN(n) ? fb : n; }
    var zoom = clamp(pf(zoomInput.value, 1),   MIN_ZOOM, MAX_ZOOM);
    var posX =       pf(posXInput.value, 0.5);
    var posY =       pf(posYInput.value, 0.5);
    s.zoom = zoom;
    setZoomLabel(zoom);

    var rendW = baseW * zoom;
    var rendH = baseH * zoom;
    var pos   = constrain(rendW, rendH, g.l + g.w / 2 - posX * rendW, g.t + g.h / 2 - posY * rendH);
    applyPosition(rendW, rendH, pos.l, pos.t);
    pan.style.cursor = 'grab';
  }

  img.addEventListener('load', initImage);
  pan._initBanner = initImage;

  // ── Drag ──────────────────────────────────────────────────────────

  pan.addEventListener('mousedown', onDragStart);
  pan.addEventListener('touchstart', function (e) {
    if (e.target.closest('button')) return;
    if (e.touches.length === 2) {
      e.preventDefault();
      s.active        = false;
      pinch.active    = true;
      pinch.startDist = touchDist(e);
      pinch.startZoom = s.zoom;
    } else if (e.touches.length === 1) {
      onDragStart(e);
    }
  }, { passive: false });

  function onDragStart(e) {
    if (img.classList.contains('hidden') || !img.naturalWidth) return;
    if (e.target.closest('button')) return;
    e.preventDefault();
    var p    = clientXY(e);
    s.active = true;
    s.startX = p.x; s.startY = p.y;
    s.snapL  = s.imgL; s.snapT = s.imgT;
    pan.style.cursor = 'grabbing';
  }

  document.addEventListener('mousemove', onMove);
  document.addEventListener('touchmove', function (e) {
    if (pinch.active && e.touches.length === 2) {
      e.preventDefault();
      applyZoom(pinch.startZoom * touchDist(e) / pinch.startDist);
    } else if (s.active) {
      e.preventDefault();
      onMove(e);
    }
  }, { passive: false });

  function onMove(e) {
    if (!s.active) return;
    var p   = clientXY(e);
    var pos = constrain(s.rendW, s.rendH, s.snapL + p.x - s.startX, s.snapT + p.y - s.startY);
    applyPosition(s.rendW, s.rendH, pos.l, pos.t);
  }

  document.addEventListener('mouseup', onStop);
  document.addEventListener('touchend', function (e) {
    if (e.touches.length < 2) pinch.active = false;
    if (e.touches.length === 0) onStop();
  });

  function onStop() {
    s.active = false;
    if (!img.classList.contains('hidden') && img.naturalWidth) pan.style.cursor = 'grab';
  }

  // ── Scroll-wheel zoom ─────────────────────────────────────────────

  pan.addEventListener('wheel', function (e) {
    if (img.classList.contains('hidden') || !img.naturalWidth) return;
    e.preventDefault();
    applyZoom(s.zoom + (e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP));
  }, { passive: false });

  // ── Zoom buttons ──────────────────────────────────────────────────

  if (zoomInBtn)  zoomInBtn.addEventListener('click',  function () { applyZoom(s.zoom + ZOOM_STEP); });
  if (zoomOutBtn) zoomOutBtn.addEventListener('click', function () { applyZoom(s.zoom - ZOOM_STEP); });
}());
</script>
<% } %>

<script>
(function () {
  var tabs   = document.querySelectorAll('.tab-btn');
  var panels = document.querySelectorAll('.tab-panel');
  var validTabs = ['entries', 'h2h', 'tournaments', 'bookmarks'];

  function activate(tabId) {
    tabs.forEach(function (btn) {
      var active = btn.dataset.tab === tabId;
      btn.classList.toggle('text-white',       active);
      btn.classList.toggle('border-charm-500', active);
      btn.classList.toggle('text-white/45',    !active);
      btn.classList.toggle('border-transparent', !active);
    });
    panels.forEach(function (panel) {
      panel.classList.toggle('hidden', panel.id !== 'tab-' + tabId);
    });
    try { history.replaceState(null, '', window.location.pathname + '#' + tabId); } catch (e) {}
  }

  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () { activate(btn.dataset.tab); });
  });

  var hash = window.location.hash.slice(1);
  activate(validTabs.includes(hash) ? hash : 'entries');
}());
</script>

<script>
(function () {
  var grid     = document.getElementById('entries-grid');
  var sentinel = document.getElementById('entries-sentinel');
  var spinner  = document.getElementById('entries-spinner');
  if (!grid || !sentinel || !spinner) return;

  var page    = 1;
  var loading = false;
  var hasMore = <%= entries && entries.length > 12 ? 'true' : 'false' %>;
  var username = <%- JSON.stringify(profileUser.username?.value) %>;

  if (!hasMore) { sentinel.remove(); return; }

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function buildCard(entry) {
    var mediaSrc = esc(entry.mediaUrl);
    var mediaHtml = entry.mediaType === 'video'
      ? '<video src="' + mediaSrc + '" class="w-full h-full object-cover" muted preload="none"></video>' +
        '<div class="absolute inset-0 flex items-center justify-center">' +
          '<iconify-icon icon="boxicons:play-circle" width="30" class="text-white/80 drop-shadow-md"></iconify-icon>' +
        '</div>'
      : '<img src="' + mediaSrc + '" alt="" class="w-full h-full object-cover">';

    var ratingHtml = '';
    if (entry.ratingCount > 0) {
      ratingHtml = '<div class="absolute bottom-1.5 left-1.5 flex items-center gap-0.5 bg-shark-950/80 rounded-md px-1.5 py-0.5">' +
        '<iconify-icon icon="boxicons:star-filled" width="10" class="text-amber-400"></iconify-icon>' +
        '<span class="text-xs font-semibold text-white ml-0.5">' + esc(entry.ratingAvg.toFixed(1)) + '</span>' +
        '</div>';
    }

    var captionHtml = entry.caption
      ? '<p class="text-sm leading-relaxed text-white/65 line-clamp-2">' + esc(entry.caption) + '</p>'
      : '';

    var tagsHtml = '';
    if (entry.tags && entry.tags.length > 0) {
      tagsHtml = '<div class="flex flex-wrap gap-x-1.5 gap-y-0.5">' +
        entry.tags.map(function (t) { return '<span class="text-xs text-charm-400/80">#' + esc(t) + '</span>'; }).join('') +
        '</div>';
    }

    var card = document.createElement('a');
    card.href = '/entry/' + entry._id;
    card.className = 'bg-shark-900 flex flex-col overflow-hidden';
    card.innerHTML =
      '<div class="relative aspect-video overflow-hidden bg-shark-950">' +
        mediaHtml + ratingHtml +
      '</div>' +
      '<div class="px-2 pt-2 pb-2.5 flex flex-col gap-1">' +
        captionHtml + tagsHtml +
      '</div>';
    return card;
  }

  function loadMore() {
    if (loading || !hasMore) return;
    loading = true;
    spinner.style.display = 'flex';
    page++;

    fetch('/api/profile/' + username + '/entries?page=' + page + '&limit=12')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        data.entries.forEach(function (entry) { grid.appendChild(buildCard(entry)); });
        hasMore = data.hasMore;
        if (!hasMore) sentinel.remove();
      })
      .catch(function () {})
      .finally(function () {
        loading = false;
        spinner.style.display = 'none';
      });
  }

  var observer = new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '300px' });

  observer.observe(sentinel);
}());
</script>

<script>
(function () {
  var img = document.getElementById('profile-banner-img');
  if (!img) return;

  function positionBanner() {
    if (!img.naturalWidth) return;
    var container = img.parentElement;
    var cW   = container.offsetWidth;
    var cH   = container.offsetHeight;
    var nW   = img.naturalWidth;
    var nH   = img.naturalHeight;
    var posX = parseFloat(img.dataset.posX) || 0.5;
    var posY = parseFloat(img.dataset.posY) || 0.5;
    var zoom = Math.max(1, parseFloat(img.dataset.zoom) || 1);

    // Scale = fit-by-height × zoom, but never smaller than cover.
    // Cover prevents empty bars when the image is too narrow (e.g. portrait images on wide banners).
    // When the user's zoom is large enough to fill the width, that zoom takes over.
    var coverScale = Math.max(cW / nW, cH / nH);
    var scale      = Math.max(coverScale, zoom * cH / nH);

    var rendW = nW * scale;
    var rendH = nH * scale;
    var left  = Math.min(0, Math.max(cW - rendW, cW / 2 - posX * rendW));
    var top   = Math.min(0, Math.max(cH - rendH, cH / 2 - posY * rendH));
    img.style.width   = rendW + 'px';
    img.style.height  = rendH + 'px';
    img.style.left    = left + 'px';
    img.style.top     = top  + 'px';
    img.style.opacity = '1';
  }

  if (img.complete && img.naturalWidth) { positionBanner(); }
  else { img.addEventListener('load', positionBanner); }
}());
</script>

<% if (!isOwn) { %>
<script>
(function () {
  var btn             = document.getElementById('follow-btn');
  var similarSection  = document.getElementById('similar-section');
  var similarList     = document.getElementById('similar-list');
  var dismissBtn      = document.getElementById('similar-dismiss');
  if (!btn) return;

  function formatStat(n) {
    if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (n >= 10000)   return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    return n.toLocaleString();
  }

  // ── Mini follow card ─────────────────────────────────────────────

  function buildCard(account) {
    var card = document.createElement('div');
    card.className = 'flex flex-col items-center gap-2 w-20 shrink-0';

    var avatarHtml = account.avatar
      ? '<img src="' + account.avatar + '" alt="" class="w-14 h-14 rounded-full object-cover">'
      : '<div class="w-14 h-14 rounded-full bg-charm-950 flex items-center justify-center"><iconify-icon icon="boxicons:user-filled" width="22" style="color:#e680a6"></iconify-icon></div>';

    var nameHtml = (account.displayName || ('@' + account.username));
    var btnCls   = account.isFollowing
      ? 'w-full text-xs px-2 py-1 rounded-md border border-white/30 text-white/70 hover:bg-white/8 transition-colors cursor-pointer'
      : 'w-full text-xs px-2 py-1 rounded-md bg-charm-500 text-white hover:bg-charm-600 transition-colors cursor-pointer';
    var btnText  = account.isFollowing ? 'Following' : 'Follow';

    card.innerHTML =
      '<a href="/' + account.username + '" class="no-underline">' + avatarHtml + '</a>' +
      '<p class="text-xs font-semibold text-white text-center truncate w-full m-0 leading-tight">' + nameHtml + '</p>' +
      '<button type="button" class="' + btnCls + '" data-username="' + account.username + '" data-following="' + (account.isFollowing ? 'true' : 'false') + '">' + btnText + '</button>';

    var miniBtn = card.querySelector('button');
    miniBtn.addEventListener('click', function () {
      var isFollowing = miniBtn.dataset.following === 'true';
      var endpoint    = isFollowing ? '/unfollow/' + account.username : '/follow/' + account.username;
      miniBtn.disabled = true;
      fetch(endpoint, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nowFollowing = data.following;
          miniBtn.dataset.following = nowFollowing ? 'true' : 'false';
          miniBtn.textContent = nowFollowing ? 'Following' : 'Follow';
          miniBtn.className = nowFollowing
            ? 'w-full text-xs px-2 py-1 rounded-md border border-white/30 text-white/70 hover:bg-white/8 transition-colors cursor-pointer'
            : 'w-full text-xs px-2 py-1 rounded-md bg-charm-500 text-white hover:bg-charm-600 transition-colors cursor-pointer';
        })
        .finally(function () { miniBtn.disabled = false; });
    });

    return card;
  }

  function loadSimilar(username) {
    fetch('/api/similar-accounts/' + username)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.accounts || !data.accounts.length) return;
        similarList.innerHTML = '';
        data.accounts.forEach(function (a) { similarList.appendChild(buildCard(a)); });
        similarSection.classList.remove('hidden');
      });
  }

  // ── Dismiss ──────────────────────────────────────────────────────

  if (dismissBtn) {
    dismissBtn.addEventListener('click', function () {
      similarSection.classList.add('hidden');
    });
  }

  // ── Main follow toggle ────────────────────────────────────────────

  btn.addEventListener('click', function () {
    var following = btn.dataset.following === 'true';
    var username  = btn.dataset.username;
    var endpoint  = following ? '/unfollow/' + username : '/follow/' + username;

    btn.disabled = true;

    fetch(endpoint, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var nowFollowing = data.following;
        btn.dataset.following = nowFollowing ? 'true' : 'false';

        var label = btn.querySelector('#follow-btn-label');
        var icon  = btn.querySelector('iconify-icon');

        if (nowFollowing) {
          btn.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer border border-white/35 text-white hover:bg-white/8';
          if (icon) icon.setAttribute('icon', 'boxicons:user-check');
          if (label) label.textContent = 'Following';
          loadSimilar(username);
        } else {
          btn.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-semibold transition-colors cursor-pointer bg-charm-500 text-white hover:bg-charm-600';
          if (icon) icon.setAttribute('icon', 'boxicons:user-plus');
          if (label) label.textContent = 'Follow';
          similarSection.classList.add('hidden');
        }

        var countEl = document.getElementById('follower-count');
        if (countEl && typeof data.followerCount === 'number') {
          countEl.textContent = formatStat(data.followerCount);
        }
      })
      .catch(function () {
        if (window.showToast) window.showToast('Something went wrong. Try again.', 'error');
      })
      .finally(function () {
        btn.disabled = false;
      });
  });

}());
</script>
<% } %>
<script>
window.h2hFollowToggle = function (btn) {
  var following = btn.dataset.following === 'true';
  var username  = btn.dataset.username;
  var endpoint  = following ? '/unfollow/' + username : '/follow/' + username;
  btn.disabled  = true;
  fetch(endpoint, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var now = data.following;
      // Sync every H2H card button for this username
      document.querySelectorAll('.h2h-follow-btn[data-username="' + username + '"]').forEach(function (b) {
        b.dataset.following = now ? 'true' : 'false';
        var ic = b.querySelector('iconify-icon');
        if (now) {
          b.classList.remove('border-charm-500/50', 'text-charm-400', 'hover:bg-charm-500/10');
          b.classList.add('border-white/20', 'text-white/40', 'hover:bg-white/8');
          if (ic) ic.setAttribute('icon', 'boxicons:user-check');
        } else {
          b.classList.remove('border-white/20', 'text-white/40', 'hover:bg-white/8');
          b.classList.add('border-charm-500/50', 'text-charm-400', 'hover:bg-charm-500/10');
          if (ic) ic.setAttribute('icon', 'boxicons:user-plus');
        }
      });
      // Also sync the main profile follow button if it targets the same user
      var mainBtn = document.getElementById('follow-btn');
      if (mainBtn && mainBtn.dataset.username === username) {
        mainBtn.dataset.following = now ? 'true' : 'false';
        var mainIcon  = mainBtn.querySelector('iconify-icon');
        var mainLabel = mainBtn.querySelector('#follow-btn-label');
        if (now) {
          mainBtn.className = 'inline-flex items-center gap-2 h-9 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer border border-white/35 text-white hover:bg-white/8';
          if (mainIcon)  mainIcon.setAttribute('icon', 'boxicons:user-check');
          if (mainLabel) mainLabel.textContent = 'Following';
        } else {
          mainBtn.className = 'inline-flex items-center gap-2 h-9 px-4 rounded-md text-sm font-semibold transition-colors cursor-pointer bg-charm-500 text-white hover:bg-charm-600';
          if (mainIcon)  mainIcon.setAttribute('icon', 'boxicons:user-plus');
          if (mainLabel) mainLabel.textContent = 'Follow';
        }
      }
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { btn.disabled = false; });
};
</script>

<% if (locals.canNominate) { %>

<!-- Nomination Modal -->
<div id="nominate-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="nominate-modal-backdrop"></div>
  <div class="relative w-full max-w-sm bg-shark-900 border border-white/10 rounded-md shadow-2xl">
    <div class="p-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold">Nominate for Head-to-Head</h2>
        <button type="button" id="nominate-modal-close" class="text-white/30 hover:text-white/70 transition-colors cursor-pointer">
          <iconify-icon icon="boxicons:x" width="20"></iconify-icon>
        </button>
      </div>

      <!-- Nominee 1 block -->
      <div class="mb-5">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wide mb-1.5">Nominee 1</p>
        <div id="nom1-badge" class="flex items-center gap-2.5 px-3 py-2 bg-shark-800 border border-white/10 rounded-md">
          <div id="nom1-avatar-wrap" class="w-7 h-7 rounded-full overflow-hidden bg-charm-950 shrink-0 flex items-center justify-center">
            <iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>
          </div>
          <div class="flex flex-col min-w-0">
            <span id="nom1-display" class="text-sm font-semibold truncate"></span>
            <span id="nom1-username" class="text-xs text-white/40 truncate"></span>
          </div>
          <iconify-icon icon="boxicons:lock-alt" width="13" class="text-white/20 ml-auto shrink-0"></iconify-icon>
        </div>
        <div id="nom1-entry-section" class="hidden mt-3">
          <div class="mb-1.5">
            <p class="text-xs font-medium text-white/70">Pick an entry</p>
            <p class="text-xs text-white/35">Leave empty to let them pick their own</p>
          </div>
          <div id="nom1-entry-grid" class="grid grid-cols-4 gap-1.5"></div>
          <button type="button" id="nom1-entry-more" class="hidden w-full text-xs text-white/40 hover:text-white/70 py-1.5 mt-1 transition-colors cursor-pointer">Show more</button>
          <div id="nom1-entry-selected" class="hidden justify-end mt-1">
            <button type="button" id="nom1-entry-clear" class="text-white/30 hover:text-white/60 cursor-pointer text-xs">Clear</button>
          </div>
        </div>
      </div>

      <!-- Nominee 2 block -->
      <div class="mb-5">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wide mb-1.5">Nominee 2 <span class="font-normal normal-case text-white/30">· up to 3</span></p>
        <div id="nom2-chips" class="hidden flex flex-wrap gap-1.5 mb-2"></div>
        <div class="relative" id="nom2-search-wrap">
          <input id="nom2-search" type="text" placeholder="Search by username…" autocomplete="off"
            class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
          <div id="nom2-dropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-shark-800 border border-white/10 rounded-md shadow-xl z-10 overflow-hidden"></div>
        </div>
        <p id="nom2-error" class="hidden text-xs text-red-400 mt-1.5"></p>
        <div id="nom2-entry-section" class="hidden mt-3">
          <div class="mb-1.5">
            <p class="text-xs font-medium text-white/70">Pick an entry</p>
            <p class="text-xs text-white/35">Leave empty to let them pick their own</p>
          </div>
          <div id="nom2-entry-grid" class="grid grid-cols-4 gap-1.5"></div>
          <button type="button" id="nom2-entry-more" class="hidden w-full text-xs text-white/40 hover:text-white/70 py-1.5 mt-1 transition-colors cursor-pointer">Show more</button>
          <div id="nom2-entry-selected" class="hidden justify-end mt-1">
            <button type="button" id="nom2-entry-clear" class="text-white/30 hover:text-white/60 cursor-pointer text-xs">Clear</button>
          </div>
        </div>
      </div>

      <!-- Optional side note -->
      <div class="mb-4">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wide mb-1.5">Side Note <span class="font-normal normal-case text-white/30">(optional)</span></p>
        <textarea id="nom-message" rows="2" maxlength="30" placeholder="Leave a note to nominees…"
          class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"></textarea>
        <p id="nom-message-counter" class="text-xs mt-1 text-right text-white/30">0/30 · 0/4 words</p>
      </div>

      <p id="nominate-modal-error" class="hidden text-xs text-red-400 mb-3"></p>

      <button type="button" id="nominate-submit-btn" disabled
        class="w-full py-2.5 rounded-md bg-charm-600 hover:bg-charm-500 text-white text-sm font-semibold transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
        Send Nomination
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  var nominateBtn    = document.getElementById('nominate-btn');
  var modal          = document.getElementById('nominate-modal');
  var backdrop       = document.getElementById('nominate-modal-backdrop');
  var closeBtn       = document.getElementById('nominate-modal-close');
  var nom2Search     = document.getElementById('nom2-search');
  var nom2SearchWrap = document.getElementById('nom2-search-wrap');
  var nom2Dropdown   = document.getElementById('nom2-dropdown');
  var nom2ChipsEl    = document.getElementById('nom2-chips');
  var nom2ErrorEl    = document.getElementById('nom2-error');
  var submitBtn      = document.getElementById('nominate-submit-btn');
  var modalErrorEl   = document.getElementById('nominate-modal-error');
  var messageEl      = document.getElementById('nom-message');
  var msgCounterEl   = document.getElementById('nom-message-counter');

  if (!nominateBtn || !modal) return;

  var nominee1Id      = '';
  var nominee2Ids     = [];
  var nominee1EntryId = '';
  var nominee2EntryId = '';
  var searchTimer     = null;

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function avatarHtml(src, name, size) {
    if (src) return '<img src="' + escHtml(src) + '" alt="' + escHtml(name) + '" class="w-full h-full object-cover rounded-full" />';
    return '<iconify-icon icon="boxicons:user-filled" width="' + size + '" style="color:#e680a6"></iconify-icon>';
  }

  // ── Entry picker ────────────────────────────────────────────────────

  var ENTRY_PAGE = 12;

  function loadEntryPicker(userId, gridEl, sectionEl, onSelect, clearBtn, onClearCb) {
    var moreBtn = sectionEl.querySelector('[id$="-entry-more"]');
    gridEl.dataset.loadedCount = '0';
    gridEl.innerHTML = '<p class="col-span-4 text-xs text-white/30 py-1">Loading…</p>';
    if (moreBtn) moreBtn.classList.add('hidden');
    sectionEl.classList.remove('hidden');

    function appendEntries(entries) {
      if (!entries.length && gridEl.dataset.loadedCount === '0') {
        gridEl.innerHTML = '<p class="col-span-4 text-xs text-white/30 py-1">No entries yet.</p>';
        if (moreBtn) moreBtn.classList.add('hidden');
        return;
      }
      entries.forEach(function (e) {
        var thumb = e.mediaType === 'video'
          ? '<div class="w-full aspect-square bg-shark-700 flex items-center justify-center rounded-md overflow-hidden"><iconify-icon icon="boxicons:play-circle" width="22" class="text-white/40"></iconify-icon></div>'
          : '<img src="' + escHtml(e.mediaUrl) + '" class="w-full aspect-square object-cover rounded-md" />';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'entry-thumb-btn relative rounded-md overflow-hidden ring-2 ring-transparent hover:ring-charm-500/60 transition-all cursor-pointer';
        btn.dataset.entryId = e._id;
        btn.innerHTML = thumb;
        btn.addEventListener('click', function () {
          gridEl.querySelectorAll('.entry-thumb-btn').forEach(function (b) {
            b.classList.remove('ring-charm-500'); b.classList.add('ring-transparent');
          });
          btn.classList.remove('ring-transparent'); btn.classList.add('ring-charm-500');
          onSelect(e._id);
        });
        gridEl.appendChild(btn);
      });
      var newCount = parseInt(gridEl.dataset.loadedCount || '0') + entries.length;
      gridEl.dataset.loadedCount = String(newCount);
      if (moreBtn) {
        if (entries.length < ENTRY_PAGE) { moreBtn.classList.add('hidden'); }
        else { moreBtn.classList.remove('hidden'); moreBtn.textContent = 'Show more'; moreBtn.disabled = false; }
      }
    }

    fetch('/api/users/' + userId + '/entries?skip=0')
      .then(function (r) { return r.json(); })
      .then(function (entries) { gridEl.innerHTML = ''; appendEntries(entries); })
      .catch(function () {
        gridEl.innerHTML = '<p class="col-span-4 text-xs text-red-400 py-1">Could not load entries.</p>';
      });

    if (moreBtn) {
      moreBtn.onclick = function () {
        var skip = parseInt(gridEl.dataset.loadedCount || '0');
        moreBtn.textContent = 'Loading…';
        moreBtn.disabled = true;
        fetch('/api/users/' + userId + '/entries?skip=' + skip)
          .then(function (r) { return r.json(); })
          .then(function (entries) { appendEntries(entries); })
          .catch(function () { moreBtn.textContent = 'Show more'; moreBtn.disabled = false; });
      };
    }

    clearBtn.onclick = function () {
      if (onClearCb) onClearCb();
      gridEl.querySelectorAll('.entry-thumb-btn').forEach(function (b) {
        b.classList.remove('ring-charm-500'); b.classList.add('ring-transparent');
      });
      var selRow = sectionEl.querySelector('[id$="-entry-selected"]');
      if (selRow) selRow.classList.add('hidden');
    };
  }

  function showEntrySelectedRow(sectionEl) {
    var selRow = sectionEl.querySelector('[id$="-entry-selected"]');
    if (selRow) selRow.classList.remove('hidden');
  }

  // ── Submit button state ─────────────────────────────────────────────

  function updateSubmitBtn() {
    var hasNom2 = nominee2Ids.length > 0;
    var words   = messageEl ? messageEl.value.trim().split(/\s+/).filter(Boolean).length : 0;
    submitBtn.disabled = !hasNom2 || words > 4;
    var count = nominee2Ids.length;
    submitBtn.textContent = count > 1 ? 'Send ' + count + ' Nominations' : 'Send Nomination';
  }

  // ── Message counter ─────────────────────────────────────────────────

  function updateMsgCounter() {
    if (!messageEl || !msgCounterEl) return;
    var chars = messageEl.value.length;
    var words = messageEl.value.trim().split(/\s+/).filter(Boolean).length;
    msgCounterEl.textContent = chars + '/30 · ' + words + '/4 words';
    msgCounterEl.className   = 'text-xs mt-1 text-right ' + (words > 4 ? 'text-red-400' : 'text-white/30');
    updateSubmitBtn();
  }

  if (messageEl) messageEl.addEventListener('input', updateMsgCounter);

  // ── Modal open/close ────────────────────────────────────────────────

  function openModal() {
    nominee1Id      = nominateBtn.dataset.nomineeId      || '';
    nominee1EntryId = '';
    nominee2Ids     = [];
    nominee2EntryId = '';
    var display  = nominateBtn.dataset.nomineeDisplay  || '';
    var username = nominateBtn.dataset.nomineeUsername || '';
    var avatar   = nominateBtn.dataset.nomineeAvatar   || '';

    document.getElementById('nom1-display').textContent  = display;
    document.getElementById('nom1-username').textContent = '@' + username;
    document.getElementById('nom1-avatar-wrap').innerHTML = avatarHtml(avatar, display, '14');

    var n1Section = document.getElementById('nom1-entry-section');
    var n1Grid    = document.getElementById('nom1-entry-grid');
    var n1Clear   = document.getElementById('nom1-entry-clear');
    var n1SelRow  = document.getElementById('nom1-entry-selected');
    if (n1SelRow) n1SelRow.classList.add('hidden');
    loadEntryPicker(nominee1Id, n1Grid, n1Section, function (eid) {
      nominee1EntryId = eid;
      showEntrySelectedRow(n1Section);
    }, n1Clear, function () { nominee1EntryId = ''; });

    clearNom2State();
    if (messageEl) { messageEl.value = ''; updateMsgCounter(); }
    if (modalErrorEl) { modalErrorEl.textContent = ''; modalErrorEl.classList.add('hidden'); }
    updateSubmitBtn();

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(function () { if (nom2Search) nom2Search.focus(); }, 50);
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  nominateBtn.addEventListener('click', openModal);
  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  // ── Nominee 2 (multi-select, up to 3) ──────────────────────────────

  function clearNom2State() {
    nominee2Ids     = [];
    nominee2EntryId = '';
    if (nom2ChipsEl)    { nom2ChipsEl.innerHTML = ''; nom2ChipsEl.classList.add('hidden'); }
    if (nom2SearchWrap)   nom2SearchWrap.classList.remove('hidden');
    nom2Search.value = '';
    nom2Dropdown.classList.add('hidden');
    nom2Dropdown.innerHTML = '';
    if (nom2ErrorEl) { nom2ErrorEl.textContent = ''; nom2ErrorEl.classList.add('hidden'); }
    var n2Section = document.getElementById('nom2-entry-section');
    if (n2Section) n2Section.classList.add('hidden');
  }

  function removeNominee2(userId) {
    nominee2Ids = nominee2Ids.filter(function (id) { return id !== userId; });
    var chip = nom2ChipsEl ? nom2ChipsEl.querySelector('[data-user-id="' + userId + '"]') : null;
    if (chip) chip.remove();
    if (nom2ChipsEl && nominee2Ids.length === 0) nom2ChipsEl.classList.add('hidden');
    if (nom2SearchWrap) nom2SearchWrap.classList.remove('hidden');

    var n2Section = document.getElementById('nom2-entry-section');
    if (nominee2Ids.length === 0) {
      if (n2Section) n2Section.classList.add('hidden');
      nominee2EntryId = '';
    } else if (nominee2Ids.length === 1) {
      var n2Grid  = document.getElementById('nom2-entry-grid');
      var n2Clear = document.getElementById('nom2-entry-clear');
      var n2Sel   = document.getElementById('nom2-entry-selected');
      if (n2Sel) n2Sel.classList.add('hidden');
      nominee2EntryId = '';
      loadEntryPicker(nominee2Ids[0], n2Grid, n2Section, function (eid) {
        nominee2EntryId = eid;
        showEntrySelectedRow(n2Section);
      }, n2Clear, function () { nominee2EntryId = ''; });
    }
    updateSubmitBtn();
  }

  function addNominee2(user) {
    nom2Dropdown.classList.add('hidden');
    nom2Dropdown.innerHTML = '';
    if (nom2ErrorEl) { nom2ErrorEl.textContent = ''; nom2ErrorEl.classList.add('hidden'); }

    fetch('/api/users/' + user._id + '/nomination-eligible')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.allowed) {
          if (nom2ErrorEl) {
            nom2ErrorEl.textContent = '@' + user.username + ' isn\'t accepting nominations from you.';
            nom2ErrorEl.classList.remove('hidden');
          }
          return;
        }
        if (nominee2Ids.indexOf(user._id) !== -1 || nominee2Ids.length >= 3) return;
        nominee2Ids.push(user._id);

        var chip = document.createElement('div');
        chip.className = 'flex items-center gap-1.5 bg-shark-700 border border-white/10 rounded-full pl-2 pr-1 py-0.5';
        chip.dataset.userId = user._id;
        var av = user.avatar
          ? '<img src="' + escHtml(user.avatar) + '" class="w-4 h-4 rounded-full object-cover shrink-0" />'
          : '<div class="w-4 h-4 rounded-full bg-charm-950 flex items-center justify-center shrink-0"><iconify-icon icon="boxicons:user-filled" width="9" style="color:#e680a6"></iconify-icon></div>';
        chip.innerHTML = av
          + '<span class="text-xs truncate max-w-[110px]">@' + escHtml(user.username) + '</span>'
          + '<button type="button" class="nom2-chip-rm text-white/30 hover:text-white/70 cursor-pointer ml-0.5 shrink-0">'
          + '<iconify-icon icon="boxicons:x" width="12"></iconify-icon></button>';
        chip.querySelector('.nom2-chip-rm').addEventListener('click', function () { removeNominee2(user._id); });
        if (nom2ChipsEl) { nom2ChipsEl.appendChild(chip); nom2ChipsEl.classList.remove('hidden'); }

        if (nominee2Ids.length >= 3 && nom2SearchWrap) nom2SearchWrap.classList.add('hidden');
        nom2Search.value = '';

        var n2Section = document.getElementById('nom2-entry-section');
        if (nominee2Ids.length === 1) {
          var n2Grid  = document.getElementById('nom2-entry-grid');
          var n2Clear = document.getElementById('nom2-entry-clear');
          var n2Sel   = document.getElementById('nom2-entry-selected');
          if (n2Sel) n2Sel.classList.add('hidden');
          nominee2EntryId = '';
          loadEntryPicker(user._id, n2Grid, n2Section, function (eid) {
            nominee2EntryId = eid;
            showEntrySelectedRow(n2Section);
          }, n2Clear, function () { nominee2EntryId = ''; });
        } else {
          if (n2Section) n2Section.classList.add('hidden');
          nominee2EntryId = '';
        }
        updateSubmitBtn();
      })
      .catch(function () {
        if (nom2ErrorEl) {
          nom2ErrorEl.textContent = 'Could not verify eligibility. Try again.';
          nom2ErrorEl.classList.remove('hidden');
        }
      });
  }

  function showDropdown(users) {
    var filtered = users.filter(function (u) {
      return u._id !== nominee1Id && nominee2Ids.indexOf(u._id) === -1;
    });
    if (!filtered.length) { nom2Dropdown.classList.add('hidden'); return; }
    nom2Dropdown.innerHTML = filtered.map(function (u) {
      var av = u.avatar
        ? '<img src="' + escHtml(u.avatar) + '" class="w-7 h-7 rounded-full object-cover shrink-0" />'
        : '<div class="w-7 h-7 rounded-full bg-charm-950 flex items-center justify-center shrink-0"><iconify-icon icon="boxicons:user-filled" width="13" style="color:#e680a6"></iconify-icon></div>';
      return '<button type="button" class="nom2-result flex items-center gap-2.5 w-full px-3 py-2.5 hover:bg-white/5 text-left transition-colors cursor-pointer"'
        + ' data-id="' + escHtml(u._id) + '"'
        + ' data-username="' + escHtml(u.username) + '"'
        + ' data-display="' + escHtml(u.displayName || u.username) + '"'
        + ' data-avatar="' + escHtml(u.avatar || '') + '">'
        + av
        + '<div class="flex flex-col min-w-0"><span class="text-sm font-medium truncate">' + escHtml(u.displayName || u.username) + '</span>'
        + '<span class="text-xs text-white/40 truncate">@' + escHtml(u.username) + '</span></div></button>';
    }).join('');
    nom2Dropdown.classList.remove('hidden');
  }

  nom2Dropdown.addEventListener('click', function (e) {
    var row = e.target.closest('.nom2-result');
    if (!row) return;
    addNominee2({
      _id:         row.dataset.id,
      username:    row.dataset.username,
      displayName: row.dataset.display,
      avatar:      row.dataset.avatar || null,
    });
  });

  nom2Search.addEventListener('input', function () {
    if (nominee2Ids.length >= 3) return;
    clearTimeout(searchTimer);
    var val = this.value.trim().replace(/^@/, '');
    if (!val) { nom2Dropdown.classList.add('hidden'); return; }
    searchTimer = setTimeout(function () {
      fetch('/api/users/search?q=' + encodeURIComponent(val))
        .then(function (r) { return r.json(); })
        .then(function (users) { showDropdown(users); })
        .catch(function () { nom2Dropdown.classList.add('hidden'); });
    }, 200);
  });

  nom2Search.addEventListener('blur', function () {
    setTimeout(function () { nom2Dropdown.classList.add('hidden'); }, 150);
  });

  // ── Submit ──────────────────────────────────────────────────────────

  submitBtn.addEventListener('click', function () {
    if (!nominee1Id || nominee2Ids.length === 0) return;
    var message = messageEl ? messageEl.value.trim() : '';
    var words   = message.split(/\s+/).filter(Boolean).length;
    if (words > 4) {
      if (modalErrorEl) {
        modalErrorEl.textContent = 'Side note must be 4 words or fewer.';
        modalErrorEl.classList.remove('hidden');
      }
      return;
    }

    submitBtn.disabled = true;
    if (modalErrorEl) { modalErrorEl.textContent = ''; modalErrorEl.classList.add('hidden'); }

    var singleNom2 = nominee2Ids.length === 1;
    var requests = nominee2Ids.map(function (nom2Id) {
      var body = { nominee1Id: nominee1Id, nominee2Id: nom2Id, message: message };
      if (nominee1EntryId) body.nominee1EntryId = nominee1EntryId;
      if (singleNom2 && nominee2EntryId) body.nominee2EntryId = nominee2EntryId;
      return fetch('/api/contests/viewer-nominate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); });
    });

    Promise.all(requests)
      .then(function (results) {
        var failed = results.filter(function (r) { return !r.ok; });
        if (failed.length) {
          if (modalErrorEl) {
            modalErrorEl.textContent = failed[0].data.error || 'Some nominations failed. Try again.';
            modalErrorEl.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          return;
        }
        closeModal();
        var label = nominee2Ids.length > 1 ? nominee2Ids.length + ' nominations sent!' : 'Nomination sent!';
        if (window.showToast) window.showToast(label, 'success');
      })
      .catch(function () {
        if (modalErrorEl) {
          modalErrorEl.textContent = 'Something went wrong. Try again.';
          modalErrorEl.classList.remove('hidden');
        }
        submitBtn.disabled = false;
      });
  });
}());
</script>
<% } %>

<% if (!isOwn) { %>
<script>
(function () {
  var moreBtn  = document.getElementById('profile-more-btn');
  var moreMenu = document.getElementById('profile-more-menu');
  if (!moreBtn || !moreMenu) return;

  function closeMenu() { moreMenu.classList.add('hidden'); }
  function toggleMenu(e) { e.stopPropagation(); moreMenu.classList.toggle('hidden'); }

  moreBtn.addEventListener('click', toggleMenu);
  document.addEventListener('click', function (e) {
    if (!moreMenu.classList.contains('hidden') && !moreMenu.contains(e.target)) closeMenu();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });

  // Share
  document.getElementById('profile-share-btn').addEventListener('click', function () {
    closeMenu();
    var baseUrl = window.location.origin + window.location.pathname;
    var shareUrl = baseUrl + '?ref=share';
    var username = '<%= profileUser.username.value %>';

    fetch('/api/users/' + username + '/share', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ method: navigator.share ? 'native' : 'clipboard' }),
    }).catch(function () {});

    if (navigator.share) {
      navigator.share({ title: document.title, url: shareUrl });
    } else {
      navigator.clipboard.writeText(shareUrl).then(function () {
        if (window.showToast) window.showToast('Profile link copied to clipboard.', 'success');
      });
    }
  });

  // Block / Unblock
  var blockBtn = document.getElementById('profile-block-btn');
  blockBtn.addEventListener('click', function () {
    closeMenu();
    var username = blockBtn.dataset.username;
    blockBtn.disabled = true;
    fetch('/api/users/' + username + '/block', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); blockBtn.disabled = false; return; }
        blockBtn.dataset.blocked = data.blocked ? 'true' : 'false';
        var span = blockBtn.querySelector('span');
        if (span) span.textContent = (data.blocked ? 'Unblock' : 'Block') + ' @' + username;
        if (window.showToast) window.showToast(data.blocked ? 'User blocked.' : 'User unblocked.', 'success');
        setTimeout(function () { window.location.reload(); }, 800);
      })
      .catch(function () {
        if (window.showToast) window.showToast('Something went wrong.', 'error');
        blockBtn.disabled = false;
      });
  });

  // Report — modal
  var reportBtn  = document.getElementById('profile-report-btn');
  var _urModal   = null;

  var USER_REPORT_REASONS = [
    'Spam or self-promotion',
    'Harassment or bullying',
    'Hate speech or discrimination',
    'Impersonation',
    'Underage user',
    'Other',
  ];

  function getReportModal() {
    if (_urModal) return _urModal;

    var overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,0.65);display:none;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(2px);';

    var card = document.createElement('div');
    card.style.cssText = 'background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:1.5rem;max-width:380px;width:100%;font-family:inherit;';

    var title = document.createElement('p');
    title.style.cssText = 'font-size:1rem;font-weight:700;color:#fff;margin:0 0 0.25rem;';
    title.textContent = 'Report this user';
    card.appendChild(title);

    var sub = document.createElement('p');
    sub.style.cssText = 'font-size:0.8125rem;color:rgba(255,255,255,0.4);margin:0 0 1.25rem;';
    sub.textContent = "What’s wrong with this account?";
    card.appendChild(sub);

    var checkboxes = [];
    USER_REPORT_REASONS.forEach(function (label) {
      var row = document.createElement('label');
      row.style.cssText = 'display:flex;align-items:center;gap:0.625rem;padding:0.5rem 0;cursor:pointer;';
      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.value = label;
      cb.style.cssText = 'width:15px;height:15px;accent-color:#e11d48;cursor:pointer;flex-shrink:0;';
      var span = document.createElement('span');
      span.style.cssText = 'font-size:0.875rem;color:rgba(255,255,255,0.7);';
      span.textContent = label;
      row.appendChild(cb);
      row.appendChild(span);
      card.appendChild(row);
      checkboxes.push(cb);
      cb.addEventListener('change', updateSubmit);
    });

    var divider = document.createElement('div');
    divider.style.cssText = 'border-top:1px solid rgba(255,255,255,0.08);margin:1rem 0 0.75rem;';
    card.appendChild(divider);

    var btnRow = document.createElement('div');
    btnRow.style.cssText = 'display:flex;justify-content:flex-end;gap:0.5rem;';

    var cancelBtn = document.createElement('button');
    cancelBtn.type = 'button';
    cancelBtn.textContent = 'Cancel';
    cancelBtn.style.cssText = 'padding:0.375rem 0.875rem;border-radius:6px;font-size:0.8125rem;font-weight:600;background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.5);border:none;cursor:pointer;font-family:inherit;';
    cancelBtn.addEventListener('click', closeModal);

    var submitBtn = document.createElement('button');
    submitBtn.type = 'button';
    submitBtn.textContent = 'Submit report';
    submitBtn.disabled = true;
    submitBtn.style.cssText = 'padding:0.375rem 0.875rem;border-radius:6px;font-size:0.8125rem;font-weight:600;background:#e11d48;color:#fff;border:none;cursor:pointer;font-family:inherit;opacity:0.4;transition:opacity 0.15s;';
    submitBtn.addEventListener('click', submitReport);

    btnRow.appendChild(cancelBtn);
    btnRow.appendChild(submitBtn);
    card.appendChild(btnRow);
    overlay.appendChild(card);
    document.body.appendChild(overlay);

    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.style.display !== 'none') closeModal(); });

    _urModal = { overlay: overlay, checkboxes: checkboxes, submitBtn: submitBtn };

    function updateSubmit() {
      var any = checkboxes.some(function (cb) { return cb.checked; });
      submitBtn.disabled = !any;
      submitBtn.style.opacity = any ? '1' : '0.4';
      submitBtn.style.cursor  = any ? 'pointer' : 'default';
    }

    function closeModal() {
      overlay.style.display = 'none';
      checkboxes.forEach(function (cb) { cb.checked = false; });
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submit report';
      submitBtn.style.opacity = '0.4';
    }

    function submitReport() {
      var selected = checkboxes.filter(function (cb) { return cb.checked; }).map(function (cb) { return cb.value; });
      if (!selected.length) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';
      var username = reportBtn.dataset.username;
      var capturedStatus;
      fetch('/api/users/' + username + '/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reasons: selected }),
      })
      .then(function (r) { capturedStatus = r.status; return r.json(); })
      .then(function (data) {
        closeModal();
        if (capturedStatus === 409) {
          if (window.showToast) window.showToast(data.error, 'info');
          return;
        }
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        if (window.showToast) window.showToast('Report submitted. Thank you.', 'success');
        reportBtn.disabled = true;
        reportBtn.style.opacity = '0.4';
      })
      .catch(function () {
        closeModal();
        if (window.showToast) window.showToast('Something went wrong.', 'error');
      });
    }

    return _urModal;
  }

  reportBtn.addEventListener('click', function () {
    closeMenu();
    var modal = getReportModal();
    modal.overlay.style.display = 'flex';
  });

}());
</script>
<% } %>

<%- include('partials/appEnd') %>
