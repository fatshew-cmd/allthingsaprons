<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="min-h-screen bg-shark-950 text-white">

  <!-- Mature content gate -->
  <div id="content-gate" style="position:fixed;inset:0;z-index:9999;background:rgba(10,10,10,0.88);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:16px">
    <div class="bg-shark-900 border border-white/10 rounded-md p-8 w-full max-w-sm text-center">
      <iconify-icon icon="boxicons:shield-quarter" width="42" class="text-charm-500 mb-5 block mx-auto"></iconify-icon>
      <h2 class="text-xl font-black mb-2">Mature Content</h2>
      <p class="text-sm text-white/45 leading-relaxed mb-7">AllThingsAprons contains mature themes and community content. By continuing you confirm that you are at least <strong class="text-white/70">19 years old</strong> and agree to our community guidelines.</p>
      <div class="flex flex-col gap-3">
        <button id="gate-confirm"
          class="w-full bg-charm-600 hover:bg-charm-500 text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
          I'm 19 or older — continue
        </button>
        <button id="gate-leave"
          class="w-full bg-white/5 hover:bg-white/8 text-white/40 hover:text-white/60 rounded-md py-3 text-sm transition-colors cursor-pointer">
          Leave
        </button>
      </div>
    </div>
  </div>

  <!-- Top bar -->
  <header class="sticky top-0 z-10 bg-shark-950/95 backdrop-blur border-b border-white/5 px-6 h-14 flex items-center justify-between">
    <a href="/">
      <img src="/assets/logo/ata_logo_concept_001.png" alt="All Things Aprons" class="h-12 w-12 object-contain" />
    </a>
    <div class="flex items-center gap-3 text-sm">
      <div class="flex items-center gap-2">
        <div id="step-1-num" class="w-6 h-6 rounded-md bg-charm-600 text-white text-xs font-bold flex items-center justify-center transition-colors">1</div>
        <span id="step-1-label" class="text-white/60 hidden sm:inline transition-colors">Profile</span>
      </div>
      <div class="w-8 h-px bg-white/15"></div>
      <div class="flex items-center gap-2">
        <div id="step-2-num" class="w-6 h-6 rounded-md bg-shark-700 text-white/35 text-xs font-bold flex items-center justify-center transition-colors">2</div>
        <span id="step-2-label" class="text-white/30 hidden sm:inline transition-colors">Verify Email</span>
      </div>
    </div>
    <a href="/login" class="text-sm text-white/35 hover:text-white/60 transition-colors">Log in</a>
  </header>

  <div class="flex justify-center px-4 py-10 pb-20">
    <form id="signup-form" action="/signup" method="POST" enctype="multipart/form-data" novalidate class="w-full">
      <input type="hidden" name="otp" id="otp-hidden">

      <!-- ── STEP 1 ── -->
      <div id="step-1-content" class="max-w-2xl mx-auto">
        <div class="mb-7">
          <h2 class="text-2xl font-black">Create your profile</h2>
          <p class="text-white/40 mt-1 text-sm">Tell us a bit about yourself to get started.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-5 items-start">

          <!-- Avatar column -->
          <div class="shrink-0 self-start pt-0.5">
            <label class="relative cursor-pointer group block" title="Upload profile photo">
              <div id="avatar-circle"
                class="w-40 h-40 rounded-md bg-shark-800 border-2 border-dashed border-white/15 flex items-center justify-center overflow-hidden group-hover:border-charm-600/60 transition-colors bg-cover bg-center">
                <div id="avatar-placeholder" class="flex flex-col items-center gap-1 text-white/35 group-hover:text-white/60 transition-colors pointer-events-none">
                  <iconify-icon icon="boxicons:camera" width="28"></iconify-icon>
                  <span class="text-xs">Photo</span>
                </div>
              </div>
              <div class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-md bg-shark-700 border border-white/15 flex items-center justify-center shadow pointer-events-none">
                <iconify-icon icon="boxicons:plus" width="14" class="text-white/60"></iconify-icon>
              </div>
              <input type="file" name="avatar" id="avatar-input" accept="image/*" class="absolute inset-0 opacity-0 w-full h-full cursor-pointer">
            </label>
            <p class="text-center mt-2 text-xs text-white/40 leading-relaxed">JPG, PNG, JPEG<br>Max 5 MB</p>
          </div>

          <!-- Form card -->
          <div class="flex-1 min-w-0 bg-shark-900 border border-white/8 rounded-md p-6 flex flex-col gap-5">

            <!-- Username -->
            <div class="flex flex-col gap-1.5">
              <label for="username" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Username <span class="text-charm-500">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm pointer-events-none">@</span>
                <input id="username" name="username" type="text" placeholder="yourhandle"
                  autocomplete="off" spellcheck="false" maxlength="15"
                  class="w-full bg-shark-800 border border-white/10 rounded-md pl-7 pr-9 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
                <span id="username-status" class="absolute right-3 top-1/2 -translate-y-1/2 hidden"></span>
              </div>
              <p id="username-hint" class="text-xs text-white/25">Letters &amp; digits only. Must start with a letter. 3–15 chars.</p>
              <p id="username-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <!-- Display Name -->
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center justify-between">
                <label for="display-name" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                  Display Name <span class="text-charm-500">*</span>
                </label>
                <span id="display-name-counter" class="text-xs" style="color:rgba(255,255,255,0.3)">0 / 50</span>
              </div>
              <input id="display-name" name="displayName" type="text" placeholder="Your Name"
                autocomplete="off" maxlength="50"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
              <p class="text-xs text-white/25">Your public name. Up to 3 words, 50 chars max.</p>
              <p id="display-name-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Email <span class="text-charm-500">*</span>
              </label>
              <input id="email" name="email" type="email" placeholder="you@email.com" autocomplete="email"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
              <p id="email-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <!-- Password -->
            <div class="flex flex-col gap-1.5">
              <label for="password" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Password <span class="text-charm-500">*</span>
              </label>
              <div class="relative">
                <input id="password" name="password" type="password" placeholder="Min. 12 characters"
                  autocomplete="new-password"
                  class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 pr-9 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
                <button type="button" id="toggle-password"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-white/30 hover:text-white/60 transition-colors cursor-pointer">
                  <iconify-icon id="pw-eye-icon" icon="boxicons:eye" width="17"></iconify-icon>
                </button>
              </div>
              <!-- Password requirement pills -->
              <div id="password-reqs" class="grid grid-cols-2 gap-2 mt-1.5" style="display:none">
                <div id="req-lower" class="flex items-center gap-1.5 border rounded-md px-2.5 py-1.5 text-xs transition-colors" style="border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.4)">
                  <iconify-icon id="req-lower-icon" icon="boxicons:x" width="12" style="display:block;flex-shrink:0"></iconify-icon>
                  3 lowercase
                </div>
                <div id="req-upper" class="flex items-center gap-1.5 border rounded-md px-2.5 py-1.5 text-xs transition-colors" style="border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.4)">
                  <iconify-icon id="req-upper-icon" icon="boxicons:x" width="12" style="display:block;flex-shrink:0"></iconify-icon>
                  3 uppercase
                </div>
                <div id="req-digit" class="flex items-center gap-1.5 border rounded-md px-2.5 py-1.5 text-xs transition-colors" style="border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.4)">
                  <iconify-icon id="req-digit-icon" icon="boxicons:x" width="12" style="display:block;flex-shrink:0"></iconify-icon>
                  3 digits
                </div>
                <div id="req-special" class="flex items-center gap-1.5 border rounded-md px-2.5 py-1.5 text-xs transition-colors" style="border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.4)">
                  <iconify-icon id="req-special-icon" icon="boxicons:x" width="12" style="display:block;flex-shrink:0"></iconify-icon>
                  3 special chars
                </div>
                <div id="req-length" class="col-span-2 flex items-center gap-1.5 border rounded-md px-2.5 py-1.5 text-xs transition-colors" style="border-color:rgba(255,255,255,0.1);color:rgba(255,255,255,0.4)">
                  <iconify-icon id="req-length-icon" icon="boxicons:x" width="12" style="display:block;flex-shrink:0"></iconify-icon>
                  12+ characters
                </div>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="flex flex-col gap-1.5">
              <label for="confirm-password" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Confirm Password <span class="text-charm-500">*</span>
              </label>
              <div class="relative">
                <input id="confirm-password" name="confirmPassword" type="password" placeholder="Repeat password"
                  autocomplete="new-password"
                  class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 pr-9 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
                <button type="button" id="toggle-confirm-password"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-white/30 hover:text-white/60 transition-colors cursor-pointer">
                  <iconify-icon id="confirm-pw-eye-icon" icon="boxicons:eye" width="17"></iconify-icon>
                </button>
              </div>
              <p id="confirm-password-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <!-- Bio -->
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center justify-between">
                <label for="bio" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Bio</label>
                <span id="bio-counter" class="text-xs" style="color:rgba(255,255,255,0.3)">0 / 220</span>
              </div>
              <textarea id="bio" name="bio" rows="3" maxlength="220"
                placeholder="Tell people about yourself and your passion for aprons..."
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"></textarea>
              <p id="bio-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <!-- Sex + Orientation -->
            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                  Sex <span class="text-charm-500">*</span>
                </label>
                <div class="custom-dropdown relative" id="sex-dropdown">
                  <input type="hidden" name="sex" id="sex">
                  <button type="button" data-dropdown-trigger
                    class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-left flex items-center justify-between focus:outline-none transition-colors cursor-pointer">
                    <span class="dropdown-label text-sm" style="color:rgba(255,255,255,0.22)">Select…</span>
                    <iconify-icon data-chevron icon="boxicons:chevron-down" width="16" class="text-white/30 shrink-0" style="transition:transform 0.15s ease"></iconify-icon>
                  </button>
                  <div class="dropdown-panel absolute z-20 w-full mt-1 bg-shark-800 border border-white/10 rounded-md shadow-xl overflow-hidden" style="display:none">
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="male" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Male</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="female" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Female</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="other" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Other</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="prefer-not-to-say" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Prefer not to say</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                  </div>
                </div>
                <p id="sex-error" class="text-xs text-red-400 hidden"></p>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">Orientation</label>
                <div class="custom-dropdown relative" id="orientation-dropdown">
                  <input type="hidden" name="orientation" id="orientation">
                  <button type="button" data-dropdown-trigger
                    class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-left flex items-center justify-between focus:outline-none transition-colors cursor-pointer">
                    <span class="dropdown-label text-sm" style="color:rgba(255,255,255,0.22)">Select…</span>
                    <iconify-icon data-chevron icon="boxicons:chevron-down" width="16" class="text-white/30 shrink-0" style="transition:transform 0.15s ease"></iconify-icon>
                  </button>
                  <div class="dropdown-panel absolute z-20 w-full mt-1 bg-shark-800 border border-white/10 rounded-md shadow-xl overflow-y-auto max-h-52 overflow-hidden" style="display:none">
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="straight" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Straight</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="gay" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Gay</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="lesbian" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Lesbian</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="bisexual" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Bisexual</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="pansexual" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Pansexual</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="other" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Other</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                    <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="prefer-not-to-say" style="color:rgba(255,255,255,0.5)">
                      <span class="opt-label">Prefer not to say</span>
                      <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="display:none;flex-shrink:0"></iconify-icon>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Location (own row) -->
            <div class="flex flex-col gap-1.5">
              <label for="location" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Location</label>
              <input id="location" name="location" type="text" placeholder="City, Country"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
            </div>

            <!-- Birthdate -->
            <div class="flex flex-col gap-1.5">
              <label for="birthdate" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
                Date of Birth <span class="text-charm-500">*</span>
              </label>
              <input id="birthdate" name="birthdate" type="date"
                max="<%= new Date(Date.now() - 13*365.25*24*60*60*1000).toISOString().split('T')[0] %>"
                min="1920-01-01"
                style="color-scheme:dark"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
              <p id="birthdate-error" class="text-xs text-red-400 hidden"></p>
            </div>

            <p id="step1-general-error" class="text-sm text-red-400 hidden"></p>

            <!-- Consent checkboxes -->
            <div class="flex flex-col gap-3">
              <label class="flex items-start gap-2.5 cursor-pointer group">
                <input type="checkbox" id="agree-terms" name="agreeTerms" value="1" class="sr-only">
                <iconify-icon id="agree-terms-icon" icon="boxicons:square" width="17" class="shrink-0 mt-0.5 transition-colors" style="color:rgba(255,255,255,0.25)"></iconify-icon>
                <span class="text-xs text-white/45 leading-relaxed group-hover:text-white/60 transition-colors">
                  I agree to the <a href="/terms" target="_blank" class="text-charm-400 hover:text-charm-300 underline underline-offset-2">Terms of Service</a> and <a href="/privacy" target="_blank" class="text-charm-400 hover:text-charm-300 underline underline-offset-2">Privacy Policy</a> <span class="text-charm-500">*</span>
                </span>
              </label>
              <label class="flex items-start gap-2.5 cursor-pointer group">
                <input type="checkbox" id="agree-marketing" name="agreeMarketing" value="1" class="sr-only">
                <iconify-icon id="agree-marketing-icon" icon="boxicons:square" width="17" class="shrink-0 mt-0.5 transition-colors" style="color:rgba(255,255,255,0.25)"></iconify-icon>
                <span class="text-xs text-white/45 leading-relaxed group-hover:text-white/60 transition-colors">
                  I'd like to receive updates, promotions, and newsletter emails from AllThingsAprons
                </span>
              </label>
            </div>

            <button type="button" id="next-btn" disabled
              class="w-full bg-charm-600 hover:bg-charm-500 disabled:opacity-35 disabled:cursor-not-allowed disabled:hover:bg-charm-600 text-white font-bold rounded-md py-3 text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer">
              Continue
              <iconify-icon icon="boxicons:right-arrow-alt" width="20"></iconify-icon>
            </button>

            <p class="text-center text-xs text-white/30">Already have an account? <a href="/login" class="text-charm-400 hover:text-charm-300 transition-colors">Log in</a></p>

          </div><!-- /form card -->
        </div><!-- /flex row -->
      </div><!-- /step-1 -->

      <!-- ── STEP 2: OTP Verification ── -->
      <div id="step-2-content" class="hidden max-w-sm mx-auto">

        <button type="button" id="back-btn"
          class="flex items-center gap-1.5 text-white/40 hover:text-white transition-colors text-sm mb-7 cursor-pointer">
          <iconify-icon icon="boxicons:left-arrow-alt" width="18"></iconify-icon>
          Back
        </button>

        <div class="text-center mb-8">
          <iconify-icon icon="boxicons:envelope-open" width="40" class="text-charm-400 mb-4 block mx-auto"></iconify-icon>
          <h2 class="text-2xl font-black">Check your email</h2>
          <p id="otp-sent-to" class="text-white/40 mt-2 text-sm leading-relaxed">We sent a 6-digit code to your email address.</p>
        </div>

        <div class="bg-shark-900 border border-white/8 rounded-md p-6 flex flex-col gap-5">

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">
              Verification Code <span class="text-charm-500">*</span>
            </label>
            <input id="otp-input" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
              placeholder="000000" autocomplete="one-time-code"
              class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-3 text-xl text-white text-center tracking-[0.5em] placeholder:text-white/20 placeholder:tracking-normal focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
            <p id="otp-error" class="text-xs text-red-400 hidden"></p>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
          <p class="text-sm text-red-400 flex items-center gap-1.5">
            <iconify-icon icon="boxicons:error-circle" width="15"></iconify-icon>
            <%= error %>
          </p>
          <% } %>

          <button type="submit" id="submit-btn"
            class="w-full bg-charm-600 hover:bg-charm-500 disabled:opacity-35 disabled:cursor-not-allowed text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
            Verify &amp; Create Account
          </button>

          <p class="text-center text-xs text-white/30">
            Didn't get it?
            <button type="button" id="resend-otp-btn" class="text-charm-400 hover:text-charm-300 transition-colors cursor-pointer">Resend code</button>
          </p>

        </div>

      </div><!-- /step-2 -->

    </form>
  </div>

<script>
(function () {

  // ── State ──────────────────────────────────────────────────
  var usernameStatus     = 'unknown';
  var allPasswordReqsMet = false;
  var currentStep        = 1;
  var STORAGE_KEY        = 'atap_signup';
  var SERVER_EDIT        = <%- (typeof editUser !== 'undefined' && editUser) ? JSON.stringify(editUser) : 'null' %>;

  // ── Utilities ──────────────────────────────────────────────
  function showErr(id, msg) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }
  function clearErr(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  }

  // ── Custom dropdown ────────────────────────────────────────
  var allDropdownClosers = [];

  function initDropdown(containerId, onChange) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var trigger = container.querySelector('[data-dropdown-trigger]');
    var panel   = container.querySelector('.dropdown-panel');
    var label   = container.querySelector('.dropdown-label');
    var chevron = container.querySelector('[data-chevron]');
    var hidden  = container.querySelector('input[type="hidden"]');
    var options = container.querySelectorAll('.dropdown-option');
    var isOpen  = false;

    function openDropdown() {
      allDropdownClosers.forEach(function (fn) { fn(); });
      panel.style.display = 'block';
      chevron.style.transform = 'rotate(180deg)';
      trigger.style.borderColor = 'rgba(199,59,100,0.5)';
      isOpen = true;
    }
    function closeDropdown() {
      panel.style.display = 'none';
      chevron.style.transform = 'rotate(0deg)';
      trigger.style.borderColor = '';
      isOpen = false;
    }
    allDropdownClosers.push(closeDropdown);

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      isOpen ? closeDropdown() : openDropdown();
    });

    options.forEach(function (opt) {
      opt.addEventListener('click', function () {
        hidden.value = this.dataset.value;
        label.textContent = this.querySelector('.opt-label').textContent;
        label.style.color = 'white';
        options.forEach(function (o) {
          o.style.color = 'rgba(255,255,255,0.5)';
          o.querySelector('.check-icon').style.display = 'none';
        });
        this.style.color = 'white';
        this.querySelector('.check-icon').style.display = 'block';
        closeDropdown();
        if (onChange) onChange(hidden.value);
      });
    });

    document.addEventListener('click', function (e) {
      if (isOpen && !container.contains(e.target)) closeDropdown();
    });
  }

  function selectDropdown(containerId, value) {
    var container = document.getElementById(containerId);
    if (!container || !value) return;
    var hidden  = container.querySelector('input[type="hidden"]');
    var label   = container.querySelector('.dropdown-label');
    var options = container.querySelectorAll('.dropdown-option');
    options.forEach(function (opt) {
      var isMatch = opt.dataset.value === value;
      opt.style.color = isMatch ? 'white' : 'rgba(255,255,255,0.5)';
      opt.querySelector('.check-icon').style.display = isMatch ? 'block' : 'none';
      if (isMatch) {
        hidden.value      = value;
        label.textContent = opt.querySelector('.opt-label').textContent;
        label.style.color = 'white';
      }
    });
  }

  initDropdown('sex-dropdown', function () { checkContinueEnabled(); saveSignupState(); });
  initDropdown('orientation-dropdown', function () { saveSignupState(); });

  // ── Step navigation ────────────────────────────────────────
  function showStep(n) {
    currentStep = n;
    saveSignupState();
    var s1 = document.getElementById('step-1-content');
    var s2 = document.getElementById('step-2-content');
    var n1 = document.getElementById('step-1-num');
    var l1 = document.getElementById('step-1-label');
    var n2 = document.getElementById('step-2-num');
    var l2 = document.getElementById('step-2-label');
    var active   = 'bg-charm-600 text-white';
    var inactive = 'bg-shark-700 text-white/35';
    if (n === 1) {
      s1.classList.remove('hidden'); s2.classList.add('hidden');
      n1.className = n1.className.replace(inactive, active);
      n2.className = n2.className.replace(active, inactive);
      l1.className = l1.className.replace('text-white/30', 'text-white/60');
      l2.className = l2.className.replace('text-white/60', 'text-white/30');
    } else {
      s1.classList.add('hidden'); s2.classList.remove('hidden');
      n2.className = n2.className.replace(inactive, active);
      n1.className = n1.className.replace(active, inactive);
      l2.className = l2.className.replace('text-white/30', 'text-white/60');
      l1.className = l1.className.replace('text-white/60', 'text-white/30');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  document.getElementById('back-btn').addEventListener('click', function () { showStep(1); });

  <% if (typeof error !== 'undefined' && error) { %>
  showStep(2);
  <% } %>

  // ── Avatar preview ─────────────────────────────────────────
  document.getElementById('avatar-input').addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      var circle = document.getElementById('avatar-circle');
      circle.style.backgroundImage = 'url(' + e.target.result + ')';
      document.getElementById('avatar-placeholder').classList.add('hidden');
    };
    reader.readAsDataURL(file);
  });

  // ── Password toggles ───────────────────────────────────────
  function makeToggle(btnId, inputId, iconId) {
    document.getElementById(btnId).addEventListener('click', function () {
      var inp  = document.getElementById(inputId);
      var icon = document.getElementById(iconId);
      if (inp.type === 'password') {
        inp.type = 'text';
        icon.setAttribute('icon', 'boxicons:eye-closed');
      } else {
        inp.type = 'password';
        icon.setAttribute('icon', 'boxicons:eye');
      }
    });
  }
  makeToggle('toggle-password',         'password',         'pw-eye-icon');
  makeToggle('toggle-confirm-password', 'confirm-password', 'confirm-pw-eye-icon');

  // ── Password requirements ──────────────────────────────────
  function setReq(key, met) {
    var row  = document.getElementById('req-' + key);
    var icon = document.getElementById('req-' + key + '-icon');
    row.style.color       = met ? '#4ade80'               : 'rgba(255,255,255,0.4)';
    row.style.borderColor = met ? 'rgba(74,222,128,0.22)' : 'rgba(255,255,255,0.1)';
    icon.setAttribute('icon', met ? 'boxicons:check' : 'boxicons:x');
  }

  function checkPasswordReqs(pw) {
    var reqs = {
      length:  pw.length >= 12,
      lower:   (pw.match(/[a-z]/g) || []).length >= 3,
      upper:   (pw.match(/[A-Z]/g) || []).length >= 3,
      digit:   (pw.match(/[0-9]/g) || []).length >= 3,
      special: (pw.match(/[^a-zA-Z0-9]/g) || []).length >= 3,
    };
    document.getElementById('password-reqs').style.display = pw.length === 0 ? 'none' : 'grid';
    setReq('length',  reqs.length);
    setReq('lower',   reqs.lower);
    setReq('upper',   reqs.upper);
    setReq('digit',   reqs.digit);
    setReq('special', reqs.special);
    allPasswordReqsMet = reqs.length && reqs.lower && reqs.upper && reqs.digit && reqs.special;
  }

  document.getElementById('password').addEventListener('input', function () {
    checkPasswordReqs(this.value);
    var confirm = document.getElementById('confirm-password').value;
    if (confirm) {
      clearErr('confirm-password-error');
      if (this.value !== confirm) showErr('confirm-password-error', 'Passwords do not match');
    }
    checkContinueEnabled();
  });

  document.getElementById('confirm-password').addEventListener('input', function () {
    var pw = document.getElementById('password').value;
    clearErr('confirm-password-error');
    if (this.value && this.value !== pw) showErr('confirm-password-error', 'Passwords do not match');
    checkContinueEnabled();
  });

  // ── Bio counter ────────────────────────────────────────────
  document.getElementById('bio').addEventListener('input', function () {
    var len     = this.value.length;
    var counter = document.getElementById('bio-counter');
    counter.textContent = len + ' / 220';
    if (len === 0)       counter.style.color = 'rgba(255,255,255,0.3)';
    else if (len < 20)   counter.style.color = '#f87171';
    else if (len >= 215) counter.style.color = '#fbbf24';
    else                 counter.style.color = '#4ade80';
    clearErr('bio-error');
    if (len > 0 && len < 20) showErr('bio-error', len + ' / 20 minimum characters reached');
    checkContinueEnabled();
  });

  // ── Display name validation ────────────────────────────────
  document.getElementById('display-name').addEventListener('input', function () {
    var val     = this.value;
    var trimmed = val.trim();
    var words   = trimmed.length ? trimmed.split(/\s+/).filter(Boolean).length : 0;
    var counter = document.getElementById('display-name-counter');
    counter.textContent = val.length + ' / 50';
    counter.style.color = val.length === 0 ? 'rgba(255,255,255,0.3)' : val.length > 45 ? '#fbbf24' : '#4ade80';
    clearErr('display-name-error');
    if (words > 3) showErr('display-name-error', 'Display name can be at most 3 words');
    checkContinueEnabled();
  });

  // ── Username availability ──────────────────────────────────
  var usernameTimer = null;
  var USERNAME_RE   = /^[a-zA-Z][a-zA-Z0-9]{2,14}$/;

  document.getElementById('username').addEventListener('input', function () {
    clearTimeout(usernameTimer);
    clearErr('username-error');
    var val      = this.value.trim();
    var statusEl = document.getElementById('username-status');
    statusEl.classList.add('hidden');
    if (val.length === 0) { usernameStatus = 'unknown'; checkContinueEnabled(); return; }
    if (!USERNAME_RE.test(val)) {
      statusEl.innerHTML = mkIcon('boxicons:x-circle', '#f87171');
      statusEl.classList.remove('hidden');
      usernameStatus = 'invalid';
      checkContinueEnabled();
      return;
    }
    if (SERVER_EDIT && val.toLowerCase() === (SERVER_EDIT.username || '').toLowerCase()) {
      statusEl.innerHTML = mkIcon('boxicons:check-circle', '#4ade80');
      statusEl.classList.remove('hidden');
      usernameStatus = 'available';
      checkContinueEnabled();
      return;
    }
    usernameStatus = 'checking';
    statusEl.innerHTML = mkIcon('boxicons:loader-alt', 'rgba(255,255,255,0.3)');
    statusEl.classList.remove('hidden');
    checkContinueEnabled();
    usernameTimer = setTimeout(function () {
      fetch('/api/check-signup?username=' + encodeURIComponent(val.toLowerCase()))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.usernameAvailable) {
            statusEl.innerHTML = mkIcon('boxicons:check-circle', '#4ade80');
            usernameStatus = 'available';
          } else {
            statusEl.innerHTML = mkIcon('boxicons:x-circle', '#f87171');
            showErr('username-error', 'Username already taken');
            usernameStatus = 'taken';
          }
          checkContinueEnabled();
        })
        .catch(function () { statusEl.classList.add('hidden'); usernameStatus = 'unknown'; checkContinueEnabled(); });
    }, 450);
  });

  function mkIcon(name, color) {
    return '<iconify-icon icon="' + name + '" width="15" style="color:' + color + ';display:block"></iconify-icon>';
  }

  // ── Enable / disable Continue ──────────────────────────────
  function checkContinueEnabled() {
    var username    = document.getElementById('username').value.trim();
    var displayName = document.getElementById('display-name').value.trim();
    var displayNameWords = displayName.length ? displayName.split(/\s+/).filter(Boolean).length : 0;
    var email     = document.getElementById('email').value.trim();
    var password  = document.getElementById('password').value;
    var confirm   = document.getElementById('confirm-password').value;
    var sex       = document.getElementById('sex').value;
    var birthdate = document.getElementById('birthdate').value;
    var bio       = document.getElementById('bio').value.trim();
    var terms     = document.getElementById('agree-terms').checked;
    var passwordOk = SERVER_EDIT
      ? (password.length === 0 || (allPasswordReqsMet && confirm === password))
      : (allPasswordReqsMet && confirm.length > 0 && password === confirm);
    var ok = (
      USERNAME_RE.test(username) &&
      usernameStatus !== 'taken' && usernameStatus !== 'invalid' &&
      displayName.length > 0 && displayName.length <= 50 && displayNameWords <= 3 &&
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) &&
      passwordOk &&
      sex !== '' &&
      birthdate !== '' &&
      (bio.length === 0 || bio.length >= 20) &&
      terms
    );
    document.getElementById('next-btn').disabled = !ok;
  }

  ['email', 'birthdate'].forEach(function (id) {
    document.getElementById(id).addEventListener('input',  checkContinueEnabled);
    document.getElementById(id).addEventListener('change', checkContinueEnabled);
  });
  function initCheckboxIcon(inputId, iconId, onChange) {
    var input = document.getElementById(inputId);
    var icon  = document.getElementById(iconId);
    input.addEventListener('change', function () {
      icon.setAttribute('icon', this.checked ? 'boxicons:check-square-filled' : 'boxicons:square');
      icon.style.color = this.checked ? '#c73b64' : 'rgba(255,255,255,0.25)';
      if (onChange) onChange();
    });
  }
  initCheckboxIcon('agree-terms',     'agree-terms-icon',     checkContinueEnabled);
  initCheckboxIcon('agree-marketing', 'agree-marketing-icon');

  // ── Step 1 final validation ────────────────────────────────
  function validateStep1() {
    var valid    = true;
    var username    = document.getElementById('username').value.trim();
    var displayName = document.getElementById('display-name').value.trim();
    var email     = document.getElementById('email').value.trim();
    var password  = document.getElementById('password').value;
    var confirm   = document.getElementById('confirm-password').value;
    var sex       = document.getElementById('sex').value;
    var birthdate = document.getElementById('birthdate').value;
    var bio       = document.getElementById('bio').value.trim();
    if (!USERNAME_RE.test(username)) { showErr('username-error', 'Must start with a letter, letters & digits only, 3–15 chars'); valid = false; }
    if (!displayName) { showErr('display-name-error', 'Display name is required'); valid = false; }
    else if (displayName.split(/\s+/).filter(Boolean).length > 3) { showErr('display-name-error', 'Display name can be at most 3 words'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('email-error', 'A valid email is required'); valid = false; }
    if (SERVER_EDIT) {
      if (password.length > 0 || confirm.length > 0) {
        if (!allPasswordReqsMet) { valid = false; }
        if (password !== confirm) { showErr('confirm-password-error', 'Passwords do not match'); valid = false; }
      }
    } else {
      if (!allPasswordReqsMet) { valid = false; }
      if (!confirm || password !== confirm) { showErr('confirm-password-error', 'Passwords do not match'); valid = false; }
    }
    if (!sex) { showErr('sex-error', 'Please select your sex'); valid = false; }
    if (!birthdate) { showErr('birthdate-error', 'Date of birth is required'); valid = false; }
    if (bio.length > 0 && bio.length < 20) { showErr('bio-error', 'Bio must be at least 20 characters'); valid = false; }
    return valid;
  }

  // ── Continue button — sends OTP ───────────────────────────
  document.getElementById('next-btn').addEventListener('click', async function () {
    if (!validateStep1()) return;
    var btn      = document.getElementById('next-btn');
    btn.disabled = true;
    btn.textContent = 'Sending code…';
    var username = document.getElementById('username').value.trim().toLowerCase();
    var email    = document.getElementById('email').value.trim().toLowerCase();
    try {
      var res  = await fetch('/auth/send-otp', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email: email, username: username }),
      });
      var data = await res.json();
      if (!data.ok) {
        if (data.field === 'email')    showErr('email-error',    data.message);
        if (data.field === 'username') showErr('username-error', data.message);
        showErr('step1-general-error', data.message || 'Could not send code. Please try again.');
        btn.disabled = false;
        btn.innerHTML = 'Continue <iconify-icon icon="boxicons:right-arrow-alt" width="20"></iconify-icon>';
      } else {
        if (data.devCode) {
          document.getElementById('otp-sent-to').innerHTML =
            '<span style="color:rgba(255,255,255,0.4)">No email provider configured. </span>' +
            '<strong style="color:#f59e0b">Dev code: ' + data.devCode + '</strong>';
          document.getElementById('otp-input').value  = data.devCode;
          document.getElementById('otp-hidden').value = data.devCode;
        } else {
          document.getElementById('otp-sent-to').textContent = 'We sent a 6-digit code to ' + email + '.';
        }
        showStep(2);
        btn.disabled = false;
        btn.innerHTML = 'Continue <iconify-icon icon="boxicons:right-arrow-alt" width="20"></iconify-icon>';
      }
    } catch (e) {
      showErr('step1-general-error', 'Could not send code. Please try again.');
      btn.disabled = false;
      btn.innerHTML = 'Continue <iconify-icon icon="boxicons:right-arrow-alt" width="20"></iconify-icon>';
    }
  });

  // ── OTP input sync ─────────────────────────────────────────
  document.getElementById('otp-input').addEventListener('input', function () {
    document.getElementById('otp-hidden').value = this.value.trim();
  });

  // ── Resend OTP ─────────────────────────────────────────────
  document.getElementById('resend-otp-btn').addEventListener('click', async function () {
    var username = document.getElementById('username').value.trim().toLowerCase();
    var email    = document.getElementById('email').value.trim().toLowerCase();
    this.textContent = 'Sending…';
    this.disabled    = true;
    try {
      await fetch('/auth/send-otp', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email: email, username: username }),
      });
    } catch (e) {}
    this.textContent = 'Sent!';
    var btn = this;
    setTimeout(function () { btn.textContent = 'Resend code'; btn.disabled = false; }, 3000);
  });


  // ── Persist & restore state ────────────────────────────────
  function saveSignupState() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        step:            currentStep,
        username:        document.getElementById('username').value,
        displayName:     document.getElementById('display-name').value,
        email:           document.getElementById('email').value,
        password:        document.getElementById('password').value,
        confirmPassword: document.getElementById('confirm-password').value,
        bio:             document.getElementById('bio').value,
        sex:             document.getElementById('sex').value,
        orientation:     document.getElementById('orientation').value,
        location:        document.getElementById('location').value,
        birthdate:       document.getElementById('birthdate').value,
        otpInput:        (document.getElementById('otp-input') || {}).value || '',
      }));
    } catch (e) {}
  }

  function restoreSignupState() {
    var s;
    if (SERVER_EDIT) {
      s = SERVER_EDIT;
    } else {
      var raw = sessionStorage.getItem(STORAGE_KEY);
      if (raw) { try { s = JSON.parse(raw); } catch (e) { s = null; } }
    }
    if (!s) return;

    if (s.username)        document.getElementById('username').value    = s.username;
    if (s.displayName) {
      var dnEl  = document.getElementById('display-name');
      var dnCtr = document.getElementById('display-name-counter');
      dnEl.value     = s.displayName;
      dnCtr.textContent = s.displayName.length + ' / 50';
      dnCtr.style.color = s.displayName.length === 0 ? 'rgba(255,255,255,0.3)' : s.displayName.length > 45 ? '#fbbf24' : '#4ade80';
    }
    if (s.email)           document.getElementById('email').value       = s.email;
    if (s.location)        document.getElementById('location').value    = s.location;
    if (s.birthdate)       document.getElementById('birthdate').value   = s.birthdate;

    if (s.password) {
      document.getElementById('password').value = s.password;
      checkPasswordReqs(s.password);
    }
    if (s.confirmPassword) {
      document.getElementById('confirm-password').value = s.confirmPassword;
    }
    if (s.bio) {
      var bioEl = document.getElementById('bio');
      var ctr   = document.getElementById('bio-counter');
      bioEl.value     = s.bio;
      ctr.textContent = s.bio.length + ' / 220';
      ctr.style.color = s.bio.length === 0 ? 'rgba(255,255,255,0.3)' : s.bio.length < 20 ? '#f87171' : s.bio.length >= 215 ? '#fbbf24' : '#4ade80';
    }

    if (s.sex)         selectDropdown('sex-dropdown',         s.sex);
    if (s.orientation) selectDropdown('orientation-dropdown', s.orientation);

    if (s.username) {
      document.getElementById('username').dispatchEvent(new Event('input'));
    }

    // In edit mode: update password placeholder, pre-load avatar, auto-accept terms
    if (SERVER_EDIT) {
      document.getElementById('password').placeholder         = 'Leave blank to keep current password';
      document.getElementById('confirm-password').placeholder = 'Leave blank to keep current password';
      if (SERVER_EDIT.avatar) {
        var circle = document.getElementById('avatar-circle');
        circle.style.backgroundImage = 'url(' + SERVER_EDIT.avatar + ')';
        document.getElementById('avatar-placeholder').classList.add('hidden');
      }
      var termsInput = document.getElementById('agree-terms');
      var termsIcon  = document.getElementById('agree-terms-icon');
      if (!termsInput.checked) {
        termsInput.checked = true;
        termsIcon.setAttribute('icon', 'boxicons:check-square-filled');
        termsIcon.style.color = '#c73b64';
      }
    }

    checkContinueEnabled();

    if (s.step === 2) {
      if (s.otpInput) {
        document.getElementById('otp-input').value  = s.otpInput;
        document.getElementById('otp-hidden').value = s.otpInput;
      }
      showStep(2);
      var email = s.email || '';
      document.getElementById('otp-sent-to').textContent = email
        ? 'We sent a 6-digit code to ' + email + '.'
        : 'We sent a 6-digit code to your email address.';
    }
  }

  document.getElementById('signup-form').addEventListener('input',  saveSignupState);
  document.getElementById('signup-form').addEventListener('change', saveSignupState);

  // ── Form submit validation ─────────────────────────────────
  document.getElementById('signup-form').addEventListener('submit', function (e) {
    var otp = document.getElementById('otp-hidden').value.trim();
    if (!otp || otp.length !== 6) {
      e.preventDefault();
      showErr('otp-error', 'Please enter the 6-digit code from your email.');
      return;
    }
    sessionStorage.removeItem(STORAGE_KEY);
    var btn = document.getElementById('submit-btn');
    btn.disabled    = true;
    btn.textContent = 'Creating your account…';
  });

  // ── Mature content gate ────────────────────────────────────
  var AGE_GATE_KEY = 'atap_age_ok';
  var contentGate  = document.getElementById('content-gate');
  if (localStorage.getItem(AGE_GATE_KEY)) {
    contentGate.remove();
  } else {
    contentGate.style.display = 'flex';
    document.getElementById('gate-confirm').addEventListener('click', function () {
      localStorage.setItem(AGE_GATE_KEY, '1');
      contentGate.style.opacity = '0';
      contentGate.style.transition = 'opacity 0.2s ease';
      setTimeout(function () { contentGate.remove(); }, 220);
    });
    document.getElementById('gate-leave').addEventListener('click', function () {
      window.location.replace('https://www.google.com');
    });
  }

  restoreSignupState();

}());
</script>

</body>
</html>
