<%- include('partials/appStart', { title: title, activePage: 'settings' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <h1 class="font-black text-xl tracking-tight">Settings</h1>
  </header>

  <div class="flex flex-col py-2">

    <!-- Account section -->
    <p class="px-5 pt-5 pb-2 text-xs font-semibold text-white/30 uppercase tracking-wider">Account</p>
    <% ['Email & Password', 'Notifications', 'Privacy'].forEach(item => { %>
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/5 hover:bg-white/5 cursor-pointer transition-colors">
        <span class="text-sm font-medium"><%= item %></span>
        <iconify-icon icon="boxicons:chevron-right" width="16" height="16" class="text-white/20"></iconify-icon>
      </div>
    <% }) %>

    <!-- Display section -->
    <p class="px-5 pt-6 pb-2 text-xs font-semibold text-white/30 uppercase tracking-wider">Display</p>
    <% ['Theme', 'Language'].forEach(item => { %>
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/5 hover:bg-white/5 cursor-pointer transition-colors">
        <span class="text-sm font-medium"><%= item %></span>
        <iconify-icon icon="boxicons:chevron-right" width="16" height="16" class="text-white/20"></iconify-icon>
      </div>
    <% }) %>

    <!-- Danger zone -->
    <div class="px-5 pt-8 pb-4">
      <button class="w-full py-3 rounded-md border border-red-500/20 text-red-400 text-sm font-semibold hover:bg-red-500/10 transition-colors cursor-pointer">
        Sign Out
      </button>
    </div>

  </div>

</div>

<%- include('partials/appEnd') %>
