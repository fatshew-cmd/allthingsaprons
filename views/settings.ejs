<%- include('partials/appStart', { title: title, activePage: 'settings' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <h1 class="font-black text-xl tracking-tight">Settings</h1>
  </header>

  <div class="px-5 py-6 max-w-xl">

    <% if (success) { %>
    <div class="flex items-center gap-2 text-sm text-green-400 bg-green-400/8 border border-green-400/20 rounded-md px-3 py-2.5 mb-6">
      <iconify-icon icon="boxicons:check-circle" width="15" class="shrink-0"></iconify-icon>
      Profile saved.
    </div>
    <% } %>

    <% if (error) { %>
    <div class="flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-6">
      <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
      <%= error %>
    </div>
    <% } %>

    <!-- Profile section -->
    <section class="mb-8">
      <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-4">Profile</h2>

      <form action="/settings/profile" method="POST" enctype="multipart/form-data" class="flex flex-col gap-5">

        <!-- Avatar -->
        <div class="flex items-center gap-4">
          <label class="relative cursor-pointer group shrink-0">
            <% if (user.avatar) { %>
            <img id="avatar-preview" src="<%= user.avatar %>" alt="Avatar"
              class="w-16 h-16 rounded-md object-cover bg-shark-800 border-2 border-dashed border-white/15 group-hover:border-charm-600/60 transition-colors">
            <% } else { %>
            <div id="avatar-preview" class="w-16 h-16 rounded-md bg-shark-800 border-2 border-dashed border-white/15 flex items-center justify-center group-hover:border-charm-600/60 transition-colors">
              <iconify-icon icon="boxicons:camera" width="22" class="text-white/30 group-hover:text-white/50 transition-colors"></iconify-icon>
            </div>
            <% } %>
            <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-md bg-shark-700 border border-white/15 flex items-center justify-center shadow pointer-events-none">
              <iconify-icon icon="boxicons:plus" width="12" class="text-white/60"></iconify-icon>
            </div>
            <input type="file" name="avatar" id="avatar-input" accept="image/*" class="absolute inset-0 opacity-0 w-full h-full cursor-pointer">
          </label>
          <div>
            <p class="text-sm font-medium">Profile photo</p>
            <p class="text-xs text-white/35 mt-0.5">JPG, PNG, JPEG — max 10 MB</p>
          </div>
        </div>

        <!-- Username -->
        <div class="flex flex-col gap-1.5">
          <label for="username" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
            Username <span class="text-charm-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm pointer-events-none">@</span>
            <input id="username" name="username" type="text" value="<%= user.username || '' %>"
              maxlength="15" autocomplete="off" spellcheck="false"
              class="w-full bg-shark-800 border border-white/10 rounded-md pl-7 pr-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
          </div>
        </div>

        <!-- Bio -->
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center justify-between">
            <label for="bio" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Bio</label>
            <span id="bio-counter" class="text-xs text-white/30"><%= user.bio ? user.bio.length : 0 %> / 220</span>
          </div>
          <textarea id="bio" name="bio" rows="3" maxlength="220"
            placeholder="Tell people about yourself and your passion for aprons..."
            class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"><%= user.bio || '' %></textarea>
        </div>

        <button type="submit"
          class="self-start px-6 py-2.5 bg-charm-600 hover:bg-charm-500 text-white text-sm font-bold rounded-md transition-colors cursor-pointer">
          Save Changes
        </button>

      </form>
    </section>

    <!-- Account section -->
    <section class="mb-8">
      <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-4">Account</h2>
      <div class="bg-shark-900 border border-white/8 rounded-md overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
          <div>
            <p class="text-sm font-medium">Email</p>
            <p class="text-xs text-white/40 mt-0.5"><%= user.email %></p>
          </div>
        </div>
        <div class="flex items-center justify-between px-4 py-3.5">
          <span class="text-sm font-medium">Notifications</span>
          <iconify-icon icon="boxicons:chevron-right" width="16" class="text-white/20"></iconify-icon>
        </div>
      </div>
    </section>

    <!-- Danger zone -->
    <section>
      <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-4">Session</h2>
      <form action="/logout" method="POST">
        <button type="submit"
          class="w-full py-3 rounded-md border border-red-500/20 text-red-400 text-sm font-semibold hover:bg-red-500/10 transition-colors cursor-pointer">
          Sign Out
        </button>
      </form>
    </section>

  </div>

</div>

<script>
(function () {
  document.getElementById('avatar-input').addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      var preview = document.getElementById('avatar-preview');
      if (preview.tagName === 'IMG') {
        preview.src = e.target.result;
      } else {
        var img = document.createElement('img');
        img.id        = 'avatar-preview';
        img.src       = e.target.result;
        img.alt       = 'Avatar';
        img.className = 'w-16 h-16 rounded-md object-cover bg-shark-800 border-2 border-dashed border-white/15 group-hover:border-charm-600/60 transition-colors';
        preview.replaceWith(img);
      }
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('bio').addEventListener('input', function () {
    document.getElementById('bio-counter').textContent = this.value.length + ' / 220';
  });
}());
</script>

<%- include('partials/appEnd') %>
