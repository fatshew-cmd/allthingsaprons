<%- include('partials/appStart', { title: title, activePage: 'settings' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-20 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <h1 class="font-black text-xl tracking-tight">Settings</h1>
  </header>

  <!-- Tab bar -->
  <div class="sticky top-15.25 z-10 bg-shark-950/95 backdrop-blur-sm border-b border-white/8 overflow-x-auto">
    <div class="flex px-2">
      <button id="tab-btn-profile"       data-tab="profile"       class="tab-btn shrink-0 px-4 py-3 text-sm font-semibold border-b-2 whitespace-nowrap transition-colors">Profile</button>
      <button id="tab-btn-notifications" data-tab="notifications" class="tab-btn shrink-0 px-4 py-3 text-sm font-semibold border-b-2 whitespace-nowrap transition-colors">Notifications</button>
      <button id="tab-btn-privacy"       data-tab="privacy"       class="tab-btn shrink-0 px-4 py-3 text-sm font-semibold border-b-2 whitespace-nowrap transition-colors">Privacy</button>
      <button id="tab-btn-wallet"        data-tab="wallet"        class="tab-btn shrink-0 px-4 py-3 text-sm font-semibold border-b-2 whitespace-nowrap transition-colors">Wallet</button>
      <button id="tab-btn-account"       data-tab="account"       class="tab-btn shrink-0 px-4 py-3 text-sm font-semibold border-b-2 whitespace-nowrap transition-colors">Account</button>
    </div>
  </div>

  <div class="px-5 py-6 max-w-xl">

    <!-- Flash banners -->
    <% if (error) { %>
    <div id="settings-error-banner" class="flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-6">
      <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
      <%= error %>
    </div>
    <% } %>
    <% if (success) { %>
    <div id="settings-success-banner" class="flex items-center gap-2 text-sm text-green-400 bg-green-400/8 border border-green-400/20 rounded-md px-3 py-2.5 mb-6">
      <iconify-icon icon="boxicons:check-circle" width="15" class="shrink-0"></iconify-icon>
      <%= success %>
    </div>
    <% } %>

    <!-- ── Profile ─────────────────────────────────────────────────── -->
    <div id="tab-panel-profile" class="hidden">
      <form action="/settings/profile" method="POST" enctype="multipart/form-data" class="flex flex-col gap-5">

        <!-- Avatar -->
        <div class="flex items-center gap-4">
          <label class="relative cursor-pointer group shrink-0">
            <% if (user.avatar?.value) { %>
            <img id="avatar-preview" src="<%= user.avatar.value %>" alt="Avatar"
              class="w-16 h-16 rounded-md object-cover bg-shark-800 border-2 border-dashed border-white/15 group-hover:border-charm-600/60 transition-colors">
            <% } else { %>
            <div id="avatar-preview" class="w-16 h-16 rounded-md bg-shark-800 border-2 border-dashed border-white/15 flex items-center justify-center group-hover:border-charm-600/60 transition-colors">
              <iconify-icon icon="boxicons:camera" width="22" class="text-white/30 group-hover:text-white/50 transition-colors"></iconify-icon>
            </div>
            <% } %>
            <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-md bg-shark-700 border border-white/15 flex items-center justify-center shadow pointer-events-none">
              <iconify-icon icon="boxicons:plus" width="12" class="text-white/60"></iconify-icon>
            </div>
            <input type="file" name="avatar" id="avatar-input" accept="image/*" class="absolute inset-0 opacity-0 w-full h-full cursor-pointer">
          </label>
          <div>
            <p class="text-sm font-medium">Profile photo</p>
            <p class="text-xs text-white/35 mt-0.5">JPG, PNG, JPEG — max 10 MB</p>
          </div>
        </div>

        <!-- Username -->
        <div class="flex flex-col gap-1.5">
          <label for="username" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
            Username <span class="text-charm-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm pointer-events-none">@</span>
            <input id="username" name="username" type="text" value="<%= user.username?.value || '' %>"
              maxlength="15" autocomplete="off" spellcheck="false"
              class="w-full bg-shark-800 border border-white/10 rounded-md pl-7 pr-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors" />
          </div>
        </div>

        <!-- Bio -->
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center justify-between">
            <label for="bio" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Bio</label>
            <span id="bio-counter" class="text-xs text-white/30"><%= user.bio?.value ? user.bio.value.replace(/\s/g, '').length : 0 %> / 220</span>
          </div>
          <textarea id="bio" name="bio" rows="3"
            placeholder="Tell people about yourself and your passion for aprons..."
            class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"><%= user.bio?.value || '' %></textarea>
        </div>

        <button type="submit"
          class="self-start px-6 py-2.5 bg-charm-600 hover:bg-charm-500 text-white text-sm font-bold rounded-md transition-colors cursor-pointer">
          Save Changes
        </button>
      </form>
    </div>

    <!-- ── Notifications ───────────────────────────────────────────── -->
    <div id="tab-panel-notifications" class="hidden">
      <form action="/settings/notifications" method="POST" class="flex flex-col gap-8">

        <div>
          <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">In-App</h2>
          <div class="bg-shark-900 border border-white/8 rounded-md px-4 py-3.5">
            <p class="text-sm text-white/50">All in-app notifications are always enabled. Use the email settings below to control which ones also reach your inbox.</p>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Email</h2>
          <div class="bg-shark-900 border border-white/8 rounded-md overflow-hidden">

            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Comments &amp; Replies</p>
                <p class="text-xs text-white/40 mt-0.5">Someone comments on your entry or replies to you</p>
              </div>
              <select name="emailComments"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= notifSettings.emailComments !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= notifSettings.emailComments === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>

            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Contest Invitations</p>
                <p class="text-xs text-white/40 mt-0.5">Nominations and take-on challenges sent to you</p>
              </div>
              <select name="emailNominations"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= notifSettings.emailNominations !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= notifSettings.emailNominations === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>

            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Contest Updates</p>
                <p class="text-xs text-white/40 mt-0.5">Status changes on contests you're in or watching</p>
              </div>
              <select name="emailContests"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= notifSettings.emailContests !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= notifSettings.emailContests === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>

            <div class="flex items-center justify-between px-4 py-3.5">
              <div>
                <p class="text-sm font-medium">Payouts</p>
                <p class="text-xs text-white/40 mt-0.5">Payout reminders and confirmed payouts</p>
              </div>
              <select name="emailPayouts"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= notifSettings.emailPayouts !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= notifSettings.emailPayouts === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>

          </div>
        </div>

        <div>
          <button type="submit"
            class="px-6 py-2.5 bg-charm-600 hover:bg-charm-500 text-white text-sm font-semibold rounded-md transition-colors cursor-pointer">
            Save Notification Settings
          </button>
        </div>
      </form>
    </div>

    <!-- ── Privacy ─────────────────────────────────────────────────── -->
    <div id="tab-panel-privacy" class="hidden">
      <form action="/settings/privacy" method="POST" class="flex flex-col gap-8">

        <!-- Nominations -->
        <div>
          <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Nominations</h2>
          <div class="bg-shark-900 border border-white/8 rounded-md overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Allow viewer nominations</p>
                <p class="text-xs text-white/40 mt-0.5">Let others nominate you for a head-to-head contest</p>
              </div>
              <select id="nomination-allow-select" name="nominationAllow"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= nominationSettings.allow !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= nominationSettings.allow === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>
            <div id="who-can-nominate-row" class="px-4 py-3.5 <%= nominationSettings.allow === false ? 'hidden' : '' %>">
              <label class="text-xs font-semibold text-white/50 uppercase tracking-wide mb-2 block">Who can nominate me</label>
              <select name="whoCanNominate"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="everyone"       <%= nominationSettings.whoCanNominate === 'everyone'       ? 'selected' : '' %>>Everyone</option>
                <option value="followers_only" <%= nominationSettings.whoCanNominate === 'followers_only' ? 'selected' : '' %>>My followers only</option>
                <option value="followees_only" <%= nominationSettings.whoCanNominate === 'followees_only' ? 'selected' : '' %>>People I follow only</option>
                <option value="mutual_follow"  <%= nominationSettings.whoCanNominate === 'mutual_follow'  ? 'selected' : '' %>>Mutual follows only</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Messaging -->
        <div>
          <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Messaging</h2>
          <div class="bg-shark-900 border border-white/8 rounded-md overflow-hidden">
            <div class="px-4 py-3.5">
              <label class="text-xs font-semibold text-white/50 uppercase tracking-wide mb-2 block">Who can send me direct messages</label>
              <select name="whoCanDm"
                class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="everyone"       <%= privacySettings.whoCanDm === 'everyone'       ? 'selected' : '' %>>Everyone</option>
                <option value="followers_only" <%= privacySettings.whoCanDm === 'followers_only' ? 'selected' : '' %>>My followers only</option>
                <option value="mutual_follow"  <%= privacySettings.whoCanDm === 'mutual_follow'  ? 'selected' : '' %>>Mutual follows only</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div>
          <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Content</h2>
          <div class="bg-shark-900 border border-white/8 rounded-md overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Show mature-tagged entries</p>
                <p class="text-xs text-white/40 mt-0.5">Display entries marked as mature content in your feed</p>
              </div>
              <select name="showMatureContent"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= privacySettings.showMatureContent !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= privacySettings.showMatureContent === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>
            <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/5">
              <div>
                <p class="text-sm font-medium">Show AI-generated entries</p>
                <p class="text-xs text-white/40 mt-0.5">Display entries marked as AI-generated in your feed</p>
              </div>
              <select name="showAiContent"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= privacySettings.showAiContent !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= privacySettings.showAiContent === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>
            <div class="flex items-center justify-between px-4 py-3.5">
              <div>
                <p class="text-sm font-medium">Allow Take Ons by default</p>
                <p class="text-xs text-white/40 mt-0.5">Pre-select "Allow Take Ons" when you submit a new entry</p>
              </div>
              <select name="defaultAllowTakeOns"
                class="bg-shark-800 border border-white/10 rounded-md px-3 py-1.5 text-sm text-white focus:outline-none focus:border-charm-600/50 cursor-pointer">
                <option value="true"  <%= privacySettings.defaultAllowTakeOns !== false ? 'selected' : '' %>>On</option>
                <option value="false" <%= privacySettings.defaultAllowTakeOns === false  ? 'selected' : '' %>>Off</option>
              </select>
            </div>
          </div>
        </div>

        <div>
          <button type="submit"
            class="px-6 py-2.5 bg-charm-600 hover:bg-charm-500 text-white text-sm font-semibold rounded-md transition-colors cursor-pointer">
            Save Privacy Settings
          </button>
        </div>
      </form>
    </div>

    <!-- ── Wallet ──────────────────────────────────────────────────── -->
    <div id="tab-panel-wallet" class="hidden">

      <!-- Balance card -->
      <div class="bg-shark-900 border border-white/10 rounded-md mb-4">
        <div class="px-4 py-4 flex items-center justify-between">
          <div>
            <p class="text-xs text-white/40 mb-0.5">Spendable balance</p>
            <div class="flex items-center gap-2">
              <iconify-icon icon="noto:hot-pepper" width="18"></iconify-icon>
              <span class="text-2xl font-black text-white"><%= wallet.balanceCHL.toLocaleString() %></span>
              <span class="text-sm text-white/40">chilli<%= wallet.balanceCHL !== 1 ? 'es' : '' %></span>
            </div>
            <p class="text-xs text-white/25 mt-1">≈ $<%= (wallet.balanceCHL * 0.20).toFixed(2) %> USD</p>
          </div>
          <a href="/wallet/topup"
            class="flex items-center gap-1.5 px-3 py-2 bg-charm-600 hover:bg-charm-500 text-white text-xs font-semibold rounded-md transition-colors">
            <iconify-icon icon="boxicons:plus" width="13"></iconify-icon>
            Top Up
          </a>
        </div>

        <% if (wallet.monthlySnapshot && wallet.monthlySnapshot.status === 'pending' && wallet.monthlySnapshot.balanceCHL > 0) { %>
        <div class="px-4 py-3 border-t border-white/8 flex items-center justify-between gap-3">
          <p class="text-xs text-white/40">
            <iconify-icon icon="boxicons:time" width="13" class="inline mr-1"></iconify-icon>
            <span class="text-white/60"><%= wallet.monthlySnapshot.balanceCHL.toLocaleString() %> chillies</span>
            scheduled for auto-payout on the 30th
          </p>
          <% if (wallet.showHoldBtn) { %>
          <form action="/wallet/hold-payout" method="POST">
            <button type="submit"
              class="shrink-0 text-xs text-white/50 hover:text-white/80 border border-white/15 hover:border-white/30 px-2.5 py-1.5 rounded transition-colors cursor-pointer">
              Hold until 15th
            </button>
          </form>
          <% } %>
        </div>
        <% } %>

        <% if (wallet.monthlySnapshot && wallet.monthlySnapshot.status === 'held') { %>
        <div class="px-4 py-3 border-t border-white/8">
          <p class="text-xs text-amber-400/70">
            <iconify-icon icon="boxicons:info-circle" width="13" class="inline mr-1"></iconify-icon>
            Payout held — <span class="font-semibold"><%= wallet.monthlySnapshot.balanceCHL.toLocaleString() %> chillies</span> will be paid out on the 15th. No further holds.
          </p>
        </div>
        <% } %>
      </div>

      <!-- Transaction history -->
      <% if (wallet.recentTransactions.length > 0) { %>
      <div class="bg-shark-900 border border-white/10 rounded-md">
        <div class="px-4 py-3 border-b border-white/8">
          <p class="text-xs font-semibold text-white/40 uppercase tracking-wider">Transaction History</p>
        </div>
        <% wallet.recentTransactions.forEach(function(tx) { %>
        <%
          var txLabels = {
            top_up:                  'Top Up',
            contribution:            'Contribution',
            contribution_adjustment: 'Contribution adjusted',
            contribution_withdrawal: 'Contribution withdrawn',
            contest_payout_settled:  'Contest payout',
            auto_payout:             'Auto-payout',
            makeup_payout:           'Makeup payout',
            admin_grant:             'Admin grant',
            platform_fee:            'Platform fee',
          };
          var label = txLabels[tx.type] || tx.type;
          var isCredit = tx.direction === 'credit';
          var dateStr = new Date(tx.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        %>
        <a href="/wallet/transaction/<%= tx._id %>"
          class="px-4 py-3 border-b border-white/5 last:border-0 flex items-center justify-between gap-3 hover:bg-white/4 transition-colors">
          <div class="min-w-0">
            <p class="text-xs font-medium text-white/70 truncate"><%= label %><% if (tx.packageName) { %> · <%= tx.packageName %><% } %></p>
            <p class="text-xs text-white/30 mt-0.5"><%= dateStr %></p>
          </div>
          <div class="text-right shrink-0 flex items-center gap-2">
            <div>
              <p class="text-sm font-semibold <%= isCredit ? 'text-green-400' : 'text-white/60' %>">
                <%= isCredit ? '+' : '−' %><%= tx.amountCHL.toLocaleString() %> 🌶️
              </p>
              <p class="text-xs text-white/25"><%= tx.balanceAfter.toLocaleString() %> after</p>
            </div>
            <iconify-icon icon="boxicons:chevron-right" width="14" class="text-white/20 shrink-0"></iconify-icon>
          </div>
        </a>
        <% }) %>
      </div>
      <% } else { %>
      <div class="bg-shark-900 border border-white/10 rounded-md px-4 py-8 text-center">
        <iconify-icon icon="noto:hot-pepper" width="28" class="mb-2 opacity-30"></iconify-icon>
        <p class="text-sm text-white/30">No transactions yet</p>
        <a href="/wallet/topup" class="text-xs text-charm-400 hover:text-charm-300 transition-colors mt-1 inline-block">Top up to get started</a>
      </div>
      <% } %>
    </div>

    <!-- ── Account ─────────────────────────────────────────────────── -->
    <div id="tab-panel-account" class="hidden">

      <!-- Email -->
      <section class="mb-8">
        <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Email</h2>
        <div class="bg-shark-900 border border-white/8 rounded-md px-4 py-3.5">
          <p class="text-xs text-white/40 mb-0.5">Email address</p>
          <p class="text-sm text-white/70"><%= user.email?.value %></p>
        </div>
      </section>

      <!-- Session -->
      <section class="mb-8">
        <h2 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">Session</h2>
        <form action="/logout" method="POST">
          <button type="submit"
            class="w-full py-3 rounded-md border border-white/10 text-white/60 text-sm font-semibold hover:bg-white/5 transition-colors cursor-pointer">
            Sign Out
          </button>
        </form>
      </section>

      <!-- Danger Zone -->
      <section>
        <h2 class="text-xs font-semibold text-red-500/60 uppercase tracking-wider mb-3">Danger Zone</h2>
        <div class="bg-red-950/20 border border-red-500/20 rounded-md p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold text-white">Delete Account</p>
              <p class="text-xs text-white/40 mt-0.5">Permanently delete your account and all your content.</p>
            </div>
            <button type="button" id="open-delete-modal"
              class="shrink-0 px-4 py-2 rounded-md border border-red-500/40 text-red-400 text-sm font-semibold hover:bg-red-500/15 transition-colors cursor-pointer">
              Delete
            </button>
          </div>
        </div>
      </section>

    </div>

  </div>
</div>

<!-- Delete Account Modal -->
<div id="delete-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="delete-modal-backdrop"></div>
  <div class="relative w-full max-w-sm bg-shark-900 border border-white/10 rounded-md shadow-2xl">
    <div class="p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 rounded-md bg-red-500/15 flex items-center justify-center shrink-0">
          <iconify-icon icon="boxicons:error-circle" width="18" class="text-red-400"></iconify-icon>
        </div>
        <h2 class="text-base font-bold">Delete your account?</h2>
      </div>
      <p class="text-sm text-white/50 mb-1">This will permanently delete:</p>
      <ul class="text-sm text-white/40 mb-5 space-y-0.5 list-none">
        <li class="flex items-center gap-1.5"><iconify-icon icon="boxicons:x" width="13" class="text-red-400/70 shrink-0"></iconify-icon> Your profile and all account data</li>
        <li class="flex items-center gap-1.5"><iconify-icon icon="boxicons:x" width="13" class="text-red-400/70 shrink-0"></iconify-icon> All entries, photos, and videos you submitted</li>
        <li class="flex items-center gap-1.5"><iconify-icon icon="boxicons:x" width="13" class="text-red-400/70 shrink-0"></iconify-icon> All your ratings, votes, and comments</li>
      </ul>
      <p class="text-xs text-white/30 mb-5">This action cannot be undone.</p>
      <form action="/account/delete" method="POST" id="delete-account-form">
        <div class="flex flex-col gap-1.5 mb-4">
          <label for="delete-password" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Confirm your password</label>
          <input type="password" name="password" id="delete-password" autocomplete="current-password"
            placeholder="Enter your password"
            class="w-full bg-shark-800 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-red-500/50 focus:ring-1 focus:ring-red-500/25 transition-colors">
        </div>
        <div class="flex gap-3">
          <button type="button" id="close-delete-modal"
            class="flex-1 py-2.5 rounded-md border border-white/10 text-white/60 text-sm font-semibold hover:bg-white/5 transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="flex-1 py-2.5 rounded-md bg-red-600 hover:bg-red-500 text-white text-sm font-bold transition-colors cursor-pointer">
            Delete Forever
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {

  // ── Tab switching ────────────────────────────────────────────────
  var TABS = ['profile', 'notifications', 'privacy', 'wallet', 'account'];

  function showTab(name) {
    if (!TABS.includes(name)) name = 'profile';
    TABS.forEach(function (t) {
      var btn   = document.getElementById('tab-btn-' + t);
      var panel = document.getElementById('tab-panel-' + t);
      var active = t === name;
      btn.classList.toggle('border-charm-500', active);
      btn.classList.toggle('text-white',        active);
      btn.classList.toggle('border-transparent', !active);
      btn.classList.toggle('text-white/40',     !active);
      panel.classList.toggle('hidden', !active);
    });
    var url = new URL(window.location.href);
    url.searchParams.set('tab', name);
    history.replaceState({}, '', url.toString());
  }

  var initialTab = new URLSearchParams(window.location.search).get('tab') || 'profile';
  showTab(initialTab);

  TABS.forEach(function (t) {
    document.getElementById('tab-btn-' + t).addEventListener('click', function () {
      showTab(t);
    });
  });

  // ── Avatar preview ───────────────────────────────────────────────
  document.getElementById('avatar-input').addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
      var preview = document.getElementById('avatar-preview');
      if (preview.tagName === 'IMG') {
        preview.src = e.target.result;
      } else {
        var img = document.createElement('img');
        img.id        = 'avatar-preview';
        img.src       = e.target.result;
        img.alt       = 'Avatar';
        img.className = 'w-16 h-16 rounded-md object-cover bg-shark-800 border-2 border-dashed border-white/15 group-hover:border-charm-600/60 transition-colors';
        preview.replaceWith(img);
      }
    };
    reader.readAsDataURL(file);
  });

  // ── Bio counter ──────────────────────────────────────────────────
  document.getElementById('bio').addEventListener('input', function () {
    document.getElementById('bio-counter').textContent = this.value.replace(/\s/g, '').length + ' / 220';
  });

  // ── Nomination allow toggle ──────────────────────────────────────
  (function () {
    var allowSel = document.getElementById('nomination-allow-select');
    var whoRow   = document.getElementById('who-can-nominate-row');
    if (allowSel && whoRow) {
      allowSel.addEventListener('change', function () {
        whoRow.classList.toggle('hidden', this.value === 'false');
      });
    }
  }());

  // ── Delete account modal ─────────────────────────────────────────
  (function () {
    var modal    = document.getElementById('delete-modal');
    var openBtn  = document.getElementById('open-delete-modal');
    var closeBtn = document.getElementById('close-delete-modal');
    var backdrop = document.getElementById('delete-modal-backdrop');
    var pwInput  = document.getElementById('delete-password');

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      pwInput.value = '';
      pwInput.focus();
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  }());

  // ── Auto-dismiss success banner ──────────────────────────────────
  (function () {
    var banner = document.getElementById('settings-success-banner');
    if (banner) setTimeout(function () {
      banner.style.transition = 'opacity 0.4s';
      banner.style.opacity = '0';
      setTimeout(function () { banner.remove(); }, 400);
    }, 4000);
  }());

}());
</script>

<%- include('partials/appEnd') %>
