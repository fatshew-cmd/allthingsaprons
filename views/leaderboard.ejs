<%- include('partials/appStart', { title: title, activePage: 'leaderboard' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <h1 class="font-black text-xl tracking-tight">Leaderboard</h1>
    <p class="text-sm text-white/40 mt-0.5">Top-rated aprons right now</p>
  </header>

  <!-- Rankings -->
  <div class="flex flex-col">
    <% items.forEach((item, i) => { %>
      <div class="flex items-center gap-4 px-5 py-4 border-b border-white/5 hover:bg-white/5 transition-colors">

        <!-- Rank -->
        <span class="text-2xl font-black w-7 text-center shrink-0
                     <%= i === 0 ? 'text-charm-400' : i === 1 ? 'text-white/60' : i === 2 ? 'text-amber-600' : 'text-white/20' %>">
          <%= i + 1 %>
        </span>

        <!-- Thumbnail -->
        <div class="w-14 h-14 rounded-md overflow-hidden shrink-0 bg-white/5">
          <img src="<%= item.mediaUrl %>" class="w-full h-full object-cover" alt="<%= item.title %>" loading="lazy" />
        </div>

        <!-- Info -->
        <div class="flex-1 min-w-0">
          <p class="font-semibold truncate"><%= item.title %></p>
          <p class="text-sm text-white/40 truncate"><%= item.authorName || 'Unknown' %></p>
          <div class="flex items-center gap-2 mt-1.5">
            <div class="h-1.5 bg-white/10 rounded-md overflow-hidden" style="width: 80px;">
              <div class="h-full bg-charm-500 rounded-md" style="width: <%= (item.ratingScore / 5 * 100).toFixed(0) %>%;"></div>
            </div>
            <span class="text-xs font-bold text-charm-400"><%= item.ratingScore.toFixed(1) %>★</span>
          </div>
        </div>

        <!-- Vote count -->
        <span class="text-xs text-white/25 shrink-0"><%= item.ratingCount %> votes</span>

      </div>
    <% }) %>
  </div>

</div>

<%- include('partials/appEnd') %>
