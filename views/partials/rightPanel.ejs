<aside class="hidden xl:flex flex-col w-80 shrink-0 sticky top-0 h-screen border-l border-white/10 overflow-y-auto">

  <!-- ── 0. Search ────────────────────────────────────────────────────────── -->
  <% if (!(typeof hideRightPanelSearch !== 'undefined' && hideRightPanelSearch)) { %>
  <div class="p-4 border-b border-white/10">
    <form action="/search" method="GET" class="relative" autocomplete="off">
      <iconify-icon icon="boxicons:search" width="15" class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 pointer-events-none" style="display:block"></iconify-icon>
      <input
        id="panelSearchInput"
        type="text"
        name="q"
        autocomplete="off"
        placeholder="Search..."
        class="w-full bg-white/5 border border-white/8 rounded-md pl-9 pr-4 py-2 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white/20 focus:bg-white/8 transition-colors"
      >
      <div id="panelSearchDropdown" class="hidden absolute left-0 right-0 top-full mt-1.5 bg-shark-900 border border-white/10 rounded-md shadow-lg max-h-96 overflow-y-auto z-20"></div>
    </form>
  </div>
  <% } %>

  <!-- ── 1. Pending Nominations ───────────────────────────────────────────── -->
  <% if (typeof panelPendingNominations !== 'undefined' && panelPendingNominations.length) { %>
    <div class="p-5 border-b border-white/10">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-bold text-white/50 uppercase tracking-wider">Nominations</h2>
        <% if (panelPendingNominations.length > 3) { %>
          <a href="/contests" class="text-xs text-charm-400 hover:text-charm-300 transition-colors no-underline">See more</a>
        <% } %>
      </div>
      <div class="flex flex-col gap-2">
        <% panelPendingNominations.slice(0, 3).forEach(nom => { %>
          <a href="/submit?nomination=<%= nom._id %>"
            class="flex items-center gap-3 bg-white/5 border border-white/8 hover:border-charm-500/30 hover:bg-charm-600/5 rounded-md px-3 py-2.5 transition-colors group no-underline">
            <div class="w-16 h-16 rounded-md overflow-hidden bg-shark-900 shrink-0 flex items-center justify-center">
              <% if (nom.entry) { %>
                <% if (nom.entry.mediaType === 'video') { %>
                  <video src="<%= nom.entry.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
                <% } else { %>
                  <img src="<%= nom.entry.mediaUrl %>" class="w-full h-full object-cover" alt="" loading="lazy">
                <% } %>
              <% } else { %>
                <iconify-icon icon="boxicons:image" width="20" class="text-white/25"></iconify-icon>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-semibold text-white/85 truncate group-hover:text-white transition-colors m-0">
                <%= nom.nominator.displayName %> <span class="font-normal text-white/35">· @<%= nom.nominator.username %></span>
              </p>
              <p class="text-xs text-white/35 m-0">challenged you to a h2h</p>
              <% if (nom.message) { %>
                <p class="text-xs text-white/30 truncate m-0">"<%= nom.message %>"</p>
              <% } %>
              <p class="panel-nom-countdown text-xs text-amber-300 font-medium tabular-nums m-0"
                data-expires="<%= nom.expiresAt.toISOString() %>"></p>
            </div>
            <iconify-icon icon="boxicons:chevron-right" width="14"
              class="text-white/20 group-hover:text-charm-400 shrink-0 transition-colors" style="display:block"></iconify-icon>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ── 3. Ongoing Tournaments (skeleton until July) ────────────────────── -->
  <div class="p-5">
    <h2 class="text-sm font-bold text-white/50 uppercase tracking-wider mb-4">Tournaments</h2>
    <div class="flex flex-col gap-3">
      <% for (let i = 0; i < 3; i++) { %>
        <div class="flex items-center gap-3 animate-pulse">
          <div class="w-10 h-10 rounded-md bg-white/5 shrink-0"></div>
          <div class="flex-1 space-y-1.5">
            <div class="h-3 bg-white/5 rounded-md w-3/4"></div>
            <div class="h-2.5 bg-white/5 rounded-md w-1/2"></div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ── 4. Announcements ───────────────────────────────────────────────── -->
  <% if (typeof panelAnnouncements !== 'undefined' && panelAnnouncements.length) { %>
    <div class="p-5 border-t border-white/10" id="panel-announcement-section">
      <h2 class="text-sm font-bold text-white/50 uppercase tracking-wider mb-3">Announcement</h2>

      <!-- Cards -->
      <div class="relative overflow-hidden rounded-md" id="ann-track-wrap">
        <div class="flex transition-transform duration-400" id="ann-track" style="will-change:transform">
          <% panelAnnouncements.forEach((ann, i) => { %>
            <div class="w-full shrink-0 rounded-md bg-white/5 border border-white/8 overflow-hidden relative <%= ann.redirectUrl ? 'cursor-pointer hover:border-white/15 transition-colors' : '' %>"
                 data-ann-id="<%= ann._id %>"
                 data-stain="<%= ann.stain || '' %>"
                 <% if (ann.redirectUrl) { %>data-redirect-url="<%= ann.redirectUrl %>" tabindex="0" role="link"<% } %>>

              <button
                class="absolute top-2 right-2 z-10 w-6 h-6 rounded-full bg-black/50 hover:bg-black/70 flex items-center justify-center transition-colors ann-dismiss-btn"
                aria-label="Dismiss"
              >
                <iconify-icon icon="boxicons:x" width="11" style="color:rgba(255,255,255,0.7);display:block"></iconify-icon>
              </button>

              <% if (ann.thumbnailUrl) { %>
                <div class="w-full h-40 bg-white/5 overflow-hidden">
                  <img src="<%= ann.thumbnailUrl %>" class="w-full h-full object-cover" alt="" loading="lazy" />
                </div>
              <% } %>

              <div class="p-3">
                <p class="text-sm font-semibold text-white leading-snug m-0"><%= ann.title %></p>
                <% if (ann.description) { %>
                  <p class="text-xs text-white/50 leading-relaxed line-clamp-3 mt-1 mb-0"><%= ann.description %></p>
                <% } %>
              </div>

            </div>
          <% }) %>
        </div>
      </div>

      <!-- Dots -->
      <% if (panelAnnouncements.length > 1) { %>
        <div class="flex justify-center gap-1.5 mt-3" id="ann-dots">
          <% panelAnnouncements.forEach((_, i) => { %>
            <button
              class="ann-dot w-1.5 h-1.5 rounded-full transition-all duration-200 <%= i === 0 ? 'bg-white scale-125' : 'bg-white/30' %>"
              data-index="<%= i %>"
              aria-label="Go to announcement <%= i + 1 %>"
            ></button>
          <% }) %>
        </div>
      <% } %>

    </div>
  <% } %>

  <!-- ── 5. People to Follow ────────────────────────────────────────────── -->
  <% if (typeof panelSuggestedUsers !== 'undefined' && panelSuggestedUsers.length) { %>
    <div class="p-5 border-t border-white/10">
      <h2 class="text-sm font-bold text-white/50 uppercase tracking-wider mb-4">People to Follow</h2>
      <div class="flex flex-col gap-4">
        <% panelSuggestedUsers.forEach(suggestion => { %>
          <div class="flex items-center gap-3" data-suggest-row="<%= suggestion.username %>">
            <a href="/<%= suggestion.username %>" class="shrink-0">
              <img
                src="<%= suggestion.avatar || '/img/default-avatar.png' %>"
                class="w-9 h-9 rounded-full object-cover bg-white/5"
                alt=""
                loading="lazy"
              />
            </a>
            <div class="flex-1 min-w-0">
              <a href="/<%= suggestion.username %>" class="text-sm font-semibold text-white hover:text-charm-300 transition-colors block truncate">
                <%= suggestion.displayName %>
              </a>
              <p class="text-xs text-white/40 truncate">@<%= suggestion.username %></p>
            </div>
            <button
              class="text-xs font-semibold text-charm-400 hover:text-charm-300 transition-colors shrink-0 panel-follow-btn"
              data-username="<%= suggestion.username %>"
            >Follow</button>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ── Footer ───────────────────────────────────────────────────────────── -->
  <div class="px-5 py-4 border-t border-white/5">
    <nav class="flex flex-wrap gap-x-1.5 gap-y-1">
      <a href="/terms" class="text-[10px] text-white/30 hover:text-white/60 transition-colors no-underline">Terms</a>
      <span class="text-[10px] text-white/15">·</span>
      <a href="/privacy" class="text-[10px] text-white/30 hover:text-white/60 transition-colors no-underline">Privacy Policy</a>
      <span class="text-[10px] text-white/15">·</span>
      <a href="/cookies" class="text-[10px] text-white/30 hover:text-white/60 transition-colors no-underline">Cookie Policy</a>
      <span class="text-[10px] text-white/15">·</span>
      <a href="/accessibility" class="text-[10px] text-white/30 hover:text-white/60 transition-colors no-underline">Accessibility</a>
    </nav>
    <p class="text-[10px] text-white/20 mt-1.5 mb-0 whitespace-nowrap">© <%= new Date().getFullYear() %> All Things Aprons</p>
  </div>

</aside>

<script>
(function () {
  // ── Nomination countdowns ─────────────────────────────────────────────────
  var nomCountdownEls = document.querySelectorAll('.panel-nom-countdown');
  if (nomCountdownEls.length) {
    function fmtNomCountdown(expiresAt) {
      var diff = expiresAt - Date.now();
      if (diff <= 0) return 'Expired';
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      var p = function (n) { return n < 10 ? '0' + n : '' + n; };
      if (h > 0) return h + 'h ' + p(m) + 'm left to reply';
      if (m > 0) return m + 'm ' + p(s) + 's left to reply';
      return s + 's left to reply';
    }
    function tickNom() {
      nomCountdownEls.forEach(function (el) {
        el.textContent = fmtNomCountdown(new Date(el.dataset.expires));
      });
    }
    tickNom();
    setInterval(tickNom, 1000);
  }

  // ── Announcement carousel ─────────────────────────────────────────────────
  var track   = document.getElementById('ann-track');
  var section = document.getElementById('panel-announcement-section');
  var dotsWrap = document.getElementById('ann-dots');

  if (track) {
    var cards = Array.from(track.querySelectorAll('[data-ann-id]'));
    var dots  = dotsWrap ? Array.from(dotsWrap.querySelectorAll('.ann-dot')) : [];
    var current = 0;
    var autoTimer;
    var impressedIds = new Set();

    function fireImpression(id) {
      if (!id || impressedIds.has(id)) return;
      impressedIds.add(id);
      fetch('/api/announcements/' + id + '/impression', { method: 'POST' }).catch(function () {});
    }

    function goTo(idx) {
      current = idx;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (d, i) {
        d.classList.toggle('bg-white', i === current);
        d.classList.toggle('scale-125', i === current);
        d.classList.toggle('bg-white/30', i !== current);
      });
      if (cards[idx]) fireImpression(cards[idx].dataset.annId);
    }

    function advance() {
      if (cards.length <= 1) return;
      goTo((current + 1) % cards.length);
    }

    function startAuto() {
      clearInterval(autoTimer);
      if (cards.length > 1) autoTimer = setInterval(advance, 6000);
    }

    // Dot clicks
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(this.dataset.index, 10));
        startAuto();
      });
    });

    // Dismiss
    cards.forEach(function (card) {
      var btn = card.querySelector('.ann-dismiss-btn');
      if (!btn) return;
      btn.addEventListener('click', async function () {
        var id = card.dataset.annId;
        try {
          await fetch('/api/announcements/' + id + '/dismiss', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ stain: card.dataset.stain || null }),
          });
        } catch {}

        var idx = cards.indexOf(card);
        cards.splice(idx, 1);
        if (dots.length) {
          var dot = dots.splice(idx, 1)[0];
          dot.remove();
          // Re-index remaining dots
          dots.forEach(function (d, i) { d.dataset.index = i; });
        }
        card.remove();

        if (cards.length === 0) {
          section.remove();
          return;
        }
        if (dotsWrap && cards.length <= 1) dotsWrap.style.display = 'none';
        goTo(idx < current ? current - 1 : Math.min(current, cards.length - 1));
        startAuto();
      });
    });

    // Card-level click/keydown → navigate + track (dismiss button is excluded via guard)
    cards.forEach(function (card) {
      var url = card.dataset.redirectUrl;
      if (!url) return;
      function activate(e) {
        if (e.target.closest('.ann-dismiss-btn')) return;
        fetch('/api/announcements/' + card.dataset.annId + '/click', {
          method:    'POST',
          headers:   { 'Content-Type': 'application/json' },
          body:      JSON.stringify({ stain: card.dataset.stain || null }),
          keepalive: true,
        }).catch(function () {});
        window.location.href = url;
      }
      card.addEventListener('click', activate);
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(e); }
      });
    });

    // Fire impression for the initially visible card
    if (cards.length) fireImpression(cards[0].dataset.annId);

    startAuto();
  }

  // ── Search typeahead ────────────────────────────────────────────────────────
  var panelSearchInput    = document.getElementById('panelSearchInput');
  var panelSearchDropdown = document.getElementById('panelSearchDropdown');

  if (panelSearchInput && panelSearchDropdown) {
    var panelSearchTimer = null;

    function psEscHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function psAvatarHtml(src, name) {
      if (src) return '<img src="' + psEscHtml(src) + '" alt="' + psEscHtml(name) + '" class="w-7 h-7 rounded-full object-cover shrink-0" />';
      return '<div class="w-7 h-7 rounded-full bg-shark-700 flex items-center justify-center shrink-0"><iconify-icon icon="boxicons:user" width="13" class="text-white/30"></iconify-icon></div>';
    }

    function psThumbHtml(mediaUrl, mediaType) {
      if (mediaType === 'video') return '<video src="' + psEscHtml(mediaUrl) + '" class="w-7 h-7 rounded-md object-cover shrink-0" muted></video>';
      return '<img src="' + psEscHtml(mediaUrl) + '" class="w-7 h-7 rounded-md object-cover shrink-0" loading="lazy" />';
    }

    function psSection(label, rowsHtml) {
      if (!rowsHtml) return '';
      return '<div class="px-2 pt-2 pb-1"><p class="text-[10px] font-bold text-white/35 uppercase tracking-wider px-2 mb-1">' + psEscHtml(label) + '</p>' + rowsHtml + '</div>';
    }

    function psRow(href, iconHtml, title, subtitle) {
      return '<a href="' + href + '" class="flex items-center gap-2.5 px-2 py-2 rounded-md hover:bg-white/5 transition-colors no-underline">'
        + iconHtml
        + '<div class="flex flex-col min-w-0"><span class="text-xs font-medium text-white truncate">' + title + '</span>'
        + (subtitle ? '<span class="text-[11px] text-white/40 truncate">' + subtitle + '</span>' : '')
        + '</div></a>';
    }

    function renderPanelResults(data) {
      var users    = data.users    || [];
      var entries   = data.entries  || [];
      var tags      = data.tags     || [];
      var contests  = data.contests || [];

      if (!users.length && !entries.length && !tags.length && !contests.length) {
        panelSearchDropdown.innerHTML = '<p class="text-xs text-white/30 text-center py-4">No results found</p>';
        panelSearchDropdown.classList.remove('hidden');
        return;
      }

      var html = '';
      html += psSection('Creators', users.map(function (u) {
        return psRow('/' + psEscHtml(u.username), psAvatarHtml(u.avatar, u.displayName), psEscHtml(u.displayName), '@' + psEscHtml(u.username));
      }).join(''));
      html += psSection('Entries', entries.map(function (e) {
        return psRow('/entry/' + psEscHtml(e._id), psThumbHtml(e.mediaUrl, e.mediaType), psEscHtml(e.title), '@' + psEscHtml(e.owner.username));
      }).join(''));
      html += psSection('Tags', tags.map(function (t) {
        return psRow('/search?q=' + encodeURIComponent('#' + t.tag), '<div class="w-7 h-7 rounded-md bg-white/5 flex items-center justify-center shrink-0 text-charm-400 text-xs font-bold">#</div>', '#' + psEscHtml(t.tag), t.count + ' entries');
      }).join(''));
      html += psSection('Contests', contests.map(function (c) {
        var cover = c.covers && c.covers[0] ? psThumbHtml(c.covers[0].mediaUrl, c.covers[0].mediaType) : psAvatarHtml(null, c.title);
        var names = (c.contestants || []).map(function (p) { return p.displayName; }).join(' vs ');
        return psRow('/contest/' + psEscHtml(c._id), cover, psEscHtml(c.title), psEscHtml(names));
      }).join(''));

      panelSearchDropdown.innerHTML = html;
      panelSearchDropdown.classList.remove('hidden');
    }

    panelSearchInput.addEventListener('input', function () {
      clearTimeout(panelSearchTimer);
      var val = this.value.trim();
      if (!val) { panelSearchDropdown.classList.add('hidden'); return; }
      panelSearchTimer = setTimeout(function () {
        fetch('/api/search?q=' + encodeURIComponent(val))
          .then(function (r) { return r.json(); })
          .then(renderPanelResults)
          .catch(function () { panelSearchDropdown.classList.add('hidden'); });
      }, 200);
    });

    panelSearchInput.addEventListener('focus', function () {
      if (this.value.trim() && panelSearchDropdown.innerHTML) panelSearchDropdown.classList.remove('hidden');
    });

    panelSearchInput.addEventListener('blur', function () {
      setTimeout(function () { panelSearchDropdown.classList.add('hidden'); }, 150);
    });
  }

  // ── People to follow ──────────────────────────────────────────────────────
  document.querySelectorAll('.panel-follow-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const username = btn.dataset.username;
      try {
        await fetch('/follow/' + username, { method: 'POST' });
        const row = btn.closest('[data-suggest-row]');
        btn.textContent = 'Following';
        btn.disabled = true;
        btn.classList.remove('text-charm-400', 'hover:text-charm-300');
        btn.classList.add('text-white/30');
        setTimeout(() => row?.remove(), 1200);
      } catch { /* silent */ }
    });
  });
})();
</script>
