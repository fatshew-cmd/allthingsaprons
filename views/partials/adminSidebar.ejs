<%
const _cp   = typeof currentPage !== 'undefined' ? currentPage : '';
const _role = typeof adminRole !== 'undefined' ? adminRole : '';
const _perms = typeof adminPermissions !== 'undefined' ? adminPermissions : [];

const _isFounder    = _role === 'founder';
const _isSuperadmin = _role === 'superadmin';
const _isSupervisor = _role === 'supervisor';
const _isModerator  = _role === 'moderator';

const _hasContent  = _perms.includes('content');
const _hasComments = _perms.includes('comments');
const _hasSupport  = _perms.includes('support');

const _isImpersonating = typeof isImpersonating !== 'undefined' ? isImpersonating : false;
const _realRole        = typeof realAdminRole !== 'undefined' ? realAdminRole : _role;
const _isActualFounder = _realRole === 'founder';

const _domainLabels = { content: 'Content', comments: 'Comments', support: 'Support', financial: 'Financial' };
const _impersonateLabel = (() => {
  const base = { superadmin: 'Super Admin', supervisor: 'Supervisor', moderator: 'Moderator' }[_role] || _role;
  if (!_perms.length) return base;
  return base + ' · ' + _perms.map(p => _domainLabels[p] || p).join(', ');
})();

const lnk = (p) => `flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-colors no-underline ${p === _cp ? 'bg-white/10 text-white font-semibold' : 'text-zinc-300 hover:text-zinc-100 hover:bg-white/5'}`;
const _viewasBtn = _isImpersonating
  ? 'w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-colors cursor-pointer text-amber-400 hover:text-amber-300 hover:bg-amber-500/10'
  : 'w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200 hover:bg-white/5';
const _roleLabels = { moderator: 'Moderator', supervisor: 'Supervisor', superadmin: 'Super Admin', founder: 'Founder' };
const _roleLabel  = _roleLabels[_realRole] || _realRole;
const _name       = typeof adminDisplayName !== 'undefined' && adminDisplayName ? adminDisplayName : (typeof adminEmail !== 'undefined' && adminEmail ? adminEmail : 'Admin');
const _avatar     = typeof adminAvatar !== 'undefined' ? adminAvatar : null;
%>

<aside class="w-57.5 shrink-0 flex flex-col bg-zinc-900" style="height:100vh;position:sticky;top:0;overflow-y:auto">

  <!-- Logo -->
  <a href="/admin" class="flex items-center gap-3 px-5 py-5.5 shrink-0 no-underline">
    <div class="w-8 h-8 rounded-md bg-charm-500 flex items-center justify-center shrink-0">
      <iconify-icon icon="boxicons:crown" width="15" style="color:#1c1917;display:block"></iconify-icon>
    </div>
    <div>
      <p class="text-white text-[13px] font-bold leading-tight m-0">ATA Admin</p>
      <p class="text-zinc-400 text-xs leading-tight m-0">All Things Aprons</p>
    </div>
  </a>

  <div class="mx-4 border-t border-zinc-800 shrink-0"></div>

  <!-- Impersonation banner -->
  <% if (_isImpersonating) { %>
  <div class="mx-3 mt-3 px-3 py-2.5 rounded-md bg-amber-500/10 border border-amber-500/25 shrink-0">
    <p class="text-[11px] font-bold text-amber-500 uppercase tracking-widest leading-none mb-1">Viewing as</p>
    <p class="text-sm font-semibold text-amber-300 leading-tight m-0"><%= _impersonateLabel %></p>
  </div>
  <% } %>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-3 flex flex-col gap-0.5">

    <!-- Overview — all roles -->
    <span class="px-3 py-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Overview</span>

    <a href="/admin" class="<%= lnk('dashboard') %>">
      <iconify-icon icon="boxicons:grid-alt" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Dashboard
    </a>

    <!-- Users — superadmin / supervisor -->
    <% if (_isSuperadmin || _isSupervisor) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Users</span>

    <a href="/admin/users" class="<%= lnk('users') %>">
      <iconify-icon icon="boxicons:group" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      User Management
    </a>

    <% if (_isSupervisor && _hasContent) { %>
    <a href="/admin/verification" class="<%= lnk('verification') %>">
      <iconify-icon icon="boxicons:shield-check" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      <span class="flex-1">ID Verification</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts.pendingVerifications > 0) { %>
      <span class="text-xs font-bold px-1.5 py-0.5 rounded-full bg-violet-500 text-white leading-none"><%= sidebarCounts.pendingVerifications %></span>
      <% } %>
    </a>
    <% } %>
    <% } %>

    <!-- Content — superadmin / supervisor -->
    <% if (_isSuperadmin || _isSupervisor) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Content</span>

    <a href="/admin/content" class="<%= lnk('content') %>">
      <iconify-icon icon="boxicons:image" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      All Entries
    </a>
    <% } %>

    <!-- Moderation — comments moderator or supervisor -->
    <% if ((_isSupervisor || _isModerator) && _hasComments) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Moderation</span>

    <a href="/admin/moderation" class="<%= lnk('moderation') %>">
      <iconify-icon icon="boxicons:flag" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Reported Comments
    </a>
    <% } %>

    <!-- Support — support moderator or supervisor -->
    <% if ((_isSupervisor || _isModerator) && _hasSupport) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Support</span>

    <a href="/admin/support" class="<%= lnk('support') %>">
      <iconify-icon icon="boxicons:message-square" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      <span class="flex-1">Messages</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts.unreadMessages > 0) { %>
      <span class="text-xs font-bold px-1.5 py-0.5 rounded-full bg-charm-500 text-white leading-none"><%= sidebarCounts.unreadMessages %></span>
      <% } %>
    </a>
    <% } %>

    <!-- Tournaments — founder + superadmin -->
    <% if (_isFounder || _isSuperadmin) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Tournaments</span>

    <a href="/admin/tournaments" class="<%= lnk('tournaments') %>">
      <iconify-icon icon="boxicons:trophy" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      All Tournaments
    </a>

    <% if (_isSuperadmin) { %>
    <a href="/admin/tournaments/review" class="<%= lnk('tournament-review') %>">
      <iconify-icon icon="boxicons:clipboard" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Review Queue
    </a>
    <% } %>
    <% } %>

    <!-- Platform — superadmin + founder -->
    <% if (_isSuperadmin || _isFounder) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Platform</span>

    <a href="/admin/announcements" class="<%= lnk('announcements') %>">
      <iconify-icon icon="boxicons:megaphone" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Announcements
    </a>

    <a href="/admin/settings" class="<%= lnk('settings') %>">
      <iconify-icon icon="boxicons:cog" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Settings
    </a>
    <% } %>

    <!-- Accountability — supervisor+ -->
    <% if (_isSuperadmin || _isSupervisor || _isFounder) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Accountability</span>

    <a href="/admin/audit-log" class="<%= lnk('audit-log') %>">
      <iconify-icon icon="boxicons:list-ul" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Audit Log
    </a>
    <% } %>

    <!-- Team — founder only -->
    <% if (_isFounder) { %>
    <span class="px-3 pt-4 pb-1 text-xs font-bold text-zinc-500 uppercase tracking-widest">Team</span>

    <a href="/admin/admins" class="<%= lnk('admins') %>">
      <iconify-icon icon="boxicons:shield" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Admin Accounts
    </a>

    <a href="/admin/applications" class="<%= lnk('applications') %>">
      <iconify-icon icon="boxicons:file" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Applications
    </a>
    <% } %>

  </nav>

  <div class="mx-4 border-t border-zinc-800 shrink-0"></div>

  <!-- Profile + view as + sign out -->
  <div class="px-3 pt-3 pb-2 shrink-0 flex flex-col gap-0.5">

    <!-- Profile badge -->
    <a href="/admin/profile" class="flex items-center gap-2.5 px-3 py-1.5 rounded-md hover:bg-white/5 transition-colors no-underline <%= _cp === 'profile' ? 'bg-white/8' : '' %>">
      <div class="shrink-0 w-8 h-8 rounded-full bg-zinc-700 border border-white/10 overflow-hidden flex items-center justify-center">
        <% if (_avatar) { %>
        <img src="<%= _avatar %>" alt="" class="w-full h-full object-cover">
        <% } else { %>
        <iconify-icon icon="boxicons:user" width="14" style="color:rgba(255,255,255,0.4);display:block"></iconify-icon>
        <% } %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-white leading-tight truncate m-0"><%= _name %></p>
        <p class="text-xs text-zinc-400 leading-tight m-0"><%= _roleLabel %></p>
      </div>
    </a>

    <!-- View as (founder only) -->
    <% if (_isActualFounder) { %>
    <div id="viewas-wrap" class="relative">

      <!-- Trigger -->
      <button type="button" id="viewas-btn" class="<%= _viewasBtn %>">
        <iconify-icon icon="boxicons:eye" width="14" style="flex-shrink:0;display:block"></iconify-icon>
        <span class="flex-1 text-left truncate text-sm"><% if (_isImpersonating) { %><%= _impersonateLabel %><% } else { %>View as...<% } %></span>
        <iconify-icon icon="boxicons:expand-alt" width="12" style="flex-shrink:0;display:block;opacity:0.5"></iconify-icon>
      </button>

      <!-- Floating panel (positioned by JS) -->
      <div id="viewas-panel" class="fixed z-50 hidden w-48 bg-zinc-800 border border-zinc-700 rounded-md shadow-2xl overflow-hidden py-1" style="min-width:200px">

        <% if (_isImpersonating) { %>
        <!-- Exit option -->
        <div class="px-1.5 pt-1 pb-1">
          <form action="/admin/impersonate/exit" method="POST">
            <button type="submit" class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded text-xs font-medium text-amber-400 hover:text-amber-200 hover:bg-amber-500/10 transition-colors cursor-pointer text-left">
              <iconify-icon icon="boxicons:x" width="12" style="flex-shrink:0;display:block"></iconify-icon>
              Exit impersonation
            </button>
          </form>
        </div>
        <div class="mx-2 border-t border-zinc-700 mb-1"></div>
        <% } %>

        <!-- Hidden form for role switching -->
        <form id="viewas-form" action="/admin/impersonate" method="POST">
          <input type="hidden" name="preset" id="viewas-preset">
        </form>

        <!-- Super Admin -->
        <div class="px-1.5 pt-1">
          <p class="px-2.5 py-0.5 text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Super Admin</p>
          <button type="button" onclick="selectViewAs('superadmin')" class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Super Admin</button>
        </div>

        <!-- Supervisor -->
        <div class="px-1.5 pt-2">
          <p class="px-2.5 py-0.5 text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Supervisor</p>
          <button type="button" onclick="selectViewAs('supervisor:content')"  class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Content</button>
          <button type="button" onclick="selectViewAs('supervisor:comments')" class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Comments</button>
          <button type="button" onclick="selectViewAs('supervisor:support')"  class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Support</button>
        </div>

        <!-- Moderator -->
        <div class="px-1.5 pt-2 pb-1">
          <p class="px-2.5 py-0.5 text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Moderator</p>
          <button type="button" onclick="selectViewAs('moderator:content')"  class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Content</button>
          <button type="button" onclick="selectViewAs('moderator:comments')" class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Comments</button>
          <button type="button" onclick="selectViewAs('moderator:support')"  class="w-full text-left px-2.5 py-1.5 rounded text-xs text-zinc-300 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">Support</button>
        </div>

      </div>
    </div>
    <% } %>

    <!-- Sign out -->
    <form action="/admin/logout" method="POST">
      <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm text-zinc-400 hover:text-zinc-200 hover:bg-white/5 transition-colors cursor-pointer">
        <iconify-icon icon="boxicons:log-out" width="14" style="flex-shrink:0;display:block"></iconify-icon>
        Sign out
      </button>
    </form>
  </div>

</aside>

<script>
(function () {
  const btn   = document.getElementById('viewas-btn');
  const panel = document.getElementById('viewas-panel');
  if (!btn || !panel) return;

  function place() {
    const r = btn.getBoundingClientRect();
    const panelH = panel.offsetHeight || 260;
    const gap = 6;
    const spaceAbove = r.top;
    const spaceBelow = window.innerHeight - r.bottom;

    panel.style.left  = r.left + 'px';
    panel.style.width = r.width + 'px';

    if (spaceAbove >= panelH || spaceAbove > spaceBelow) {
      // open upward
      panel.style.top    = 'auto';
      panel.style.bottom = (window.innerHeight - r.top + gap) + 'px';
    } else {
      // open downward
      panel.style.top    = (r.bottom + gap) + 'px';
      panel.style.bottom = 'auto';
    }
  }

  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    const isHidden = panel.classList.contains('hidden');
    if (isHidden) {
      panel.classList.remove('hidden');
      place();
    } else {
      panel.classList.add('hidden');
    }
  });

  document.addEventListener('click', function (e) {
    if (!panel.contains(e.target)) panel.classList.add('hidden');
  });

  window.selectViewAs = function (preset) {
    document.getElementById('viewas-preset').value = preset;
    document.getElementById('viewas-form').submit();
  };
}());
</script>
