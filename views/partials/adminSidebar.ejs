<% const _cp = typeof currentPage !== 'undefined' ? currentPage : ''; %>
<% const lnk = (p) => `flex items-center gap-2.5 px-3 py-2 rounded-md text-[13px] transition-colors no-underline ${p === _cp ? 'bg-white/10 text-white font-semibold' : 'text-zinc-400 hover:text-zinc-100 hover:bg-white/5'}` %>

<aside class="w-[230px] shrink-0 flex flex-col bg-zinc-900" style="height:100vh;position:sticky;top:0;overflow-y:auto">

  <!-- Logo -->
  <a href="/admin" class="flex items-center gap-3 px-5 py-[22px] shrink-0 no-underline">
    <div class="w-8 h-8 rounded-md bg-amber-500 flex items-center justify-center shrink-0">
      <iconify-icon icon="lucide:chef-hat" width="15" style="color:#1c1917;display:block"></iconify-icon>
    </div>
    <div>
      <p class="text-white text-[13px] font-bold leading-tight m-0">ATA Admin</p>
      <p class="text-zinc-500 text-[11px] leading-tight m-0">All Things Aprons</p>
    </div>
  </a>

  <div class="mx-4 border-t border-zinc-800 shrink-0"></div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-3 flex flex-col gap-0.5">

    <span class="px-3 py-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Overview</span>

    <a href="/admin" class="<%= lnk('dashboard') %>">
      <iconify-icon icon="lucide:layout-dashboard" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Dashboard
    </a>

    <span class="px-3 pt-4 pb-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Users</span>

    <a href="/admin/users" class="<%= lnk('users') %>">
      <iconify-icon icon="lucide:users" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      User Management
    </a>

    <a href="/admin/verification" class="<%= lnk('verification') %>">
      <iconify-icon icon="lucide:shield-check" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      <span class="flex-1">ID Verification</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts.pendingVerifications > 0) { %>
      <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-violet-500 text-white leading-none"><%= sidebarCounts.pendingVerifications %></span>
      <% } %>
    </a>

    <span class="px-3 pt-4 pb-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Content</span>

    <a href="/admin/entries" class="<%= lnk('entries') %>">
      <iconify-icon icon="lucide:inbox" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      <span class="flex-1">Entry Review</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts.pendingEntries > 0) { %>
      <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-amber-500 text-stone-900 leading-none"><%= sidebarCounts.pendingEntries %></span>
      <% } %>
    </a>

    <a href="/admin/content" class="<%= lnk('content') %>">
      <iconify-icon icon="lucide:image" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Entries
    </a>

    <span class="px-3 pt-4 pb-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Tournaments</span>

    <a href="/admin/tournaments" class="<%= lnk('tournaments') %>">
      <iconify-icon icon="lucide:trophy" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      All Tournaments
    </a>

    <a href="/admin/tournaments/review" class="<%= lnk('tournament-review') %>">
      <iconify-icon icon="lucide:clipboard-check" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Review Queue
    </a>

    <span class="px-3 pt-4 pb-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Moderation</span>

    <a href="/admin/moderation" class="<%= lnk('moderation') %>">
      <iconify-icon icon="lucide:flag" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      Reported Comments
    </a>

    <span class="px-3 pt-4 pb-1 text-[10px] font-bold text-zinc-600 uppercase tracking-widest">Support</span>

    <a href="/admin/support" class="<%= lnk('support') %>">
      <iconify-icon icon="lucide:message-square" width="14" style="flex-shrink:0;display:block"></iconify-icon>
      <span class="flex-1">Messages</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts.unreadMessages > 0) { %>
      <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-charm-500 text-white leading-none"><%= sidebarCounts.unreadMessages %></span>
      <% } %>
    </a>

  </nav>

  <div class="mx-4 border-t border-zinc-800 shrink-0"></div>

  <!-- Sign out -->
  <div class="px-3 py-4 shrink-0">
    <form action="/admin/logout" method="POST">
      <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-[13px] text-zinc-500 hover:text-zinc-200 hover:bg-white/5 transition-colors cursor-pointer">
        <iconify-icon icon="lucide:log-out" width="14" style="flex-shrink:0;display:block"></iconify-icon>
        Sign out
      </button>
    </form>
  </div>

</aside>
