<div id="toast-container"
  class="fixed bottom-20 md:bottom-5 right-4 md:right-5 z-9999 flex flex-col gap-2 pointer-events-none"
  aria-live="polite"></div>

<style>
  @keyframes _toast-in  { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
  @keyframes _toast-out { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(4px); } }
  ._toast-enter { animation: _toast-in  0.18s ease forwards; }
  ._toast-exit  { animation: _toast-out 0.16s ease forwards; }
</style>

<script>
(function () {
  var container = document.getElementById('toast-container');

  var CONFIGS = {
    success: { icon: 'boxicons:check-circle',  cls: 'text-green-400 bg-green-400/8 border-green-400/20' },
    error:   { icon: 'boxicons:error-circle',   cls: 'text-red-400   bg-red-400/8   border-red-400/20'   },
    info:    { icon: 'boxicons:info-circle',    cls: 'text-white/60  border-white/10'                      },
  };

  function dismiss(el) {
    if (!el.parentNode) return;
    el.classList.remove('_toast-enter');
    el.classList.add('_toast-exit');
    el.addEventListener('animationend', function () {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, { once: true });
  }

  window.showToast = function (message, type, duration, actions, opts) {
    var cfg = CONFIGS[type] || CONFIGS.info;
    var hasActions = actions && actions.length > 0;
    if (duration === undefined) duration = hasActions ? 0 : 4000;
    opts = opts || {};

    var el = document.createElement('div');
    el.className = 'pointer-events-auto flex flex-col rounded-md border shadow-xl min-w-56 max-w-xs bg-shark-900 _toast-enter ' + cfg.cls;

    var header = document.createElement('div');
    header.className = 'flex items-start gap-2.5 px-3.5 py-2.5 text-sm';
    var inner = '';
    if (!opts.noIcon) inner += '<iconify-icon icon="' + cfg.icon + '" width="15" class="shrink-0"></iconify-icon>';
    inner += '<span class="flex-1">' + message + '</span>';
    if (!opts.noClose && !hasActions) inner +=
      '<button type="button" class="shrink-0 ml-1 opacity-40 hover:opacity-80 transition-opacity cursor-pointer">' +
        '<iconify-icon icon="boxicons:x" width="16"></iconify-icon>' +
      '</button>';
    header.innerHTML = inner;
    if (!opts.noClose) header.querySelector('button').addEventListener('click', function () { dismiss(el); });
    el.appendChild(header);

    if (hasActions) {
      var actRow = document.createElement('div');
      actRow.className = 'flex items-center justify-end gap-2 px-3 pt-1 pb-3';
      actions.forEach(function (a) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'text-xs font-semibold px-3 py-1.5 rounded-md transition-colors cursor-pointer ' + (a.cls || 'bg-white/10 text-white/60 hover:bg-white/15');
        b.textContent = a.label;
        b.addEventListener('click', function () { dismiss(el); if (a.fn) a.fn(); });
        actRow.appendChild(b);
      });
      el.appendChild(actRow);
    }

    container.appendChild(el);
    if (duration > 0) setTimeout(function () { dismiss(el); }, duration);
    return el;
  };

  document.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);

    if (params.get('saved') === '1') {
      window.showToast('Profile saved.', 'success');
      params.delete('saved');
      history.replaceState(null, '', window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash);
    }
  });
}());
</script>
