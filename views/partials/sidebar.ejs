<aside class="hidden md:flex flex-col sticky top-0 h-screen w-16 xl:w-64 shrink-0 border-r border-white/10 overflow-hidden">

  <!-- Logo -->
  <div class="flex items-center justify-center xl:justify-start h-16 px-4 xl:px-5 shrink-0">
    <!-- <img src="/assets/logo/ata_logo_concept_001.png" alt="All Things Aprons" class="h-12 w-12 object-contain shrink-0" /> -->
    <span class="font-gochi text-charm-500 whitespace-nowrap overflow-hidden hidden xl:inline text-xl leading-none" style="-webkit-text-stroke: 0.75px currentColor">AllThingsAprons</span>
  </div>

  <!-- Nav links -->
  <nav class="flex flex-col gap-1 px-2 py-4 flex-1 overflow-y-auto">
    <%
      const navLinks = [
        { href: '/feed',          label: 'Feed',          page: 'feed',          icon: 'boxicons:home',              iconActive: 'boxicons:home-filled' },
        { href: '/search',        label: 'Explore',       page: 'search',        icon: 'boxicons:search',            iconActive: 'boxicons:search' },
        { href: '/leaderboard',   label: 'Leaderboard',   page: 'leaderboard',   icon: 'boxicons:trending-up',       iconActive: 'boxicons:trending-up' },
        { href: '/contests',      label: 'Contests',      page: 'contests',      icon: 'boxicons:trophy',            iconActive: 'boxicons:trophy-filled' },
        { href: '#',              label: 'Marketplace',   page: 'marketplace',   icon: 'boxicons:shopping-bag',      iconActive: 'boxicons:shopping-bag-filled', future: true },
        { href: '/notifications', label: 'Notifications', page: 'notifications', icon: 'boxicons:bell',              iconActive: 'boxicons:bell-ring' },
        { href: '/messages',      label: 'Messages',      page: 'messages',      icon: 'boxicons:message-bubble-dots',   iconActive: 'boxicons:message-bubble-dots-filled' },
{ href: '/settings',      label: 'Settings',      page: 'settings',      icon: 'boxicons:cog',               iconActive: 'boxicons:cog-filled' },
      ];
    %>

    <% navLinks.forEach(link => { %>
      <a href="<%= link.href %>"
         class="flex items-center gap-4 px-3 py-2 rounded-md transition-colors
                <%= activePage === link.page ? 'text-charm-400' : 'text-white/50 hover:text-white hover:bg-white/5' %>
                <%= link.future ? 'opacity-40 pointer-events-none cursor-not-allowed' : 'cursor-pointer' %>">
        <div class="relative shrink-0 flex items-center justify-center w-6 h-6">
          <% if (activePage === link.page) { %>
            <span class="absolute -left-3 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-charm-400"></span>
          <% } %>
          <iconify-icon icon="<%= activePage === link.page ? link.iconActive : link.icon %>" width="24" height="24" style="display:block"></iconify-icon>
          <% if (link.page === 'notifications' && typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
            <span class="xl:hidden absolute -top-1 -right-1 w-2 h-2 rounded-full bg-charm-400 block"></span>
          <% } else if (link.page === 'contests' && typeof panelPendingNominations !== 'undefined' && panelPendingNominations.length > 0) { %>
            <span class="xl:hidden absolute -top-1 -right-1 w-2 h-2 rounded-full bg-charm-400 block"></span>
          <% } %>
        </div>
        <span class="hidden xl:inline font-medium text-sm truncate"><%= link.label %></span>
        <% if (link.future) { %>
          <span class="hidden xl:inline text-xs text-white/25 ml-auto">Soon</span>
        <% } else if (link.page === 'notifications' && typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
          <span id="notif-badge" class="hidden xl:inline text-xs bg-charm-600 text-white font-bold px-1.5 py-0.5 rounded-md ml-auto leading-none"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
        <% } else if (link.page === 'contests' && typeof panelPendingNominations !== 'undefined' && panelPendingNominations.length > 0) { %>
          <span class="hidden xl:inline text-xs bg-charm-600 text-white font-bold px-1.5 py-0.5 rounded-md ml-auto leading-none"><%= panelPendingNominations.length %></span>
        <% } %>
      </a>
    <% }) %>
  </nav>

  <!-- Profile Card -->
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <div class="px-2 xl:px-3 pt-3 pb-2 shrink-0">
    <a href="/<%= currentUser.username %>" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-white/5 transition-colors">
      <div class="w-11 h-11 rounded-full shrink-0 overflow-hidden bg-charm-700/30 flex items-center justify-center">
        <% if (currentUser.avatar) { %>
          <img src="<%= currentUser.avatar %>" alt="<%= currentUser.username %>" class="w-full h-full object-cover" />
        <% } else { %>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="text-charm-400">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1" />
          </svg>
        <% } %>
      </div>
      <div class="hidden xl:flex flex-col min-w-0">
        <span class="text-sm font-semibold text-white truncate">@<%= currentUser.username || 'user' %></span>
        <span class="text-xs text-white/40 truncate"><%= currentUser.email %></span>
      </div>
    </a>
  </div>
  <% } %>

  <!-- Submit CTA -->
  <div class="px-2 xl:px-3 pt-2 pb-4 shrink-0">
    <a href="/submit"
       class="flex items-center justify-center gap-2 bg-charm-600 hover:bg-charm-500 text-white font-bold rounded-md py-3 transition-colors w-full cursor-pointer">
      <iconify-icon icon="boxicons:plus" width="20" height="20" class="shrink-0"></iconify-icon>
      <span class="hidden xl:inline text-sm">Submit</span>
    </a>
  </div>

</aside>
