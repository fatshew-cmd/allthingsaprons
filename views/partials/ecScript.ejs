<script>
(function () {
  var LABELS      = ['','Chopped — What even is this? 🤮','An L — Not even trying 😑','Mid — It\'s just... there 😐','Basic — Standard, pretty boring 🥱','Mid — Just whatever 🫱','Decent — Not bad, actually kind of okay 😉','Fire — This is kind of hot 🔥','Banger — Goddayumm 😍','Ate — I\'m gagged 🌶️','God-tier — That should be illegal 😈'];
  var EMOJIS      = ['','🤮','😑','😐','🥱','🫱','😉','🔥','😍','🌶️','😈'];
  var SCORE_TEXT  = ['','Chopped — What even is this?','An L — Not even trying','Mid — It\'s just... there','Basic — Standard, pretty boring','Mid — Just whatever','Decent — Not bad, actually kind of okay','Fire — This is kind of hot','Banger — Goddayumm','Ate — I\'m gagged','God-tier — That should be illegal'];

  function ecEsc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function getConfettiOverlay() {
    var overlay = document.getElementById('ec-confetti-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'ec-confetti-overlay';
      overlay.style.cssText = 'position:fixed;top:0;bottom:0;overflow:hidden;pointer-events:none;z-index:9999;';
      document.body.appendChild(overlay);
    }
    var main = document.querySelector('main');
    var rect = main ? main.getBoundingClientRect() : { left: 0, width: window.innerWidth };
    overlay.style.left  = rect.left + 'px';
    overlay.style.width = rect.width + 'px';
    return overlay;
  }

  function burstConfetti(score) {
    var emoji = EMOJIS[score];
    if (!emoji) return;
    var overlay = getConfettiOverlay();
    var ow = overlay.offsetWidth;
    var oh = overlay.offsetHeight;
    var count = 30;
    for (var i = 0; i < count; i++) {
      (function (idx) {
        var p = document.createElement('span');
        p.textContent = emoji;
        var cx = 40 + Math.random() * (ow - 80);
        p.style.cssText = 'position:absolute;left:' + cx + 'px;top:' + oh + 'px;pointer-events:none;font-size:3.5rem;line-height:1;will-change:transform,opacity;';
        var tx = (Math.random() - 0.5) * 220;
        var ty = -(320 + Math.random() * 260);
        var mx = tx + (Math.random() - 0.5) * 300;
        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--mx', mx + 'px');
        p.style.animation = '_ec-burst ' + (2.8 + Math.random() * 0.5) + 's ease-out forwards';
        p.style.animationDelay = (idx * 0.04 + Math.random() * 0.15) + 's';
        overlay.appendChild(p);
        p.addEventListener('animationend', function () { if (p.parentNode) p.parentNode.removeChild(p); }, { once: true });
      }(i));
    }
  }

  function getCard(eid) { return document.getElementById('ec-' + eid); }

  window.ecToggleMore = function (btn, e) {
    e.stopPropagation();
    e.preventDefault();
    var menu = btn.nextElementSibling;
    if (!menu) return;
    var isHidden = menu.classList.contains('hidden');
    document.querySelectorAll('.ec-more-menu').forEach(function (m) { m.classList.add('hidden'); });
    if (isHidden) menu.classList.remove('hidden');
  };

  function setTab(eid, panel) {
    var panels  = document.querySelectorAll('.ec-panel[data-eid="' + eid + '"]');
    var tabBtns = document.querySelectorAll('.ec-tab-btn[data-eid="' + eid + '"]');
    var target  = document.querySelector('.ec-panel[data-eid="' + eid + '"][data-panel="' + panel + '"]');
    var isOpen  = target && !target.classList.contains('hidden');

    panels.forEach(function (p) { p.classList.add('hidden'); });
    tabBtns.forEach(function (b) { b.classList.remove('ec-on'); });

    if (!isOpen && target) {
      target.classList.remove('hidden');
      var btn = document.querySelector('.ec-tab-btn[data-eid="' + eid + '"][data-panel="' + panel + '"]');
      if (btn) btn.classList.add('ec-on');
    }
  }

  var _pendingToasts = {};

  function lockRatingPanel(eid, confirmedScore) {
    selectTile(eid, confirmedScore);
    document.querySelectorAll('.ec-rating-tile[data-eid="' + eid + '"]').forEach(function (t) {
      t.classList.add('ec-locked');
    });
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + eid + '"]');
    if (lbl) lbl.textContent = LABELS[confirmedScore] || '';
  }

  function selectTile(eid, score) {
    document.querySelectorAll('.ec-rating-tile[data-eid="' + eid + '"]').forEach(function (t) { t.classList.remove('ec-sel'); });
    var tile = document.querySelector('.ec-rating-tile[data-eid="' + eid + '"][data-score="' + score + '"]');
    if (tile) tile.classList.add('ec-sel');
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + eid + '"]');
    if (lbl) lbl.textContent = LABELS[score] || '';
  }

  function clearTileSelection(eid) {
    document.querySelectorAll('.ec-rating-tile[data-eid="' + eid + '"]').forEach(function (t) { t.classList.remove('ec-sel'); });
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + eid + '"]');
    if (lbl) lbl.textContent = ' ';
  }

  function submitRating(eid, score) {
    fetch('/api/entries/' + eid + '/rate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ score: score, source: window.__ecSource })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { window.showToast(data.error, 'error'); return; }
      lockRatingPanel(eid, score);
      var avgSpan = document.querySelector('.ec-tab-btn.ec-rat[data-eid="' + eid + '"] span');
      if (avgSpan) avgSpan.textContent = parseFloat(data.ratingAvg).toFixed(1);
      window.showToast('Rating submitted.', 'success');

      var rlist = document.querySelector('.ec-rlist[data-eid="' + eid + '"]');
      if (rlist) {
        var empty = rlist.querySelector('.ec-rlist-empty');
        if (empty) empty.remove();
        var username = rlist.dataset.curUsername || '';
        var avatar   = rlist.dataset.curAvatar   || '';
        var dn       = rlist.dataset.curDisplayname || ('@' + username);
        if (username) {
          var av = avatar
            ? '<img src="' + ecEsc(avatar) + '" alt="" class="w-full h-full object-cover">'
            : '<iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>';
          var _now = new Date();
          var _ts = _now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
            + ' – ' + _now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
          var pfp = '<a href="/' + ecEsc(username) + '" class="flex flex-col gap-2 bg-white/4 rounded-md p-3 min-w-0 hover:bg-white/7 transition-colors">'
            + '<div class="flex items-center gap-2 min-w-0">'
            + '<div class="shrink-0 w-8 h-8 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center">' + av + '</div>'
            + '<div class="flex-1 min-w-0">'
            + '<p class="text-xs font-semibold text-white/80 truncate">' + ecEsc(dn) + '</p>'
            + '<p class="text-xs text-white/35 truncate">@' + ecEsc(username) + '</p>'
            + '</div></div>'
            + '<p class="text-xs text-white/25">' + _ts + '</p>'
            + '</a>';

          var existing = rlist.querySelector('.ec-rscore-group[data-score="' + score + '"]');
          if (existing) {
            var grid = existing.querySelector('.ec-rscore-grid');
            var visibleCount = grid.querySelectorAll('.ec-rcard:not(.hidden)').length;
            if (visibleCount >= 9) {
              var hiddenPfp = pfp.replace('class="ec-rcard ', 'class="ec-rcard hidden ');
              grid.insertAdjacentHTML('afterbegin', hiddenPfp);
              var smBtn = existing.querySelector('.ec-rshow-more');
              if (smBtn) {
                var hiddenNow = grid.querySelectorAll('.ec-rcard.hidden').length;
                smBtn.textContent = 'Show ' + hiddenNow + ' more';
              } else {
                grid.insertAdjacentHTML('afterend', '<button type="button" class="ec-rshow-more mt-2 w-full py-2 text-xs text-white/40 hover:text-white/70 transition-colors cursor-pointer" data-shown="9" data-batch="6">Show 1 more</button>');
              }
            } else {
              grid.insertAdjacentHTML('afterbegin', pfp);
            }
            var countEl = existing.querySelector('.ec-rscore-count');
            if (countEl) {
              var n = (parseInt(countEl.textContent) || 0) + 1;
              countEl.textContent = n + ' ' + (n === 1 ? 'rating' : 'ratings');
            }
          } else {
            var groupHtml = '<div class="ec-rscore-group px-3 py-3 border-t border-white/6" data-score="' + score + '">'
              + '<div class="flex items-center gap-2 mb-2.5 flex-wrap">'
              + '<span class="text-xl font-bold text-amber-400">' + score + '</span>'
              + '<span class="text-white/20">·</span>'
              + '<span class="text-sm">' + (EMOJIS[score] || '') + (EMOJIS[score] || '') + (EMOJIS[score] || '') + '</span>'
              + '<span class="text-xs text-white/50">' + (SCORE_TEXT[score] || '') + '</span>'
              + '<span class="text-white/20">·</span>'
              + '<span class="ec-rscore-count text-xs text-white/30">1 rating</span>'
              + '</div>'
              + '<div class="ec-rscore-grid grid grid-cols-3 gap-2">' + pfp + '</div>'
              + '</div>';
            var inserted = false;
            var groups = rlist.querySelectorAll('.ec-rscore-group');
            for (var i = 0; i < groups.length; i++) {
              if (parseInt(groups[i].dataset.score) < score) {
                groups[i].insertAdjacentHTML('beforebegin', groupHtml);
                inserted = true;
                break;
              }
            }
            if (!inserted) rlist.insertAdjacentHTML('beforeend', groupHtml);
          }
        }
      }
    })
    .catch(function () { window.showToast('Something went wrong.', 'error'); });
  }

  document.addEventListener('click', function (e) {
    var rfollowBtn = e.target.closest('.ec-rfollow-btn');
    if (rfollowBtn) {
      e.preventDefault();
      e.stopPropagation();
      var uname = rfollowBtn.dataset.username;
      var following = rfollowBtn.dataset.following === 'true';
      var url = following ? '/unfollow/' + uname : '/follow/' + uname;
      fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
          var nowFollowing = !following;
          rfollowBtn.dataset.following = nowFollowing ? 'true' : 'false';
          rfollowBtn.className = 'ec-rfollow-btn shrink-0 w-8 h-8 flex items-center justify-center rounded-md transition-colors cursor-pointer '
            + (nowFollowing ? 'text-white hover:text-red-400' : 'text-white hover:text-charm-400');
          var icon = rfollowBtn.querySelector('iconify-icon');
          if (icon) icon.setAttribute('icon', nowFollowing ? 'boxicons:user-check' : 'boxicons:user-plus');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); });
      return;
    }

    var showMoreBtn = e.target.closest('.ec-rshow-more');
    if (showMoreBtn) {
      var grid = showMoreBtn.previousElementSibling;
      var hiddenCards = Array.from(grid.querySelectorAll('.ec-rcard.hidden'));
      var batch = parseInt(showMoreBtn.dataset.batch, 10) || 6;
      hiddenCards.slice(0, batch).forEach(function (c) { c.classList.remove('hidden'); });
      var remaining = hiddenCards.length - batch;
      if (remaining <= 0) {
        showMoreBtn.remove();
      } else {
        showMoreBtn.textContent = 'Show ' + remaining + ' more';
      }
      return;
    }

    // Close all more menus when clicking outside
    if (!e.target.closest('.ec-more-btn') && !e.target.closest('.ec-more-menu')) {
      document.querySelectorAll('.ec-more-menu').forEach(function (m) { m.classList.add('hidden'); });
    }

    var shareBtn = e.target.closest('.ec-share-btn');
    if (shareBtn) {
      e.stopPropagation();
      var eid = shareBtn.dataset.eid;
      var url = window.location.origin + '/s/' + eid;
      if (navigator.share) {
        navigator.share({ url: url }).catch(function () {});
      } else {
        navigator.clipboard.writeText(url).then(function () {
          if (window.showToast) window.showToast('Link copied!', 'success');
        }).catch(function () {
          if (window.showToast) window.showToast('Could not copy link.', 'error');
        });
      }
      return;
    }

    var reportBtn = e.target.closest('.ec-more-report');
    if (reportBtn) {
      document.querySelectorAll('.ec-more-menu').forEach(function (m) { m.classList.add('hidden'); });
      var eid = reportBtn.dataset.eid;
      fetch('/api/entries/' + eid + '/report', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.ok) {
            if (window.showToast) window.showToast('Report submitted.', 'success');
          } else {
            if (window.showToast) window.showToast(data.error || 'Something went wrong.', 'error');
          }
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); });
      return;
    }

    var blockBtn = e.target.closest('.ec-more-block');
    if (blockBtn) {
      document.querySelectorAll('.ec-more-menu').forEach(function (m) { m.classList.add('hidden'); });
      if (window.showToast) window.showToast('User blocked.', 'success');
      return;
    }

    var notIntBtn = e.target.closest('.ec-more-notinterested');
    if (notIntBtn) {
      document.querySelectorAll('.ec-more-menu').forEach(function (m) { m.classList.add('hidden'); });
      var card = notIntBtn.closest('[data-ec-nav], [id^="ec-"]');
      if (card) card.remove();
      return;
    }

    var navCard = e.target.closest('[data-ec-nav]');
    if (navCard && !e.target.closest('button') && !e.target.closest('a')) {
      window.location.href = navCard.dataset.ecNav;
      return;
    }

    var followBtn = e.target.closest('.ec-follow');
    if (followBtn) {
      var following = followBtn.dataset.following === 'true';
      var uname = followBtn.dataset.username;
      followBtn.disabled = true;
      fetch((following ? '/unfollow/' : '/follow/') + uname, {
        method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var nowFollowing = data.following;
        followBtn.dataset.following = nowFollowing ? 'true' : 'false';
        followBtn.textContent = nowFollowing ? 'Following' : 'Follow';
        followBtn.className = 'ec-follow text-xs font-semibold rounded-md px-2.5 py-1 transition-colors cursor-pointer ' +
          (nowFollowing
            ? 'border border-white/30 text-white/50 hover:bg-white/8'
            : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { followBtn.disabled = false; });
      return;
    }

    var pinBtn = e.target.closest('.ec-pin-btn');
    if (pinBtn) {
      var eid    = pinBtn.dataset.eid;
      var pinned = pinBtn.dataset.pinned === 'true';
      pinBtn.disabled = true;
      fetch('/api/entries/' + eid + '/pin', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) { if (window.showToast) window.showToast(data.error || 'Something went wrong.', 'error'); return; }
          var nowPinned = data.pinned;

          // Update the clicked button
          pinBtn.dataset.pinned = nowPinned ? 'true' : 'false';
          pinBtn.title = nowPinned ? 'Unpin from profile' : 'Pin to profile';
          pinBtn.className = 'ec-pin-btn w-9 h-9 flex items-center justify-center rounded-md transition-colors cursor-pointer '
            + (nowPinned ? 'text-charm-400' : 'text-white/35 hover:bg-white/8 hover:text-white');
          var icon = pinBtn.querySelector('iconify-icon');
          if (icon) icon.setAttribute('icon', nowPinned ? 'boxicons:pin-alt-filled' : 'boxicons:pin-alt');

          // Update badge on this card
          var card = document.getElementById('ec-' + eid);
          if (card) {
            var badge = card.querySelector('.ec-pin-badge');
            if (nowPinned && !badge) {
              var newBadge = document.createElement('div');
              newBadge.className = 'ec-pin-badge self-start flex items-center gap-1 ml-3 mt-2.5 px-2 py-0.5 rounded-md bg-charm-500/15 border border-charm-500/25';
              newBadge.innerHTML = '<iconify-icon icon="boxicons:pin-alt-filled" width="11" class="text-charm-400"></iconify-icon><span class="text-xs font-semibold text-charm-400">Pinned</span>';
              card.insertBefore(newBadge, card.firstChild);
            } else if (!nowPinned && badge) {
              badge.remove();
            }

            // Move pinned card to top of entries grid
            if (nowPinned) {
              var grid = document.getElementById('entries-grid');
              if (grid && card.parentElement === grid) {
                grid.insertBefore(card, grid.firstChild);
              }
            }
          }

          // Reset any previously pinned card
          document.querySelectorAll('.ec-pin-btn[data-pinned="true"]').forEach(function (btn) {
            if (btn === pinBtn) return;
            btn.dataset.pinned = 'false';
            btn.title = 'Pin to profile';
            btn.className = 'ec-pin-btn w-9 h-9 flex items-center justify-center rounded-md transition-colors cursor-pointer text-white/35 hover:bg-white/8 hover:text-white';
            var i = btn.querySelector('iconify-icon');
            if (i) i.setAttribute('icon', 'boxicons:pin-alt');
            var c = document.getElementById('ec-' + btn.dataset.eid);
            if (c) {
              var b = c.querySelector('.ec-pin-badge');
              if (b) b.remove();
            }
          });

          if (window.showToast) window.showToast(nowPinned ? 'Pinned to your profile.' : 'Unpinned from your profile.', 'success');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
        .finally(function () { pinBtn.disabled = false; });
      return;
    }

    var bookmarkBtn = e.target.closest('.ec-bookmark-btn');
    if (bookmarkBtn) {
      var eid = bookmarkBtn.dataset.eid;
      bookmarkBtn.disabled = true;
      fetch('/api/entries/' + eid + '/bookmark', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ source: window.__ecSource }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
          var on = data.bookmarked;
          bookmarkBtn.dataset.bookmarked = on ? 'true' : 'false';
          bookmarkBtn.title = on ? 'Remove bookmark' : 'Bookmark';
          bookmarkBtn.className = 'ec-bookmark-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors cursor-pointer '
            + (on ? 'text-charm-400' : 'text-white/35 hover:bg-white/8 hover:text-white');
          var icon = bookmarkBtn.querySelector('iconify-icon');
          if (icon) icon.setAttribute('icon', on ? 'boxicons:bookmark-filled' : 'boxicons:bookmark');
          var countEl = bookmarkBtn.querySelector('span');
          if (countEl) countEl.textContent = Math.max(0, (parseInt(countEl.textContent, 10) || 0) + (on ? 1 : -1));
          if (window.showToast) window.showToast(on ? 'Bookmarked.' : 'Bookmark removed.', 'success');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
        .finally(function () { bookmarkBtn.disabled = false; });
      return;
    }

    var takeOnBtn = e.target.closest('.ec-take-on');
    if (takeOnBtn) {
      window.location.href = '/submit?takeOnTargetId=' + takeOnBtn.dataset.eid;
      return;
    }

    var btn = e.target.closest('.ec-tab-btn');
    if (btn) {
      var card = getCard(btn.dataset.eid);
      if (btn.dataset.panel === 'comments' && card && card.dataset.ecNav) {
        window.location.href = '/entry/' + btn.dataset.eid;
        return;
      }
      setTab(btn.dataset.eid, btn.dataset.panel);
      return;
    }

    var tile = e.target.closest('.ec-rating-tile');
    if (tile) {
      var eid   = tile.dataset.eid;
      var score = parseInt(tile.dataset.score, 10);

      if (_pendingToasts[eid]) {
        _pendingToasts[eid].dispatchEvent(new Event('ec-dismiss'));
      }

      selectTile(eid, score);

      if (localStorage.getItem('ec-skip-rating-confirm') === '1') {
        burstConfetti(score);
        submitRating(eid, score);
        return;
      }

      var t = window.showToast(
        'Your rating can\'t be changed after you confirm.',
        'info', 0,
        [
          {
            label: 'Cancel',
            cls: 'bg-white/8 text-white/50 hover:bg-white/12 hover:text-white/80',
            fn: function () { delete _pendingToasts[eid]; clearTileSelection(eid); }
          },
          {
            label: 'Confirm rating',
            cls: 'bg-amber-500 text-black hover:bg-amber-400',
            fn: function () {
              if (t.querySelector('.ec-skip-cb') && t.querySelector('.ec-skip-cb').checked) {
                localStorage.setItem('ec-skip-rating-confirm', '1');
              }
              delete _pendingToasts[eid];
              burstConfetti(score);
              submitRating(eid, score);
            }
          }
        ]
      );

      var skipRow = document.createElement('div');
      skipRow.className = 'px-3 pb-1';
      skipRow.innerHTML = '<label class="flex items-center gap-2 text-xs text-white/35 cursor-pointer select-none"><input type="checkbox" class="ec-skip-cb cursor-pointer accent-amber-500"> Don\'t show again</label>';
      t.insertBefore(skipRow, t.lastElementChild);

      _pendingToasts[eid] = t;
      t.addEventListener('ec-dismiss', function () {
        t.dispatchEvent(new Event('animationend'));
        if (t.parentNode) t.parentNode.removeChild(t);
        delete _pendingToasts[eid];
        clearTileSelection(eid);
      });
    }
  });

  document.addEventListener('mouseover', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile || tile.classList.contains('ec-locked')) return;
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + tile.dataset.eid + '"]');
    if (lbl) lbl.textContent = LABELS[parseInt(tile.dataset.score, 10)] || '';
  });

  document.addEventListener('mouseout', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile) return;
    var eid  = tile.dataset.eid;
    var sel  = document.querySelector('.ec-rating-tile.ec-sel[data-eid="' + eid + '"]');
    var lbl  = document.querySelector('.ec-rlabel[data-eid="' + eid + '"]');
    if (lbl) lbl.textContent = sel ? (LABELS[parseInt(sel.dataset.score, 10)] || ' ') : ' ';
  });

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.ec-panel[data-panel="rating"][data-user-rating]').forEach(function (panel) {
      lockRatingPanel(panel.dataset.eid, parseInt(panel.dataset.userRating, 10));
    });
    // Auto-open comments panel on the full entry page (not feed cards)
    document.querySelectorAll('.ec-panel[data-panel="comments"]').forEach(function (panel) {
      var eid = panel.dataset.eid;
      if (panel.closest('[data-ec-nav]')) return;
      setTab(eid, 'comments');
    });
  });

  function ecTsAgo(ms) {
    var s = Math.floor(ms / 1000);
    if (s < 60)  return 'Just now';
    var m = Math.floor(s / 60);
    if (m < 60)  return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24)  return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7)   return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52)  return w + 'w';
    return Math.floor(d / 365) + 'y';
  }
  setInterval(function () {
    var now = Date.now();
    document.querySelectorAll('[data-ts]').forEach(function (el) {
      el.textContent = ecTsAgo(Math.max(0, now - new Date(el.dataset.ts).getTime()));
    });
  }, 30000);
}());
</script>
