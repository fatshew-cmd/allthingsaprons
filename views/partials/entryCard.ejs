<%
  function _ecDate(d) {
    var now = new Date();
    var dt  = new Date(d);
    var timeStr = dt.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    if (now.toDateString() === dt.toDateString()) return 'Today · ' + timeStr;
    return dt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' · ' + timeStr;
  }
  var _eid      = entry._id.toString();
  var _isOwner  = currentUserId && owner && owner._id.toString() === currentUserId;
  var _avg      = entry.ratingCount > 0 ? entry.ratingAvg.toFixed(1) : null;
%>

<% if (!locals.__ecAssets) { locals.__ecAssets = true; %>
<style>
  .ec-tab-btn.ec-on        { background: rgba(255,255,255,0.09); color: #fff; }
  .ec-tab-btn.ec-on.ec-rat { background: rgba(245,158,11,0.18);  color: #fcd34d; }
  .ec-rating-tile:hover    { background: rgba(245,158,11,0.22); color: #fcd34d; }
  .ec-rating-tile.ec-sel   { background: #f59e0b; color: #000; }
  .ec-rating-tile.ec-locked { opacity: 0.18; cursor: not-allowed; pointer-events: none; }
  @keyframes _ec-burst {
    0%   { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
    40%  { transform: translate(calc(-50% + var(--mx)), calc(-50% + var(--ty) * 0.48)) scale(0.9); opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.45); opacity: 0; }
  }
</style>
<% } %>

<div class="flex flex-col overflow-hidden border-b border-white/10<% if (!locals.mediaFull) { %> cursor-pointer<% } %>" id="ec-<%= _eid %>"<% if (!locals.mediaFull) { %> data-ec-nav="/entry/<%= _eid %>"<% } %>>

  <!-- Media -->
  <% if (locals.mediaFull) { %>
  <div class="relative bg-shark-950 overflow-hidden">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" controls class="w-full max-h-[70vh] object-contain"></video>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full max-h-[70vh] object-contain">
    <% } %>
    <% if (locals.contestInfo) { %>
    <a href="/contest/<%= contestInfo.contestId %>" class="absolute top-3 left-3 flex items-center gap-1 px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wide backdrop-blur-sm <%= contestInfo.status === 'active' ? 'bg-green-500/80 text-white' : 'bg-amber-500/80 text-black' %>">
      <iconify-icon icon="boxicons:git-compare" width="11"></iconify-icon>
      <span><%= contestInfo.status === 'active' ? 'H2H Live' : 'H2H' %></span>
    </a>
    <% } %>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-3 left-3 bg-violet-600 text-white text-xs font-bold px-2 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>
  <% } else { %>
  <div class="relative bg-shark-950 overflow-hidden aspect-video">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <iconify-icon icon="bx:play-circle" width="52" class="text-white/80 drop-shadow-lg"></iconify-icon>
    </div>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full h-full object-cover">
    <% } %>
    <a href="/entry/<%= _eid %>" class="absolute inset-0 z-0" aria-label="View entry"></a>
    <% if (locals.contestInfo) { %>
    <a href="/contest/<%= contestInfo.contestId %>" onclick="event.stopPropagation()" class="absolute top-2 left-2 z-10 flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wide backdrop-blur-sm <%= contestInfo.status === 'active' ? 'bg-green-500/80 text-white' : 'bg-amber-500/80 text-black' %>">
      <iconify-icon icon="boxicons:git-compare" width="10"></iconify-icon>
      <span><%= contestInfo.status === 'active' ? 'H2H Live' : 'H2H' %></span>
    </a>
    <% } %>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-2 left-2 z-10 bg-violet-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>
  <% } %>

  <!-- User row -->
  <div class="px-3 pt-3 flex items-center gap-3">
    <!-- Avatar + names -->
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <a href="/<%= owner.username?.value %>" class="shrink-0 w-9 h-9 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
        <% if (owner.avatar?.value) { %>
        <img src="<%= owner.avatar.value %>" alt="<%= owner.username?.value %>" class="w-full h-full object-cover">
        <% } else { %>
        <iconify-icon icon="bx:user" width="18" class="text-white/30"></iconify-icon>
        <% } %>
      </a>
      <div class="min-w-0">
        <a href="/<%= owner.username?.value %>" class="block text-sm font-semibold text-white truncate leading-tight hover:text-charm-300 transition-colors">
          <%= owner.displayName?.value || ('@' + owner.username?.value) %>
        </a>
        <a href="/<%= owner.username?.value %>" class="block text-xs text-white/40 truncate leading-tight mt-0.5">@<%= owner.username?.value %></a>
      </div>
    </div>
    <!-- Follow + date/views -->
    <div class="flex items-center gap-2.5 shrink-0">
      <% if (!_isOwner && isFollowing) { %>
      <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-white/30 text-white/50 hover:bg-white/8 transition-colors cursor-pointer" data-username="<%= owner.username?.value %>" data-following="true">Following</button>
      <% } else if (!_isOwner) { %>
      <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-charm-500/40 text-charm-400 hover:bg-charm-500/10 transition-colors cursor-pointer" data-username="<%= owner.username?.value %>" data-following="false">Follow</button>
      <% } %>
      <div class="text-right">
        <span class="block text-xs text-white/40 leading-tight"><%= _ecDate(entry.createdAt) %></span>
        <span class="block text-xs text-white/25 leading-tight mt-0.5"><%= (entry.viewCount || 0).toLocaleString() %> views</span>
      </div>
    </div>
  </div>

  <!-- Title + Caption -->
  <% if (entry.title) { %>
  <p class="px-3 pt-2.5 text-base font-bold text-white leading-snug"><%= entry.title %></p>
  <% } %>
  <% if (entry.caption) { %>
  <p class="px-3 <%= entry.title ? 'pt-1' : 'pt-2.5' %> text-sm leading-relaxed text-white/55"><%= entry.caption %></p>
  <% } %>

  <!-- Tags -->
  <% if (entry.tags && entry.tags.length > 0) { %>
  <div class="px-3 pt-2 flex flex-wrap gap-x-2 gap-y-0.5">
    <% entry.tags.forEach(function(t) { %><span class="text-xs text-charm-400/50">#<%= t %></span><% }); %>
  </div>
  <% } %>

  <!-- Nominees -->
  <% if (locals.nominees && locals.nominees.length) { %>
  <div class="px-3 pt-3 flex flex-col gap-1.5">
    <p class="text-xs font-semibold text-white/35 uppercase tracking-wide">Nominated</p>
    <div class="flex flex-wrap gap-1.5">
      <% locals.nominees.forEach(function(n) {
           var isVoid    = n.status === 'void';
           var isPending = n.status === 'pending';
           var showVotes = !isVoid && !isPending && n.contestStatus === 'active';
           var Tag       = isVoid ? 'span' : 'a';
      %>
      <<%= Tag %>
        <% if (!isVoid) { %>href="/contest/<%= n.contestId %>"<% } %>
        class="inline-flex items-center gap-1.5 rounded-md pl-1.5 py-1 transition-colors
          <% if (isVoid) { %>opacity-35 cursor-default pr-2.5 bg-white/5 border border-white/10
          <% } else if (isPending) { %>pr-2 bg-charm-600/10 hover:bg-charm-600/18 border border-charm-600/30 hover:border-charm-600/50 cursor-pointer
          <% } else { %>pr-2.5 bg-charm-600/10 hover:bg-charm-600/18 border border-charm-600/30 hover:border-charm-600/50 cursor-pointer<% } %>">
        <% if (n.avatar) { %>
        <img src="<%= n.avatar %>" alt="" class="w-5 h-5 rounded object-cover bg-shark-800 shrink-0">
        <% } else { %>
        <span class="w-5 h-5 rounded bg-shark-700 flex items-center justify-center shrink-0">
          <iconify-icon icon="bx:user" width="12" class="text-white/30"></iconify-icon>
        </span>
        <% } %>
        <span class="text-xs font-medium <%= isVoid ? 'text-white/40' : 'text-white/70' %>">@<%= n.username %></span>
        <% if (isVoid) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="text-xs font-semibold text-white">Timed out</span>
        <% } else if (isPending) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="text-xs font-semibold text-amber-400/70">Pending</span>
        <% } else if (showVotes) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="inline-flex items-center gap-1">
          <span class="text-xs font-bold text-charm-400"><%= n.voteCountMine %></span>
          <span class="text-white/20 text-xs">·</span>
          <span class="text-xs font-bold text-white/35"><%= n.voteCountNominee %></span>
        </span>
        <% } else if (n.status === 'accepted') { %>
        <iconify-icon icon="boxicons:check-circle" width="12" class="text-charm-400 shrink-0"></iconify-icon>
        <% } %>
      </<%= Tag %>>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- CTAs -->
  <div class="px-2 pt-3 pb-1.5 flex items-center gap-0.5">
    <button class="ec-tab-btn ec-rat flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-amber-300 cursor-pointer" data-eid="<%= _eid %>" data-panel="rating">
      <iconify-icon icon="boxicons:star-filled" width="14" class="text-amber-400 shrink-0"></iconify-icon>
      <span class="text-sm font-semibold text-amber-300 whitespace-nowrap"><% if (_avg) { %><%= _avg %><% } else { %>No rating yet<% } %></span>
    </button>
    <button class="ec-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-white/50 hover:text-white cursor-pointer" data-eid="<%= _eid %>" data-panel="comments">
      <iconify-icon icon="bx:comment" width="16" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.commentCount || 0 %></span>
    </button>
    <button class="ec-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-white/50 hover:text-white cursor-pointer" data-eid="<%= _eid %>" data-panel="likes">
      <iconify-icon icon="bx:heart" width="16" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.likeCount || 0 %></span>
    </button>
    <div class="flex-1"></div>
    <% if (_isOwner && !locals.mediaFull) { %>
    <a href="/entry/<%= _eid %>/edit" class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors">
      <iconify-icon icon="bx:pencil" width="17"></iconify-icon>
    </a>
    <% } %>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="bx:bookmark" width="18"></iconify-icon>
    </button>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="bx:share-alt" width="18"></iconify-icon>
    </button>
  </div>

  <!-- Rating panel -->
  <div class="ec-panel hidden border-t border-white/8 px-3 py-4" data-eid="<%= _eid %>" data-panel="rating"<% if (locals.userRating) { %> data-user-rating="<%= locals.userRating %>"<% } %>>
    <% if (_isOwner) { %>
    <div class="flex flex-col items-center gap-2 text-center py-2">
      <iconify-icon icon="bx:lock" width="22" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">You can't rate your own entry</p>
    </div>
    <% } else { %>
    <p class="text-xs text-white/30 text-center mb-3 tracking-wide uppercase">Rate this entry</p>
    <div class="flex items-center gap-1">
      <% for (var _i = 1; _i <= 10; _i++) { %>
      <button class="ec-rating-tile flex-1 h-9 rounded-md text-sm font-bold transition-all cursor-pointer bg-shark-800 text-white/45" data-score="<%= _i %>" data-eid="<%= _eid %>"><%= _i %></button>
      <% } %>
    </div>
    <div class="ec-rlabel mt-2 text-center text-sm text-amber-400/70 min-h-4" data-eid="<%= _eid %>"></div>
    <% } %>
  </div>

  <!-- Comments panel -->
  <div class="ec-panel hidden border-t border-white/8" data-eid="<%= _eid %>" data-panel="comments">
  <% if (locals.mediaFull && Array.isArray(locals.comments)) { %>
  <%
  function ecLinkifyBody(body) {
    var esc = String(body).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return esc.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }
  %>

  <!-- Compose box -->
  <div class="px-3 pt-3 pb-2.5 border-b border-white/8 ec-compose-box"
    data-eid="<%= _eid %>"
    data-is-owner="<%= _isOwner ? '1' : '0' %>"
    data-cur-username="<%= locals.currentUser ? locals.currentUser.username : '' %>"
    data-cur-avatar="<%= (locals.currentUser && locals.currentUser.avatar) ? locals.currentUser.avatar : '' %>">
    <div class="flex gap-2.5">
      <a href="<%= locals.currentUser ? '/' + locals.currentUser.username : '#' %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
        <% if (locals.currentUser && locals.currentUser.avatar) { %>
        <img src="<%= locals.currentUser.avatar %>" class="w-full h-full object-cover">
        <% } else { %>
        <iconify-icon icon="bx:user" width="14" class="text-white/30"></iconify-icon>
        <% } %>
      </a>
      <div class="flex-1 flex flex-col gap-1.5">
        <textarea class="ec-comment-ta w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white placeholder-white/25 resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2" placeholder="Add a comment…" data-eid="<%= _eid %>"></textarea>
        <div class="flex items-center justify-between">
          <span class="ec-comment-count text-xs text-white/25" data-eid="<%= _eid %>">0/280</span>
          <div class="flex items-center gap-2">
            <button type="button" class="ec-comment-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer" data-eid="<%= _eid %>">Cancel</button>
            <button type="button" class="ec-comment-submit h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-eid="<%= _eid %>">Post</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Comment list -->
  <div class="ec-clist flex flex-col" data-eid="<%= _eid %>">
    <% if (!locals.comments.length) { %>
    <p class="ec-clist-empty px-3 py-4 text-sm text-white/25">No comments yet.</p>
    <% } %>

    <% locals.comments.forEach(function(comment) {
      var cid          = comment._id.toString();
      var cUser        = comment.userId;
      var isOwnComment = currentUserId && cUser._id.toString() === currentUserId;
    %>
    <div class="ec-citem px-3 py-3 border-t border-white/6" data-cid="<%= cid %>">
      <div class="flex gap-2.5">
        <a href="/<%= cUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
          <% if (cUser.avatar?.value) { %><img src="<%= cUser.avatar.value %>" class="w-full h-full object-cover">
          <% } else { %><iconify-icon icon="bx:user" width="14" class="text-white/30"></iconify-icon><% } %>
        </a>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <a href="/<%= cUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= cUser.displayName?.value || ('@' + cUser.username?.value) %></a>
            <span class="text-xs text-white/25"><%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
            <% if (comment.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
          </div>
          <p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- ecLinkifyBody(comment.body) %></p>
          <div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
            <textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2"><%= comment.body %></textarea>
            <div class="flex items-center justify-end gap-2">
              <button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
              <button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Save</button>
            </div>
          </div>
          <div class="flex items-center gap-3 mt-1.5">
            <button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= cid %>">Reply</button>
            <% if (isOwnComment) { %>
            <button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= cid %>">Edit</button>
            <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Delete</button>
            <% } else if (_isOwner) { %>
            <button type="button" class="ec-chide text-xs text-white/30 hover:text-amber-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Hide</button>
            <button type="button" class="ec-creport text-xs text-white/20 hover:text-white/50 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Report</button>
            <% } else { %>
            <button type="button" class="ec-creport text-xs text-white/20 hover:text-white/50 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Report</button>
            <% } %>
          </div>
          <div class="ec-reply-form hidden mt-2.5 flex gap-2" data-parent-id="<%= cid %>">
            <div class="w-px bg-white/10 self-stretch shrink-0 ml-0.5"></div>
            <div class="flex-1 flex flex-col gap-1">
              <textarea class="ec-reply-ta w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white placeholder-white/25 resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2" placeholder="Reply…"></textarea>
              <div class="flex justify-end gap-2">
                <button type="button" class="ec-reply-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
                <button type="button" class="ec-reply-submit h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="<%= cid %>" data-eid="<%= _eid %>">Reply</button>
              </div>
            </div>
          </div>
          <% if (comment.replies && comment.replies.length) { %>
          <div class="ec-replies mt-3 flex flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="<%= cid %>">
            <% comment.replies.forEach(function(reply) {
              var rid       = reply._id.toString();
              var rUser     = reply.userId;
              var isOwnReply = currentUserId && rUser._id.toString() === currentUserId;
            %>
            <div class="ec-citem" data-cid="<%= rid %>">
              <div class="flex gap-2">
                <a href="/<%= rUser.username?.value %>" class="shrink-0 w-6 h-6 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
                  <% if (rUser.avatar?.value) { %><img src="<%= rUser.avatar.value %>" class="w-full h-full object-cover">
                  <% } else { %><iconify-icon icon="bx:user" width="12" class="text-white/30"></iconify-icon><% } %>
                </a>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline gap-1.5 flex-wrap">
                    <a href="/<%= rUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= rUser.displayName?.value || ('@' + rUser.username?.value) %></a>
                    <span class="text-xs text-white/25"><%= new Date(reply.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                    <% if (reply.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
                  </div>
                  <p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- ecLinkifyBody(reply.body) %></p>
                  <div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
                    <textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2"><%= reply.body %></textarea>
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
                      <button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Save</button>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 mt-1.5">
                    <% if (isOwnReply) { %>
                    <button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= rid %>">Edit</button>
                    <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Delete</button>
                    <% } else { %>
                    <button type="button" class="ec-creport text-xs text-white/20 hover:text-white/50 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Report</button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div class="ec-replies hidden mt-3 flex flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="<%= cid %>"></div>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <% if (_isOwner && locals.hiddenComments && locals.hiddenComments.length) { %>
  <div class="px-3 py-3 border-t border-white/8">
    <p class="text-xs font-semibold text-white/30 uppercase tracking-wide mb-3">Hidden (<%= locals.hiddenComments.length %>)</p>
    <div class="flex flex-col gap-4">
      <% locals.hiddenComments.forEach(function(hc) {
        var hcid   = hc._id.toString();
        var hcUser = hc.userId;
      %>
      <div class="ec-citem opacity-45" data-cid="<%= hcid %>">
        <div class="flex gap-2.5">
          <a href="/<%= hcUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
            <% if (hcUser.avatar?.value) { %><img src="<%= hcUser.avatar.value %>" class="w-full h-full object-cover">
            <% } else { %><iconify-icon icon="bx:user" width="14" class="text-white/30"></iconify-icon><% } %>
          </a>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-1.5 flex-wrap">
              <a href="/<%= hcUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= hcUser.displayName?.value || ('@' + hcUser.username?.value) %></a>
              <span class="text-xs text-white/25"><%= new Date(hc.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
            </div>
            <p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- ecLinkifyBody(hc.body) %></p>
            <div class="flex items-center gap-3 mt-1.5">
              <button type="button" class="ec-chide text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= hcid %>" data-eid="<%= _eid %>">Unhide</button>
              <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= hcid %>" data-eid="<%= _eid %>">Delete</button>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <% } else { %>
  <div class="flex flex-col items-center gap-2 text-center px-3 py-6">
    <iconify-icon icon="bx:comment-dots" width="28" class="text-white/15"></iconify-icon>
    <p class="text-xs text-white/30">No comments yet</p>
  </div>
  <% } %>
  </div>

  <!-- Likes panel -->
  <div class="ec-panel hidden border-t border-white/8 px-3 py-6" data-eid="<%= _eid %>" data-panel="likes">
    <% if (_isOwner) { %>
    <div class="flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="bx:lock" width="22" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">You can't like your own entry</p>
    </div>
    <% } else { %>
    <div class="flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="bx:heart" width="28" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">No likes yet</p>
    </div>
    <% } %>
  </div>

</div>

<% if (!locals.__ecScript) { locals.__ecScript = true; %>
<script>
(function () {
  var LABELS = ['','Chopped — What even is this? 🤮','An L — Not even trying 😑','Mid — It\'s just... there 😐','Basic — Standard, pretty boring 🥱','Mid — Just whatever 🫱','Decent — Not bad, actually kind of okay 😉','Fire — This is kind of hot 🔥','Banger — Goddayumm 😍','Ate — I\'m gagged 🌶️','God-tier — That should be illegal 😈'];
  var EMOJIS  = ['','🤮','😑','😐','🥱','🫱','😉','🔥','😍','🌶️','😈'];

  function getConfettiOverlay() {
    var overlay = document.getElementById('ec-confetti-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'ec-confetti-overlay';
      overlay.style.cssText = 'position:fixed;top:0;bottom:0;overflow:hidden;pointer-events:none;z-index:9999;';
      document.body.appendChild(overlay);
    }
    var main = document.querySelector('main');
    var rect = main ? main.getBoundingClientRect() : { left: 0, width: window.innerWidth };
    overlay.style.left  = rect.left + 'px';
    overlay.style.width = rect.width + 'px';
    return overlay;
  }

  function burstConfetti(score) {
    var emoji = EMOJIS[score];
    if (!emoji) return;
    var overlay = getConfettiOverlay();
    var ow = overlay.offsetWidth;
    var oh = overlay.offsetHeight;
    var count = 30;
    for (var i = 0; i < count; i++) {
      (function (idx) {
        var p = document.createElement('span');
        p.textContent = emoji;
        var cx = 40 + Math.random() * (ow - 80);
        p.style.cssText = 'position:absolute;left:' + cx + 'px;top:' + oh + 'px;pointer-events:none;font-size:3.5rem;line-height:1;will-change:transform,opacity;';
        var tx = (Math.random() - 0.5) * 220;
        var ty = -(320 + Math.random() * 260);
        var mx = tx + (Math.random() - 0.5) * 300;
        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--mx', mx + 'px');
        p.style.animation = '_ec-burst ' + (2.8 + Math.random() * 0.5) + 's ease-out forwards';
        p.style.animationDelay = (idx * 0.04 + Math.random() * 0.15) + 's';
        overlay.appendChild(p);
        p.addEventListener('animationend', function () { if (p.parentNode) p.parentNode.removeChild(p); }, { once: true });
      }(i));
    }
  }

  function getCard(eid) { return document.getElementById('ec-' + eid); }

  function setTab(eid, panel) {
    var card = getCard(eid);
    if (!card) return;
    var panels  = card.querySelectorAll('.ec-panel');
    var tabBtns = card.querySelectorAll('.ec-tab-btn');
    var target  = card.querySelector('.ec-panel[data-panel="' + panel + '"]');
    var isOpen  = target && !target.classList.contains('hidden');

    panels.forEach(function (p) { p.classList.add('hidden'); });
    tabBtns.forEach(function (b) { b.classList.remove('ec-on'); });

    if (!isOpen && target) {
      target.classList.remove('hidden');
      var btn = card.querySelector('.ec-tab-btn[data-panel="' + panel + '"]');
      if (btn) btn.classList.add('ec-on');
    }
  }

  var _pendingToasts = {};

  function lockRatingPanel(eid, confirmedScore) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) {
      if (parseInt(t.dataset.score, 10) !== confirmedScore) {
        t.classList.add('ec-locked');
      }
    });
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = LABELS[confirmedScore] || '';
  }

  function selectTile(eid, score) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) { t.classList.remove('ec-sel'); });
    var tile = card.querySelector('.ec-rating-tile[data-score="' + score + '"]');
    if (tile) tile.classList.add('ec-sel');
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = LABELS[score] || '';
  }

  function clearTileSelection(eid) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) { t.classList.remove('ec-sel'); });
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = '';
  }

  function submitRating(eid, score) {
    fetch('/api/entries/' + eid + '/rate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ score: score })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { window.showToast(data.error, 'error'); return; }
      lockRatingPanel(eid, score);
      var card = getCard(eid);
      if (card) {
        var avgSpan = card.querySelector('.ec-tab-btn.ec-rat span');
        if (avgSpan) avgSpan.textContent = parseFloat(data.ratingAvg).toFixed(1);
      }
      window.showToast('Rating submitted.', 'success');
    })
    .catch(function () { window.showToast('Something went wrong.', 'error'); });
  }

  document.addEventListener('click', function (e) {
    var navCard = e.target.closest('[data-ec-nav]');
    if (navCard && !e.target.closest('button') && !e.target.closest('a')) {
      window.location.href = navCard.dataset.ecNav;
      return;
    }

    var followBtn = e.target.closest('.ec-follow');
    if (followBtn) {
      var following = followBtn.dataset.following === 'true';
      var uname = followBtn.dataset.username;
      followBtn.disabled = true;
      fetch((following ? '/unfollow/' : '/follow/') + uname, {
        method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var nowFollowing = data.following;
        followBtn.dataset.following = nowFollowing ? 'true' : 'false';
        followBtn.textContent = nowFollowing ? 'Following' : 'Follow';
        followBtn.className = 'ec-follow text-xs font-semibold rounded-md px-2.5 py-1 transition-colors cursor-pointer ' +
          (nowFollowing
            ? 'border border-white/30 text-white/50 hover:bg-white/8'
            : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { followBtn.disabled = false; });
      return;
    }

    var btn = e.target.closest('.ec-tab-btn');
    if (btn) { setTab(btn.dataset.eid, btn.dataset.panel); return; }

    var tile = e.target.closest('.ec-rating-tile');
    if (tile) {
      var eid   = tile.dataset.eid;
      var score = parseInt(tile.dataset.score, 10);

      if (_pendingToasts[eid]) {
        _pendingToasts[eid].dispatchEvent(new Event('ec-dismiss'));
      }

      selectTile(eid, score);

      if (localStorage.getItem('ec-skip-rating-confirm') === '1') {
        burstConfetti(score);
        submitRating(eid, score);
        return;
      }

      var t = window.showToast(
        'Your rating can\'t be changed after you confirm.',
        'info', 0,
        [
          {
            label: 'Cancel',
            cls: 'bg-white/8 text-white/50 hover:bg-white/12 hover:text-white/80',
            fn: function () { delete _pendingToasts[eid]; clearTileSelection(eid); }
          },
          {
            label: 'Confirm rating',
            cls: 'bg-amber-500 text-black hover:bg-amber-400',
            fn: function () {
              if (t.querySelector('.ec-skip-cb') && t.querySelector('.ec-skip-cb').checked) {
                localStorage.setItem('ec-skip-rating-confirm', '1');
              }
              delete _pendingToasts[eid];
              burstConfetti(score);
              submitRating(eid, score);
            }
          }
        ]
      );

      var skipRow = document.createElement('div');
      skipRow.className = 'px-3 pb-1';
      skipRow.innerHTML = '<label class="flex items-center gap-2 text-xs text-white/35 cursor-pointer select-none"><input type="checkbox" class="ec-skip-cb cursor-pointer accent-amber-500"> Don\'t show again</label>';
      t.insertBefore(skipRow, t.lastElementChild);

      _pendingToasts[eid] = t;
      t.addEventListener('ec-dismiss', function () {
        t.dispatchEvent(new Event('animationend'));
        if (t.parentNode) t.parentNode.removeChild(t);
        delete _pendingToasts[eid];
        clearTileSelection(eid);
      });
    }
  });

  document.addEventListener('mouseover', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile || tile.classList.contains('ec-locked')) return;
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + tile.dataset.eid + '"]');
    if (lbl) lbl.textContent = LABELS[parseInt(tile.dataset.score, 10)] || '';
  });

  document.addEventListener('mouseout', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile) return;
    var eid  = tile.dataset.eid;
    var card = getCard(eid);
    if (!card) return;
    var sel = card.querySelector('.ec-rating-tile.ec-sel');
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = sel ? (LABELS[parseInt(sel.dataset.score, 10)] || '') : '';
  });

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.ec-panel[data-panel="rating"][data-user-rating]').forEach(function (panel) {
      lockRatingPanel(panel.dataset.eid, parseInt(panel.dataset.userRating, 10));
    });
    // Auto-open comments panel on the full entry page
    document.querySelectorAll('.ec-panel[data-panel="comments"]').forEach(function (panel) {
      var eid = panel.dataset.eid;
      if (panel.closest('[data-ec-nav]')) return; // feed card — leave collapsed
      setTab(eid, 'comments');
    });
  });
}());
</script>
<% } %>

<% if (locals.mediaFull && Array.isArray(locals.comments)) { %>
<script>
(function () {
  function ecEsc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function ecLinkify(esc) {
    return esc.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }

  function ecGetCompose(eid) {
    return document.querySelector('.ec-compose-box[data-eid="' + eid + '"]');
  }
  function ecUpdateCount(eid, delta) {
    var btn  = document.querySelector('.ec-tab-btn[data-panel="comments"][data-eid="' + eid + '"]');
    if (!btn) return;
    var span = btn.querySelector('span');
    var cur  = span ? (parseInt(span.textContent, 10) || 0) : 0;
    if (span) span.textContent = Math.max(0, cur + delta);
  }

  function ecBuildTopHtml(c, eid, isOwner) {
    var dn  = c.user.displayName || ('@' + c.user.username);
    var dt  = new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    var av  = c.user.avatar
      ? '<img src="' + ecEsc(c.user.avatar) + '" class="w-full h-full object-cover">'
      : '<iconify-icon icon="bx:user" width="14" class="text-white/30"></iconify-icon>';
    var act = '<button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Edit</button>'
      + '<button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Delete</button>';
    return '<div class="ec-citem px-3 py-3 border-t border-white/6" data-cid="' + c._id + '">'
      + '<div class="flex gap-2.5">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">' + av + '</a>'
      + '<div class="flex-1 min-w-0">'
      + '<div class="flex items-baseline gap-1.5 flex-wrap">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity">' + ecEsc(dn) + '</a>'
      + '<span class="text-xs text-white/25">' + dt + '</span>'
      + '</div>'
      + '<p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words">' + ecLinkify(ecEsc(c.body)) + '</p>'
      + '<div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">'
      + '<textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2">' + ecEsc(c.body) + '</textarea>'
      + '<div class="flex items-center justify-end gap-2">'
      + '<button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Save</button>'
      + '</div></div>'
      + '<div class="flex items-center gap-3 mt-1.5">'
      + '<button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Reply</button>'
      + act
      + '</div>'
      + '<div class="ec-reply-form hidden mt-2.5 flex gap-2" data-parent-id="' + c._id + '">'
      + '<div class="w-px bg-white/10 self-stretch shrink-0 ml-0.5"></div>'
      + '<div class="flex-1 flex flex-col gap-1">'
      + '<textarea class="ec-reply-ta w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white placeholder-white/25 resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2" placeholder="Reply…"></textarea>'
      + '<div class="flex justify-end gap-2">'
      + '<button type="button" class="ec-reply-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-reply-submit h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="' + c._id + '" data-eid="' + eid + '">Reply</button>'
      + '</div></div></div>'
      + '<div class="ec-replies hidden mt-3 flex flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="' + c._id + '"></div>'
      + '</div></div></div>';
  }

  function ecBuildReplyHtml(c, eid) {
    var dn = c.user.displayName || ('@' + c.user.username);
    var dt = new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    var av = c.user.avatar
      ? '<img src="' + ecEsc(c.user.avatar) + '" class="w-full h-full object-cover">'
      : '<iconify-icon icon="bx:user" width="12" class="text-white/30"></iconify-icon>';
    return '<div class="ec-citem" data-cid="' + c._id + '">'
      + '<div class="flex gap-2">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="shrink-0 w-6 h-6 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">' + av + '</a>'
      + '<div class="flex-1 min-w-0">'
      + '<div class="flex items-baseline gap-1.5 flex-wrap">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity">' + ecEsc(dn) + '</a>'
      + '<span class="text-xs text-white/25">' + dt + '</span>'
      + '</div>'
      + '<p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words">' + ecLinkify(ecEsc(c.body)) + '</p>'
      + '<div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">'
      + '<textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2">' + ecEsc(c.body) + '</textarea>'
      + '<div class="flex items-center justify-end gap-2">'
      + '<button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Save</button>'
      + '</div></div>'
      + '<div class="flex items-center gap-3 mt-1.5">'
      + '<button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Edit</button>'
      + '<button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Delete</button>'
      + '</div>'
      + '</div></div></div>';
  }

  // Post new top-level comment
  function ecPostComment(eid) {
    var compose = ecGetCompose(eid);
    if (!compose) return;
    var ta = compose.querySelector('.ec-comment-ta');
    if (!ta || ta.dataset.posting) return;
    var body = ta.value.trim();
    if (!body) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Comment cannot exceed 280 characters.', 'error');
      return;
    }
    var isOwner = compose.dataset.isOwner === '1';
    var btn = compose.querySelector('.ec-comment-submit');
    ta.dataset.posting = '1';
    if (btn) btn.disabled = true;
    fetch('/api/entries/' + eid + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var list  = document.querySelector('.ec-clist[data-eid="' + eid + '"]');
      var empty = list && list.querySelector('.ec-clist-empty');
      if (empty) empty.remove();
      if (list) list.insertAdjacentHTML('beforeend', ecBuildTopHtml(data, eid, isOwner));
      ta.value = '';
      var countEl = compose.querySelector('.ec-comment-count');
      if (countEl) countEl.textContent = '0/280';
      ecUpdateCount(eid, 1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete ta.dataset.posting; if (btn) btn.disabled = false; });
  }

  // Post reply
  function ecPostReply(form) {
    var ta       = form.querySelector('.ec-reply-ta');
    var parentId = form.dataset.parentId;
    var eid      = form.querySelector('.ec-reply-submit')?.dataset.eid;
    if (!ta || !parentId || !eid || ta.dataset.posting) return;
    var body = ta.value.trim();
    if (!body) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Reply cannot exceed 280 characters.', 'error');
      return;
    }
    var btn = form.querySelector('.ec-reply-submit');
    ta.dataset.posting = '1';
    if (btn) btn.disabled = true;
    fetch('/api/entries/' + eid + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body, parentId: parentId }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var repliesEl = document.querySelector('.ec-replies[data-parent-id="' + parentId + '"]');
      if (repliesEl) {
        repliesEl.classList.remove('hidden');
        repliesEl.insertAdjacentHTML('beforeend', ecBuildReplyHtml(data, eid));
      }
      form.classList.add('hidden');
      ta.value = '';
      ecUpdateCount(eid, 1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete ta.dataset.posting; if (btn) btn.disabled = false; });
  }

  // Char count
  document.addEventListener('input', function (e) {
    var ta = e.target.closest('.ec-comment-ta');
    if (!ta) return;
    var eid     = ta.dataset.eid;
    var compose = ecGetCompose(eid);
    if (!compose) return;
    var countEl = compose.querySelector('.ec-comment-count');
    if (countEl) countEl.textContent = ta.value.replace(/\s/g, '').length + '/280';
  });

  // Enter to submit (Shift+Enter = newline)
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || e.shiftKey) return;
    var ta = e.target;
    if (ta.classList.contains('ec-comment-ta')) {
      e.preventDefault();
      ecPostComment(ta.dataset.eid);
      return;
    }
    if (ta.classList.contains('ec-reply-ta')) {
      e.preventDefault();
      ecPostReply(ta.closest('.ec-reply-form'));
      return;
    }
  });

  document.addEventListener('click', function (e) {

    // Post comment
    var submitBtn = e.target.closest('.ec-comment-submit');
    if (submitBtn && !submitBtn.disabled) { ecPostComment(submitBtn.dataset.eid); return; }

    // Cancel compose
    var cancelBtn = e.target.closest('.ec-comment-cancel');
    if (cancelBtn) {
      var compose = ecGetCompose(cancelBtn.dataset.eid);
      if (compose) { var ta = compose.querySelector('.ec-comment-ta'); if (ta) ta.value = ''; }
      return;
    }

    // Toggle reply form
    var replyToggle = e.target.closest('.ec-reply-toggle');
    if (replyToggle) {
      var item = replyToggle.closest('.ec-citem');
      var form = item && item.querySelector('.ec-reply-form');
      if (form) {
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) form.querySelector('.ec-reply-ta').focus();
      }
      return;
    }

    // Submit reply
    var replySubmit = e.target.closest('.ec-reply-submit');
    if (replySubmit && !replySubmit.disabled) { ecPostReply(replySubmit.closest('.ec-reply-form')); return; }

    // Cancel reply
    var replyCancel = e.target.closest('.ec-reply-cancel');
    if (replyCancel) {
      var form = replyCancel.closest('.ec-reply-form');
      if (form) { form.classList.add('hidden'); form.querySelector('.ec-reply-ta').value = ''; }
      return;
    }

    // Toggle edit form
    var editToggle = e.target.closest('.ec-edit-toggle');
    if (editToggle) {
      var item = editToggle.closest('.ec-citem');
      if (item) {
        item.querySelector('.ec-cbody').classList.add('hidden');
        item.querySelector('.ec-edit-wrap').classList.remove('hidden');
        item.querySelector('.ec-edit-body').focus();
      }
      return;
    }

    // Cancel edit
    var editCancel = e.target.closest('.ec-edit-cancel');
    if (editCancel) {
      var item = editCancel.closest('.ec-citem');
      if (item) {
        item.querySelector('.ec-cbody').classList.remove('hidden');
        item.querySelector('.ec-edit-wrap').classList.add('hidden');
      }
      return;
    }

    // Save edit
    var editSave = e.target.closest('.ec-edit-save');
    if (editSave && !editSave.disabled) {
      var item = editSave.closest('.ec-citem');
      var cid  = editSave.dataset.cid;
      var eid  = editSave.dataset.eid;
      var body = item && item.querySelector('.ec-edit-body').value.trim();
      if (!body) return;
      if (body.replace(/\s/g, '').length > 280) {
        if (window.showToast) window.showToast('Comment cannot exceed 280 characters.', 'error');
        return;
      }
      editSave.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body: body }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var bodyEl = item.querySelector('.ec-cbody');
        bodyEl.innerHTML = ecLinkify(ecEsc(data.body));
        bodyEl.classList.remove('hidden');
        item.querySelector('.ec-edit-wrap').classList.add('hidden');
        item.querySelector('.ec-edit-body').value = data.body;
        var meta = item.querySelector('.flex.items-baseline');
        if (meta && !meta.querySelector('.ec-edited')) {
          var badge = document.createElement('span');
          badge.className = 'ec-edited text-xs text-white/20 italic';
          badge.textContent = 'edited';
          meta.appendChild(badge);
        }
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { editSave.disabled = false; });
      return;
    }

    // Delete
    var delBtn = e.target.closest('.ec-cdelete');
    if (delBtn && !delBtn.disabled) {
      var cid = delBtn.dataset.cid;
      var eid = delBtn.dataset.eid;
      delBtn.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid, { method: 'DELETE' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var item = document.querySelector('.ec-citem[data-cid="' + cid + '"]');
        if (item) item.remove();
        ecUpdateCount(eid, -(data.deletedCount || 1));
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { delBtn.disabled = false; });
      return;
    }

    // Hide / Unhide
    var hideBtn = e.target.closest('.ec-chide');
    if (hideBtn && !hideBtn.disabled) {
      var cid = hideBtn.dataset.cid;
      var eid = hideBtn.dataset.eid;
      hideBtn.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid + '/hide', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        // Reload the page so hidden/visible sections update correctly
        window.location.reload();
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); hideBtn.disabled = false; });
      return;
    }

    // Report
    var reportBtn = e.target.closest('.ec-creport');
    if (reportBtn && !reportBtn.disabled) {
      var cid = reportBtn.dataset.cid;
      var eid = reportBtn.dataset.eid;
      reportBtn.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid + '/report', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); reportBtn.disabled = false; return; }
        reportBtn.textContent = 'Reported';
        reportBtn.classList.add('text-white/20');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); reportBtn.disabled = false; });
      return;
    }

  });

}());
</script>
<% } %>
