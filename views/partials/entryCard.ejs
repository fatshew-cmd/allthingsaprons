<%
  function _ecDate(d) {
    var now = new Date();
    var dt  = new Date(d);
    var timeStr = dt.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    if (now.toDateString() === dt.toDateString()) return 'Today · ' + timeStr;
    return dt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' · ' + timeStr;
  }
  var _eid      = entry._id.toString();
  var _isOwner  = currentUserId && owner && owner._id.toString() === currentUserId;
  var _avg      = entry.ratingCount > 0 ? entry.ratingAvg.toFixed(1) : null;
%>

<% if (!locals.__ecAssets) { locals.__ecAssets = true; %>
<style>
  .ec-tab-btn.ec-on        { background: rgba(255,255,255,0.09); color: #fff; }
  .ec-tab-btn.ec-on.ec-rat { background: rgba(245,158,11,0.18);  color: #fcd34d; }
  .ec-rating-tile:hover    { background: rgba(245,158,11,0.22); color: #fcd34d; }
  .ec-rating-tile.ec-sel   { background: #f59e0b; color: #000; }
  .ec-rating-tile.ec-locked { opacity: 0.18; cursor: not-allowed; pointer-events: none; }
  @keyframes _ec-burst {
    0%   { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
    40%  { transform: translate(calc(-50% + var(--mx)), calc(-50% + var(--ty) * 0.48)) scale(0.9); opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.45); opacity: 0; }
  }
</style>
<% } %>

<div class="flex flex-col overflow-hidden border-b border-white/10<% if (!locals.mediaFull) { %> cursor-pointer<% } %>" id="ec-<%= _eid %>"<% if (!locals.mediaFull) { %> data-ec-nav="/entry/<%= _eid %>"<% } %>>

  <!-- Media -->
  <% if (locals.mediaFull) { %>
  <div class="relative bg-shark-950 overflow-hidden">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" controls class="w-full max-h-[70vh] object-contain"></video>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full max-h-[70vh] object-contain">
    <% } %>
    <% if (locals.contestInfo) { %>
    <a href="/contest/<%= contestInfo.contestId %>" class="absolute top-3 left-3 flex items-center gap-1 px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wide backdrop-blur-sm <%= contestInfo.status === 'active' ? 'bg-green-500/80 text-white' : 'bg-amber-500/80 text-black' %>">
      <iconify-icon icon="boxicons:git-compare" width="11"></iconify-icon>
      <span><%= contestInfo.status === 'active' ? 'H2H Live' : 'H2H' %></span>
    </a>
    <% } %>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-3 left-3 bg-violet-600 text-white text-xs font-bold px-2 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>
  <% } else { %>
  <div class="relative bg-shark-950 overflow-hidden aspect-video">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <iconify-icon icon="bx:play-circle" width="52" class="text-white/80 drop-shadow-lg"></iconify-icon>
    </div>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full h-full object-cover">
    <% } %>
    <a href="/entry/<%= _eid %>" class="absolute inset-0 z-0" aria-label="View entry"></a>
    <% if (locals.contestInfo) { %>
    <a href="/contest/<%= contestInfo.contestId %>" onclick="event.stopPropagation()" class="absolute top-2 left-2 z-10 flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wide backdrop-blur-sm <%= contestInfo.status === 'active' ? 'bg-green-500/80 text-white' : 'bg-amber-500/80 text-black' %>">
      <iconify-icon icon="boxicons:git-compare" width="10"></iconify-icon>
      <span><%= contestInfo.status === 'active' ? 'H2H Live' : 'H2H' %></span>
    </a>
    <% } %>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-2 left-2 z-10 bg-violet-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>
  <% } %>

  <!-- User row -->
  <div class="px-3 pt-3 flex items-center gap-3">
    <!-- Avatar + names -->
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <a href="/<%= owner.username?.value %>" class="shrink-0 w-9 h-9 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
        <% if (owner.avatar?.value) { %>
        <img src="<%= owner.avatar.value %>" alt="<%= owner.username?.value %>" class="w-full h-full object-cover">
        <% } else { %>
        <iconify-icon icon="bx:user" width="18" class="text-white/30"></iconify-icon>
        <% } %>
      </a>
      <div class="min-w-0">
        <a href="/<%= owner.username?.value %>" class="block text-sm font-semibold text-white truncate leading-tight hover:text-charm-300 transition-colors">
          <%= owner.displayName?.value || ('@' + owner.username?.value) %>
        </a>
        <a href="/<%= owner.username?.value %>" class="block text-xs text-white/40 truncate leading-tight mt-0.5">@<%= owner.username?.value %></a>
      </div>
    </div>
    <!-- Follow + date/views -->
    <div class="flex items-center gap-2.5 shrink-0">
      <% if (!_isOwner && isFollowing) { %>
      <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-white/30 text-white/50 hover:bg-white/8 transition-colors cursor-pointer" data-username="<%= owner.username?.value %>" data-following="true">Following</button>
      <% } else if (!_isOwner) { %>
      <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-charm-500/40 text-charm-400 hover:bg-charm-500/10 transition-colors cursor-pointer" data-username="<%= owner.username?.value %>" data-following="false">Follow</button>
      <% } %>
      <div class="text-right">
        <span class="block text-xs text-white/40 leading-tight"><%= _ecDate(entry.createdAt) %></span>
        <span class="block text-xs text-white/25 leading-tight mt-0.5"><%= (entry.viewCount || 0).toLocaleString() %> views</span>
      </div>
    </div>
  </div>

  <!-- Title + Caption -->
  <% if (entry.title) { %>
  <p class="px-3 pt-2.5 text-base font-bold text-white leading-snug"><%= entry.title %></p>
  <% } %>
  <% if (entry.caption) { %>
  <p class="px-3 <%= entry.title ? 'pt-1' : 'pt-2.5' %> text-sm leading-relaxed text-white/55"><%= entry.caption %></p>
  <% } %>

  <!-- Tags -->
  <% if (entry.tags && entry.tags.length > 0) { %>
  <div class="px-3 pt-2 flex flex-wrap gap-x-2 gap-y-0.5">
    <% entry.tags.forEach(function(t) { %><span class="text-xs text-charm-400/50">#<%= t %></span><% }); %>
  </div>
  <% } %>

  <!-- Nominees -->
  <% if (locals.nominees && locals.nominees.length) { %>
  <div class="px-3 pt-3 flex flex-col gap-1.5">
    <p class="text-xs font-semibold text-white/35 uppercase tracking-wide">Nominated</p>
    <div class="flex flex-wrap gap-1.5">
      <% locals.nominees.forEach(function(n) {
           var isVoid    = n.status === 'void';
           var isPending = n.status === 'pending';
           var showVotes = !isVoid && !isPending && n.contestStatus === 'active';
           var Tag       = isVoid ? 'span' : 'a';
      %>
      <<%= Tag %>
        <% if (!isVoid) { %>href="/contest/<%= n.contestId %>"<% } %>
        class="inline-flex items-center gap-1.5 rounded-md pl-1.5 py-1 transition-colors
          <% if (isVoid) { %>opacity-35 cursor-default pr-2.5 bg-white/5 border border-white/10
          <% } else if (isPending) { %>pr-2 bg-charm-600/10 hover:bg-charm-600/18 border border-charm-600/30 hover:border-charm-600/50 cursor-pointer
          <% } else { %>pr-2.5 bg-charm-600/10 hover:bg-charm-600/18 border border-charm-600/30 hover:border-charm-600/50 cursor-pointer<% } %>">
        <% if (n.avatar) { %>
        <img src="<%= n.avatar %>" alt="" class="w-5 h-5 rounded object-cover bg-shark-800 shrink-0">
        <% } else { %>
        <span class="w-5 h-5 rounded bg-shark-700 flex items-center justify-center shrink-0">
          <iconify-icon icon="bx:user" width="12" class="text-white/30"></iconify-icon>
        </span>
        <% } %>
        <span class="text-xs font-medium <%= isVoid ? 'text-white/40' : 'text-white/70' %>">@<%= n.username %></span>
        <% if (isPending) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="text-xs font-semibold text-amber-400/70">Pending</span>
        <% } else if (showVotes) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="inline-flex items-center gap-1">
          <span class="text-xs font-bold text-charm-400"><%= n.voteCountMine %></span>
          <span class="text-white/20 text-xs">·</span>
          <span class="text-xs font-bold text-white/35"><%= n.voteCountNominee %></span>
        </span>
        <% } else if (n.status === 'accepted') { %>
        <iconify-icon icon="boxicons:check-circle" width="12" class="text-charm-400 shrink-0"></iconify-icon>
        <% } %>
      </<%= Tag %>>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- CTAs -->
  <div class="px-2 pt-3 pb-1.5 flex items-center gap-0.5">
    <button class="ec-tab-btn ec-rat flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-amber-300 cursor-pointer" data-eid="<%= _eid %>" data-panel="rating">
      <iconify-icon icon="boxicons:star-filled" width="14" class="text-amber-400 shrink-0"></iconify-icon>
      <span class="text-sm font-semibold text-amber-300 whitespace-nowrap"><% if (_avg) { %><%= _avg %><% } else { %>No rating yet<% } %></span>
    </button>
    <button class="ec-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-white/50 hover:text-white cursor-pointer" data-eid="<%= _eid %>" data-panel="comments">
      <iconify-icon icon="bx:comment" width="16" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.commentCount || 0 %></span>
    </button>
    <button class="ec-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-white/50 hover:text-white cursor-pointer" data-eid="<%= _eid %>" data-panel="likes">
      <iconify-icon icon="bx:heart" width="16" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.likeCount || 0 %></span>
    </button>
    <div class="flex-1"></div>
    <% if (_isOwner && !locals.mediaFull) { %>
    <a href="/entry/<%= _eid %>/edit" class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors">
      <iconify-icon icon="bx:pencil" width="17"></iconify-icon>
    </a>
    <% } %>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="bx:bookmark" width="18"></iconify-icon>
    </button>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="bx:share-alt" width="18"></iconify-icon>
    </button>
  </div>

  <!-- Rating panel -->
  <div class="ec-panel hidden border-t border-white/8 px-3 py-4" data-eid="<%= _eid %>" data-panel="rating"<% if (locals.userRating) { %> data-user-rating="<%= locals.userRating %>"<% } %>>
    <% if (_isOwner) { %>
    <div class="flex flex-col items-center gap-2 text-center py-2">
      <iconify-icon icon="bx:lock" width="22" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">You can't rate your own entry</p>
    </div>
    <% } else { %>
    <p class="text-xs text-white/30 text-center mb-3 tracking-wide uppercase">Rate this entry</p>
    <div class="flex items-center gap-1">
      <% for (var _i = 1; _i <= 10; _i++) { %>
      <button class="ec-rating-tile flex-1 h-9 rounded-md text-sm font-bold transition-all cursor-pointer bg-shark-800 text-white/45" data-score="<%= _i %>" data-eid="<%= _eid %>"><%= _i %></button>
      <% } %>
    </div>
    <div class="ec-rlabel mt-2 text-center text-sm text-amber-400/70 min-h-4" data-eid="<%= _eid %>"></div>
    <% } %>
  </div>

  <!-- Comments panel -->
  <div class="ec-panel hidden border-t border-white/8 px-3 py-6" data-eid="<%= _eid %>" data-panel="comments">
    <div class="flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="bx:comment-dots" width="28" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">No comments yet</p>
    </div>
  </div>

  <!-- Likes panel -->
  <div class="ec-panel hidden border-t border-white/8 px-3 py-6" data-eid="<%= _eid %>" data-panel="likes">
    <% if (_isOwner) { %>
    <div class="flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="bx:lock" width="22" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">You can't like your own entry</p>
    </div>
    <% } else { %>
    <div class="flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="bx:heart" width="28" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">No likes yet</p>
    </div>
    <% } %>
  </div>

</div>

<% if (!locals.__ecScript) { locals.__ecScript = true; %>
<script>
(function () {
  var LABELS = ['','Chopped — What even is this? 🤮','An L — Not even trying 😑','Mid — It\'s just... there 😐','Basic — Standard, pretty boring 🥱','Mid — Just whatever 🫱','Decent — Not bad, actually kind of okay 😉','Fire — This is kind of hot 🔥','Banger — Goddayumm 😍','Ate — I\'m gagged 🌶️','God-tier — That should be illegal 😈'];
  var EMOJIS  = ['','🤮','😑','😐','🥱','🫱','😉','🔥','😍','🌶️','😈'];

  function getConfettiOverlay() {
    var overlay = document.getElementById('ec-confetti-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'ec-confetti-overlay';
      overlay.style.cssText = 'position:fixed;top:0;bottom:0;overflow:hidden;pointer-events:none;z-index:9999;';
      document.body.appendChild(overlay);
    }
    var main = document.querySelector('main');
    var rect = main ? main.getBoundingClientRect() : { left: 0, width: window.innerWidth };
    overlay.style.left  = rect.left + 'px';
    overlay.style.width = rect.width + 'px';
    return overlay;
  }

  function burstConfetti(score) {
    var emoji = EMOJIS[score];
    if (!emoji) return;
    var overlay = getConfettiOverlay();
    var ow = overlay.offsetWidth;
    var oh = overlay.offsetHeight;
    var count = 30;
    for (var i = 0; i < count; i++) {
      (function (idx) {
        var p = document.createElement('span');
        p.textContent = emoji;
        var cx = 40 + Math.random() * (ow - 80);
        p.style.cssText = 'position:absolute;left:' + cx + 'px;top:' + oh + 'px;pointer-events:none;font-size:3.5rem;line-height:1;will-change:transform,opacity;';
        var tx = (Math.random() - 0.5) * 220;
        var ty = -(320 + Math.random() * 260);
        var mx = tx + (Math.random() - 0.5) * 300;
        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--mx', mx + 'px');
        p.style.animation = '_ec-burst ' + (2.8 + Math.random() * 0.5) + 's ease-out forwards';
        p.style.animationDelay = (idx * 0.04 + Math.random() * 0.15) + 's';
        overlay.appendChild(p);
        p.addEventListener('animationend', function () { if (p.parentNode) p.parentNode.removeChild(p); }, { once: true });
      }(i));
    }
  }

  function getCard(eid) { return document.getElementById('ec-' + eid); }

  function setTab(eid, panel) {
    var card = getCard(eid);
    if (!card) return;
    var panels  = card.querySelectorAll('.ec-panel');
    var tabBtns = card.querySelectorAll('.ec-tab-btn');
    var target  = card.querySelector('.ec-panel[data-panel="' + panel + '"]');
    var isOpen  = target && !target.classList.contains('hidden');

    panels.forEach(function (p) { p.classList.add('hidden'); });
    tabBtns.forEach(function (b) { b.classList.remove('ec-on'); });

    if (!isOpen && target) {
      target.classList.remove('hidden');
      var btn = card.querySelector('.ec-tab-btn[data-panel="' + panel + '"]');
      if (btn) btn.classList.add('ec-on');
    }
  }

  var _pendingToasts = {};

  function lockRatingPanel(eid, confirmedScore) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) {
      if (parseInt(t.dataset.score, 10) !== confirmedScore) {
        t.classList.add('ec-locked');
      }
    });
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = LABELS[confirmedScore] || '';
  }

  function selectTile(eid, score) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) { t.classList.remove('ec-sel'); });
    var tile = card.querySelector('.ec-rating-tile[data-score="' + score + '"]');
    if (tile) tile.classList.add('ec-sel');
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = LABELS[score] || '';
  }

  function clearTileSelection(eid) {
    var card = getCard(eid);
    if (!card) return;
    card.querySelectorAll('.ec-rating-tile').forEach(function (t) { t.classList.remove('ec-sel'); });
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = '';
  }

  function submitRating(eid, score) {
    fetch('/api/entries/' + eid + '/rate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ score: score })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { window.showToast(data.error, 'error'); return; }
      lockRatingPanel(eid, score);
      var card = getCard(eid);
      if (card) {
        var avgSpan = card.querySelector('.ec-tab-btn.ec-rat span');
        if (avgSpan) avgSpan.textContent = parseFloat(data.ratingAvg).toFixed(1);
      }
      window.showToast('Rating submitted.', 'success');
    })
    .catch(function () { window.showToast('Something went wrong.', 'error'); });
  }

  document.addEventListener('click', function (e) {
    var navCard = e.target.closest('[data-ec-nav]');
    if (navCard && !e.target.closest('button') && !e.target.closest('a')) {
      window.location.href = navCard.dataset.ecNav;
      return;
    }

    var followBtn = e.target.closest('.ec-follow');
    if (followBtn) {
      var following = followBtn.dataset.following === 'true';
      var uname = followBtn.dataset.username;
      followBtn.disabled = true;
      fetch((following ? '/unfollow/' : '/follow/') + uname, {
        method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var nowFollowing = data.following;
        followBtn.dataset.following = nowFollowing ? 'true' : 'false';
        followBtn.textContent = nowFollowing ? 'Following' : 'Follow';
        followBtn.className = 'ec-follow text-xs font-semibold rounded-md px-2.5 py-1 transition-colors cursor-pointer ' +
          (nowFollowing
            ? 'border border-white/30 text-white/50 hover:bg-white/8'
            : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { followBtn.disabled = false; });
      return;
    }

    var btn = e.target.closest('.ec-tab-btn');
    if (btn) { setTab(btn.dataset.eid, btn.dataset.panel); return; }

    var tile = e.target.closest('.ec-rating-tile');
    if (tile) {
      var eid   = tile.dataset.eid;
      var score = parseInt(tile.dataset.score, 10);

      if (_pendingToasts[eid]) {
        _pendingToasts[eid].dispatchEvent(new Event('ec-dismiss'));
      }

      selectTile(eid, score);

      if (localStorage.getItem('ec-skip-rating-confirm') === '1') {
        burstConfetti(score);
        submitRating(eid, score);
        return;
      }

      var t = window.showToast(
        'Your rating can\'t be changed after you confirm.',
        'info', 0,
        [
          {
            label: 'Cancel',
            cls: 'bg-white/8 text-white/50 hover:bg-white/12 hover:text-white/80',
            fn: function () { delete _pendingToasts[eid]; clearTileSelection(eid); }
          },
          {
            label: 'Confirm rating',
            cls: 'bg-amber-500 text-black hover:bg-amber-400',
            fn: function () {
              if (t.querySelector('.ec-skip-cb') && t.querySelector('.ec-skip-cb').checked) {
                localStorage.setItem('ec-skip-rating-confirm', '1');
              }
              delete _pendingToasts[eid];
              burstConfetti(score);
              submitRating(eid, score);
            }
          }
        ]
      );

      var skipRow = document.createElement('div');
      skipRow.className = 'px-3 pb-1';
      skipRow.innerHTML = '<label class="flex items-center gap-2 text-xs text-white/35 cursor-pointer select-none"><input type="checkbox" class="ec-skip-cb cursor-pointer accent-amber-500"> Don\'t show again</label>';
      t.insertBefore(skipRow, t.lastElementChild);

      _pendingToasts[eid] = t;
      t.addEventListener('ec-dismiss', function () {
        t.dispatchEvent(new Event('animationend'));
        if (t.parentNode) t.parentNode.removeChild(t);
        delete _pendingToasts[eid];
        clearTileSelection(eid);
      });
    }
  });

  document.addEventListener('mouseover', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile || tile.classList.contains('ec-locked')) return;
    var lbl = document.querySelector('.ec-rlabel[data-eid="' + tile.dataset.eid + '"]');
    if (lbl) lbl.textContent = LABELS[parseInt(tile.dataset.score, 10)] || '';
  });

  document.addEventListener('mouseout', function (e) {
    var tile = e.target.closest('.ec-rating-tile');
    if (!tile) return;
    var eid  = tile.dataset.eid;
    var card = getCard(eid);
    if (!card) return;
    var sel = card.querySelector('.ec-rating-tile.ec-sel');
    var lbl = card.querySelector('.ec-rlabel');
    if (lbl) lbl.textContent = sel ? (LABELS[parseInt(sel.dataset.score, 10)] || '') : '';
  });

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.ec-panel[data-panel="rating"][data-user-rating]').forEach(function (panel) {
