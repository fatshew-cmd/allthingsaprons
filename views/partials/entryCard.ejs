<%
  function _ecDate(d) {
    var now = new Date();
    var dt  = new Date(d);
    var timeStr = dt.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    if (now.toDateString() === dt.toDateString()) return 'Today · ' + timeStr;
    return dt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' · ' + timeStr;
  }
  function ecTimeAgo(date) {
    var diff = Math.max(0, Date.now() - new Date(date).getTime());
    var s = Math.floor(diff / 1000);
    if (s < 60) return s + 's';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52) return w + 'w';
    return Math.floor(d / 365) + 'y';
  }
  var _eid      = entry._id.toString();
  var _isOwner  = currentUserId && owner && owner._id.toString() === currentUserId;
  var _avg      = entry.ratingCount > 0 ? entry.ratingAvg.toFixed(1) : null;
%>

<% if (!locals.__ecAssets) { locals.__ecAssets = true; %>
<style>
  .ec-tab-btn.ec-on        { background: rgba(255,255,255,0.09); color: #fff; }
  .ec-tab-btn.ec-on.ec-rat { background: rgba(245,158,11,0.18);  color: #fcd34d; }
  .ec-rating-tile:hover    { background: rgba(245,158,11,0.22); color: #fcd34d; }
  .ec-rating-tile.ec-sel   { background: #f59e0b; color: #000; }
  .ec-rating-tile.ec-locked { opacity: 0.18; cursor: not-allowed; pointer-events: none; }
  .ec-rating-tile.ec-sel.ec-locked { opacity: 1; }
  @keyframes _ec-burst {
    0%   { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
    40%  { transform: translate(calc(-50% + var(--mx)), calc(-50% + var(--ty) * 0.48)) scale(0.9); opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.45); opacity: 0; }
  }
</style>
<% } %>

<div class="flex flex-col border-b border-white/10<% if (!locals.mediaFull) { %> cursor-pointer<% } %>" id="ec-<%= _eid %>"<% if (!locals.mediaFull) { %> data-ec-nav="/entry/<%= _eid %>"<% } %>>

  <!-- User row -->
  <div class="px-3 pt-3">
    <div class="flex items-center gap-3">
      <!-- Left group: avatar + names + follow (all close together) -->
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <!-- Avatar -->
        <a href="/<%= owner.username?.value %>" class="shrink-0 w-9 h-9 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
          <% if (owner.avatar?.value) { %>
          <img src="<%= owner.avatar.value %>" alt="<%= owner.username?.value %>" class="w-full h-full object-cover">
          <% } else { %>
          <iconify-icon icon="boxicons:user" width="18" class="text-white/30"></iconify-icon>
          <% } %>
        </a>
        <!-- Names -->
        <div class="min-w-0">
          <a href="/<%= owner.username?.value %>" class="block text-sm font-semibold text-white truncate leading-tight hover:text-charm-300 transition-colors">
            <%= owner.displayName?.value || ('@' + owner.username?.value) %>
          </a>
          <a href="/<%= owner.username?.value %>" class="block text-xs text-white/40 truncate leading-tight mt-0.5">@<%= owner.username?.value %></a>
        </div>
        <!-- Follow button immediately after names -->
        <% if (!_isOwner && isFollowing) { %>
        <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-white/30 text-white/50 hover:bg-white/8 transition-colors cursor-pointer shrink-0 ml-3" data-username="<%= owner.username?.value %>" data-following="true">Following</button>
        <% } else if (!_isOwner) { %>
        <button class="ec-follow text-xs font-semibold rounded-md px-2.5 py-1 border border-charm-500/40 text-charm-400 hover:bg-charm-500/10 transition-colors cursor-pointer shrink-0 ml-3" data-username="<%= owner.username?.value %>" data-following="false">Follow</button>
        <% } %>
      </div>
      <!-- More menu pinned to far right -->
      <% if (!_isOwner) { %>
      <div class="relative shrink-0">
        <button class="ec-more-btn w-8 h-8 flex items-center justify-center rounded-md text-white/30 hover:text-white hover:bg-white/8 transition-colors cursor-pointer" onclick="ecToggleMore(this,event)">
          <iconify-icon icon="boxicons:dots-horizontal-rounded" width="20"></iconify-icon>
        </button>
        <div class="ec-more-menu hidden absolute right-0 top-9 z-50 w-52 bg-shark-900 border border-white/10 rounded-md shadow-xl overflow-hidden" data-eid="<%= _eid %>">
          <button class="ec-more-report w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-white/65 hover:bg-white/8 hover:text-white transition-colors cursor-pointer text-left" data-eid="<%= _eid %>">
            <iconify-icon icon="boxicons:flag-alt-2-filled" width="15" class="shrink-0 text-white/35"></iconify-icon>
            <span>Report this post</span>
          </button>
          <button class="ec-more-block w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-white/65 hover:bg-white/8 hover:text-white transition-colors cursor-pointer text-left" data-username="<%= owner.username?.value %>">
            <iconify-icon icon="boxicons:block-filled" width="15" class="shrink-0 text-white/35"></iconify-icon>
            <span>Block @<%= owner.username?.value %></span>
          </button>
          <button class="ec-more-notinterested w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-white/65 hover:bg-white/8 hover:text-white transition-colors cursor-pointer text-left" data-eid="<%= _eid %>">
            <iconify-icon icon="boxicons:sad-filled" width="15" class="shrink-0 text-white/35"></iconify-icon>
            <span>Not interested in this post</span>
          </button>
        </div>
      </div>
      <% } %>
    </div>
    <!-- Timestamp below the full top row -->
    <p class="text-xs text-white/35 mt-2"><%= _ecDate(entry.createdAt) %></p>
  </div>

  <!-- Title + Caption -->
  <% if (entry.title) { %>
  <p class="px-3 pt-2.5 text-base font-bold text-white leading-snug"><%= entry.title %></p>
  <% } %>
  <% if (entry.caption) { %>
  <p class="px-3 <%= entry.title ? 'pt-1' : 'pt-2.5' %> text-sm leading-relaxed text-white/55"><%= entry.caption %></p>
  <% } %>

  <!-- Tags -->
  <% if (entry.tags && entry.tags.length > 0) { %>
  <div class="px-3 pt-2 flex flex-wrap gap-x-2 gap-y-0.5">
    <% entry.tags.forEach(function(t) { %><span class="text-xs text-charm-400/50">#<%= t %></span><% }); %>
  </div>
  <% } %>

  <!-- Media -->
  <% if (locals.mediaFull) { %>
  <div class="relative bg-shark-950 overflow-hidden mt-3">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" controls class="w-full max-h-[30vh] object-contain cursor-zoom-in" id="ec-media-<%= _eid %>"></video>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full max-h-[30vh] object-contain cursor-zoom-in" id="ec-media-<%= _eid %>">
    <% } %>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-3 left-3 bg-violet-600 text-white text-xs font-bold px-2 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>

  <!-- Media lightbox — Instagram-style split, CTAs pinned at bottom -->
  <div id="ec-lightbox-<%= _eid %>" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;flex-direction:column">
    <!-- Top row: media (left) + panel (right) -->
    <div style="flex:1;min-height:0;display:flex;flex-direction:row">
      <!-- Left: media -->
      <div id="ec-lightbox-left-<%= _eid %>" style="flex:1;min-width:0;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:rgba(0,0,0,0.96);cursor:pointer">
        <button id="ec-lightbox-close-<%= _eid %>" onclick="event.stopPropagation()" style="position:absolute;top:14px;left:14px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,0.1);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:white;z-index:1" aria-label="Close">
          <iconify-icon icon="boxicons:x" width="18"></iconify-icon>
        </button>
        <div id="ec-lightbox-media-<%= _eid %>" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:48px 24px 24px;pointer-events:none">
          <% if (entry.mediaType === 'video') { %>
          <video src="<%= entry.mediaUrl %>" controls style="max-width:100%;max-height:100%;object-fit:contain;pointer-events:all"></video>
          <% } else { %>
          <img src="<%= entry.mediaUrl %>" alt="" style="max-width:100%;max-height:100%;object-fit:contain">
          <% } %>
        </div>
      </div>
      <!-- Right: scrollable panel area -->
      <div class="w-1/6 shrink-0 flex flex-col border-l border-white/8" style="background:#0c0c0c">
        <div id="ec-lightbox-panel-area-<%= _eid %>" style="flex:1;overflow-y:auto;min-height:0">
          <!-- .ec-panel elements land here on open -->
        </div>
      </div>
    </div>
    <!-- Bottom: CTAs spanning full width -->
    <div id="ec-lightbox-ctas-dock-<%= _eid %>" style="flex-shrink:0;background:rgba(0,0,0,0.96);display:flex;justify-content:center">
      <!-- CTAs land here on open -->
    </div>
  </div>
  <script>
  (function () {
    var lightbox   = document.getElementById('ec-lightbox-<%= _eid %>');
    var leftArea   = document.getElementById('ec-lightbox-left-<%= _eid %>');
    var closeBtn   = document.getElementById('ec-lightbox-close-<%= _eid %>');
    var panelArea  = document.getElementById('ec-lightbox-panel-area-<%= _eid %>');
    var dock       = document.getElementById('ec-lightbox-ctas-dock-<%= _eid %>');
    var media      = document.getElementById('ec-media-<%= _eid %>');
    var sentinels  = [];
    function moveIn(el, container) {
      var s = document.createComment('ec-s');
      el.parentNode.insertBefore(s, el);
      container.appendChild(el);
      sentinels.push({ el: el, s: s });
    }
    function open() {
      document.querySelectorAll('.ec-panel[data-eid="<%= _eid %>"]').forEach(function (p) { moveIn(p, panelArea); });
      var ctas = document.getElementById('ec-ctas-<%= _eid %>');
      if (ctas) moveIn(ctas, dock);
      lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function close() {
      sentinels.slice().reverse().forEach(function (item) {
        if (item.s.parentNode) {
          item.s.parentNode.insertBefore(item.el, item.s);
          item.s.parentNode.removeChild(item.s);
        }
      });
      sentinels = [];
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }
    media.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    leftArea.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lightbox.style.display !== 'none') close(); });
  }());
  </script>
  <% } else { %>
  <div class="relative bg-shark-950 overflow-hidden mt-3">
    <% if (entry.mediaType === 'video') { %>
    <video src="<%= entry.mediaUrl %>" class="w-full max-h-[30vh] object-contain" muted preload="none"></video>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <iconify-icon icon="boxicons:play-circle" width="52" class="text-white/80 drop-shadow-lg"></iconify-icon>
    </div>
    <% } else { %>
    <img src="<%= entry.mediaUrl %>" alt="" class="w-full max-h-[30vh] object-contain">
    <% } %>
    <a href="/entry/<%= _eid %>" class="absolute inset-0 z-0" aria-label="View entry"></a>
    <% if (entry.aiGenerated) { %>
    <div class="absolute bottom-2 left-2 z-10 bg-violet-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
    <% } %>
  </div>
  <% } %>

  <!-- Nominees -->
  <% if (locals.nominees && locals.nominees.length) { %>
  <div class="px-3 pt-3 flex flex-col gap-1.5">
    <p class="text-xs font-semibold text-white/35 uppercase tracking-wide">Head to Head</p>
    <div class="flex flex-wrap gap-1.5">
      <% locals.nominees.forEach(function(n) {
           var isVoid     = n.status === 'void';
           var isPending  = n.status === 'pending';
           var isActive   = !isVoid && !isPending && n.contestStatus === 'active';
           var isClosed   = !isVoid && !isPending && n.contestStatus === 'closed';
           var isWon      = isClosed && n.isWinner;
           var isLost     = isClosed && !n.isWinner;
           var isAccepted = n.status === 'accepted' && !isActive && !isClosed;
           var Tag        = isVoid ? 'span' : 'a';

           var wrapCls;
           if      (isVoid)     wrapCls = 'opacity-35 cursor-default pr-2.5 bg-white/5 border border-white/10';
           else if (isPending)  wrapCls = 'pr-2 bg-amber-500/10 border border-amber-500/30 hover:border-amber-500/50 cursor-pointer';
           else if (isActive)   wrapCls = 'pr-2.5 bg-green-500/10 border border-green-500/30 hover:border-green-500/50 cursor-pointer';
           else if (isWon)      wrapCls = 'pr-2.5 bg-yellow-500/10 border border-yellow-500/30 hover:border-yellow-500/50 cursor-pointer';
           else if (isLost)     wrapCls = 'pr-2.5 bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer';
           else                 wrapCls = 'pr-2.5 bg-charm-600/10 border border-charm-600/30 hover:border-charm-600/50 cursor-pointer';
      %>
      <<%= Tag %>
        <% if (!isVoid) { %>href="/contest/<%= n.contestId %>"<% } %>
        class="inline-flex items-center gap-1.5 rounded-md pl-1.5 py-1 transition-colors <%= wrapCls %>">
        <%# Avatar %>
        <% if (n.avatar) { %>
        <img src="<%= n.avatar %>" alt="" class="w-5 h-5 rounded object-cover bg-shark-800 shrink-0">
        <% } else { %>
        <span class="w-5 h-5 rounded bg-shark-700 flex items-center justify-center shrink-0">
          <iconify-icon icon="boxicons:user" width="12" class="text-white/30"></iconify-icon>
        </span>
        <% } %>
        <%# Username %>
        <span class="text-xs font-medium <%= (isVoid || isLost) ? 'text-white/40' : 'text-white/70' %>">@<%= n.username %></span>
        <%# Trailing content %>
        <% if (isVoid) { %>
        <span class="text-white/20 text-xs">|</span>
        <span class="text-xs font-semibold text-white/40"><%= ({ expired: 'No Response', declined: 'Denied', nominee_forfeit: 'Forfeited', nominator_forfeit: 'Forfeit Win' })[n.voidReason] || 'No Response' %></span>
        <% } else if (isPending) { %>
        <span class="text-amber-500/30 text-xs">|</span>
        <span class="text-xs font-semibold text-amber-400">Pending</span>
        <% } else if (isAccepted) { %>
        <span class="text-charm-500/30 text-xs">|</span>
        <span class="text-xs font-semibold text-charm-400">Accepted</span>
        <% } else if (isActive || isClosed) { %>
        <span class="<%= isLost ? 'text-white/15' : 'text-white/20' %> text-xs">|</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="text-xs leading-none">👍</span>
          <span class="text-xs font-bold <%= isLost ? 'text-white/35' : 'text-yellow-400' %>"><%= n.voteCountMine %></span>
          <span class="<%= isLost ? 'text-white/10' : 'text-white/15' %> text-xs">·</span>
          <span class="text-xs leading-none">🌶️</span>
          <span class="text-xs font-bold <%= isLost ? 'text-white/35' : 'text-charm-400' %>"><%= n.contribution %></span>
        </span>
        <% } %>
      </<%= Tag %>>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- CTAs -->
  <div class="px-2 pt-3 pb-1.5 flex items-center gap-0.5" id="ec-ctas-<%= _eid %>">
    <span class="flex items-center gap-1.5 px-3 py-2 text-white/50">
      <iconify-icon icon="boxicons:bar-chart" width="18" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= (entry.viewCount || 0).toLocaleString() %></span>
    </span>
    <button class="ec-tab-btn ec-rat flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-amber-300 cursor-pointer" data-eid="<%= _eid %>" data-panel="rating">
      <iconify-icon icon="boxicons:star-filled" width="14" class="text-amber-400 shrink-0"></iconify-icon>
      <span class="text-sm font-semibold text-amber-300 whitespace-nowrap"><% if (_avg) { %><%= _avg %><% } else { %>No rating yet<% } %></span>
    </button>
    <% if (!_isOwner && entry.allowTakeOns !== false) { %>
    <button class="ec-take-on flex items-center gap-1.5 px-3 py-2 rounded-md text-white/35 hover:text-charm-400 transition-colors cursor-pointer" data-eid="<%= _eid %>" title="Take On">
      <iconify-icon icon="boxicons:git-compare" width="17" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.takeOnCount || 0 %></span>
    </button>
    <% } %>
    <button class="ec-tab-btn flex items-center gap-1.5 px-3 py-2 rounded-md transition-colors text-white/50 hover:text-white cursor-pointer" data-eid="<%= _eid %>" data-panel="comments">
      <iconify-icon icon="boxicons:message" width="16" class="shrink-0"></iconify-icon>
      <span class="text-sm font-medium"><%= entry.commentCount || 0 %></span>
    </button>

    <div class="flex-1"></div>
    <% if (_isOwner && !locals.mediaFull) { %>
    <a href="/entry/<%= _eid %>/edit" class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors">
      <iconify-icon icon="boxicons:edit-alt" width="17"></iconify-icon>
    </a>
    <% } %>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="boxicons:bookmark" width="18"></iconify-icon>
    </button>
    <button class="w-9 h-9 flex items-center justify-center rounded-md text-white/35 hover:bg-white/8 hover:text-white transition-colors cursor-pointer">
      <iconify-icon icon="boxicons:share" width="18"></iconify-icon>
    </button>
  </div>

  <!-- Rating panel -->
  <div class="ec-panel hidden border-t border-white/8" data-eid="<%= _eid %>" data-panel="rating"<% if (locals.userRating) { %> data-user-rating="<%= locals.userRating %>"<% } %>>
    <% if (_isOwner) { %>
    <div class="px-3 py-4 flex flex-col items-center gap-2 text-center">
      <iconify-icon icon="boxicons:lock" width="22" class="text-white/15"></iconify-icon>
      <p class="text-xs text-white/30">You can't rate your own entry</p>
    </div>
    <% } else { %>
    <div class="px-3 py-4">
      <p class="text-xs text-white/30 text-center mb-3 tracking-wide uppercase">Rate this entry</p>
      <div class="flex items-center gap-1">
        <% for (var _i = 1; _i <= 10; _i++) { %>
        <button class="ec-rating-tile flex-1 h-9 rounded-md text-sm font-bold transition-all cursor-pointer bg-shark-800 text-white/45" data-score="<%= _i %>" data-eid="<%= _eid %>"><%= _i %></button>
        <% } %>
      </div>
      <div class="ec-rlabel mt-2 text-center text-sm text-amber-400/70 h-5 leading-5 overflow-hidden" data-eid="<%= _eid %>"></div>
    </div>
    <% } %>

  </div>

  <!-- Ratings list (always visible on entry detail page) -->
  <% if (locals.mediaFull && Array.isArray(locals.ratings)) { %>
  <div class="ec-rlist flex flex-col border-t border-white/8"
    data-eid="<%= _eid %>"
    data-cur-username="<%= locals.currentUser ? locals.currentUser.username : '' %>"
    data-cur-displayname="<%= locals.currentUser ? (locals.currentUser.displayName || '') : '' %>"
    data-cur-avatar="<%= locals.currentUser && locals.currentUser.avatar && locals.currentUser.avatar.value ? locals.currentUser.avatar.value : (locals.currentUser && locals.currentUser.avatar && typeof locals.currentUser.avatar === 'string' ? locals.currentUser.avatar : '') %>">
    <% if (!locals.ratings.length) { %>
    <p class="ec-rlist-empty px-3 py-4 text-sm text-white/25">No ratings yet.</p>
    <% } %>
    <% locals.ratings.forEach(function(r) {
      var rUser = r.userId;
    %>
    <div class="ec-ritem px-3 py-2.5 border-t border-white/6 first:border-t-0 flex items-center gap-2.5">
      <a href="/<%= rUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
        <% if (rUser.avatar?.value) { %><img src="<%= rUser.avatar.value %>" alt="" class="w-full h-full object-cover">
        <% } else { %><iconify-icon icon="boxicons:user" width="14" class="text-white/30"></iconify-icon><% } %>
      </a>
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline gap-1.5 flex-wrap">
          <a href="/<%= rUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= rUser.displayName?.value || ('@' + rUser.username?.value) %></a>
          <% if (rUser.displayName?.value) { %><span class="text-xs text-white/35">@<%= rUser.username?.value %></span><% } %>
          <span class="text-xs text-white/25"><%= ecTimeAgo(r.createdAt) %></span>
        </div>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <iconify-icon icon="boxicons:star-filled" width="12" class="text-amber-400"></iconify-icon>
        <span class="text-sm font-bold text-amber-300"><%= r.score %></span>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Comments panel -->
  <div class="ec-panel hidden" data-eid="<%= _eid %>" data-panel="comments">
  <% if (locals.mediaFull && Array.isArray(locals.comments)) { %>
  <%
  function ecLinkifyBody(body) {
    var esc = String(body).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return esc.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }
  function ecTimeAgo(date) {
    var diff = Math.max(0, Date.now() - new Date(date).getTime());
    var s = Math.floor(diff / 1000);
    if (s < 60) return s + 's';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52) return w + 'w';
    return Math.floor(d / 365) + 'y';
  }
  %>

  <!-- Compose box -->
  <div class="px-3 pt-3 pb-2.5 ec-compose-box"
    data-eid="<%= _eid %>"
    data-is-owner="<%= _isOwner ? '1' : '0' %>"
    data-cur-username="<%= locals.currentUser ? locals.currentUser.username : '' %>"
    data-cur-avatar="<%= (locals.currentUser && locals.currentUser.avatar) ? locals.currentUser.avatar : '' %>">
    <div class="border border-white/12 rounded-md bg-white/6 focus-within:border-charm-500/40 transition-colors cursor-text" onclick="if(!event.target.closest('button,a,textarea')){this.querySelector('textarea').focus()}">
      <!-- Row 1: pfp badge + char counter -->
      <div class="flex items-center justify-between px-3 pt-3">
        <div class="flex items-center gap-2 min-w-0">
          <a href="<%= locals.currentUser ? '/' + locals.currentUser.username : '#' %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
            <% if (locals.currentUser && locals.currentUser.avatar) { %>
            <img src="<%= locals.currentUser.avatar %>" class="w-full h-full object-cover">
            <% } else { %>
            <iconify-icon icon="boxicons:user" width="14" class="text-white/30"></iconify-icon>
            <% } %>
          </a>
          <div class="flex flex-col min-w-0">
            <span class="text-xs text-white/30">Posting as:</span>
            <div class="flex items-baseline gap-1.5">
              <span class="text-sm font-semibold text-white/80 truncate"><%= locals.currentUser ? (locals.currentUser.displayName || ('@' + locals.currentUser.username)) : '' %></span>
              <% if (locals.currentUser && locals.currentUser.displayName) { %>
              <span class="text-xs text-white/30 shrink-0">@<%= locals.currentUser.username %></span>
              <% } %>
            </div>
          </div>
        </div>
        <span class="ec-comment-count text-xs text-white/25 shrink-0 ml-2" data-eid="<%= _eid %>">0/280</span>
      </div>
      <!-- Row 2: textarea -->
      <div class="px-3 pt-3">
        <textarea class="ec-comment-ta w-full bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none" rows="3" placeholder="Add a comment…" data-eid="<%= _eid %>"></textarea>
      </div>
      <!-- Row 3: buttons -->
      <div class="flex items-center justify-end gap-2 px-3 pb-3">
        <button type="button" class="ec-comment-cancel h-8 px-4 text-sm rounded-md text-white hover:text-white/60 transition-colors cursor-pointer" data-eid="<%= _eid %>">Cancel</button>
        <button type="button" class="ec-comment-submit h-8 px-4 text-sm font-semibold rounded-md bg-charm-600 text-charm-100 hover:bg-charm-500 transition-colors cursor-pointer" data-eid="<%= _eid %>">Post</button>
      </div>
    </div>
  </div>

  <!-- Comment list -->
  <div class="ec-clist flex flex-col" data-eid="<%= _eid %>">
    <% if (!locals.comments.length) { %>
    <p class="ec-clist-empty px-3 py-4 text-sm text-white/25">No comments yet.</p>
    <% } %>

    <% locals.comments.forEach(function(comment) {
      var cid          = comment._id.toString();
      var cUser        = comment.userId;
      var isOwnComment = currentUserId && cUser._id.toString() === currentUserId;
    %>
    <div class="ec-citem px-3 py-3 border-t border-white/6" data-cid="<%= cid %>" data-username="<%= cUser.username?.value %>">
      <div class="flex gap-2.5">
        <a href="/<%= cUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
          <% if (cUser.avatar?.value) { %><img src="<%= cUser.avatar.value %>" class="w-full h-full object-cover">
          <% } else { %><iconify-icon icon="boxicons:user" width="14" class="text-white/30"></iconify-icon><% } %>
        </a>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <a href="/<%= cUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= cUser.displayName?.value || ('@' + cUser.username?.value) %></a>
            <% if (cUser.displayName?.value) { %><span class="text-xs text-white/35">@<%= cUser.username?.value %></span><% } %>
            <span class="text-xs text-white/25"><%= ecTimeAgo(comment.createdAt) %></span>
            <% if (comment.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
          </div>
          <p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- ecLinkifyBody(comment.body) %></p>
          <div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
            <textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2"><%= comment.body %></textarea>
            <div class="flex items-center justify-end gap-2">
              <button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
              <button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Save</button>
            </div>
          </div>
          <div class="flex items-center gap-3 mt-1.5">
            <button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= cid %>">Reply</button>
            <% if (isOwnComment) { %>
            <button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= cid %>">Edit</button>
            <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Delete</button>
            <% } else if (_isOwner) { %>
            <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Delete</button>
            <button type="button" class="ec-creport text-xs text-red-400/60 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Report</button>
            <% } else { %>
            <button type="button" class="ec-creport text-xs text-red-400/60 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= cid %>" data-eid="<%= _eid %>">Report</button>
            <% } %>
            <% if (comment.replies && comment.replies.length) { %>
            <button type="button" class="ec-replies-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-parent-id="<%= cid %>">Show Replies (<%= comment.replies.length %>)</button>
            <% } %>
          </div>
          <div class="ec-reply-form hidden mt-2.5" data-parent-id="<%= cid %>">
            <div class="border border-white/12 rounded-md bg-white/6 focus-within:border-charm-500/40 transition-colors">
              <div class="px-3 pt-3 flex items-start gap-1">
                <span class="ec-reply-mention hidden text-sm text-charm-400 font-medium leading-5.5 shrink-0"></span>
                <textarea class="ec-reply-ta flex-1 min-w-0 bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none" rows="2" placeholder="Reply…"></textarea>
              </div>
              <div class="flex items-center gap-2 px-3 pb-3">
                <span class="ec-reply-count text-xs text-white/25 flex-1">0/280</span>
                <button type="button" class="ec-reply-cancel h-8 px-4 text-sm rounded-md text-white hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
                <button type="button" class="ec-reply-submit h-8 px-4 text-sm font-semibold rounded-md bg-charm-600 text-charm-100 hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="<%= cid %>" data-eid="<%= _eid %>">Reply</button>
              </div>
            </div>
          </div>
          <div class="ec-replies hidden mt-3 flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="<%= cid %>">
            <% (comment.replies || []).forEach(function(reply) {
              var rid       = reply._id.toString();
              var rUser     = reply.userId;
              var isOwnReply = currentUserId && rUser._id.toString() === currentUserId;
            %>
            <div class="ec-citem" data-cid="<%= rid %>" data-username="<%= rUser.username?.value %>">
              <div class="flex gap-2">
                <a href="/<%= rUser.username?.value %>" class="shrink-0 w-6 h-6 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">
                  <% if (rUser.avatar?.value) { %><img src="<%= rUser.avatar.value %>" class="w-full h-full object-cover">
                  <% } else { %><iconify-icon icon="boxicons:user" width="12" class="text-white/30"></iconify-icon><% } %>
                </a>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline gap-1.5 flex-wrap">
                    <a href="/<%= rUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= rUser.displayName?.value || ('@' + rUser.username?.value) %></a>
                    <% if (rUser.displayName?.value) { %><span class="text-xs text-white/35">@<%= rUser.username?.value %></span><% } %>
                    <span class="text-xs text-white/25"><%= ecTimeAgo(reply.createdAt) %></span>
                    <% if (reply.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
                  </div>
                  <p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- ecLinkifyBody(reply.body) %></p>
                  <div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
                    <textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2"><%= reply.body %></textarea>
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
                      <button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Save</button>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 mt-1.5">
                    <button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= rid %>">Reply</button>
                    <% if (isOwnReply) { %>
                    <button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="<%= rid %>">Edit</button>
                    <button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Delete</button>
                    <% } else { %>
                    <button type="button" class="ec-creport text-xs text-red-400/60 hover:text-red-400 transition-colors cursor-pointer" data-cid="<%= rid %>" data-eid="<%= _eid %>">Report</button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <% } else { %>
  <div class="flex flex-col items-center gap-2 text-center px-3 py-6">
    <iconify-icon icon="boxicons:message-circle-dots" width="28" class="text-white/15"></iconify-icon>
    <p class="text-xs text-white/30">No comments yet</p>
  </div>
  <% } %>
  </div>


</div>

<%# ecScript.ejs is included once by appEnd — nothing to emit here %>

<% if (locals.mediaFull && Array.isArray(locals.comments)) { %>
<script>
(function () {
  function ecEsc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function ecTimeAgo(date) {
    var diff = Math.max(0, Date.now() - new Date(date).getTime());
    var s = Math.floor(diff / 1000);
    if (s < 60) return s + 's';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52) return w + 'w';
    return Math.floor(d / 365) + 'y';
  }
  function ecLinkify(esc) {
    return esc.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }

  function ecGetCompose(eid) {
    return document.querySelector('.ec-compose-box[data-eid="' + eid + '"]');
  }
  function ecUpdateCount(eid, delta) {
    var btn  = document.querySelector('.ec-tab-btn[data-panel="comments"][data-eid="' + eid + '"]');
    if (!btn) return;
    var span = btn.querySelector('span');
    var cur  = span ? (parseInt(span.textContent, 10) || 0) : 0;
    if (span) span.textContent = Math.max(0, cur + delta);
  }

  function ecBuildTopHtml(c, eid, isOwner) {
    var dn  = c.user.displayName || ('@' + c.user.username);
    var dt  = ecTimeAgo(c.createdAt);
    var av  = c.user.avatar
      ? '<img src="' + ecEsc(c.user.avatar) + '" class="w-full h-full object-cover">'
      : '<iconify-icon icon="boxicons:user" width="14" class="text-white/30"></iconify-icon>';
    var act = '<button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Edit</button>'
      + '<button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Delete</button>';
    var unameSpan = c.user.displayName ? '<span class="text-xs text-white/35">@' + ecEsc(c.user.username) + '</span>' : '';
    return '<div class="ec-citem px-3 py-3 border-t border-white/6" data-cid="' + c._id + '">'
      + '<div class="flex gap-2.5">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">' + av + '</a>'
      + '<div class="flex-1 min-w-0">'
      + '<div class="flex items-baseline gap-1.5 flex-wrap">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity">' + ecEsc(dn) + '</a>'
      + unameSpan
      + '<span class="text-xs text-white/25">' + dt + '</span>'
      + '</div>'
      + '<p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words">' + ecLinkify(ecEsc(c.body)) + '</p>'
      + '<div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">'
      + '<textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2">' + ecEsc(c.body) + '</textarea>'
      + '<div class="flex items-center justify-end gap-2">'
      + '<button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Save</button>'
      + '</div></div>'
      + '<div class="flex items-center gap-3 mt-1.5">'
      + '<button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Reply</button>'
      + act
      + '</div>'
      + '<div class="ec-reply-form hidden mt-2.5" data-parent-id="' + c._id + '">'
      + '<div class="border border-white/12 rounded-md bg-white/6 focus-within:border-charm-500/40 transition-colors">'
      + '<div class="flex items-start gap-1 px-3 pt-3">'
      + '<span class="ec-reply-mention hidden text-sm text-charm-400 font-medium leading-5.5 shrink-0"></span>'
      + '<textarea class="ec-reply-ta flex-1 min-w-0 bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none" rows="2" placeholder="Reply…"></textarea>'
      + '</div>'
      + '<div class="flex items-center gap-2 px-3 pb-3">'
      + '<span class="ec-reply-count text-xs text-white/25 flex-1">0/280</span>'
      + '<button type="button" class="ec-reply-cancel h-8 px-4 text-sm rounded-md text-white hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-reply-submit h-8 px-4 text-sm font-semibold rounded-md bg-charm-600 text-charm-100 hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="' + c._id + '" data-eid="' + eid + '">Reply</button>'
      + '</div></div></div>'
      + '<div class="ec-replies hidden mt-3 flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="' + c._id + '"></div>'
      + '</div></div></div>';
  }

  function ecBuildReplyHtml(c, eid) {
    var dn = c.user.displayName || ('@' + c.user.username);
    var dt = ecTimeAgo(c.createdAt);
    var av = c.user.avatar
      ? '<img src="' + ecEsc(c.user.avatar) + '" class="w-full h-full object-cover">'
      : '<iconify-icon icon="boxicons:user" width="12" class="text-white/30"></iconify-icon>';
    var unameSpanR = c.user.displayName ? '<span class="text-xs text-white/35">@' + ecEsc(c.user.username) + '</span>' : '';
    return '<div class="ec-citem" data-cid="' + c._id + '" data-username="' + ecEsc(c.user.username) + '">'
      + '<div class="flex gap-2">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="shrink-0 w-6 h-6 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5">' + av + '</a>'
      + '<div class="flex-1 min-w-0">'
      + '<div class="flex items-baseline gap-1.5 flex-wrap">'
      + '<a href="/' + ecEsc(c.user.username) + '" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity">' + ecEsc(dn) + '</a>'
      + unameSpanR
      + '<span class="text-xs text-white/25">' + dt + '</span>'
      + '</div>'
      + '<p class="ec-cbody text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words">' + ecLinkify(ecEsc(c.body)) + '</p>'
      + '<div class="ec-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">'
      + '<textarea class="ec-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2">' + ecEsc(c.body) + '</textarea>'
      + '<div class="flex items-center justify-end gap-2">'
      + '<button type="button" class="ec-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 transition-colors cursor-pointer">Cancel</button>'
      + '<button type="button" class="ec-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Save</button>'
      + '</div></div>'
      + '<div class="flex items-center gap-3 mt-1.5">'
      + '<button type="button" class="ec-reply-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Reply</button>'
      + '<button type="button" class="ec-edit-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer" data-cid="' + c._id + '">Edit</button>'
      + '<button type="button" class="ec-cdelete text-xs text-white/30 hover:text-red-400 transition-colors cursor-pointer" data-cid="' + c._id + '" data-eid="' + eid + '">Delete</button>'
      + '</div>'
      + '</div></div></div>';
  }

  // Post new top-level comment
  function ecPostComment(eid) {
    var compose = ecGetCompose(eid);
    if (!compose) return;
    var ta = compose.querySelector('.ec-comment-ta');
    if (!ta || ta.dataset.posting) return;
    var body = ta.value.trim();
    if (!body) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Comment cannot exceed 280 characters.', 'error');
      return;
    }
    var isOwner = compose.dataset.isOwner === '1';
    var btn = compose.querySelector('.ec-comment-submit');
    ta.dataset.posting = '1';
    if (btn) btn.disabled = true;
    fetch('/api/entries/' + eid + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var list  = document.querySelector('.ec-clist[data-eid="' + eid + '"]');
      var empty = list && list.querySelector('.ec-clist-empty');
      if (empty) empty.remove();
      if (list) list.insertAdjacentHTML('beforeend', ecBuildTopHtml(data, eid, isOwner));
      ta.value = '';
      var countEl = compose.querySelector('.ec-comment-count');
      if (countEl) countEl.textContent = '0/280';
      ecUpdateCount(eid, 1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete ta.dataset.posting; if (btn) btn.disabled = false; });
  }

  // Post reply
  function ecPostReply(form) {
    var ta       = form.querySelector('.ec-reply-ta');
    var parentId = form.dataset.parentId;
    var eid      = form.querySelector('.ec-reply-submit')?.dataset.eid;
    if (!ta || !parentId || !eid || ta.dataset.posting) return;
    var mention = form.querySelector('.ec-reply-mention');
    var mentionPrefix = (mention && !mention.classList.contains('hidden') && mention.textContent) ? mention.textContent + ' ' : '';
    var body = mentionPrefix + ta.value.trim();
    if (!body.trim()) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Reply cannot exceed 280 characters.', 'error');
      return;
    }
    var btn = form.querySelector('.ec-reply-submit');
    ta.dataset.posting = '1';
    if (btn) btn.disabled = true;
    fetch('/api/entries/' + eid + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body, parentId: parentId }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var repliesEl = document.querySelector('.ec-replies[data-parent-id="' + parentId + '"]');
      if (repliesEl) {
        repliesEl.classList.remove('hidden');
        repliesEl.classList.add('flex');
        repliesEl.insertAdjacentHTML('beforeend', ecBuildReplyHtml(data, eid));
        var replyCount = repliesEl.querySelectorAll(':scope > .ec-citem').length;
        var toggleBtn = document.querySelector('.ec-replies-toggle[data-parent-id="' + parentId + '"]');
        if (replyCount >= 1) {
          if (toggleBtn) {
            toggleBtn.textContent = 'Hide Replies';
          } else {
            var newToggle = document.createElement('button');
            newToggle.type = 'button';
            newToggle.className = 'ec-replies-toggle text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer';
            newToggle.dataset.parentId = parentId;
            newToggle.textContent = 'Hide Replies';
            var commentItem = document.querySelector('.ec-citem[data-cid="' + parentId + '"]');
            var actionsRow = commentItem && commentItem.querySelector('.flex.items-center.gap-3');
            if (actionsRow) actionsRow.appendChild(newToggle);
          }
        }
      }
      form.classList.add('hidden');
      ta.value = '';
      var countEl = form.querySelector('.ec-reply-count');
      if (countEl) countEl.textContent = '0/280';
      ecUpdateCount(eid, 1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete ta.dataset.posting; if (btn) btn.disabled = false; });
  }

  // Char count
  document.addEventListener('input', function (e) {
    var cta = e.target.closest('.ec-comment-ta');
    if (cta) {
      var compose = ecGetCompose(cta.dataset.eid);
      var countEl = compose && compose.querySelector('.ec-comment-count');
      if (countEl) countEl.textContent = cta.value.replace(/\s/g, '').length + '/280';
      return;
    }
    var rta = e.target.closest('.ec-reply-ta');
    if (rta) {
      var form    = rta.closest('.ec-reply-form');
      var countEl = form && form.querySelector('.ec-reply-count');
      if (countEl) countEl.textContent = rta.value.replace(/\s/g, '').length + '/280';
    }
  });

  // Enter to submit (Shift+Enter = newline)
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || e.shiftKey) return;
    var ta = e.target;
    if (ta.classList.contains('ec-comment-ta')) {
      e.preventDefault();
      ecPostComment(ta.dataset.eid);
      return;
    }
    if (ta.classList.contains('ec-reply-ta')) {
      e.preventDefault();
      ecPostReply(ta.closest('.ec-reply-form'));
      return;
    }
  });

  document.addEventListener('click', function (e) {

    // Post comment
    var submitBtn = e.target.closest('.ec-comment-submit');
    if (submitBtn && !submitBtn.disabled) { ecPostComment(submitBtn.dataset.eid); return; }

    // Cancel compose
    var cancelBtn = e.target.closest('.ec-comment-cancel');
    if (cancelBtn) {
      var compose = ecGetCompose(cancelBtn.dataset.eid);
      if (compose) { var ta = compose.querySelector('.ec-comment-ta'); if (ta) ta.value = ''; }
      return;
    }

    // Show/Hide replies toggle
    var repliesToggle = e.target.closest('.ec-replies-toggle');
    if (repliesToggle) {
      var parentId = repliesToggle.dataset.parentId;
      var repliesEl = document.querySelector('.ec-replies[data-parent-id="' + parentId + '"]');
      if (repliesEl) {
        var isHidden = repliesEl.classList.contains('hidden');
        if (isHidden) {
          repliesEl.classList.remove('hidden');
          repliesEl.classList.add('flex');
          repliesToggle.textContent = 'Hide Replies';
        } else {
          repliesEl.classList.add('hidden');
          repliesEl.classList.remove('flex');
          var replyCount = repliesEl.querySelectorAll(':scope > .ec-citem').length;
          repliesToggle.textContent = 'Show Replies (' + replyCount + ')';
        }
      }
      return;
    }

    // Toggle reply form
    var replyToggle = e.target.closest('.ec-reply-toggle');
    if (replyToggle) {
      var item = replyToggle.closest('.ec-citem');
      var form = item && item.querySelector('.ec-reply-form');
      var mentionUsername = item && item.dataset.username;
      if (!form) {
        // replying to a sub-reply — open the root comment's form
        var repliesContainer = item && item.closest('.ec-replies');
        var rootItem = repliesContainer && repliesContainer.closest('.ec-citem');
        form = rootItem && rootItem.querySelector('.ec-reply-form');
        if (form) {
          form.classList.remove('hidden');
          var mention = form.querySelector('.ec-reply-mention');
          if (mention && mentionUsername) {
            mention.textContent = '@' + mentionUsername;
            mention.classList.remove('hidden');
          }
          form.querySelector('.ec-reply-ta').focus();
        }
      } else {
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
          var mention = form.querySelector('.ec-reply-mention');
          if (mention && mentionUsername) {
            mention.textContent = '@' + mentionUsername;
            mention.classList.remove('hidden');
          }
          form.querySelector('.ec-reply-ta').focus();
        }
      }
      return;
    }

    // Submit reply
    var replySubmit = e.target.closest('.ec-reply-submit');
    if (replySubmit && !replySubmit.disabled) { ecPostReply(replySubmit.closest('.ec-reply-form')); return; }

    // Cancel reply
    var replyCancel = e.target.closest('.ec-reply-cancel');
    if (replyCancel) {
      var form = replyCancel.closest('.ec-reply-form');
      if (form) {
        form.classList.add('hidden');
        form.querySelector('.ec-reply-ta').value = '';
        var mention = form.querySelector('.ec-reply-mention');
        if (mention) { mention.textContent = ''; mention.classList.add('hidden'); }
        var countEl = form.querySelector('.ec-reply-count');
        if (countEl) countEl.textContent = '0/280';
      }
      return;
    }

    // Toggle edit form
    var editToggle = e.target.closest('.ec-edit-toggle');
    if (editToggle) {
      var item = editToggle.closest('.ec-citem');
      if (item) {
        item.querySelector('.ec-cbody').classList.add('hidden');
        item.querySelector('.ec-edit-wrap').classList.remove('hidden');
        item.querySelector('.ec-edit-body').focus();
      }
      return;
    }

    // Cancel edit
    var editCancel = e.target.closest('.ec-edit-cancel');
    if (editCancel) {
      var item = editCancel.closest('.ec-citem');
      if (item) {
        item.querySelector('.ec-cbody').classList.remove('hidden');
        item.querySelector('.ec-edit-wrap').classList.add('hidden');
      }
      return;
    }

    // Save edit
    var editSave = e.target.closest('.ec-edit-save');
    if (editSave && !editSave.disabled) {
      var item = editSave.closest('.ec-citem');
      var cid  = editSave.dataset.cid;
      var eid  = editSave.dataset.eid;
      var body = item && item.querySelector('.ec-edit-body').value.trim();
      if (!body) return;
      if (body.replace(/\s/g, '').length > 280) {
        if (window.showToast) window.showToast('Comment cannot exceed 280 characters.', 'error');
        return;
      }
      editSave.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body: body }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var bodyEl = item.querySelector('.ec-cbody');
        bodyEl.innerHTML = ecLinkify(ecEsc(data.body));
        bodyEl.classList.remove('hidden');
        item.querySelector('.ec-edit-wrap').classList.add('hidden');
        item.querySelector('.ec-edit-body').value = data.body;
        var meta = item.querySelector('.flex.items-baseline');
        if (meta && !meta.querySelector('.ec-edited')) {
          var badge = document.createElement('span');
          badge.className = 'ec-edited text-xs text-white/20 italic';
          badge.textContent = 'edited';
          meta.appendChild(badge);
        }
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { editSave.disabled = false; });
      return;
    }

    // Delete
    var delBtn = e.target.closest('.ec-cdelete');
    if (delBtn && !delBtn.disabled) {
      var cid = delBtn.dataset.cid;
      var eid = delBtn.dataset.eid;
      delBtn.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid, { method: 'DELETE' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var item = document.querySelector('.ec-citem[data-cid="' + cid + '"]');
        if (item) item.remove();
        ecUpdateCount(eid, -(data.deletedCount || 1));
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { delBtn.disabled = false; });
      return;
    }

    // Report
    var reportBtn = e.target.closest('.ec-creport');
    if (reportBtn && !reportBtn.disabled) {
      var cid = reportBtn.dataset.cid;
      var eid = reportBtn.dataset.eid;
      reportBtn.disabled = true;
      fetch('/api/entries/' + eid + '/comments/' + cid + '/report', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); reportBtn.disabled = false; return; }
        reportBtn.textContent = 'Reported';
        reportBtn.classList.add('text-white/20');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); reportBtn.disabled = false; });
      return;
    }

  });

}());
</script>
<% } %>
