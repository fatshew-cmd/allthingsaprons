<%- include('../partials/appStart', { title: title, activePage: 'tournaments' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <a href="/tournament/<%= tournament._id %>" class="text-white/40 hover:text-white/70 transition-colors">
        <iconify-icon icon="boxicons:arrow-back" width="18"></iconify-icon>
      </a>
      <h1 class="font-black text-xl tracking-tight m-0">Jury Invitation</h1>
    </div>
  </header>

  <% var totalPrize = tournament.prizes.first + tournament.prizes.second + (tournament.prizes.third || 0); %>

  <div class="px-5 py-6 flex flex-col gap-5">

    <div class="flex items-center gap-3 bg-shark-900 border border-white/10 rounded-md p-3">
      <% if (tournament.thumbnailUrl) { %>
      <img src="<%= tournament.thumbnailUrl %>" class="w-14 h-14 rounded-md object-cover shrink-0" alt="">
      <% } %>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white truncate m-0"><%= tournament.name %></p>
        <p class="text-xs text-white/40 m-0 mt-0.5"><%= tournament.size %> entries &nbsp;·&nbsp; <%= totalPrize.toLocaleString() %> 🌶️ prize pool</p>
      </div>
    </div>

    <p class="text-sm text-white/60 m-0">
      You've been selected to serve as jury for this tournament. As a juror, you'll cast tie-break votes when matches end in a draw. Your identity will never be shown to anyone else.
    </p>

    <div class="flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 rounded-md p-3">
      <iconify-icon icon="boxicons:time" width="16" class="text-amber-400 shrink-0"></iconify-icon>
      <p class="text-xs text-amber-300 m-0">Respond by <span id="jury-invite-deadline" class="font-semibold" data-deadline="<%= new Date(tournament.openDeadline).toISOString() %>"></span> — no response counts as acceptance.</p>
    </div>

    <div class="flex items-center gap-2 mt-2">
      <button type="button" id="jury-invite-decline"
        class="h-12 flex-1 bg-shark-900 hover:bg-shark-800 border border-white/10 text-white/70 text-sm font-semibold rounded-md transition-colors">
        Decline
      </button>
      <button type="button" id="jury-invite-accept"
        class="h-12 flex-1 bg-charm-600 hover:bg-charm-500 text-white text-sm font-semibold rounded-md transition-colors">
        Accept
      </button>
    </div>
    <p id="jury-invite-error" class="hidden text-xs text-red-400 m-0"></p>

  </div>
</div>

<%- include('../partials/appEnd') %>

<script>
(function () {
  var tournamentId = <%- JSON.stringify(tournament._id.toString()) %>;
  var acceptBtn  = document.getElementById('jury-invite-accept');
  var declineBtn = document.getElementById('jury-invite-decline');
  var errorEl    = document.getElementById('jury-invite-error');
  var deadlineEl = document.getElementById('jury-invite-deadline');

  var deadline = new Date(deadlineEl.dataset.deadline);
  deadlineEl.textContent = deadline.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' at ' + deadline.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

  function respond(action) {
    acceptBtn.disabled = true;
    declineBtn.disabled = true;
    errorEl.classList.add('hidden');

    fetch('/tournament/' + tournamentId + '/jury-invite/respond', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: action }),
    })
      .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
      .then(function (res) {
        if (!res.ok) throw new Error(res.data.error || 'Something went wrong.');
        window.location.href = res.data.redirect || ('/tournament/' + tournamentId);
      })
      .catch(function (err) {
        errorEl.textContent = err.message;
        errorEl.classList.remove('hidden');
        acceptBtn.disabled = false;
        declineBtn.disabled = false;
      });
  }

  acceptBtn.addEventListener('click', function () { respond('accept'); });
  declineBtn.addEventListener('click', function () { respond('decline'); });
})();
</script>
