<%- include('../partials/appStart', { title: title, activePage: 'tournaments' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <%
    var SORT_LABELS = {
      recent: 'Most recent', oldest: 'Oldest', rating: 'Highest rated',
      ratingCount: 'Most ratings', followers: 'Most followers',
    };
  %>
  <form method="GET" class="px-5 pt-4 flex flex-wrap items-center gap-2">
    <div class="relative flex-1 min-w-40">
      <iconify-icon icon="boxicons:search" width="16" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-white/30"></iconify-icon>
      <input type="search" name="q" value="<%= search %>" placeholder="Search by username"
        class="w-full bg-shark-900 border border-white/10 rounded-md pl-8 pr-3 py-2 text-sm text-white placeholder-white/25 focus:outline-none focus:border-white/25 transition-colors">
    </div>
    <div class="custom-dropdown relative shrink-0" id="review-sort-dropdown" style="min-width:150px">
      <input type="hidden" name="sort" value="<%= sort %>">
      <button type="button" data-dropdown-trigger
        class="w-full bg-shark-900 border border-white/10 rounded-md px-3 py-2 text-sm text-left flex items-center justify-between gap-2 focus:outline-none transition-colors cursor-pointer text-white">
        <span class="dropdown-label"><%= SORT_LABELS[sort] %></span>
        <iconify-icon data-chevron icon="boxicons:chevron-down" width="14" style="color:rgba(255,255,255,0.3);flex-shrink:0;transition:transform 0.15s ease;display:block"></iconify-icon>
      </button>
      <div class="dropdown-panel absolute z-30 w-full mt-1 bg-shark-900 border border-white/10 rounded-md shadow-xl overflow-hidden" style="display:none">
        <% Object.keys(SORT_LABELS).forEach(function (val) { %>
        <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-white/8 transition-colors cursor-pointer text-white/70" data-value="<%= val %>">
          <span class="opt-label"><%= SORT_LABELS[val] %></span>
          <iconify-icon icon="boxicons:check" width="13" class="check-icon" style="display:none;color:#e680a6;flex-shrink:0"></iconify-icon>
        </button>
        <% }) %>
      </div>
    </div>
  </form>

  <div class="px-5 py-5">
    <% if (!pendingEntries.length) { %>
      <div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
        <iconify-icon icon="boxicons:inbox" width="32" class="text-white/15"></iconify-icon>
        <p class="text-sm text-white/30 m-0"><%= search ? 'No candidates match that search.' : 'No candidates waiting for review.' %></p>
      </div>
    <% } else { %>
      <div class="flex flex-col gap-3" id="review-rows">
        <% pendingEntries.forEach(function(pe) { %>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-start gap-3 bg-shark-900 border border-white/10 rounded-md p-3" data-entry-row="<%= pe._id %>">

            <% var _candFollowing = followingSet.has(pe.userId?._id?.toString()); %>
            <div class="flex flex-col gap-3 w-full sm:w-44 shrink-0">
              <div class="flex items-center gap-1.5 min-w-0">
                <a href="/<%= pe.userId?.username?.value %>" class="flex items-center gap-2 min-w-0 flex-1 no-underline">
                  <span class="shrink-0 w-8 h-8 rounded-full overflow-hidden bg-charm-950 flex items-center justify-center">
                    <% if (pe.userId?.avatar?.value) { %>
                      <img src="<%= pe.userId.avatar.value %>" class="w-full h-full object-cover" alt="">
                    <% } else { %>
                      <iconify-icon icon="boxicons:user-filled" width="16" style="color:#e680a6"></iconify-icon>
                    <% } %>
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-white truncate m-0"><%= pe.userId?.displayName?.value || pe.userId?.username?.value %></p>
                    <p class="text-xs text-white/40 truncate m-0">@<%= pe.userId?.username?.value %></p>
                  </div>
                </a>
                <button type="button" class="tournament-entry-follow-btn shrink-0 w-7 h-7 flex items-center justify-center rounded-md transition-colors cursor-pointer <%= _candFollowing ? 'text-white hover:text-red-400' : 'text-white hover:text-charm-400' %>"
                  data-username="<%= pe.userId?.username?.value %>" data-following="<%= _candFollowing ? 'true' : 'false' %>">
                  <iconify-icon icon="<%= _candFollowing ? 'boxicons:user-check' : 'boxicons:user-plus' %>" width="17"></iconify-icon>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex flex-col items-center flex-1">
                  <span class="text-base font-bold leading-tight"><%= pe.followerCount || 0 %></span>
                  <span class="text-[10px] text-white/40 mt-0.5">Followers</span>
                </div>
                <div class="flex flex-col items-center flex-1">
                  <span class="text-base font-bold leading-tight"><%= pe.entryId?.ratingAvg ? pe.entryId.ratingAvg.toFixed(1) : '0' %></span>
                  <span class="text-[10px] text-white/40 mt-0.5">Avg Rating</span>
                </div>
                <div class="flex flex-col items-center flex-1">
                  <span class="text-base font-bold leading-tight"><%= nominationCountMap[pe.userId?._id?.toString()] || 0 %></span>
                  <span class="text-[10px] text-white/40 mt-0.5">Nominations</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button type="button" class="reject-btn flex-1 text-xs font-semibold px-3 py-1.5 rounded-md bg-white/8 text-white/60 hover:bg-red-500/15 hover:text-red-400 transition-colors">Reject</button>
                <button type="button" class="approve-btn flex-1 text-xs font-semibold px-3 py-1.5 rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors">Approve</button>
              </div>
            </div>

            <div class="h-px w-full sm:h-auto sm:w-px sm:self-stretch bg-white/10 shrink-0"></div>

            <a href="/entry/<%= pe.entryId?._id %>" class="flex flex-col gap-1.5 min-w-0 flex-1 no-underline">
              <div class="relative w-full aspect-square rounded-md overflow-hidden bg-shark-800 shrink-0">
                <% if (pe.entryId?.mediaType === 'video') { %>
                  <video src="<%= pe.entryId.mediaUrl %>" class="w-full h-full object-contain pointer-events-none" muted preload="none"></video>
                  <iconify-icon icon="boxicons:play" width="22" class="absolute inset-0 m-auto text-white/90"></iconify-icon>
                <% } else if (pe.entryId?.mediaUrl) { %>
                  <img src="<%= pe.entryId.mediaUrl %>" class="w-full h-full object-contain" alt="">
                <% } %>
              </div>
              <div class="min-w-0 max-w-full text-left">
                <p class="text-base font-semibold text-white truncate m-0"><%= pe.entryId?.title || 'Untitled entry' %></p>
                <% if (pe.entryId?.caption) { %>
                <p class="text-xs text-white/50 line-clamp-2 m-0 mt-1"><%= pe.entryId.caption %></p>
                <% } %>
                <div class="flex items-center gap-4 mt-2">
                  <span class="flex items-center gap-1.5 text-white/50">
                    <iconify-icon icon="boxicons:bar-chart" width="15" class="shrink-0"></iconify-icon>
                    <span class="text-xs font-medium">0</span>
                  </span>
                  <span class="flex items-center gap-1.5 text-amber-300">
                    <iconify-icon icon="boxicons:star-filled" width="13" class="text-amber-400 shrink-0"></iconify-icon>
                    <span class="text-xs font-semibold"><%= pe.entryId?.ratingAvg ? pe.entryId.ratingAvg.toFixed(1) : '0' %></span>
                  </span>
                  <span class="flex items-center gap-1.5 text-white/50">
                    <iconify-icon icon="boxicons:git-compare" width="15" class="shrink-0"></iconify-icon>
                    <span class="text-xs font-medium"><%= pe.entryId?.takeOnCount || 0 %></span>
                  </span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Cap Reached Confirmation Modal -->
<div id="cap-reached-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="cap-reached-modal-backdrop"></div>
  <div class="relative w-full max-w-sm bg-shark-900 border border-white/10 rounded-md shadow-2xl">
    <div class="p-6">

      <div class="flex items-start gap-3 mb-5">
        <div class="w-10 h-10 rounded-md bg-charm-500/10 flex items-center justify-center shrink-0 overflow-hidden mt-0.5">
          <% if (tournament.thumbnailUrl) { %>
            <img src="<%= tournament.thumbnailUrl %>" class="w-full h-full object-cover" alt="">
          <% } else { %>
            <iconify-icon icon="boxicons:trophy" width="18" style="color:#c45c7a"></iconify-icon>
          <% } %>
        </div>
        <div>
          <p class="font-bold text-white text-base leading-snug">Start the tournament now?</p>
          <p class="text-sm text-white/45 mt-1">You just approved the last candidate needed (<%= tournament.size %>/<%= tournament.size %>). You can go live immediately, or leave this candidate in review a little longer.</p>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="button" id="cap-reached-not-yet-btn"
          class="flex-1 py-2.5 rounded-md border border-white/10 text-white/60 text-sm font-semibold hover:bg-white/5 transition-colors cursor-pointer">
          Not yet
        </button>
        <button type="button" id="cap-reached-confirm-btn"
          class="flex-1 py-2.5 rounded-md bg-charm-600 text-white text-sm font-semibold hover:bg-charm-500 transition-colors cursor-pointer">
          Go live now
        </button>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/appEnd') %>

<script>
(function () {
  var tournamentId = <%- JSON.stringify(tournament._id.toString()) %>;
  var capState = null; // { eid, row } — the row awaiting a go-live/not-yet decision

  var capModal      = document.getElementById('cap-reached-modal');
  var capBackdrop   = document.getElementById('cap-reached-modal-backdrop');
  var capNotYetBtn  = document.getElementById('cap-reached-not-yet-btn');
  var capConfirmBtn = document.getElementById('cap-reached-confirm-btn');

  function openCapModal(eid, row) {
    capState = { eid: eid, row: row };
    capModal.classList.remove('hidden');
    capModal.classList.add('flex');
  }
  function closeCapModal() {
    capModal.classList.add('hidden');
    capModal.classList.remove('flex');
  }
  function reenableRow(row) {
    row.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
  }

  function handleAction(btn, action) {
    var row = btn.closest('[data-entry-row]');
    var eid = row.getAttribute('data-entry-row');
    row.querySelectorAll('button').forEach(function (b) { b.disabled = true; });

    fetch('/api/tournaments/' + tournamentId + '/entries/' + eid + '/' + action, { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.success) {
          if (action === 'approve' && data.capReached) {
            openCapModal(eid, row);
            return;
          }
          row.remove();
          if (window.showToast) window.showToast(action === 'approve' ? 'Entry approved.' : 'Entry rejected.', 'success');
        } else {
          reenableRow(row);
          if (window.showToast) window.showToast((data && data.error) || 'Something went wrong.', 'error');
        }
      })
      .catch(function () {
        reenableRow(row);
        if (window.showToast) window.showToast('Something went wrong.', 'error');
      });
  }

  document.getElementById('review-rows')?.addEventListener('click', function (e) {
    var approveBtn = e.target.closest('.approve-btn');
    var rejectBtn  = e.target.closest('.reject-btn');
    if (approveBtn) handleAction(approveBtn, 'approve');
    if (rejectBtn)  handleAction(rejectBtn, 'reject');

    var followBtn = e.target.closest('.tournament-entry-follow-btn');
    if (followBtn) {
      if (followBtn.disabled) return;
      followBtn.disabled = true;
      var username  = followBtn.dataset.username;
      var following = followBtn.dataset.following === 'true';
      var url       = following ? '/unfollow/' + username : '/follow/' + username;
      fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var nowFollowing = data.following;
          followBtn.dataset.following = nowFollowing ? 'true' : 'false';
          followBtn.classList.remove('hover:text-red-400', 'hover:text-charm-400');
          followBtn.classList.add(nowFollowing ? 'hover:text-red-400' : 'hover:text-charm-400');
          followBtn.querySelector('iconify-icon').setAttribute('icon', nowFollowing ? 'boxicons:user-check' : 'boxicons:user-plus');
        })
        .finally(function () { followBtn.disabled = false; });
      return;
    }

    var copyBtn = e.target.closest('.wildcard-stain-copy-btn');
    if (copyBtn) {
      e.preventDefault();
      e.stopPropagation();
      var icon  = copyBtn.querySelector('iconify-icon');
      var stain = copyBtn.closest('.wildcard-stain-badge').dataset.stain;
      navigator.clipboard.writeText(stain).then(function () {
        if (window.showToast) window.showToast('Copied #' + stain, 'success');
        icon.setAttribute('icon', 'boxicons:check');
        setTimeout(function () { icon.setAttribute('icon', 'boxicons:copy'); }, 1200);
      }).catch(function () {
        if (window.showToast) window.showToast('Could not copy', 'error');
      });
    }
  });

  function declineCapModal() {
    if (!capState) return;
    var eid = capState.eid, row = capState.row;
    closeCapModal();
    fetch('/api/tournaments/' + tournamentId + '/entries/' + eid + '/revert', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        reenableRow(row);
        if (data && data.success) {
          if (window.showToast) window.showToast('Kept in review — approve again when you\'re ready.', 'success');
        } else if (window.showToast) {
          window.showToast((data && data.error) || 'Something went wrong.', 'error');
        }
      })
      .catch(function () {
        reenableRow(row);
        if (window.showToast) window.showToast('Something went wrong.', 'error');
      });
  }

  capNotYetBtn.addEventListener('click', declineCapModal);
  capBackdrop.addEventListener('click', declineCapModal);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !capModal.classList.contains('hidden')) declineCapModal();
  });

  capConfirmBtn.addEventListener('click', function () {
    if (!capState) return;
    capConfirmBtn.disabled = true;
    capConfirmBtn.textContent = 'Starting…';
    fetch('/api/tournaments/' + tournamentId + '/advance-now', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.success) {
          window.location.href = '/tournament/' + tournamentId;
          return;
        }
        capConfirmBtn.disabled = false;
        capConfirmBtn.textContent = 'Go live now';
        var row = capState.row;
        closeCapModal();
        reenableRow(row);
        if (window.showToast) window.showToast((data && data.error) || 'Something went wrong.', 'error');
      })
      .catch(function () {
        capConfirmBtn.disabled = false;
        capConfirmBtn.textContent = 'Go live now';
        var row = capState.row;
        closeCapModal();
        reenableRow(row);
        if (window.showToast) window.showToast('Something went wrong.', 'error');
      });
  });
})();
</script>

<script>
(function () {
  var closers = [];

  function initDropdown(containerId, onSelect) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var trigger = container.querySelector('[data-dropdown-trigger]');
    var panel   = container.querySelector('.dropdown-panel');
    var label   = container.querySelector('.dropdown-label');
    var chevron = container.querySelector('[data-chevron]');
    var hidden  = container.querySelector('input[type="hidden"]');
    var options = container.querySelectorAll('.dropdown-option');
    var isOpen  = false;

    function open() {
      closers.forEach(function (fn) { fn(); });
      panel.style.display = 'block';
      chevron.style.transform = 'rotate(180deg)';
      trigger.style.borderColor = 'rgba(230,128,166,0.5)';
      isOpen = true;
    }
    function close() {
      panel.style.display = 'none';
      chevron.style.transform = '';
      trigger.style.borderColor = '';
      isOpen = false;
    }
    closers.push(close);

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      isOpen ? close() : open();
    });

    options.forEach(function (opt) {
      var check = opt.querySelector('.check-icon');
      if (opt.getAttribute('data-value') === hidden.value) check.style.display = 'block';
      opt.addEventListener('click', function () {
        hidden.value = opt.getAttribute('data-value');
        label.textContent = opt.querySelector('.opt-label').textContent;
        options.forEach(function (o) { o.querySelector('.check-icon').style.display = 'none'; });
        check.style.display = 'block';
        close();
        if (onSelect) onSelect();
      });
    });

    document.addEventListener('click', function (e) {
      if (isOpen && !container.contains(e.target)) close();
    });
  }

  initDropdown('review-sort-dropdown', function () {
    document.getElementById('review-sort-dropdown').closest('form').submit();
  });
})();
</script>
