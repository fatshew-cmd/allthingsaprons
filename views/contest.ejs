<%- include('partials/appStart', { title: title, activePage: '' }) %>

<%
  var statusCls = {
    pending: 'bg-amber-500/15 text-amber-400',
    active:  'bg-green-500/15 text-green-400',
    void:    'bg-white/10 text-white/40',
    closed:  'bg-red-500/15 text-red-400',
  }[effectiveStatus] || 'bg-white/10 text-white/40';

  var winnerSide = null;
  if (left && left.isWinner) winnerSide = left;
  else if (right && right.isWinner) winnerSide = right;
%>

<div class="max-w-2xl mx-auto pb-24 md:pb-8">

  <!-- Header -->
  <div class="sticky top-0 z-10 flex items-center gap-3 px-4 py-3 bg-shark-950/95 backdrop-blur-sm border-b border-white/10">
    <button onclick="history.back()" class="w-8 h-8 flex items-center justify-center rounded-md text-white/50 hover:bg-white/8 hover:text-white transition-colors cursor-pointer shrink-0">
      <iconify-icon icon="boxicons:chevron-left" width="22"></iconify-icon>
    </button>
    <span class="font-bold text-base flex-1">H2H Contest</span>
    <% var _isParticipant = locals.isNominator || locals.isNominee ||
      (locals.currentUser && (contest.entries || []).some(function(e) { return String(e.userId) === String(locals.currentUser._id); })); %>
    <% if (!_isParticipant) { %>
    <button id="cv-loop-btn" type="button"
      data-contest-id="<%= contest._id %>"
      data-looped-in="<%= locals.isLoopedIn ? 'true' : 'false' %>"
      title="<%= locals.isLoopedIn ? 'Leave the loop' : 'Stay in the loop' %>"
      class="w-8 h-8 flex items-center justify-center rounded-md transition-colors cursor-pointer shrink-0 <%= locals.isLoopedIn ? 'text-charm-400 hover:text-white/50' : 'text-zinc-400 hover:text-zinc-200' %>">
      <iconify-icon icon="<%= locals.isLoopedIn ? 'boxicons:bell-ring-filled' : 'boxicons:bell' %>" width="18"></iconify-icon>
    </button>
    <% } %>
    <span class="text-xs font-semibold px-2 py-0.5 rounded-md <%= statusCls %>"><%= statusLabel %></span>
  </div>

  <% if (locals.isTiebreakerMatch) { %>
  <div class="px-4 py-2.5 border-b border-purple-500/30 bg-purple-500/8 flex items-center gap-2.5">
    <iconify-icon icon="boxicons:medal" width="16" class="text-purple-400 shrink-0"></iconify-icon>
    <span class="text-sm text-white/70"><span class="font-semibold text-white">Tie Breaker Contest</span> — these two entries tied in their group and this match decides who advances</span>
  </div>
  <% } %>

  <!-- Status banners -->
  <% if (effectiveStatus === 'active' && contest.votingDeadline) { %>
  <div class="px-4 py-2.5 border-b border-white/10 flex items-center gap-2">
    <iconify-icon icon="boxicons:time-five" width="15" class="text-charm-400 shrink-0"></iconify-icon>
    <span class="text-sm text-white/50 flex-1">Voting closes <span id="contest-deadline" data-ts="<%= new Date(contest.votingDeadline).getTime() %>" class="text-white font-medium">...</span></span>
    <% if (locals.isNominator || locals.isNominee) { %>
    <button id="cv-forfeit-btn" type="button" data-contest-id="<%= contest._id %>"
      class="shrink-0 text-xs font-medium text-white/50 hover:text-red-400 transition-colors cursor-pointer"
      title="Drop out of contest">
      Drop Out Contest
    </button>
    <% } %>
  </div>
  <% } %>

  <% if (contest.status === 'pending' && contest.voidDeadline) { %>
  <div class="px-4 py-2.5 border-b border-white/10 flex items-center gap-2">
    <iconify-icon icon="boxicons:time-five" width="15" class="text-amber-400 shrink-0"></iconify-icon>
    <span class="text-sm text-white/50 flex-1">Nomination expires <span id="contest-void-deadline" data-ts="<%= new Date(contest.voidDeadline).getTime() %>" class="text-amber-300 font-medium">...</span></span>
    <button id="cv-share-btn" type="button" class="shrink-0 flex items-center gap-1 text-xs font-medium text-white/50 hover:text-white/80 transition-colors cursor-pointer">
      <iconify-icon icon="boxicons:share" width="14"></iconify-icon>
      Share
    </button>
    <% if (locals.isNominator) { %>
    <button id="cv-void-btn" type="button" data-contest-id="<%= contest._id %>"
      class="shrink-0 text-xs font-medium text-white/50 hover:text-red-400 transition-colors cursor-pointer"
      title="Cancel contest">
      Cancel
    </button>
    <% } %>
  </div>
  <% } %>

  <% if (winnerSide && (contest.status === 'closed' || (contest.status === 'void' && (contest.voidReason === 'nominee_forfeit' || contest.voidReason === 'nominator_forfeit')))) { %>
  <div class="px-4 py-3 border-b border-charm-500/30 bg-charm-500/8 flex items-center gap-2.5">
    <iconify-icon icon="boxicons:trophy" width="17" class="text-charm-400 shrink-0"></iconify-icon>
    <span class="text-sm font-semibold text-white">
      <%= winnerSide.user?.displayName?.value || ('@' + winnerSide.user?.username?.value) %> wins this contest<% if (contest.status === 'void') { %> by forfeit<% } %>
    </span>
  </div>
  <% } %>

  <% if (contest.status === 'void') { %>
  <%
    var voidBannerText = {
      expired:          'The nomination expired without a response.',
      declined:         'The nominee declined this contest.',
      canceled:         'This contest was canceled by the creator.',
      nominee_forfeit:  (right?.user?.displayName?.value || (right?.user?.username?.value ? '@' + right.user.username.value : 'The nominee')) + ' forfeited this contest.',
      nominator_forfeit: (left?.user?.displayName?.value  || (left?.user?.username?.value  ? '@' + left.user.username.value  : 'The creator')) + ' forfeited this contest.',
    }[contest.voidReason] || 'This contest was voided.';
  %>
  <div class="px-4 py-3 border-b border-white/10 flex items-center gap-2.5">
    <iconify-icon icon="boxicons:x-circle" width="15" class="text-white/30 shrink-0"></iconify-icon>
    <span class="text-sm text-white/40 flex-1"><%- voidBannerText %></span>
    <% if (locals.isNominator || locals.isNominee) { %>
    <button id="cv-void-btn" type="button" data-contest-id="<%= contest._id %>"
      class="shrink-0 text-xs font-medium text-white/30 hover:text-red-400 transition-colors cursor-pointer"
      title="Remove this contest record">
      Remove
    </button>
    <% } %>
  </div>
  <% } %>

  <% if (locals.pendingTakeOnNomId && contest.status === 'pending') { %>
  <!-- Take-on Accept/Decline banner (nominee only) -->
  <div class="px-4 py-4 border-b border-white/10">
    <p class="text-sm text-white/60 mb-3"><strong class="text-white"><%= left?.user?.displayName?.value || (left?.user?.username?.value ? '@' + left.user.username.value : 'Someone') %></strong> wants to go head-to-head with you. Accept to start the contest, or decline to pass.</p>
    <div id="takeon-error" class="hidden items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-3">
      <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
      <span id="takeon-error-text"></span>
    </div>
    <div class="flex gap-3">
      <button id="cv-takeon-accept-btn" data-nom-id="<%= locals.pendingTakeOnNomId %>"
        class="flex-1 bg-charm-600 hover:bg-charm-500 text-white font-bold rounded-md py-2.5 text-sm transition-colors cursor-pointer">
        Accept
      </button>
      <button id="cv-takeon-decline-btn" data-nom-id="<%= locals.pendingTakeOnNomId %>"
        class="flex-1 border border-white/15 text-white/50 hover:border-white/30 hover:text-white/70 font-semibold rounded-md py-2.5 text-sm transition-colors cursor-pointer">
        Decline
      </button>
    </div>
  </div>
  <% } %>

  <!-- VS layout -->
  <div class="px-4 pt-5 pb-4">
    <div class="flex flex-col gap-0 md:grid md:grid-cols-[1fr_36px_1fr]">

      <!-- ── Left side (nominator) ── -->
      <% var ls = left; var showLeftEntry = ls && ls.entry && (!ls.hidden || contest.status !== 'pending'); %>
      <div class="flex flex-col gap-2.5">

        <a href="<%= ls && ls.entryId ? '/entry/' + ls.entryId : '#' %>" class="block relative aspect-square rounded-md overflow-hidden bg-shark-900 <%= (!ls || !showLeftEntry) ? 'pointer-events-none' : '' %>">
          <% if (ls && showLeftEntry) { %>
            <% if (ls.entry.mediaType === 'video') { %>
            <video src="<%= ls.entry.mediaUrl %>" class="w-full h-full object-cover rounded-md" muted preload="none"></video>
            <div class="absolute inset-0 flex items-center justify-center">
              <iconify-icon icon="boxicons:play-circle" width="40" class="text-white/80"></iconify-icon>
            </div>
            <% } else { %>
            <img src="<%= ls.entry.mediaUrl %>" alt="" class="w-full h-full object-cover rounded-md">
            <% } %>
          <% } else if (ls && ls.hidden && contest.status === 'pending') { %>
          <div class="w-full h-full flex flex-col items-center justify-center text-white/15 gap-1.5">
            <iconify-icon icon="boxicons:lock" width="28"></iconify-icon>
            <span class="text-xs text-white/20">Hidden until accepted</span>
          </div>
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-white/15">
            <iconify-icon icon="boxicons:image" width="28"></iconify-icon>
          </div>
          <% } %>
          <% if (ls && ls.isWinner) { %>
          <div class="absolute inset-0 ring-[3px] ring-inset ring-yellow-400 rounded-md pointer-events-none"></div>
          <% } %>
          <% var _lsTopContrib = locals.topContributionEntryId && ls && ls.entryId && ls.entryId === locals.topContributionEntryId.toString(); %>
          <% if ((ls && ls.isWinner) || _lsTopContrib) { %>
          <div class="absolute top-2 right-2 flex flex-col items-center gap-1.5 pointer-events-none">
            <% if (ls && ls.isWinner) { %>
            <div class="w-7 h-7 rounded-full bg-yellow-400 flex items-center justify-center shadow-md">
              <iconify-icon icon="boxicons:thumb-up-filled" width="14" class="text-black"></iconify-icon>
            </div>
            <% } %>
            <% if (_lsTopContrib) { %>
            <div class="w-7 h-7 rounded-full bg-charm-600 flex items-center justify-center shadow-md">
              <iconify-icon icon="boxicons:dollar-circle-stars-filled" width="14" class="text-white"></iconify-icon>
            </div>
            <% } %>
          </div>
          <% } else if (ls && ls.iVotedFor) { %>
          <div class="absolute top-2 right-2 w-6 h-6 rounded-full bg-charm-500 flex items-center justify-center shadow-md">
            <iconify-icon icon="boxicons:check" width="14" class="text-white"></iconify-icon>
          </div>
          <% } %>
          <% if (ls && ls.entry && ls.entry.aiGenerated) { %>
          <div class="absolute bottom-2 left-2 bg-violet-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
          <% } %>
        </a>

        <% if (ls && ls.user) { %>
        <% var _lsF = followingIds && followingIds[ls.userId]; %>
        <div class="flex items-center gap-2 min-w-0">
          <a href="/<%= ls.user.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center hover:opacity-80 transition-opacity">
            <% if (ls.user.avatar?.value) { %>
            <img src="<%= ls.user.avatar.value %>" class="w-full h-full object-cover">
            <% } else { %>
            <iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>
            <% } %>
          </a>
          <div class="flex flex-col min-w-0 flex-1">
            <a href="/<%= ls.user.username?.value %>" class="text-sm font-semibold text-white/80 truncate leading-tight hover:opacity-80 transition-opacity"><%= ls.user.displayName?.value || ('@' + ls.user.username?.value) %></a>
            <a href="/<%= ls.user.username?.value %>" class="text-xs text-white/35 truncate leading-tight hover:opacity-80 transition-opacity">@<%= ls.user.username?.value %></a>
          </div>
          <% if (!ls.isMine) { %>
          <button type="button" class="contest-follow-btn shrink-0 text-xs font-semibold px-2.5 py-1 rounded-md transition-colors cursor-pointer <%= _lsF ? 'border border-white/30 text-white/50 hover:bg-white/8' : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10' %>"
            data-username="<%= ls.user.username?.value %>" data-following="<%= _lsF ? 'true' : 'false' %>">
            <%= _lsF ? 'Following' : 'Follow' %>
          </button>
          <% } %>
        </div>
        <% } %>

        <% if ((ls && ls.entry && (ls.entry.title || ls.entry.caption || ls.entry.tags && ls.entry.tags.length))) { %>
        <div class="flex flex-col gap-1 mt-1">
          <% if (ls.entry.title) { %>
          <p class="text-sm font-semibold text-white leading-snug"><%= ls.entry.title %></p>
          <% } %>
          <% if (ls.entry.caption) { %>
          <p class="text-xs text-white/45 line-clamp-2 leading-relaxed"><%= ls.entry.caption %></p>
          <% } %>
          <% if (ls.entry.tags && ls.entry.tags.length) { %>
          <div class="flex flex-wrap gap-x-2 gap-y-0.5">
            <% ls.entry.tags.forEach(function(t) { %><span class="text-xs text-charm-400/70">#<%= t %></span><% }); %>
          </div>
          <% } %>
        </div>
        <% } %>

        <% if (ls && ls.entryId) { %>
        <div class="flex items-center gap-1">
          <% if (showLeftEntry) { %>
          <% if (ls.isMine) { %>
          <div class="cursor-not-allowed shrink-0">
            <a href="#" class="flex items-center gap-1.5 h-10 px-2 rounded-md text-white/50 pointer-events-none">
              <iconify-icon icon="boxicons:git-compare" width="20"></iconify-icon>
              <span class="text-sm font-semibold">0</span>
            </a>
          </div>
          <% } else { %>
          <a href="/submit?challenge=<%= ls.entryId %>" class="flex items-center gap-1.5 h-10 px-2 rounded-md text-white/50 hover:text-charm-400 transition-colors shrink-0">
            <iconify-icon icon="boxicons:git-compare" width="20"></iconify-icon>
            <span class="text-sm font-semibold">0</span>
          </a>
          <% } %>
          <% } %>
          <div data-cv-action="<%= ls.entryId %>">
            <% if (canVote && !ls.isMine) { %>
            <button class="contest-vote-btn flex items-center gap-2 h-8 px-2 text-amber-400 hover:text-amber-300 transition-colors cursor-pointer font-semibold text-sm"
              data-contest-id="<%= contest._id %>"
              data-entry-id="<%= ls.entryId %>">
              <iconify-icon icon="boxicons:thumb-up" width="16"></iconify-icon>
              <span><%= ls.voteCount %></span>
            </button>
            <% } else if (ls.iVotedFor) { %>
            <button class="contest-unvote-btn flex items-center gap-2 h-8 px-2 text-amber-300 hover:text-white/50 transition-colors cursor-pointer font-semibold text-sm" data-contest-id="<%= contest._id %>">
              <iconify-icon icon="boxicons:thumb-up-filled" width="16"></iconify-icon>
              <span><%= ls.voteCount %></span>
            </button>
            <% } else { %>
            <div class="cursor-not-allowed">
              <button disabled class="flex items-center gap-2 h-8 px-2 text-white/50 font-semibold text-sm pointer-events-none">
                <iconify-icon icon="boxicons:thumb-up" width="16"></iconify-icon>
                <span><%= ls.voteCount %></span>
              </button>
            </div>
            <% } %>
          </div>
          <% if (ls.isMine) { %>
          <div class="cursor-not-allowed">
            <button type="button" class="flex items-center gap-1.5 h-8 px-2 font-semibold text-sm text-white/50 pointer-events-none">
              <span>🌶️</span>
              <span><%= grossByEntry[ls.entryId] || 0 %></span>
            </button>
          </div>
          <% } else { %>
          <button type="button" data-contrib-open="left"
            class="flex items-center gap-1.5 h-8 px-2 font-semibold text-sm text-white/50 hover:text-charm-400 transition-colors cursor-pointer">
            <span>🌶️</span>
            <span><%= grossByEntry[ls.entryId] || 0 %></span>
          </button>
          <% } %>
        </div>
        <% } %>

      </div><!-- /left -->

      <!-- ── VS divider ── -->
      <div class="flex items-center gap-3 py-5 md:flex-col md:justify-center md:py-0 md:gap-0">
        <div class="flex-1 h-px bg-white/8 md:hidden"></div>
        <span class="text-xs md:text-[10px] font-black text-white/20 tracking-widest">VS</span>
        <div class="flex-1 h-px bg-white/8 md:hidden"></div>
      </div>

      <!-- ── Right side (nominee) ── -->
      <% var rs = right; var showRightEntry = rs && rs.entry; %>
      <% var _ne = locals.nomineeEntry; %>
      <div class="flex flex-col gap-2.5">

        <a href="<%= rs && rs.entryId ? '/entry/' + rs.entryId : (_ne ? '/entry/' + _ne._id : '#') %>" class="block relative aspect-square rounded-md overflow-hidden bg-shark-900 <%= (!rs && !_ne) ? 'pointer-events-none' : '' %>">
          <% if (rs && showRightEntry) { %>
            <% if (rs.entry.mediaType === 'video') { %>
            <video src="<%= rs.entry.mediaUrl %>" class="w-full h-full object-cover rounded-md" muted preload="none"></video>
            <div class="absolute inset-0 flex items-center justify-center">
              <iconify-icon icon="boxicons:play-circle" width="40" class="text-white/80"></iconify-icon>
            </div>
            <% } else { %>
            <img src="<%= rs.entry.mediaUrl %>" alt="" class="w-full h-full object-cover rounded-md">
            <% } %>
          <% } else if (_ne) { %>
            <% if (_ne.mediaType === 'video') { %>
            <video src="<%= _ne.mediaUrl %>" class="w-full h-full object-cover rounded-md" muted preload="none"></video>
            <div class="absolute inset-0 flex items-center justify-center">
              <iconify-icon icon="boxicons:play-circle" width="40" class="text-white/80"></iconify-icon>
            </div>
            <% } else { %>
            <img src="<%= _ne.mediaUrl %>" alt="" class="w-full h-full object-cover rounded-md">
            <% } %>
          <% } else { %>
          <div class="w-full h-full flex flex-col items-center justify-center text-white/15 gap-1.5">
            <iconify-icon icon="boxicons:user-plus" width="28"></iconify-icon>
            <span class="text-xs text-white/20">Awaiting entry</span>
          </div>
          <% } %>
          <% if (rs && rs.isWinner) { %>
          <div class="absolute inset-0 ring-[3px] ring-inset ring-yellow-400 rounded-md pointer-events-none"></div>
          <% } %>
          <% var _rsTopContrib = locals.topContributionEntryId && rs && rs.entryId && rs.entryId === locals.topContributionEntryId.toString(); %>
          <% if ((rs && rs.isWinner) || _rsTopContrib) { %>
          <div class="absolute top-2 right-2 flex flex-col items-center gap-1.5 pointer-events-none">
            <% if (rs && rs.isWinner) { %>
            <div class="w-7 h-7 rounded-full bg-yellow-400 flex items-center justify-center shadow-md">
              <iconify-icon icon="boxicons:thumb-up-filled" width="14" class="text-black"></iconify-icon>
            </div>
            <% } %>
            <% if (_rsTopContrib) { %>
            <div class="w-7 h-7 rounded-full bg-charm-600 flex items-center justify-center shadow-md">
              <iconify-icon icon="boxicons:dollar-circle-stars-filled" width="14" class="text-white"></iconify-icon>
            </div>
            <% } %>
          </div>
          <% } else if (rs && rs.iVotedFor) { %>
          <div class="absolute top-2 right-2 w-6 h-6 rounded-full bg-charm-500 flex items-center justify-center shadow-md">
            <iconify-icon icon="boxicons:check" width="14" class="text-white"></iconify-icon>
          </div>
          <% } %>
          <% if (rs && rs.entry && rs.entry.aiGenerated) { %>
          <div class="absolute bottom-2 left-2 bg-violet-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md uppercase tracking-wide pointer-events-none">AI Generated</div>
          <% } %>
        </a>

        <% var rsUser = (rs && rs.user) ? rs.user : null; %>
        <% if (rsUser || nomineeUser) { %>
        <% var displayUser = rsUser || nomineeUser; var isPending = !rsUser; %>
        <% var _rsId = rs ? rs.userId : (nomineeUser ? nomineeUser._id.toString() : null); %>
        <% var _rsIsMine = rs ? rs.isMine : false; %>
        <% var _rsF = followingIds && _rsId && followingIds[_rsId]; %>
        <div class="flex items-center gap-2 min-w-0">
          <a href="/<%= displayUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center hover:opacity-80 transition-opacity">
            <% if (displayUser.avatar?.value) { %>
            <img src="<%= displayUser.avatar.value %>" class="w-full h-full object-cover">
            <% } else { %>
            <iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>
            <% } %>
          </a>
          <div class="flex flex-col min-w-0 flex-1">
            <a href="/<%= displayUser.username?.value %>" class="text-sm font-semibold text-white/80 truncate leading-tight hover:opacity-80 transition-opacity"><%= displayUser.displayName?.value || ('@' + displayUser.username?.value) %></a>
            <a href="/<%= displayUser.username?.value %>" class="text-xs text-white/35 truncate leading-tight hover:opacity-80 transition-opacity">@<%= displayUser.username?.value %></a>
          </div>
          <% if (isPending && locals.isNominator) { %>
          <button type="button" class="contest-follow-btn shrink-0 text-xs font-semibold px-2.5 py-1 rounded-md transition-colors cursor-pointer <%= _rsF ? 'border border-white/30 text-white/50 hover:bg-white/8' : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10' %>"
            data-username="<%= displayUser.username?.value %>" data-following="<%= _rsF ? 'true' : 'false' %>">
            <%= _rsF ? 'Following' : 'Follow' %>
          </button>
          <% } else if (!_rsIsMine) { %>
          <button type="button" class="contest-follow-btn shrink-0 text-xs font-semibold px-2.5 py-1 rounded-md transition-colors cursor-pointer <%= _rsF ? 'border border-white/30 text-white/50 hover:bg-white/8' : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10' %>"
            data-username="<%= displayUser.username?.value %>" data-following="<%= _rsF ? 'true' : 'false' %>">
            <%= _rsF ? 'Following' : 'Follow' %>
          </button>
          <% } %>
        </div>
        <% } else { %>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-shark-800 border border-white/10 shrink-0"></div>
          <span class="text-sm text-white/25"><%= contest.status === 'void' ? 'No response' : 'Awaiting nominee' %></span>
        </div>
        <% } %>

        <div class="flex flex-col gap-1 mt-1">
          <% if (isPending && _ne && _ne.title) { %>
          <p class="text-sm font-semibold text-white leading-snug"><%= _ne.title %></p>
          <% } else if (!isPending && rs && rs.entry && rs.entry.title) { %>
          <p class="text-sm font-semibold text-white leading-snug"><%= rs.entry.title %></p>
          <% } %>
          <% if (isPending && _ne && _ne.caption) { %>
          <p class="text-xs text-white/45 line-clamp-2 leading-relaxed"><%= _ne.caption %></p>
          <% } else if (rs && rs.entry && rs.entry.caption) { %>
          <p class="text-xs text-white/45 line-clamp-2 leading-relaxed"><%= rs.entry.caption %></p>
          <% } %>
          <% if (isPending && _ne && _ne.tags && _ne.tags.length) { %>
          <div class="flex flex-wrap gap-x-2 gap-y-0.5">
            <% _ne.tags.forEach(function(t) { %><span class="text-xs text-charm-400/70">#<%= t %></span><% }); %>
          </div>
          <% } else if (rs && rs.entry && rs.entry.tags && rs.entry.tags.length) { %>
          <div class="flex flex-wrap gap-x-2 gap-y-0.5">
            <% rs.entry.tags.forEach(function(t) { %><span class="text-xs text-charm-400/70">#<%= t %></span><% }); %>
          </div>
          <% } %>
        </div>

        <% if (isPending) { %>
        <div class="w-fit border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-semibold px-2.5 py-1 rounded-md">Has yet to accept take-on</div>
        <% } %>

        <% if (rs && rs.entryId) { %>
        <div class="flex items-center gap-1">
          <% if (showRightEntry) { %>
          <% if (rs.isMine) { %>
          <div class="cursor-not-allowed shrink-0">
            <a href="#" class="flex items-center gap-1.5 h-10 px-2 rounded-md text-white/50 pointer-events-none">
              <iconify-icon icon="boxicons:git-compare" width="20"></iconify-icon>
              <span class="text-sm font-semibold">0</span>
            </a>
          </div>
          <% } else { %>
          <a href="/submit?challenge=<%= rs.entryId %>" class="flex items-center gap-1.5 h-10 px-2 rounded-md text-white/50 hover:text-charm-400 transition-colors shrink-0">
            <iconify-icon icon="boxicons:git-compare" width="20"></iconify-icon>
            <span class="text-sm font-semibold">0</span>
          </a>
          <% } %>
          <% } %>
          <div data-cv-action="<%= rs.entryId %>">
            <% if (canVote && !rs.isMine) { %>
            <button class="contest-vote-btn flex items-center gap-2 h-8 px-2 text-amber-400 hover:text-amber-300 transition-colors cursor-pointer font-semibold text-sm"
              data-contest-id="<%= contest._id %>"
              data-entry-id="<%= rs.entryId %>">
              <iconify-icon icon="boxicons:thumb-up" width="16"></iconify-icon>
              <span><%= rs.voteCount %></span>
            </button>
            <% } else if (rs.iVotedFor) { %>
            <button class="contest-unvote-btn flex items-center gap-2 h-8 px-2 text-amber-300 hover:text-white/50 transition-colors cursor-pointer font-semibold text-sm" data-contest-id="<%= contest._id %>">
              <iconify-icon icon="boxicons:thumb-up-filled" width="16"></iconify-icon>
              <span><%= rs.voteCount %></span>
            </button>
            <% } else { %>
            <div class="cursor-not-allowed">
              <button disabled class="flex items-center gap-2 h-8 px-2 text-white/50 font-semibold text-sm pointer-events-none">
                <iconify-icon icon="boxicons:thumb-up" width="16"></iconify-icon>
                <span><%= rs.voteCount %></span>
              </button>
            </div>
            <% } %>
          </div>
          <% if (rs.isMine) { %>
          <div class="cursor-not-allowed">
            <button type="button" class="flex items-center gap-1.5 h-8 px-2 font-semibold text-sm text-white/50 pointer-events-none">
              <span>🌶️</span>
              <span><%= grossByEntry[rs.entryId] || 0 %></span>
            </button>
          </div>
          <% } else { %>
          <button type="button" data-contrib-open="right"
            class="flex items-center gap-1.5 h-8 px-2 font-semibold text-sm text-white/50 hover:text-charm-400 transition-colors cursor-pointer">
            <span>🌶️</span>
            <span><%= grossByEntry[rs.entryId] || 0 %></span>
          </button>
          <% } %>
        </div>
        <% } %>

      </div><!-- /right -->

    </div><!-- /grid -->
  </div><!-- /contest-entries -->

  <!-- Unified vote ratio bar -->
  <% if (ls && ls.entryId) { %>
  <% var _rPct = (rs && rs.entryId) ? rs.votePct : 0; var _rCount = (rs && rs.entryId) ? rs.voteCount : 0; %>
  <div id="cv-unified-bar" class="px-4 pb-2<%= showVotes ? '' : ' hidden' %>">
    <div class="relative h-2 rounded-md overflow-hidden bg-white/8">
      <div id="cv-bar-left" class="absolute left-0 top-0 bottom-0 bg-charm-500 transition-all duration-500" style="width: <%= ls.votePct %>%"></div>
      <div id="cv-bar-right" class="absolute right-0 top-0 bottom-0 bg-white/30 transition-all duration-500" style="width: <%= _rPct %>%"></div>
    </div>
    <div class="flex justify-between text-xs mt-1.5">
      <span id="cv-label-left" class="text-charm-400/70"><%= ls.voteCount %> vote<%= ls.voteCount !== 1 ? 's' : '' %> · <%= ls.votePct %>%</span>
      <span id="cv-label-right" class="text-white/40"><%= _rCount %> vote<%= _rCount !== 1 ? 's' : '' %> · <%= _rPct %>%</span>
    </div>
  </div>
  <% } %>

  <!-- Total vote count (once revealed) -->
  <p id="cv-total" class="px-4 pb-4 text-xs text-white/25 text-center<%= (showVotes && totalVotes > 0) ? '' : ' hidden' %>"><%= totalVotes %> total vote<%= totalVotes !== 1 ? 's' : '' %></p>

  <!-- ── Chilli Contributions ── -->
  <% if (ls && ls.entryId) { %>
  <%
  %>
  <div id="chl-gross-left" class="px-4 pb-4 border-t border-white/8 pt-4">
    <div class="grid grid-cols-2 gap-x-9">

      <!-- Left column -->
      <div id="contrib-panel-left">
        <% if (contribRankLeft.length === 0) { %>
        <p class="text-xs text-white/20 py-2">No contributions yet</p>
        <% } else { %>
        <% contribRankLeft.forEach(function(c, i) { %>
        <%
          var _cu = c.contributorId;
          var _cuName = (_cu && (_cu.displayName && _cu.displayName.value || '@' + _cu.username.value)) || 'Unknown';
          var _cuHandle = _cu ? ('@' + _cu.username.value) : '';
          var _cuAvatar = _cu && _cu.avatar && _cu.avatar.value;
          var _cuSlug = _cu && _cu.username && _cu.username.value;
          var _isOwn = locals.currentUser && _cu && String(_cu._id) === String(locals.currentUser._id);
        %>
        <div class="flex items-center gap-2 py-1.5 <%= i > 0 ? 'border-t border-white/5' : '' %>"<% if (_isOwn) { %> data-contrib-row="<%= String(c.entryId) %>"<% } %>>
          <a href="<%= _cuSlug ? '/' + _cuSlug : '#' %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 flex items-center justify-center no-underline">
            <% if (_cuAvatar) { %>
            <img src="<%= _cuAvatar %>" alt="" class="w-full h-full object-cover">
            <% } else { %>
            <iconify-icon icon="boxicons:user-filled" width="13" style="color:#e680a6"></iconify-icon>
            <% } %>
          </a>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-white truncate leading-tight"><%= _cuName %></p>
            <p class="text-[10px] text-white/30 truncate leading-tight"><%= _cuHandle %></p>
          </div>
          <p class="shrink-0 text-xs font-bold text-charm-400">🌶️ <%= c.amountCHL.toLocaleString() %></p>
          <% if (_isOwn && effectiveStatus === 'active') { %>
          <button type="button" class="contrib-withdraw-btn shrink-0 text-xs text-white/40 hover:text-red-400 transition-colors cursor-pointer ml-1" data-entry-id="<%= String(c.entryId) %>" data-side="left">Withdraw</button>
          <% } %>
        </div>
        <% }); %>
        <% } %>
      </div>

      <!-- Right column -->
      <div id="contrib-panel-right">
        <% if (contribRankRight.length === 0) { %>
        <p class="text-xs text-white/20 py-2">No contributions yet</p>
        <% } else { %>
        <% contribRankRight.forEach(function(c, i) { %>
        <%
          var _cu = c.contributorId;
          var _cuName = (_cu && (_cu.displayName && _cu.displayName.value || '@' + _cu.username.value)) || 'Unknown';
          var _cuHandle = _cu ? ('@' + _cu.username.value) : '';
          var _cuAvatar = _cu && _cu.avatar && _cu.avatar.value;
          var _cuSlug = _cu && _cu.username && _cu.username.value;
          var _isOwn = locals.currentUser && _cu && String(_cu._id) === String(locals.currentUser._id);
        %>
        <div class="flex items-center gap-2 py-1.5 <%= i > 0 ? 'border-t border-white/5' : '' %>"<% if (_isOwn) { %> data-contrib-row="<%= String(c.entryId) %>"<% } %>>
          <a href="<%= _cuSlug ? '/' + _cuSlug : '#' %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 flex items-center justify-center no-underline">
            <% if (_cuAvatar) { %>
            <img src="<%= _cuAvatar %>" alt="" class="w-full h-full object-cover">
            <% } else { %>
            <iconify-icon icon="boxicons:user-filled" width="13" style="color:#e680a6"></iconify-icon>
            <% } %>
          </a>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-white truncate leading-tight"><%= _cuName %></p>
            <p class="text-[10px] text-white/30 truncate leading-tight"><%= _cuHandle %></p>
          </div>
          <p class="shrink-0 text-xs font-bold text-charm-400">🌶️ <%= c.amountCHL.toLocaleString() %></p>
          <% if (_isOwn && effectiveStatus === 'active') { %>
          <button type="button" class="contrib-withdraw-btn shrink-0 text-xs text-white/40 hover:text-red-400 transition-colors cursor-pointer ml-1" data-entry-id="<%= String(c.entryId) %>" data-side="right">Withdraw</button>
          <% } %>
        </div>
        <% }); %>
        <% } %>
      </div>

    </div>
  </div><!-- /contributions -->
  <% } %>


  <%
  function linkifyCommentBody(body) {
    var esc = String(body).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return esc.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }
  function timeAgo(date) {
    var diff = Math.max(0, Date.now() - new Date(date).getTime());
    var s = Math.floor(diff / 1000);
    if (s < 60) return s + 's';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52) return w + 'w';
    return Math.floor(d / 365) + 'y';
  }
  var _totalComments = comments.reduce(function(n,c){return n+1+c.replies.length;},0);
  var _statusCls = { pending: 'bg-amber-500/15 text-amber-400', active: 'bg-green-500/15 text-green-400', closed: 'bg-white/10 text-white/50' };
  %>

  <!-- Tab bar -->
  <div class="border-t border-white/10 flex">
    <button id="tab-btn-comments" class="tab-btn px-4 py-3 text-sm font-semibold text-white border-b-2 border-charm-500 transition-colors cursor-pointer" data-tab="comments">
      Comments<% if (_totalComments) { %> <span class="text-white/40 font-normal text-xs">(<%= _totalComments %>)</span><% } %>
    </button>
    <button id="tab-btn-related" class="tab-btn px-4 py-3 text-sm font-semibold text-white/40 border-b-2 border-transparent hover:text-white/70 transition-colors cursor-pointer" data-tab="related">
      Related<% if (relatedContests.length) { %> <span class="text-white/30 font-normal text-xs">(<%= relatedContests.length %>)</span><% } %>
    </button>
  </div>

  <!-- Comments panel -->
  <div id="tab-panel-comments" class="pt-4 pb-6">

    <!-- New comment input -->
    <% if (locals.currentUser) { %>
    <div class="px-2 mb-5" id="cc-new-root">
      <div class="border border-white/12 rounded-md bg-white/6 focus-within:border-charm-500/40 transition-colors cursor-text" onclick="if(!event.target.closest('button,a,textarea')){this.querySelector('textarea').focus()}">
        <!-- Row 1: pfp badge + char counter -->
        <div class="flex items-center justify-between px-3 pt-3">
          <div class="flex items-center gap-2 min-w-0">
            <a href="/<%= currentUser.username %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center">
              <% if (currentUser.avatar) { %>
              <img src="<%= currentUser.avatar %>" class="w-full h-full object-cover">
              <% } else { %>
              <iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>
              <% } %>
            </a>
            <div class="flex flex-col min-w-0">
              <span class="text-xs text-white/30">Posting as:</span>
              <div class="flex items-baseline gap-1.5">
                <span class="text-sm font-semibold text-white/80 truncate"><%= currentUser.displayName || ('@' + currentUser.username) %></span>
                <% if (currentUser.displayName) { %>
                <span class="text-xs text-white/30 shrink-0">@<%= currentUser.username %></span>
                <% } %>
              </div>
            </div>
          </div>
          <span id="cc-new-count" class="text-xs text-white/25 shrink-0 ml-2">0/280</span>
        </div>
        <!-- Row 2: textarea -->
        <div class="px-3 pt-3">
          <textarea id="cc-new-body" rows="3" placeholder="Add a comment…"
            class="w-full bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none"></textarea>
        </div>
        <!-- Row 3: buttons -->
        <div class="flex items-center justify-end gap-2 px-3 pb-3">
          <button id="cc-new-cancel" type="button" class="h-8 px-4 text-sm rounded-md text-white hover:text-white/60 transition-colors cursor-pointer">Cancel</button>
          <button id="cc-new-submit" type="button" class="h-8 px-4 text-sm font-semibold rounded-md bg-charm-600 text-charm-100 hover:bg-charm-500 transition-colors cursor-pointer">Post</button>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Comment list -->
    <div id="cc-list" class="flex flex-col">

    <% comments.forEach(function(comment) {
      var cid         = comment._id.toString();
      var cUser       = comment.userId;
      var isOwnTop    = locals.currentUser && cUser._id.toString() === currentUser._id.toString();
    %>
    <div class="cc-item px-2 py-3 border-t border-white/6" data-cid="<%= cid %>" data-username="<%= cUser.username?.value %>">
      <div class="flex gap-2.5">
        <a href="/<%= cUser.username?.value %>" class="shrink-0 w-7 h-7 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center mt-0.5">
          <% if (cUser.avatar?.value) { %>
          <img src="<%= cUser.avatar.value %>" class="w-full h-full object-cover">
          <% } else { %>
          <iconify-icon icon="boxicons:user-filled" width="14" style="color:#e680a6"></iconify-icon>
          <% } %>
        </a>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <a href="/<%= cUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= cUser.displayName?.value || ('@' + cUser.username?.value) %></a>
            <span class="text-xs text-white/25"><%= timeAgo(comment.createdAt) %></span>
            <% if (comment.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
          </div>
          <p class="cc-body text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- linkifyCommentBody(comment.body) %></p>
          <!-- edit textarea (hidden) -->
          <div class="cc-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
            <textarea class="cc-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2"><%= comment.body %></textarea>
            <div class="flex items-center gap-2 justify-end">
              <button type="button" class="cc-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer">Cancel</button>
              <button type="button" class="cc-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>">Save</button>
            </div>
          </div>
          <%
            var _ccLikes = comment.likes || [];
            var _ccDislikes = comment.dislikes || [];
            var _ccCuid = locals.currentUser ? locals.currentUser._id.toString() : '';
            var _ccUserLiked = _ccCuid && _ccLikes.some(function(id){ return id.toString() === _ccCuid; });
            var _ccUserDisliked = _ccCuid && _ccDislikes.some(function(id){ return id.toString() === _ccCuid; });
          %>
          <div class="flex items-center gap-2 mt-1.5">
            <button type="button" class="cc-react-btn flex items-center gap-1 transition-colors cursor-pointer <%= _ccUserLiked ? 'text-charm-400' : 'text-zinc-400 hover:text-zinc-200' %>" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>" data-type="like"><iconify-icon icon="<%= _ccUserLiked ? 'boxicons:thumb-up-filled' : 'boxicons:thumb-up' %>" width="15"></iconify-icon><span class="cc-like-count text-xs leading-none opacity-60<%= _ccLikes.length ? '' : ' hidden' %>"><%= _ccLikes.length || '' %></span></button>
            <button type="button" class="cc-react-btn flex items-center gap-1 transition-colors cursor-pointer <%= _ccUserDisliked ? 'text-red-400' : 'text-zinc-400 hover:text-zinc-200' %>" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>" data-type="dislike"><iconify-icon icon="<%= _ccUserDisliked ? 'boxicons:thumb-down-filled' : 'boxicons:thumb-down' %>" width="15"></iconify-icon><span class="cc-dislike-count text-xs leading-none opacity-60<%= _ccDislikes.length ? '' : ' hidden' %>"><%= _ccDislikes.length || '' %></span></button>
            <% if (locals.currentUser) { %>
            <button type="button" class="cc-reply-btn ml-2 flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="<%= cid %>">Reply<span class="cc-rcnt opacity-60 text-xs leading-none<%= comment.replies.length ? '' : ' hidden' %> ml-0.5"><%= comment.replies.length || '' %></span><iconify-icon icon="boxicons:chevrons-down-up-filled" width="14" class="ml-0.5"></iconify-icon></button>
            <% } %>
            <div class="ml-auto flex items-center gap-1">
              <% if (isOwnTop) { %>
              <button type="button" class="cc-edit-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" title="Edit" data-cid="<%= cid %>"><iconify-icon icon="boxicons:pencil" width="15"></iconify-icon></button>
              <button type="button" class="cc-del-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-red-400 transition-colors cursor-pointer" title="Delete" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>"><iconify-icon icon="boxicons:trash" width="15"></iconify-icon></button>
              <% } else if (locals.currentUser) { %>
              <button type="button" class="cc-report-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-red-400 transition-colors cursor-pointer" title="Report" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>"><iconify-icon icon="boxicons:flag-alt-2" width="15"></iconify-icon></button>
              <% } %>
            </div>
          </div>
          <!-- Reply input (hidden) -->
          <div class="cc-reply-form hidden mt-2.5 flex gap-2" data-parent-id="<%= cid %>">
            <div class="w-px bg-white/10 self-stretch shrink-0 ml-0.5"></div>
            <div class="flex-1 flex flex-col gap-1">
              <div class="flex items-start gap-1 bg-white/6 border border-white/12 rounded-md px-3 py-2 focus-within:border-white/25 transition-colors">
                <span class="cc-reply-mention hidden text-sm text-charm-400 font-medium leading-5.5 shrink-0"></span>
                <textarea class="cc-reply-body flex-1 min-w-0 bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none" rows="2" placeholder="Reply…"></textarea>
              </div>
              <div class="flex items-center justify-end gap-2">
                <button type="button" class="cc-reply-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer">Cancel</button>
                <button type="button" class="cc-reply-submit h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="<%= cid %>" data-contest-id="<%= contest._id %>">Reply</button>
              </div>
            </div>
          </div>
          <!-- Replies -->
          <div class="cc-replies hidden mt-3 flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="<%= cid %>">
            <% comment.replies.forEach(function(reply) {
              var rid      = reply._id.toString();
              var rUser    = reply.userId;
              var isOwnRep = locals.currentUser && rUser._id.toString() === currentUser._id.toString();
            %>
            <div class="cc-item" data-cid="<%= rid %>" data-username="<%= rUser.username?.value %>">
              <div class="flex gap-2">
                <a href="/<%= rUser.username?.value %>" class="shrink-0 w-6 h-6 rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center mt-0.5">
                  <% if (rUser.avatar?.value) { %>
                  <img src="<%= rUser.avatar.value %>" class="w-full h-full object-cover">
                  <% } else { %>
                  <iconify-icon icon="boxicons:user-filled" width="12" style="color:#e680a6"></iconify-icon>
                  <% } %>
                </a>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline gap-1.5 flex-wrap">
                    <a href="/<%= rUser.username?.value %>" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity"><%= rUser.displayName?.value || ('@' + rUser.username?.value) %></a>
                    <span class="text-xs text-white/25"><%= timeAgo(reply.createdAt) %></span>
                    <% if (reply.editedAt) { %><span class="text-xs text-white/20 italic">edited</span><% } %>
                  </div>
                  <p class="cc-body text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words"><%- linkifyCommentBody(reply.body) %></p>
                  <!-- edit textarea (hidden) -->
                  <div class="cc-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">
                    <textarea class="cc-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2" maxlength="1000"><%= reply.body %></textarea>
                    <div class="flex items-center gap-2 justify-end">
                      <button type="button" class="cc-edit-cancel text-xs text-white/40 hover:text-white/70 transition-colors cursor-pointer">Cancel</button>
                      <button type="button" class="cc-edit-save text-xs font-semibold px-3 py-1 rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="<%= rid %>" data-contest-id="<%= contest._id %>">Save</button>
                    </div>
                  </div>
                  <%
                    var _crLikes = reply.likes || [];
                    var _crDislikes = reply.dislikes || [];
                    var _crCuid = locals.currentUser ? locals.currentUser._id.toString() : '';
                    var _crUserLiked = _crCuid && _crLikes.some(function(id){ return id.toString() === _crCuid; });
                    var _crUserDisliked = _crCuid && _crDislikes.some(function(id){ return id.toString() === _crCuid; });
                  %>
                  <div class="flex items-center gap-2 mt-1.5">
                    <button type="button" class="cc-react-btn flex items-center gap-1 transition-colors cursor-pointer <%= _crUserLiked ? 'text-charm-400' : 'text-zinc-400 hover:text-zinc-200' %>" data-cid="<%= rid %>" data-contest-id="<%= contest._id %>" data-type="like"><iconify-icon icon="<%= _crUserLiked ? 'boxicons:thumb-up-filled' : 'boxicons:thumb-up' %>" width="15"></iconify-icon><span class="cc-like-count text-xs leading-none opacity-60<%= _crLikes.length ? '' : ' hidden' %>"><%= _crLikes.length || '' %></span></button>
                    <button type="button" class="cc-react-btn flex items-center gap-1 transition-colors cursor-pointer <%= _crUserDisliked ? 'text-red-400' : 'text-zinc-400 hover:text-zinc-200' %>" data-cid="<%= rid %>" data-contest-id="<%= contest._id %>" data-type="dislike"><iconify-icon icon="<%= _crUserDisliked ? 'boxicons:thumb-down-filled' : 'boxicons:thumb-down' %>" width="15"></iconify-icon><span class="cc-dislike-count text-xs leading-none opacity-60<%= _crDislikes.length ? '' : ' hidden' %>"><%= _crDislikes.length || '' %></span></button>
                    <% if (locals.currentUser) { %>
                    <button type="button" class="cc-reply-btn ml-2 flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="<%= rid %>">Reply<iconify-icon icon="boxicons:chevrons-down-up-filled" width="14" class="ml-0.5"></iconify-icon></button>
                    <% } %>
                    <div class="ml-auto flex items-center gap-1">
                      <% if (isOwnRep) { %>
                      <button type="button" class="cc-edit-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" title="Edit" data-cid="<%= rid %>"><iconify-icon icon="boxicons:pencil" width="15"></iconify-icon></button>
                      <button type="button" class="cc-del-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-red-400 transition-colors cursor-pointer" title="Delete" data-cid="<%= rid %>" data-contest-id="<%= contest._id %>"><iconify-icon icon="boxicons:trash" width="15"></iconify-icon></button>
                      <% } else if (locals.currentUser) { %>
                      <button type="button" class="cc-report-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-red-400 transition-colors cursor-pointer" title="Report" data-cid="<%= rid %>" data-contest-id="<%= contest._id %>"><iconify-icon icon="boxicons:flag-alt-2" width="15"></iconify-icon></button>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <% }); %>

    <% if (!comments.length) { %>
    <p class="px-2 pt-2 text-sm text-white/25">No comments yet.</p>
    <% } %>

    </div><!-- /cc-list -->
  </div><!-- /tab-panel-comments -->

  <!-- Related panel -->
  <div id="tab-panel-related" class="hidden pb-6">
    <% if (!relatedContests.length) { %>
    <p class="px-2 pt-4 text-sm text-white/25">No other contests found for these participants.</p>
    <% } else { %>
    <div class="flex flex-col">
      <% relatedContests.forEach(function(rc) {
        var rcLeft  = rc.entries[0] || null;
        var rcRight = rc.entries[1] || null;
        var rcLUser = rcLeft  ? relatedUserMap[rcLeft.userId.toString()]  : null;
        var rcRUser = rcRight ? relatedUserMap[rcRight.userId.toString()] : null;
        var rcSt    = (rc.status === 'active' && rc.votingDeadline && new Date(rc.votingDeadline) < new Date()) ? 'closed' : rc.status;
        var rcStCls = rcSt === 'active' ? 'bg-green-500/15 text-green-400' : rcSt === 'pending' ? 'bg-amber-500/15 text-amber-400' : 'bg-white/8 text-white/40';
        var rcStLbl = rcSt === 'active' ? 'Live' : rcSt === 'pending' ? 'Pending' : 'Contest has ended';
      %>
      <a href="/contest/<%= rc._id %>" class="flex items-center gap-3 px-2 py-3 border-t border-white/6 hover:bg-white/4 transition-colors">
        <!-- Thumbnails -->
        <div class="flex items-center gap-1 shrink-0">
          <div class="w-10 h-10 rounded-md overflow-hidden bg-shark-900 shrink-0">
            <% if (rcLeft && rcLeft.entryId && rcLeft.entryId.mediaUrl) { %>
            <% if (rcLeft.entryId.mediaType === 'video') { %>
            <video src="<%= rcLeft.entryId.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
            <% } else { %>
            <img src="<%= rcLeft.entryId.mediaUrl %>" class="w-full h-full object-cover" alt="">
            <% } %>
            <% } else { %>
            <div class="w-full h-full flex items-center justify-center"><iconify-icon icon="boxicons:image" width="16" class="text-white/15"></iconify-icon></div>
            <% } %>
          </div>
          <span class="text-[10px] font-black text-white/20 tracking-widest px-0.5">VS</span>
          <div class="w-10 h-10 rounded-md overflow-hidden bg-shark-900 shrink-0">
            <% if (rcRight && rcRight.entryId && rcRight.entryId.mediaUrl) { %>
            <% if (rcRight.entryId.mediaType === 'video') { %>
            <video src="<%= rcRight.entryId.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
            <% } else { %>
            <img src="<%= rcRight.entryId.mediaUrl %>" class="w-full h-full object-cover" alt="">
            <% } %>
            <% } else { %>
            <div class="w-full h-full flex items-center justify-center"><iconify-icon icon="boxicons:user-plus" width="16" class="text-white/15"></iconify-icon></div>
            <% } %>
          </div>
        </div>
        <!-- Names -->
        <div class="flex-1 min-w-0">
          <p class="text-sm text-white/70 truncate">
            <%= rcLUser ? (rcLUser.displayName?.value || rcLUser.username?.value) : '—' %>
            <span class="text-white/25 text-xs mx-1">vs</span>
            <%= rcRUser ? (rcRUser.displayName?.value || rcRUser.username?.value) : 'Awaiting' %>
          </p>
          <p class="text-xs text-white/30 mt-0.5"><%= new Date(rc.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
        </div>
        <!-- Status -->
        <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-md <%= rcStCls %>"><%= rcStLbl %></span>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div><!-- /tab-panel-related -->

  <!-- @mention dropdown -->
  <div id="cc-mention-dd" class="hidden fixed z-50 w-56 bg-shark-900 border border-white/12 rounded-md shadow-xl overflow-hidden"></div>

</div>

<% if (canContribute && locals.currentUser) { %>
<!-- Contribution Popup -->
<div id="contrib-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="contrib-modal-bg"></div>
  <div class="relative w-full max-w-xs bg-shark-900 border border-white/10 rounded-md shadow-2xl">
    <div class="p-5">
      <div class="flex items-center justify-between mb-3">
        <p id="contrib-modal-title" class="text-sm font-bold text-white">Contribute</p>
        <button type="button" id="contrib-modal-close" class="w-7 h-7 flex items-center justify-center text-white/40 hover:text-white/70 transition-colors cursor-pointer rounded-md hover:bg-white/8">
          <iconify-icon icon="boxicons:x" width="18"></iconify-icon>
        </button>
      </div>
      <div id="contrib-modal-recipient" class="relative mb-3"></div>
      <p class="text-sm text-white/60 mb-6">Balance: <span id="contrib-modal-balance"><%= viewerBalanceCHL.toLocaleString() %></span> 🌶️ · <a href="/wallet/topup" class="text-charm-400 hover:text-charm-300 transition-colors">Top up</a></p>
      <div id="contrib-modal-mount" class="contrib-slider-mount"></div>
    </div>
  </div>
</div>
<% } %>

<% if (locals.isNominator || locals.isNominee) { %>
<!-- Drop Out Confirmation Modal -->
<div id="dropout-modal" class="fixed inset-0 z-50 items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="dropout-modal-backdrop"></div>
  <div class="relative w-full max-w-sm bg-shark-900 border border-white/10 rounded-md shadow-2xl">
    <div class="p-6">

      <div class="flex items-start gap-3 mb-5">
        <div class="w-10 h-10 rounded-md bg-red-500/15 flex items-center justify-center shrink-0 mt-0.5">
          <iconify-icon icon="boxicons:error-circle" width="22" class="text-red-400"></iconify-icon>
        </div>
        <div>
          <p class="font-bold text-white text-base leading-snug">Drop Out of Contest?</p>
          <p class="text-sm text-white/45 mt-1">This action is permanent and cannot be undone.</p>
        </div>
      </div>

      <div class="mb-6 flex flex-col gap-2.5">
        <p class="text-xs font-semibold text-white/35 uppercase tracking-wide">What happens</p>
        <ul class="flex flex-col gap-2">
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70">The contest ends immediately</span>
          </li>
          <% if (locals.isNominee) { %>
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70">You forfeit all votes you've accumulated — you walk away with nothing</span>
          </li>
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70"><%= left?.user?.displayName?.value || (left?.user?.username?.value ? '@' + left.user.username.value : 'Your opponent') %> wins this contest by forfeit</span>
          </li>
          <% } else { %>
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70">Your opponent wins this contest by forfeit</span>
          </li>
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70">They keep all their accumulated votes — you lose yours</span>
          </li>
          <% } %>
          <li class="flex items-start gap-2.5">
            <iconify-icon icon="boxicons:x" width="16" class="text-red-400 shrink-0 mt-0.5"></iconify-icon>
            <span class="text-sm text-white/70">Your contest record will show <strong class="text-white/60">Forfeited</strong></span>
          </li>
        </ul>
      </div>

      <div class="flex gap-3">
        <button type="button" id="dropout-cancel-btn"
          class="flex-1 py-2.5 rounded-md border border-white/10 text-white/60 text-sm font-semibold hover:bg-white/5 transition-colors cursor-pointer">
          Cancel
        </button>
        <button type="button" id="dropout-confirm-btn" data-contest-id="<%= contest._id %>"
          class="flex-1 py-2.5 rounded-md bg-red-600 text-white text-sm font-semibold hover:bg-red-500 transition-colors cursor-pointer">
          Yes, Drop Out
        </button>
      </div>

    </div>
  </div>
</div>
<% } %>

<style>
  @keyframes _cv-burst {
    0%   { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
    40%  { transform: translate(calc(-50% + var(--mx)), calc(-50% + var(--ty) * 0.48)) scale(0.9); opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.45); opacity: 0; }
  }
  input[type="range"].contrib-range {
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: linear-gradient(to right, #c73b64 var(--fill-pct, 0%), rgba(255,255,255,0.12) var(--fill-pct, 0%));
    border-radius: 9999px;
    outline: none;
    cursor: pointer;
    width: 100%;
    display: block;
  }
  input[type="range"].contrib-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: #c73b64;
    cursor: pointer;
    border: 2px solid rgba(255,255,255,0.15);
    box-shadow: 0 2px 6px rgba(0,0,0,0.5);
  }
  input[type="range"].contrib-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: #c73b64;
    cursor: pointer;
    border: 2px solid rgba(255,255,255,0.15);
    box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    border: none;
  }
  input[type="range"].contrib-range::-moz-range-track {
    height: 4px;
    background: transparent;
  }
  input[type="range"].contrib-range::-moz-range-progress {
    height: 4px;
    background: #c73b64;
    border-radius: 9999px;
  }
</style>
<script>
(function () {
  var CONTEST_ID     = '<%= contest._id %>';
  var LEFT_ENTRY_ID  = '<%= left  && left.entryId  ? left.entryId  : "" %>';
  var RIGHT_ENTRY_ID = '<%= right && right.entryId ? right.entryId : "" %>';
  var SIDE_AVATARS = {
    '<%= left  && left.entryId  ? left.entryId  : "" %>': '<%= left  && left.user  && left.user.avatar  && left.user.avatar.value  ? left.user.avatar.value  : "" %>',
    '<%= right && right.entryId ? right.entryId : "" %>': '<%= right && right.user && right.user.avatar && right.user.avatar.value ? right.user.avatar.value : "" %>'
  };

  function getVoteOverlay() {
    var overlay = document.getElementById('cv-confetti-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'cv-confetti-overlay';
      overlay.style.cssText = 'position:fixed;top:0;bottom:0;overflow:hidden;pointer-events:none;z-index:9999;';
      document.body.appendChild(overlay);
    }
    var main = document.querySelector('main');
    var rect = main ? main.getBoundingClientRect() : { left: 0, width: window.innerWidth };
    overlay.style.left  = rect.left + 'px';
    overlay.style.width = rect.width + 'px';
    return overlay;
  }

  function burstVoteConfetti(avatarUrl) {
    var overlay = getVoteOverlay();
    var ow = overlay.offsetWidth;
    var oh = overlay.offsetHeight;
    var total = 30;
    for (var i = 0; i < total; i++) {
      (function (idx) {
        var useAvatar = avatarUrl && (idx % 3 === 0);
        var p = document.createElement(useAvatar ? 'img' : 'span');
        if (useAvatar) {
          p.src = avatarUrl;
          p.style.cssText = 'position:absolute;width:42px;height:42px;border-radius:9999px;object-fit:cover;border:2px solid rgba(255,255,255,0.25);pointer-events:none;will-change:transform,opacity;';
        } else {
          p.textContent = '👍';
          p.style.cssText = 'position:absolute;pointer-events:none;font-size:3.2rem;line-height:1;will-change:transform,opacity;';
        }
        var cx = 40 + Math.random() * (ow - 80);
        p.style.left = cx + 'px';
        p.style.top  = oh + 'px';
        var tx = (Math.random() - 0.5) * 220;
        var ty = -(320 + Math.random() * 260);
        var mx = tx + (Math.random() - 0.5) * 300;
        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--mx', mx + 'px');
        p.style.animation = '_cv-burst ' + (2.8 + Math.random() * 0.5) + 's ease-out forwards';
        p.style.animationDelay = (idx * 0.04 + Math.random() * 0.15) + 's';
        overlay.appendChild(p);
        p.addEventListener('animationend', function () { if (p.parentNode) p.parentNode.removeChild(p); }, { once: true });
      }(i));
    }
  }

  window.burstContribConfetti = function burstContribConfetti(avatarUrl) {
    var overlay = getVoteOverlay();
    var ow = overlay.offsetWidth;
    var oh = overlay.offsetHeight;
    var total = 32;
    for (var i = 0; i < total; i++) {
      (function (idx) {
        var useAvatar = avatarUrl && (idx % 4 === 0);
        var p = document.createElement(useAvatar ? 'img' : 'span');
        if (useAvatar) {
          p.src = avatarUrl;
          p.style.cssText = 'position:absolute;width:42px;height:42px;border-radius:9999px;object-fit:cover;border:2px solid rgba(255,255,255,0.25);pointer-events:none;will-change:transform,opacity;';
        } else {
          p.textContent = '🌶️';
          p.style.cssText = 'position:absolute;pointer-events:none;font-size:2.8rem;line-height:1;will-change:transform,opacity;';
        }
        var cx = 40 + Math.random() * (ow - 80);
        p.style.left = cx + 'px';
        p.style.top  = oh + 'px';
        var tx = (Math.random() - 0.5) * 220;
        var ty = -(320 + Math.random() * 260);
        var mx = tx + (Math.random() - 0.5) * 300;
        p.style.setProperty('--tx', tx + 'px');
        p.style.setProperty('--ty', ty + 'px');
        p.style.setProperty('--mx', mx + 'px');
        p.style.animation = '_cv-burst ' + (2.8 + Math.random() * 0.5) + 's ease-out forwards';
        p.style.animationDelay = (idx * 0.04 + Math.random() * 0.15) + 's';
        overlay.appendChild(p);
        p.addEventListener('animationend', function () { if (p.parentNode) p.parentNode.removeChild(p); }, { once: true });
      }(i));
    }
  }

  function makeCountdown(id, onExpire) {
    var el = document.getElementById(id);
    if (!el) return;
    var ts = parseInt(el.dataset.ts, 10);
    var iv = setInterval(update, 1000);
    function update() {
      var diff = ts - Date.now();
      if (diff <= 0) {
        clearInterval(iv);
        el.textContent = 'closed';
        if (onExpire) onExpire();
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      if (d > 0) el.textContent = 'in ' + d + 'd ' + pad(h) + 'h';
      else if (h > 0) el.textContent = 'in ' + pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
      else el.textContent = 'in ' + pad(m) + 'm ' + pad(s) + 's';
    }
    update();
  }
  makeCountdown('contest-deadline', function() {
    var banner = document.getElementById('contest-deadline');
    if (banner) {
      var row = banner.closest('.border-b');
      if (row) row.innerHTML = '<span class="text-sm text-white/40 italic">Voting ended — finalizing results…</span>';
    }
    // Allow ~4 s for the agenda job to close the contest, then reload to show updated state
    setTimeout(function() { window.location.reload(); }, 4000);
  });
  makeCountdown('contest-void-deadline');


  document.addEventListener('click', function (e) {
    var followBtn = e.target.closest('.contest-follow-btn');
    if (followBtn) {
      var following = followBtn.dataset.following === 'true';
      var uname = followBtn.dataset.username;
      followBtn.disabled = true;
      fetch((following ? '/unfollow/' : '/follow/') + uname, {
        method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' },
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var nowFollowing = data.following;
        followBtn.dataset.following = nowFollowing ? 'true' : 'false';
        followBtn.textContent = nowFollowing ? 'Following' : 'Follow';
        followBtn.className = 'contest-follow-btn shrink-0 text-xs font-semibold px-2.5 py-1 rounded-md transition-colors cursor-pointer ' +
          (nowFollowing
            ? 'border border-white/30 text-white/50 hover:bg-white/8'
            : 'border border-charm-500/40 text-charm-400 hover:bg-charm-500/10');
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { followBtn.disabled = false; });
      return;
    }

    var voteBtn = e.target.closest('.contest-vote-btn');
    if (voteBtn && !voteBtn.disabled) {
      voteBtn.disabled = true;
      voteBtn.style.opacity = '0.4';
      fetch('/api/contests/' + voteBtn.dataset.contestId + '/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entryId: voteBtn.dataset.entryId }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) {
          if (window.showToast) window.showToast(data.error, 'error');
          voteBtn.disabled = false;
          voteBtn.style.opacity = '';
          return;
        }
        burstVoteConfetti(SIDE_AVATARS[data.votedFor] || '');
        var votedFor   = data.votedFor;
        var voteCounts = data.voteCounts || {};
        var total      = data.total || 0;
        var lCount = voteCounts[LEFT_ENTRY_ID]  || 0;
        var rCount = voteCounts[RIGHT_ENTRY_ID] || 0;
        var lPct   = total > 0 ? Math.round((lCount / total) * 100) : 50;
        var rPct   = total > 0 ? Math.round((rCount / total) * 100) : 50;
        var barEl    = document.getElementById('cv-unified-bar');
        var barLeft  = document.getElementById('cv-bar-left');
        var barRight = document.getElementById('cv-bar-right');
        var lblLeft  = document.getElementById('cv-label-left');
        var lblRight = document.getElementById('cv-label-right');
        if (barLeft)  barLeft.style.width  = lPct + '%';
        if (barRight) barRight.style.width = rPct + '%';
        if (lblLeft)  lblLeft.textContent  = lCount + ' vote' + (lCount !== 1 ? 's' : '') + ' · ' + lPct + '%';
        if (lblRight) lblRight.textContent = rCount + ' vote' + (rCount !== 1 ? 's' : '') + ' · ' + rPct + '%';
        if (barEl)    barEl.classList.remove('hidden');
        document.querySelectorAll('[data-cv-action]').forEach(function (action) {
          var eid = action.dataset.cvAction;
          if (eid === votedFor) {
            action.innerHTML = '<button class="contest-unvote-btn flex items-center gap-2 h-8 px-2 text-amber-300 hover:text-white/50 transition-colors cursor-pointer font-semibold text-sm" data-contest-id="' + CONTEST_ID + '"><iconify-icon icon="boxicons:thumb-up-filled" width="16"></iconify-icon><span>' + (voteCounts[eid] || 0) + '</span></button>';
          } else {
            action.innerHTML = '';
          }
        });
        var totalEl = document.getElementById('cv-total');
        if (totalEl) {
          totalEl.textContent = total + ' total vote' + (total !== 1 ? 's' : '');
          totalEl.classList.remove('hidden');
        }
      })
      .catch(function () {
        if (window.showToast) window.showToast('Something went wrong.', 'error');
        voteBtn.disabled = false;
        voteBtn.style.opacity = '';
      });
      return;
    }

    var unvoteBtn = e.target.closest('.contest-unvote-btn');
    if (unvoteBtn && !unvoteBtn.disabled) {
      unvoteBtn.disabled = true;
      unvoteBtn.style.opacity = '0.4';
      fetch('/api/contests/' + unvoteBtn.dataset.contestId + '/vote', { method: 'DELETE' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) {
          if (window.showToast) window.showToast(data.error, 'error');
          unvoteBtn.disabled = false;
          unvoteBtn.style.opacity = '';
          return;
        }
        var barEl = document.getElementById('cv-unified-bar');
        if (barEl) barEl.classList.add('hidden');
        document.querySelectorAll('[data-cv-action]').forEach(function (action) {
          var eid = action.dataset.cvAction;
          if (!eid) return;
          action.innerHTML = '<button class="contest-vote-btn flex items-center gap-2 h-8 px-2 text-amber-400 hover:text-amber-300 transition-colors cursor-pointer font-semibold text-sm" data-contest-id="' + CONTEST_ID + '" data-entry-id="' + eid + '"><iconify-icon icon="boxicons:thumb-up" width="16"></iconify-icon><span>0</span></button>';
        });
        var totalEl = document.getElementById('cv-total');
        if (totalEl) totalEl.classList.add('hidden');
      })
      .catch(function () {
        if (window.showToast) window.showToast('Something went wrong.', 'error');
        unvoteBtn.disabled = false;
        unvoteBtn.textContent = 'Undo vote';
      });
    }
  });

  var voidBtn = document.getElementById('cv-void-btn');
  if (voidBtn) {
    voidBtn.addEventListener('click', function () {
      voidBtn.disabled = true;
      voidBtn.style.opacity = '0.4';
      fetch('/api/contests/' + voidBtn.dataset.contestId, { method: 'DELETE' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) {
            if (window.showToast) window.showToast(data.error, 'error');
            voidBtn.disabled = false;
            voidBtn.style.opacity = '';
            return;
          }
          if (data.deleted) {
            window.location.href = '/profile';
          } else {
            window.location.reload();
          }
        })
        .catch(function () {
          if (window.showToast) window.showToast('Something went wrong.', 'error');
          voidBtn.disabled = false;
          voidBtn.style.opacity = '';
        });
    });
  }

  (function () {
    var forfeitBtn   = document.getElementById('cv-forfeit-btn');
    var modal        = document.getElementById('dropout-modal');
    var cancelBtn    = document.getElementById('dropout-cancel-btn');
    var confirmBtn   = document.getElementById('dropout-confirm-btn');
    var backdrop     = document.getElementById('dropout-modal-backdrop');

    if (!forfeitBtn || !modal) return;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    forfeitBtn.addEventListener('click', openModal);
    cancelBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

    confirmBtn.addEventListener('click', function () {
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Dropping out…';
      fetch('/api/contests/' + confirmBtn.dataset.contestId + '/forfeit', { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) {
            if (window.showToast) window.showToast(data.error, 'error');
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Yes, Drop Out';
            closeModal();
            return;
          }
          window.location.reload();
        })
        .catch(function () {
          if (window.showToast) window.showToast('Something went wrong.', 'error');
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Yes, Drop Out';
          closeModal();
        });
    });
  }());

  (function () {
    var acceptBtn  = document.getElementById('cv-takeon-accept-btn');
    var declineBtn = document.getElementById('cv-takeon-decline-btn');
    var errorEl    = document.getElementById('takeon-error');
    var errorText  = document.getElementById('takeon-error-text');

    function showTakeonError(msg) {
      if (!errorEl || !errorText) return;
      errorText.textContent = msg;
      errorEl.classList.remove('hidden');
      errorEl.style.display = 'flex';
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        var nomId = acceptBtn.dataset.nomId;
        acceptBtn.disabled = declineBtn.disabled = true;
        acceptBtn.textContent = 'Accepting…';
        fetch('/api/nominations/' + nomId + '/take-on-accept', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { showTakeonError(data.error); acceptBtn.disabled = declineBtn.disabled = false; acceptBtn.textContent = 'Accept'; return; }
          window.location.reload();
        })
        .catch(function () { showTakeonError('Something went wrong.'); acceptBtn.disabled = declineBtn.disabled = false; acceptBtn.textContent = 'Accept'; });
      });
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', function () {
        var nomId = declineBtn.dataset.nomId;
        acceptBtn.disabled = declineBtn.disabled = true;
        declineBtn.textContent = 'Declining…';
        fetch('/api/nominations/' + nomId + '/decline', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { showTakeonError(data.error); acceptBtn.disabled = declineBtn.disabled = false; declineBtn.textContent = 'Decline'; return; }
          window.location.href = '/notifications';
        })
        .catch(function () { showTakeonError('Something went wrong.'); acceptBtn.disabled = declineBtn.disabled = false; declineBtn.textContent = 'Decline'; });
      });
    }
  }());

  var shareBtn = document.getElementById('cv-share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', function () {
      var url   = window.location.href;
      var title = 'H2H Contest';
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function () {});
      } else {
        navigator.clipboard.writeText(url).then(function () {
          if (window.showToast) window.showToast('Link copied to clipboard', 'success');
        }).catch(function () {
          if (window.showToast) window.showToast('Could not copy link', 'error');
        });
      }
    });
  }

  // ── Loop-in toggle ───────────────────────────────────────────────

  var loopBtn = document.getElementById('cv-loop-btn');
  if (loopBtn) {
    loopBtn.addEventListener('click', function () {
      loopBtn.disabled = true;
      fetch('/api/contests/' + loopBtn.dataset.contestId + '/loop-in', { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var loopedIn = data.loopedIn;
          loopBtn.dataset.loopedIn = loopedIn ? 'true' : 'false';
          loopBtn.title = loopedIn ? 'Leave the loop' : 'Stay in the loop';
          loopBtn.className = 'w-8 h-8 flex items-center justify-center rounded-md transition-colors cursor-pointer shrink-0 ' +
            (loopedIn ? 'text-charm-400 hover:text-white/50' : 'text-zinc-400 hover:text-zinc-200');
          loopBtn.querySelector('iconify-icon').setAttribute('icon', loopedIn ? 'boxicons:bell-ring-filled' : 'boxicons:bell');
          if (window.showToast) window.showToast(loopedIn ? "You're now looped in on this contest" : 'Left the loop', 'success');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
        .finally(function () { loopBtn.disabled = false; });
    });
  }

  // ── Tab switcher ─────────────────────────────────────────────────

  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tab = btn.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(function (b) {
        var active = b.dataset.tab === tab;
        b.classList.toggle('text-white',        active);
        b.classList.toggle('border-charm-500',  active);
        b.classList.toggle('text-white/40',    !active);
        b.classList.toggle('border-transparent',!active);
      });
      document.querySelectorAll('[id^="tab-panel-"]').forEach(function (p) {
        p.classList.toggle('hidden', p.id !== 'tab-panel-' + tab);
      });
    });
  });

  // ── Contest comments ──────────────────────────────────────────────

  var CONTEST_ID_CC = '<%= contest._id %>';

  function ccAvatarHtml(size) {
    var sz = size === 'sm' ? 'w-6 h-6' : 'w-7 h-7';
    var ic = size === 'sm' ? '12' : '14';
    <% if (locals.currentUser && currentUser.avatar) { %>
    return '<a href="/<%= currentUser.username %>" class="shrink-0 ' + sz + ' rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5"><img src="<%= currentUser.avatar %>" class="w-full h-full object-cover"></a>';
    <% } else if (locals.currentUser) { %>
    return '<a href="/<%= currentUser.username %>" class="shrink-0 ' + sz + ' rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center mt-0.5"><iconify-icon icon="boxicons:user-filled" width="' + ic + '" style="color:#e680a6"></iconify-icon></a>';
    <% } else { %>
    return '';
    <% } %>
  }

  function buildCommentHtml(c, isReply) {
    var displayName = c.user.displayName || ('@' + c.user.username);
    var date = timeAgo(c.createdAt);
    var avatarSz = isReply ? 'sm' : 'md';
    var avatarCls = isReply ? 'w-6 h-6' : 'w-7 h-7';
    var iconSz    = isReply ? '12' : '14';
    var avatarHtml = c.user.avatar
      ? '<a href="/' + c.user.username + '" class="shrink-0 ' + avatarCls + ' rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center mt-0.5"><img src="' + c.user.avatar + '" class="w-full h-full object-cover"></a>'
      : '<a href="/' + c.user.username + '" class="shrink-0 ' + avatarCls + ' rounded-full overflow-hidden bg-charm-950 border border-white/10 flex items-center justify-center mt-0.5"><iconify-icon icon="boxicons:user-filled" width="' + iconSz + '" style="color:#e680a6"></iconify-icon></a>';
    var gap = isReply ? 'gap-2' : 'gap-2.5';
    var replyBlock = !isReply
      ? '<div class="cc-replies hidden mt-3 flex-col gap-3 pl-3 border-l border-white/8" data-parent-id="' + c._id + '"></div>'
      : '';
    var replyBtn = isReply
      ? '<button type="button" class="cc-reply-btn ml-2 flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="' + c._id + '">Reply<iconify-icon icon="boxicons:chevrons-down-up-filled" width="14" class="ml-0.5"></iconify-icon></button>'
      : '<button type="button" class="cc-reply-btn ml-2 flex items-center gap-1 text-xs text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="' + c._id + '">Reply<span class="cc-rcnt opacity-60 text-xs leading-none hidden ml-0.5"></span><iconify-icon icon="boxicons:chevrons-down-up-filled" width="14" class="ml-0.5"></iconify-icon></button>';
    var replyForm = !isReply
      ? '<div class="cc-reply-form hidden mt-2.5 flex gap-2" data-parent-id="' + c._id + '"><div class="w-px bg-white/10 self-stretch shrink-0 ml-0.5"></div><div class="flex-1 flex flex-col gap-1"><div class="flex items-start gap-1 bg-white/6 border border-white/12 rounded-md px-3 py-2 focus-within:border-white/25 transition-colors"><span class="cc-reply-mention hidden text-sm text-charm-400 font-medium leading-5.5 shrink-0"></span><textarea class="cc-reply-body flex-1 min-w-0 bg-transparent text-sm text-white placeholder-white/25 resize-none focus:outline-none" rows="2" placeholder="Reply…"></textarea></div><div class="flex items-center justify-end gap-2"><button type="button" class="cc-reply-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer">Cancel</button><button type="button" class="cc-reply-submit h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-parent-id="' + c._id + '" data-contest-id="' + CONTEST_ID_CC + '">Reply</button></div></div></div>'
      : '';
    return '<div class="cc-item' + (!isReply ? ' px-2 py-3 border-t border-white/6' : '') + '" data-cid="' + c._id + '" data-username="' + escHtml(c.user.username) + '">'
      + '<div class="flex ' + gap + '">'
      + avatarHtml
      + '<div class="flex-1 min-w-0">'
      + '<div class="flex items-baseline gap-1.5 flex-wrap">'
      + '<a href="/' + c.user.username + '" class="text-sm font-semibold text-white/80 hover:opacity-70 transition-opacity">' + displayName + '</a>'
      + '<span class="text-xs text-white/25">' + date + '</span>'
      + '</div>'
      + '<p class="cc-body text-sm text-white/70 mt-0.5 leading-relaxed whitespace-pre-wrap break-words">' + linkifyMentions(escHtml(c.body)) + '</p>'
      + '<div class="cc-edit-wrap hidden mt-1.5 flex flex-col gap-1.5">'
      + '<textarea class="cc-edit-body w-full bg-white/6 border border-white/12 rounded-md px-3 py-2 text-sm text-white resize-none focus:outline-none focus:border-white/25 transition-colors" rows="2">' + escHtml(c.body) + '</textarea>'
      + '<div class="flex items-center justify-end gap-2"><button type="button" class="cc-edit-cancel h-7 px-3 text-xs rounded-md border border-white/12 text-white/40 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer">Cancel</button><button type="button" class="cc-edit-save h-7 px-3 text-xs font-semibold rounded-md bg-charm-600 text-white hover:bg-charm-500 transition-colors cursor-pointer" data-cid="' + c._id + '" data-contest-id="' + CONTEST_ID_CC + '">Save</button></div>'
      + '</div>'
      + '<div class="flex items-center gap-2 mt-1.5">'
      + '<button type="button" class="cc-react-btn flex items-center gap-1 text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="' + c._id + '" data-contest-id="' + CONTEST_ID_CC + '" data-type="like"><iconify-icon icon="boxicons:thumb-up" width="15"></iconify-icon><span class="cc-like-count text-xs leading-none opacity-60 hidden"></span></button>'
      + '<button type="button" class="cc-react-btn flex items-center gap-1 text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" data-cid="' + c._id + '" data-contest-id="' + CONTEST_ID_CC + '" data-type="dislike"><iconify-icon icon="boxicons:thumb-down" width="15"></iconify-icon><span class="cc-dislike-count text-xs leading-none opacity-60 hidden"></span></button>'
      + replyBtn
      + '<div class="ml-auto flex items-center gap-1">'
      + '<button type="button" class="cc-edit-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer" title="Edit" data-cid="' + c._id + '"><iconify-icon icon="boxicons:pencil" width="15"></iconify-icon></button>'
      + '<button type="button" class="cc-del-btn w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-red-400 transition-colors cursor-pointer" title="Delete" data-cid="' + c._id + '" data-contest-id="' + CONTEST_ID_CC + '"><iconify-icon icon="boxicons:trash" width="15"></iconify-icon></button>'
      + '</div>'
      + '</div>'
      + replyForm
      + replyBlock
      + '</div></div></div>';
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function timeAgo(date) {
    var diff = Math.max(0, Date.now() - new Date(date).getTime());
    var s = Math.floor(diff / 1000);
    if (s < 60) return s + 's';
    var m = Math.floor(s / 60);
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60);
    if (h < 24) return h + 'h';
    var d = Math.floor(h / 24);
    if (d < 7) return d + 'd';
    var w = Math.floor(d / 7);
    if (w < 52) return w + 'w';
    return Math.floor(d / 365) + 'y';
  }

  function linkifyMentions(escapedHtml) {
    return escapedHtml.replace(/@(\w+)/g, '<a href="/$1" class="text-charm-400 hover:opacity-80 transition-opacity">@$1</a>');
  }

  // ── @mention autocomplete ─────────────────────────────────────────

  var mentionDd    = document.getElementById('cc-mention-dd');
  var mentionTa    = null;
  var mentionTimer = null;

  function getMentionQuery(ta) {
    var before = ta.value.slice(0, ta.selectionStart);
    var m = before.match(/@(\w*)$/);
    return m ? m[1] : null;
  }

  function hideMentionDd() {
    mentionDd.classList.add('hidden');
    mentionDd.innerHTML = '';
    mentionTa = null;
  }

  function positionMentionDd(ta) {
    var r = ta.getBoundingClientRect();
    var ddH = mentionDd.offsetHeight;
    var spaceBelow = window.innerHeight - r.bottom;
    if (spaceBelow < ddH + 8 && r.top > ddH + 8) {
      mentionDd.style.top = (r.top - ddH - 4) + 'px';
    } else {
      mentionDd.style.top = (r.bottom + 4) + 'px';
    }
    mentionDd.style.left  = r.left + 'px';
    mentionDd.style.width = Math.min(r.width, 224) + 'px';
  }

  function insertMention(username) {
    if (!mentionTa) return;
    var val    = mentionTa.value;
    var pos    = mentionTa.selectionStart;
    var before = val.slice(0, pos);
    var after  = val.slice(pos);
    var atIdx  = before.lastIndexOf('@');
    var inserted = '@' + username + ' ';
    mentionTa.value = before.slice(0, atIdx) + inserted + after;
    var newPos = atIdx + inserted.length;
    mentionTa.setSelectionRange(newPos, newPos);
    mentionTa.focus();
    hideMentionDd();
  }

  function renderMentionDd(users, ta) {
    mentionDd.innerHTML = '';
    users.forEach(function (u) {
      var item = document.createElement('div');
      item.className = 'flex items-center gap-2.5 px-3 py-2 hover:bg-white/6 cursor-pointer transition-colors';
      item.innerHTML = (u.avatar
        ? '<img src="' + u.avatar + '" class="w-6 h-6 rounded-full object-cover shrink-0">'
        : '<div class="w-6 h-6 rounded-full bg-charm-950 border border-white/10 shrink-0 flex items-center justify-center"><iconify-icon icon="boxicons:user-filled" width="12" style="color:#e680a6"></iconify-icon></div>')
        + '<div class="flex flex-col min-w-0">'
        + '<span class="text-xs font-semibold text-white/80 truncate">' + escHtml(u.displayName || u.username) + '</span>'
        + '<span class="text-xs text-white/35 truncate">@' + escHtml(u.username) + '</span>'
        + '</div>';
      item.addEventListener('mousedown', function (e) {
        e.preventDefault();
        insertMention(u.username);
      });
      mentionDd.appendChild(item);
    });
    mentionTa = ta;
    mentionDd.classList.remove('hidden');
    positionMentionDd(ta);
  }

  document.addEventListener('input', function (e) {
    var ta = e.target;
    if (!ta.matches('#cc-new-body, .cc-reply-body, .cc-edit-body')) return;
    if (ta.id === 'cc-new-body') {
      var countEl = document.getElementById('cc-new-count');
      if (countEl) countEl.textContent = ta.value.replace(/\s/g, '').length + '/280';
    }
    var q = getMentionQuery(ta);
    if (q === null || q === '') { hideMentionDd(); return; }
    clearTimeout(mentionTimer);
    mentionTimer = setTimeout(function () {
      fetch('/api/users/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (users) {
          if (!users.length) { hideMentionDd(); return; }
          renderMentionDd(users, ta);
        })
        .catch(function () { hideMentionDd(); });
    }, 200);
  });

  document.addEventListener('keydown', function (e) {
    if (!mentionDd.classList.contains('hidden') && e.key === 'Escape') {
      e.stopPropagation();
      hideMentionDd();
      return;
    }
  });

  document.addEventListener('click', function (e) {
    if (!mentionDd.contains(e.target)) hideMentionDd();
  });

  document.addEventListener('scroll', function () {
    if (!mentionDd.classList.contains('hidden') && mentionTa) positionMentionDd(mentionTa);
  }, true);

  function updateCommentCount(delta) {
    var btn  = document.getElementById('tab-btn-comments');
    if (!btn) return;
    var span = btn.querySelector('span');
    var cur  = span ? parseInt(span.textContent.replace(/\D/g,''), 10) || 0 : 0;
    var next = Math.max(0, cur + delta);
    if (!span) {
      span = document.createElement('span');
      span.className = 'text-white/40 font-normal text-xs';
      btn.appendChild(span);
    }
    span.textContent = next ? '(' + next + ')' : '';
  }

  // New top-level comment
  var newBody   = document.getElementById('cc-new-body');
  var newSubmit = document.getElementById('cc-new-submit');
  var newCancel = document.getElementById('cc-new-cancel');

  function postNewComment() {
    var body = newBody.value.trim();
    if (!body || newBody.dataset.posting) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Comment cannot exceed 280 characters (spaces not counted).', 'error');
      return;
    }
    newBody.dataset.posting = '1';
    if (newSubmit) newSubmit.disabled = true;
    fetch('/api/contests/' + CONTEST_ID_CC + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var list  = document.getElementById('cc-list');
      var empty = list.querySelector('p.text-white\\/25');
      if (empty) empty.remove();
      list.insertAdjacentHTML('beforeend', buildCommentHtml(data, false));
      newBody.value = '';
      updateCommentCount(1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete newBody.dataset.posting; if (newSubmit) newSubmit.disabled = false; });
  }

  if (newBody) {
    newBody.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); postNewComment(); }
    });
  }
  if (newSubmit) newSubmit.addEventListener('click', postNewComment);
  if (newCancel) newCancel.addEventListener('click', function () { newBody.value = ''; newBody.focus(); });

  function submitReply(form) {
    var ta       = form.querySelector('.cc-reply-body');
    var parentId = form.dataset.parentId;
    if (!parentId || ta.dataset.posting) return;
    var mention = form.querySelector('.cc-reply-mention');
    var mentionPrefix = (mention && !mention.classList.contains('hidden') && mention.textContent) ? mention.textContent + ' ' : '';
    var body     = mentionPrefix + ta.value.trim();
    if (!body.trim()) return;
    if (body.replace(/\s/g, '').length > 280) {
      if (window.showToast) window.showToast('Comment cannot exceed 280 characters (spaces not counted).', 'error');
      return;
    }
    ta.dataset.posting = '1';
    var btn = form.querySelector('.cc-reply-submit');
    if (btn) btn.disabled = true;
    fetch('/api/contests/' + CONTEST_ID_CC + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ body: body, parentId: parentId }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
      var repliesEl = document.querySelector('.cc-replies[data-parent-id="' + parentId + '"]');
      if (repliesEl) {
        repliesEl.classList.remove('hidden');
        repliesEl.classList.add('flex');
        repliesEl.insertAdjacentHTML('beforeend', buildCommentHtml(data, true));
        var replyCount = repliesEl.querySelectorAll(':scope > .cc-item').length;
        var rcnt = document.querySelector('.cc-reply-btn[data-cid="' + parentId + '"] .cc-rcnt');
        if (rcnt) { rcnt.textContent = replyCount; rcnt.classList.remove('hidden'); }
      }
      form.classList.add('hidden');
      ta.value = '';
      updateCommentCount(1);
    })
    .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
    .finally(function () { delete ta.dataset.posting; if (btn) btn.disabled = false; });
  }

  // Reply — Enter to send, Shift+Enter for newline
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' || e.shiftKey) return;
    var ta = e.target.closest('.cc-reply-body');
    if (!ta) return;
    e.preventDefault();
    submitReply(ta.closest('.cc-reply-form'));
  });

  document.addEventListener('click', function (e) {

    // Reply button — toggle replies container + reply form
    var replyBtn = e.target.closest('.cc-reply-btn');
    if (replyBtn) {
      var rcid = replyBtn.dataset.cid;
      var item = replyBtn.closest('.cc-item');
      var mentionUsername = item && item.dataset.username;
      // If inside a replies container this is a reply-item → open parent's form
      var repliesContainer = item && item.closest('.cc-replies');
      if (repliesContainer) {
        var rootItem = repliesContainer.closest('.cc-item');
        var rootCid  = rootItem && rootItem.dataset.cid;
        var form = rootItem && rootItem.querySelector('.cc-reply-form[data-parent-id="' + rootCid + '"]');
        if (form) {
          form.classList.remove('hidden');
          var mention = form.querySelector('.cc-reply-mention');
          if (mention && mentionUsername) {
            mention.textContent = '@' + mentionUsername;
            mention.classList.remove('hidden');
          }
          form.querySelector('.cc-reply-body').focus();
        }
        return;
      }
      // Top-level: toggle replies container + reply form together
      var form      = item && item.querySelector('.cc-reply-form[data-parent-id="' + rcid + '"]');
      var repliesEl = item && item.querySelector('.cc-replies[data-parent-id="' + rcid + '"]');
      var isOpen    = form && !form.classList.contains('hidden');
      if (isOpen) {
        if (form) form.classList.add('hidden');
        if (repliesEl) { repliesEl.classList.add('hidden'); repliesEl.classList.remove('flex'); }
      } else {
        if (repliesEl) { repliesEl.classList.remove('hidden'); repliesEl.classList.add('flex'); }
        if (form) { form.classList.remove('hidden'); form.querySelector('.cc-reply-body').focus(); }
      }
      return;
    }

    // Reply submit button
    var replySubmit = e.target.closest('.cc-reply-submit');
    if (replySubmit && !replySubmit.disabled) {
      submitReply(replySubmit.closest('.cc-reply-form'));
      return;
    }

    // Reply cancel
    var replyCancel = e.target.closest('.cc-reply-cancel');
    if (replyCancel) {
      var form = replyCancel.closest('.cc-reply-form');
      if (form) {
        form.classList.add('hidden');
        form.querySelector('.cc-reply-body').value = '';
        var mention = form.querySelector('.cc-reply-mention');
        if (mention) { mention.textContent = ''; mention.classList.add('hidden'); }
      }
      return;
    }

    // Edit button — swap body for textarea
    var editBtn = e.target.closest('.cc-edit-btn');
    if (editBtn) {
      var item = editBtn.closest('.cc-item');
      item.querySelector('.cc-body').classList.add('hidden');
      item.querySelector('.cc-edit-wrap').classList.remove('hidden');
      item.querySelector('.cc-edit-body').focus();
      return;
    }

    // Edit cancel
    var editCancel = e.target.closest('.cc-edit-cancel');
    if (editCancel) {
      var item = editCancel.closest('.cc-item');
      item.querySelector('.cc-body').classList.remove('hidden');
      item.querySelector('.cc-edit-wrap').classList.add('hidden');
      return;
    }

    // Edit save
    var editSave = e.target.closest('.cc-edit-save');
    if (editSave && !editSave.disabled) {
      var item      = editSave.closest('.cc-item');
      var body      = item.querySelector('.cc-edit-body').value.trim();
      var cid       = editSave.dataset.cid;
      var contestId = editSave.dataset.contestId;
      if (!body) return;
      if (body.replace(/\s/g, '').length > 280) {
        if (window.showToast) window.showToast('Comment cannot exceed 280 characters (spaces not counted).', 'error');
        return;
      }
      editSave.disabled = true;
      fetch('/api/contests/' + contestId + '/comments/' + cid, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body: body }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var bodyEl = item.querySelector('.cc-body');
        bodyEl.innerHTML = linkifyMentions(escHtml(data.body));
        bodyEl.classList.remove('hidden');
        item.querySelector('.cc-edit-wrap').classList.add('hidden');
        item.querySelector('.cc-edit-body').value = data.body;
        // mark as edited
        var meta = item.querySelector('.flex.items-baseline');
        if (meta && !meta.querySelector('.cc-edited-badge')) {
          var badge = document.createElement('span');
          badge.className = 'cc-edited-badge text-xs text-white/20 italic';
          badge.textContent = 'edited';
          meta.appendChild(badge);
        }
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { editSave.disabled = false; });
      return;
    }

    // Delete
    var delBtn = e.target.closest('.cc-del-btn');
    if (delBtn && !delBtn.disabled) {
      var cid       = delBtn.dataset.cid;
      var contestId = delBtn.dataset.contestId;
      delBtn.disabled = true;
      fetch('/api/contests/' + contestId + '/comments/' + cid, { method: 'DELETE' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var item = document.querySelector('.cc-item[data-cid="' + cid + '"]');
        if (!item) return;
        // if top-level, count replies too
        var replyCount = (item.querySelectorAll('.cc-replies .cc-item') || []).length;
        item.remove();
        updateCommentCount(-(1 + replyCount));
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { delBtn.disabled = false; });
      return;
    }

    // Report
    var reportBtn = e.target.closest('.cc-report-btn');
    if (reportBtn && !reportBtn.disabled) {
      var cid       = reportBtn.dataset.cid;
      var contestId = reportBtn.dataset.contestId;
      reportBtn.disabled = true;
      fetch('/api/contests/' + contestId + '/comments/' + cid + '/report', { method: 'POST' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        reportBtn.textContent = 'Reported';
        reportBtn.classList.add('text-white/20');
      })
      .catch(function () {
        if (window.showToast) window.showToast('Something went wrong.', 'error');
        reportBtn.disabled = false;
      });
      return;
    }

    // Like / dislike comment
    var reactBtn = e.target.closest('.cc-react-btn');
    if (reactBtn && !reactBtn.dataset.reacting) {
      var cid       = reactBtn.dataset.cid;
      var contestId = reactBtn.dataset.contestId;
      var type      = reactBtn.dataset.type;
      reactBtn.dataset.reacting = '1';
      fetch('/api/contests/' + contestId + '/comments/' + cid + '/react', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: type }),
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); return; }
        var item = document.querySelector('.cc-item[data-cid="' + cid + '"]');
        if (!item) return;
        var likeBtn = item.querySelector('.cc-react-btn[data-type="like"]');
        if (likeBtn) {
          var likeIcon  = likeBtn.querySelector('iconify-icon');
          var likeCount = likeBtn.querySelector('.cc-like-count');
          if (likeIcon)  likeIcon.setAttribute('icon', data.userLiked ? 'boxicons:thumb-up-filled' : 'boxicons:thumb-up');
          likeBtn.className = 'cc-react-btn flex items-center gap-1 transition-colors cursor-pointer ' + (data.userLiked ? 'text-charm-400' : 'text-zinc-400 hover:text-zinc-200');
          if (likeCount) { likeCount.textContent = data.likes || ''; likeCount.classList.toggle('hidden', !data.likes); }
        }
        var dislikeBtn = item.querySelector('.cc-react-btn[data-type="dislike"]');
        if (dislikeBtn) {
          var dlIcon  = dislikeBtn.querySelector('iconify-icon');
          var dlCount = dislikeBtn.querySelector('.cc-dislike-count');
          if (dlIcon)  dlIcon.setAttribute('icon', data.userDisliked ? 'boxicons:thumb-down-filled' : 'boxicons:thumb-down');
          dislikeBtn.className = 'cc-react-btn flex items-center gap-1 transition-colors cursor-pointer ' + (data.userDisliked ? 'text-red-400' : 'text-zinc-400 hover:text-zinc-200');
          if (dlCount) { dlCount.textContent = data.dislikes || ''; dlCount.classList.toggle('hidden', !data.dislikes); }
        }
      })
      .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); })
      .finally(function () { delete reactBtn.dataset.reacting; });
      return;
    }

  });

}());

// ── Chilli contribution popup ─────────────────────────────────────
(function () {
  var CONTEST_ID = '<%= contest._id %>';

  // Server-rendered contribution data for each side (snapshot on page load)
  var SIDES = {
    left: {
      entryId:    '<%= ls && ls.entryId || "" %>',
      name:       <%- JSON.stringify(ls && ls.user && (ls.user.displayName && ls.user.displayName.value || '@' + ls.user.username.value) || '') %>,
      handle:         <%- JSON.stringify(ls && ls.user && ls.user.username && ls.user.username.value || '') %>,
      avatar:         <%- JSON.stringify(ls && ls.user && ls.user.avatar && ls.user.avatar.value || '') %>,
      entryMediaUrl:  <%- JSON.stringify(ls && ls.entry && ls.entry.mediaUrl || '') %>,
      entryMediaType: <%- JSON.stringify(ls && ls.entry && ls.entry.mediaType || 'photo') %>,
      existing:   <%- (ls && ls.entryId && myContribMap[ls.entryId]) ? myContribMap[ls.entryId].amountCHL : 0 %>,
      balance:    <%- viewerBalanceCHL %>,
      milestones: <%- JSON.stringify((contribRankLeft || []).filter(function(c){ return c.contributorId && String(c.contributorId._id) !== (locals.currentUser ? String(locals.currentUser._id) : ''); }).map(function(c){ return { amount: c.amountCHL, avatar: c.contributorId && c.contributorId.avatar && c.contributorId.avatar.value || '' }; })) %>,
      canContrib: <%- (canContribute && locals.currentUser && ls && !ls.isMine) ? 'true' : 'false' %>,
    },
    right: {
      entryId:    '<%= rs && rs.entryId || "" %>',
      name:       <%- JSON.stringify(rs && rs.user && (rs.user.displayName && rs.user.displayName.value || '@' + rs.user.username.value) || '') %>,
      handle:         <%- JSON.stringify(rs && rs.user && rs.user.username && rs.user.username.value || '') %>,
      avatar:         <%- JSON.stringify(rs && rs.user && rs.user.avatar && rs.user.avatar.value || '') %>,
      entryMediaUrl:  <%- JSON.stringify(rs && rs.entry && rs.entry.mediaUrl || '') %>,
      entryMediaType: <%- JSON.stringify(rs && rs.entry && rs.entry.mediaType || 'photo') %>,
      existing:   <%- (rs && rs.entryId && myContribMap[rs.entryId]) ? myContribMap[rs.entryId].amountCHL : 0 %>,
      balance:    <%- viewerBalanceCHL %>,
      milestones: <%- JSON.stringify((contribRankRight || []).filter(function(c){ return c.contributorId && String(c.contributorId._id) !== (locals.currentUser ? String(locals.currentUser._id) : ''); }).map(function(c){ return { amount: c.amountCHL, avatar: c.contributorId && c.contributorId.avatar && c.contributorId.avatar.value || '' }; })) %>,
      canContrib: <%- (canContribute && locals.currentUser && rs && rs.entryId && !rs.isMine) ? 'true' : 'false' %>,
    },
  };

  var modal          = document.getElementById('contrib-modal');
  var modalBg        = document.getElementById('contrib-modal-bg');
  var modalClose     = document.getElementById('contrib-modal-close');
  var modalTitle     = document.getElementById('contrib-modal-title');
  var modalBal       = document.getElementById('contrib-modal-balance');
  var modalRecipient = document.getElementById('contrib-modal-recipient');
  var mount          = document.getElementById('contrib-modal-mount');

  var activeSide = null;

  function renderRecipient(selectedSide) {
    if (!modalRecipient) return;
    var available = ['left', 'right'].filter(function (s) { return SIDES[s] && SIDES[s].canContrib; });
    var sd = SIDES[selectedSide];
    var canToggle = available.length > 1;

    var arrowHtml = canToggle
      ? '<button type="button" class="contrib-toggle-btn shrink-0 w-8 self-stretch flex items-center justify-center text-white/50 hover:text-white transition-colors cursor-pointer border-r border-white/8">'
        + '<iconify-icon icon="boxicons:arrow-left-right" width="15"></iconify-icon>'
        + '</button>'
      : '<span class="shrink-0 w-8 border-r border-white/8 self-stretch"></span>';

    var avatarHtml = sd.avatar
      ? '<img src="' + sd.avatar + '" alt="" class="w-9 h-9 rounded-full object-cover border border-white/15 shrink-0">'
      : '<span class="w-9 h-9 rounded-full bg-charm-950 border border-white/15 flex items-center justify-center shrink-0"><iconify-icon icon="boxicons:user-filled" width="15" style="color:#e680a6"></iconify-icon></span>';
    var handleHtml = sd.handle ? '<p class="text-[11px] text-white/40 truncate">@' + sd.handle + '</p>' : '';
    var pfpHtml = '<div class="flex items-center gap-2.5 flex-1 min-w-0">'
      + avatarHtml
      + '<div class="flex flex-col gap-0.5 min-w-0"><p class="text-sm font-semibold text-white leading-tight truncate">' + sd.name + '</p>' + handleHtml + '</div>'
      + '</div>';

    var thumbHtml = sd.entryMediaUrl
      ? (sd.entryMediaType === 'video'
          ? '<div class="shrink-0 w-14 h-14 rounded-r-md overflow-hidden border-l border-white/8">'
            + '<video src="' + sd.entryMediaUrl + '" class="w-full h-full object-cover" muted preload="metadata" playsinline></video>'
            + '</div>'
          : '<img src="' + sd.entryMediaUrl + '" alt="" class="shrink-0 w-14 h-14 rounded-r-md object-cover border-l border-white/8">')
      : '<div class="shrink-0 w-14 h-14 rounded-r-md bg-shark-800 border-l border-white/8"></div>';

    modalRecipient.innerHTML = '<div class="flex items-center bg-shark-800/60 border border-white/8 rounded-md overflow-hidden">'
      + arrowHtml
      + '<div class="flex items-center gap-2.5 flex-1 px-3 py-2 min-w-0">' + pfpHtml + '</div>'
      + thumbHtml
      + '</div>';
  }

  function mountSide(side) {
    var sd = SIDES[side];
    activeSide = side;
    if (modalBal) modalBal.textContent = Number(sd.balance).toLocaleString();
    mount.dataset.entryId    = sd.entryId;
    mount.dataset.side       = side;
    mount.dataset.contestId  = CONTEST_ID;
    mount.dataset.existing   = sd.existing;
    mount.dataset.balance    = sd.balance;
    mount.dataset.max        = sd.balance;
    mount.dataset.milestones = JSON.stringify(sd.milestones);
    initContribSlider(mount);
  }

  function openModal(side) {
    var sd = SIDES[side];
    if (!sd || !sd.canContrib || !modal) return;
    modalTitle.textContent = 'Contribute to';
    renderRecipient(side);
    mountSide(side);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    activeSide = null;
  }

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modalBg)    modalBg.addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && activeSide) { e.stopPropagation(); closeModal(); }
  });

  // Open on 🌶️ button click
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-contrib-open]');
    if (btn) { openModal(btn.dataset.contribOpen); return; }

    // Toggle arrow — switch to the other available side
    if (e.target.closest('.contrib-toggle-btn')) {
      var available = ['left', 'right'].filter(function (s) { return SIDES[s] && SIDES[s].canContrib; });
      var otherSide = available.find(function (s) { return s !== activeSide; });
      if (otherSide) { renderRecipient(otherSide); mountSide(otherSide); }
      return;
    }
  });

  // ── Slider logic ──────────────────────────────────────────────────

  function getStep(max) {
    if (max <= 100)  return 1;
    if (max <= 500)  return 5;
    if (max <= 2000) return 10;
    return 25;
  }

  function buildClusters(milestones, max) {
    var step = getStep(max);
    var threshold = Math.max(step * 2, Math.floor(max * 0.05));
    var clusters = [];
    var sorted = milestones.filter(function (m) { return m.amount <= max; }).sort(function (a, b) { return a.amount - b.amount; });
    sorted.forEach(function (m) {
      var last = clusters[clusters.length - 1];
      if (last && (m.amount - last.midAmount) <= threshold) {
        last.items.push(m);
        last.midAmount = last.items.reduce(function (s, x) { return s + x.amount; }, 0) / last.items.length;
      } else {
        clusters.push({ items: [m], midAmount: m.amount });
      }
    });
    return clusters;
  }

  function avatarEl(avatar) {
    if (avatar) return '<img src="' + avatar + '" alt="" class="w-6 h-6 rounded-full object-cover border border-white/15 shadow-md">';
    return '<span class="w-6 h-6 rounded-full bg-charm-950 border border-white/15 flex items-center justify-center"><iconify-icon icon="boxicons:user-filled" width="11" style="color:#e680a6"></iconify-icon></span>';
  }

  function initContribSlider(m) {
    var entryId  = m.dataset.entryId;
    var side     = m.dataset.side;
    var cid      = m.dataset.contestId;
    var existing = parseInt(m.dataset.existing, 10) || 0;
    var balance  = parseInt(m.dataset.balance, 10)  || 0;
    var max      = parseInt(m.dataset.max, 10)       || balance;
    var milestones;
    try { milestones = JSON.parse(m.dataset.milestones || '[]'); } catch (x) { milestones = []; }

    if (max === 0) {
      m.innerHTML = '<p class="text-sm text-white/40 text-center py-3">No balance to contribute. <a href="/wallet/topup" class="text-charm-400 hover:text-charm-300 transition-colors">Top up →</a></p>';
      return;
    }

    var initVal = 0;
    var step    = getStep(max);
    var clusters = buildClusters(milestones, max);

    var markersHtml = clusters.map(function (cl) {
      var pct = max > 0 ? Math.min(100, (cl.midAmount / max) * 100).toFixed(2) : 0;
      var tip = cl.items.length === 1
        ? cl.midAmount + ' 🌶️'
        : cl.items.length + ' contributors at ~' + Math.round(cl.midAmount) + ' 🌶️';
      var inner = cl.items.length === 1
        ? avatarEl(cl.items[0].avatar)
        : '<span class="w-6 h-6 rounded-full bg-shark-800 border border-white/20 flex items-center justify-center text-[10px] font-bold text-white/60">' + cl.items.length + '</span>';
      return '<div class="absolute bottom-0 -translate-x-1/2 flex flex-col items-center" title="' + tip + '" style="left:' + pct + '%">'
        + inner + '<div class="w-px h-1.5 bg-white/20 shrink-0"></div></div>';
    }).join('');

    m.innerHTML =
      (existing > 0 ? '<p class="text-xs text-white/50 mb-3">Current contribution: <span class="text-charm-400 font-semibold">' + existing.toLocaleString() + ' 🌶️</span></p>' : '') +
      (clusters.length ? '<div class="relative h-8 mb-1">' + markersHtml + '</div>' : '') +
      '<input type="range" class="contrib-range" min="0" max="' + max + '" step="' + step + '" value="0">' +
      '<div class="flex items-center gap-1.5 mt-3">' +
        '<span class="text-sm shrink-0">🌶️</span>' +
        '<input type="number" class="contrib-num min-w-0 flex-1 bg-shark-800 border border-white/10 rounded-md px-2 py-1.5 text-xs text-white focus:outline-none focus:border-charm-500/60" min="0" max="' + max + '" value="0" placeholder="0">' +
      '</div>' +
      '<div class="flex gap-2 mt-3">' +
        '<button type="button" class="contrib-send-btn flex-1 py-2.5 text-xs font-bold rounded-md transition-colors cursor-pointer bg-shark-700 text-white/35 hover:bg-shark-600 hover:text-white/60"' +
          ' data-entry-id="' + entryId + '" data-side="' + side + '" data-contest-id="' + cid + '">Contribute' +
        '</button>' +
      '</div>';

    var rangeEl = m.querySelector('.contrib-range');
    var numEl   = m.querySelector('.contrib-num');
    var sendBtn = m.querySelector('.contrib-send-btn');

    function syncTrack(v) {
      var pct = max > 0 ? ((v / max) * 100).toFixed(2) : 0;
      rangeEl.style.setProperty('--fill-pct', pct + '%');
    }
    function activateBtn(v) {
      sendBtn.className = 'contrib-send-btn flex-1 py-2.5 text-xs font-bold rounded-md transition-colors cursor-pointer bg-charm-600 hover:bg-charm-500 text-white';
      sendBtn.textContent = 'Contribute ' + Number(v).toLocaleString() + ' Chillies';
    }
    function deactivateBtn() {
      sendBtn.className = 'contrib-send-btn flex-1 py-2.5 text-xs font-bold rounded-md transition-colors cursor-pointer bg-shark-700 text-white/35 hover:bg-shark-600 hover:text-white/60';
      sendBtn.textContent = 'Contribute';
    }

    rangeEl.addEventListener('input', function () {
      var v = parseInt(this.value, 10);
      numEl.value = v;
      syncTrack(v);
      if (v > 0) activateBtn(v); else deactivateBtn();
    });
    numEl.addEventListener('input', function () {
      var v = Math.max(0, Math.min(max, parseInt(this.value, 10) || 0));
      rangeEl.value = v;
      syncTrack(v);
      if (v > 0) activateBtn(v); else deactivateBtn();
    });
    syncTrack(0);
  }

  // ── API handlers ──────────────────────────────────────────────────

  function updateGrossBtns(data) {
    var gross  = data.grossByEntry || {};
    var lGross = gross['<%= ls && ls.entryId ? ls.entryId : "" %>'];
    var rGross = gross['<%= rs && rs.entryId ? rs.entryId : "" %>'];
    var lBtn = document.querySelector('[data-contrib-open="left"] span:last-child');
    var rBtn = document.querySelector('[data-contrib-open="right"] span:last-child');
    if (lBtn && lGross != null) lBtn.textContent = Number(lGross).toLocaleString();
    if (rBtn && rGross != null) rBtn.textContent = Number(rGross).toLocaleString();
  }

  function afterSuccess(side, newExisting, newBalance) {
    var sd = SIDES[side];
    if (sd) sd.existing = newExisting;
    if (newBalance != null) {
      if (SIDES.left)  SIDES.left.balance  = newBalance;
      if (SIDES.right) SIDES.right.balance = newBalance;
      if (modalBal) modalBal.textContent = Number(newBalance).toLocaleString();
    }
    closeModal();
  }

  document.addEventListener('click', function (e) {

    var sendBtn = e.target.closest('.contrib-send-btn');
    if (sendBtn && !sendBtn.disabled) {
      var m       = sendBtn.closest('.contrib-slider-mount');
      var entryId = sendBtn.dataset.entryId;
      var side    = sendBtn.dataset.side;
      var numEl   = m && m.querySelector('.contrib-num');
      var amount  = parseInt(numEl && numEl.value, 10);

      if (!amount || amount < 1) { if (window.showToast) window.showToast('Enter an amount greater than 0.', 'error'); return; }
      sendBtn.disabled = true;
      sendBtn.style.opacity = '0.5';

      var url    = '/api/contests/' + CONTEST_ID + '/contribute';
      var method = 'POST';
      var body   = { entryId: entryId, amountCHL: amount };

      fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); sendBtn.disabled = false; sendBtn.style.opacity = ''; return; }
          updateGrossBtns(data);
          afterSuccess(side, data.myAmountCHL != null ? data.myAmountCHL : amount, data.newBalance);
          if (window.burstContribConfetti) window.burstContribConfetti(SIDES[side] && SIDES[side].avatar || '');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); sendBtn.disabled = false; sendBtn.style.opacity = ''; });
      return;
    }

    var wdBtn = e.target.closest('.contrib-withdraw-btn');
    if (wdBtn && !wdBtn.disabled) {
      var entryId  = wdBtn.dataset.entryId;
      var side     = wdBtn.dataset.side;
      var listRow  = wdBtn.closest('[data-contrib-row]');
      wdBtn.disabled = true;
      fetch('/api/contests/' + CONTEST_ID + '/contribute/' + entryId, { method: 'DELETE' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) { if (window.showToast) window.showToast(data.error, 'error'); wdBtn.disabled = false; return; }
          updateGrossBtns(data);
          afterSuccess(side, 0, data.newBalance);
          if (listRow && listRow.parentNode) listRow.parentNode.removeChild(listRow);
          if (window.showToast) window.showToast('Contribution withdrawn.', 'success');
        })
        .catch(function () { if (window.showToast) window.showToast('Something went wrong.', 'error'); wdBtn.disabled = false; });
      return;
    }

  });
}());
</script>

<%- include('partials/appEnd') %>
