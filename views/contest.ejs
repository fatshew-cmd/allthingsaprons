            <button type="button" class="cc-report-btn text-xs text-white/20 hover:text-white/50 transition-colors cursor-pointer" data-cid="<%= cid %>" data-contest-id="<%= contest._id %>">Report</button>
            <% } %>
          </div>
          <!-- Reply input (hidden) -->
