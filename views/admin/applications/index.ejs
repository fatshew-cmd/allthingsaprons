<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'applications' }) %>

  <div class="flex-1 overflow-y-auto">
    <div class="max-w-4xl mx-auto px-8 py-10">

      <div class="mb-6 flex items-center justify-between gap-4">
        <div>
          <h1 class="text-xl font-bold text-white m-0">Applications</h1>
          <p class="text-sm text-zinc-500 mt-1 m-0">Job applications submitted through the careers page.</p>
        </div>
        <a href="/careers" target="_blank"
          class="flex items-center gap-1.5 text-xs text-zinc-400 hover:text-white border border-white/10 hover:border-white/20 rounded-md px-3 py-1.5 transition-colors no-underline">
          <iconify-icon icon="lucide:external-link" width="12"></iconify-icon>
          View careers page
        </a>
      </div>

      <% if (hired) { %>
      <div class="mb-5 flex items-center gap-2.5 bg-emerald-500/10 border border-emerald-500/20 rounded-md px-4 py-3 text-sm text-emerald-400">
        <iconify-icon icon="lucide:check-circle" width="15" class="shrink-0"></iconify-icon>
        Account created and invite email sent.
      </div>
      <% } %>

      <!-- Status filter -->
      <div class="flex items-center gap-2 mb-5">
        <% [['', 'All'], ['pending', 'Pending'], ['reviewed', 'Reviewed'], ['hired', 'Hired'], ['rejected', 'Rejected']].forEach(function(f) { %>
        <a href="/admin/applications<%= f[0] ? '?status=' + f[0] : '' %>"
          class="text-[12px] px-3 py-1 rounded-md border transition-colors no-underline <%= statusFilter === f[0] ? 'bg-white/10 border-white/20 text-white font-semibold' : 'border-white/8 text-zinc-500 hover:text-zinc-200 hover:border-white/15' %>">
          <%= f[1] %>
        </a>
        <% }); %>
      </div>

      <% if (applications.length === 0) { %>
      <div class="text-center py-16 text-zinc-600 text-sm">No applications found.</div>
      <% } else { %>
      <div class="flex flex-col gap-2">
        <% applications.forEach(function(app) {
          const statusColors = {
            pending:  'bg-amber-500/15 text-amber-400 border-amber-500/25',
            reviewed: 'bg-blue-500/15 text-blue-400 border-blue-500/25',
            hired:    'bg-emerald-500/15 text-emerald-400 border-emerald-500/25',
            rejected: 'bg-red-500/15 text-red-400 border-red-500/25',
          };
          const statusLabel = { pending: 'Pending', reviewed: 'Reviewed', hired: 'Hired', rejected: 'Rejected' };
          const date = new Date(app.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        %>
        <a href="/admin/applications/<%= app._id %>"
          class="flex items-center gap-4 bg-zinc-900 border border-white/8 hover:border-white/15 rounded-md px-5 py-3.5 transition-colors no-underline group">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-white m-0 group-hover:text-amber-400 transition-colors"><%= app.name %></p>
            <p class="text-xs text-zinc-500 m-0 mt-0.5"><%= app.email %></p>
          </div>
          <p class="text-[11px] text-zinc-600 shrink-0"><%= date %></p>
          <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded border shrink-0 <%= statusColors[app.status] || 'bg-white/5 text-zinc-400 border-white/10' %>">
            <%= statusLabel[app.status] || app.status %>
          </span>
          <iconify-icon icon="lucide:chevron-right" width="14" class="text-zinc-600 group-hover:text-zinc-400 transition-colors shrink-0"></iconify-icon>
        </a>
        <% }); %>
      </div>
      <% } %>

    </div>
  </div>

</body>
</html>
