<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'applications' }) %>

  <div class="flex-1 overflow-y-auto">
    <div class="max-w-3xl mx-auto px-8 py-10">

      <!-- Back -->
      <a href="/admin/applications" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-white transition-colors no-underline mb-6">
        <iconify-icon icon="lucide:arrow-left" width="13"></iconify-icon>
        All applications
      </a>

      <%
        const statusColors = {
          pending:  'bg-amber-500/15 text-amber-400 border-amber-500/25',
          reviewed: 'bg-blue-500/15 text-blue-400 border-blue-500/25',
          hired:    'bg-emerald-500/15 text-emerald-400 border-emerald-500/25',
          rejected: 'bg-red-500/15 text-red-400 border-red-500/25',
        };
        const statusLabel = { pending: 'Pending', reviewed: 'Reviewed', hired: 'Hired', rejected: 'Rejected' };
        const date = new Date(application.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        const TIER_ORDER = { moderator: 1, supervisor: 2, superadmin: 3, founder: 4 };
        const granterTier = TIER_ORDER[granterRole] || 0;
        const ALL_PERMS = ['content', 'chat', 'comments', 'financial', 'support'];
        const PERM_LABELS = { content: 'Content', chat: 'Chat', comments: 'Comments', financial: 'Financial', support: 'Support' };
        const hireableRoles = [
          { value: 'moderator',  label: 'Moderator',  tier: 1 },
          { value: 'supervisor', label: 'Supervisor',  tier: 2 },
          { value: 'superadmin', label: 'Super Admin', tier: 3 },
        ].filter(r => granterTier - r.tier >= 2);
      %>

      <!-- Header -->
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-xl font-bold text-white m-0"><%= application.name %></h1>
          <p class="text-sm text-zinc-500 m-0 mt-0.5"><%= application.email %> · Submitted <%= date %></p>
        </div>
        <span class="text-[11px] font-semibold px-2.5 py-1 rounded border shrink-0 mt-1 <%= statusColors[application.status] || '' %>">
          <%= statusLabel[application.status] || application.status %>
        </span>
      </div>

      <% if (error) { %>
      <div class="mb-5 flex items-center gap-2 bg-red-500/10 border border-red-500/20 rounded-md px-4 py-3 text-sm text-red-400">
        <iconify-icon icon="lucide:alert-circle" width="14" class="shrink-0"></iconify-icon>
        <%= error %>
      </div>
      <% } %>

      <!-- Application content -->
      <div class="bg-zinc-900 border border-white/8 rounded-md divide-y divide-white/8 mb-6">

        <% if (application.linkedin) { %>
        <div class="px-5 py-3.5 flex items-center gap-3">
          <iconify-icon icon="lucide:linkedin" width="14" class="text-zinc-500 shrink-0"></iconify-icon>
          <a href="<%= application.linkedin %>" target="_blank" rel="noopener"
            class="text-sm text-blue-400 hover:text-blue-300 transition-colors truncate no-underline">
            <%= application.linkedin %>
          </a>
        </div>
        <% } %>

        <div class="px-5 py-4">
          <p class="text-[11px] font-semibold text-zinc-600 uppercase tracking-widest mb-2">Message</p>
          <p class="text-sm text-zinc-300 leading-relaxed m-0 whitespace-pre-wrap"><%= application.message %></p>
        </div>

      </div>

      <!-- Actions -->
      <% if (application.status !== 'hired') { %>
      <div class="flex flex-wrap items-center gap-3 mb-6">

        <% if (application.status !== 'reviewed') { %>
        <form action="/admin/applications/<%= application._id %>/status" method="POST">
          <input type="hidden" name="status" value="reviewed">
          <button type="submit" class="text-sm px-4 py-2 rounded-md border border-blue-500/30 text-blue-400 hover:bg-blue-500/10 transition-colors cursor-pointer">
            Mark as reviewed
          </button>
        </form>
        <% } %>

        <% if (application.status !== 'rejected') { %>
        <form action="/admin/applications/<%= application._id %>/status" method="POST">
          <input type="hidden" name="status" value="rejected">
          <button type="submit" class="text-sm px-4 py-2 rounded-md border border-red-500/25 text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer">
            Reject
          </button>
        </form>
        <% } %>

      </div>
      <% } %>

      <!-- Hire section -->
      <% if (application.status !== 'hired' && application.status !== 'rejected' && hireableRoles.length > 0) { %>
      <div class="bg-zinc-900 border border-white/8 rounded-md px-5 py-5">
        <h2 class="text-sm font-semibold text-white mb-1 m-0">Hire this applicant</h2>
        <p class="text-xs text-zinc-500 mb-5 m-0">An account will be created and an invite email sent to <strong class="text-zinc-300"><%= application.email %></strong>. The link expires in 72 hours.</p>

        <form action="/admin/applications/<%= application._id %>/hire" method="POST" class="flex flex-col gap-4">

          <!-- Role -->
          <div class="flex flex-col gap-1.5">
            <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-widest">Role</label>
            <select name="role" id="hire-role"
              class="bg-zinc-800 border border-white/10 text-white text-sm rounded-md px-3 py-2 outline-none focus:border-white/25 cursor-pointer w-48">
              <% hireableRoles.forEach(function(r) { %>
              <option value="<%= r.value %>"><%= r.label %></option>
              <% }); %>
            </select>
          </div>

          <!-- Permissions -->
          <div id="perm-section" class="flex flex-col gap-1.5">
            <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-widest">Domain permission</label>
            <div class="flex flex-wrap gap-3">
              <% ALL_PERMS.forEach(function(p) { %>
              <label class="flex items-center gap-2 text-sm text-zinc-300 cursor-pointer select-none">
                <input type="checkbox" name="permissions" value="<%= p %>" class="perm-cb accent-amber-500 cursor-pointer">
                <%= PERM_LABELS[p] %>
              </label>
              <% }); %>
            </div>
            <p id="perm-hint" class="text-[11px] text-zinc-600 m-0"></p>
          </div>

          <!-- Temporary account -->
          <div class="flex flex-col gap-3">
            <label class="flex items-center gap-2.5 text-sm text-zinc-300 cursor-pointer select-none">
              <input type="checkbox" name="isTemporary" id="is-temporary" class="accent-amber-500 cursor-pointer">
              Temporary account
            </label>
            <div id="expiry-section" class="hidden flex flex-col gap-1.5 pl-6">
              <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-widest">Expires on</label>
              <input type="date" name="temporaryUntil" id="temporary-until"
                class="bg-zinc-800 border border-white/10 text-white text-sm rounded-md px-3 py-2 outline-none focus:border-white/25 w-48 cursor-pointer"
                min="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

          <div class="pt-1">
            <button type="submit"
              class="bg-amber-500 hover:bg-amber-400 text-zinc-900 text-sm font-bold px-5 py-2 rounded-md transition-colors cursor-pointer">
              Send invite
            </button>
          </div>

        </form>
      </div>
      <% } %>

      <% if (application.status === 'hired') { %>
      <div class="flex items-center gap-2.5 bg-emerald-500/10 border border-emerald-500/20 rounded-md px-4 py-3 text-sm text-emerald-400">
        <iconify-icon icon="lucide:check-circle" width="15" class="shrink-0"></iconify-icon>
        An account has been created for this applicant.
      </div>
      <% } %>

    </div>
  </div>

<script>
(function () {
  var roleSelect   = document.getElementById('hire-role');
  var permSection  = document.getElementById('perm-section');
  var permHint     = document.getElementById('perm-hint');
  var isTemp       = document.getElementById('is-temporary');
  var expirySection = document.getElementById('expiry-section');

  function updatePermSection() {
    if (!roleSelect || !permSection) return;
    var role = roleSelect.value;
    if (role === 'superadmin') {
      permSection.style.display = 'none';
    } else {
      permSection.style.display = '';
      permHint.textContent = role === 'moderator' ? 'Moderators must have exactly one permission.' : '';
    }
  }

  if (roleSelect) {
    updatePermSection();
    roleSelect.addEventListener('change', updatePermSection);
  }

  if (isTemp && expirySection) {
    isTemp.addEventListener('change', function () {
      if (isTemp.checked) {
        expirySection.classList.remove('hidden');
        expirySection.style.display = 'flex';
      } else {
        expirySection.classList.add('hidden');
        expirySection.style.display = '';
      }
    });
  }
}());
</script>

</body>
</html>
