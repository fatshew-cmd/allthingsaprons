<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'users' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Content -->
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-3xl flex flex-col gap-6">

        <a href="/admin/users" class="inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors no-underline -mb-2">
          <iconify-icon icon="boxicons:chevron-left" width="14" style="display:block"></iconify-icon>
          All users
        </a>

        <!-- Profile card -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">

          <!-- Banner -->
          <div class="h-24 bg-zinc-800 relative">
            <% if (user.banner?.value) { %>
            <img src="<%= user.banner.value %>" alt="" class="w-full h-full object-cover">
            <% } %>
          </div>

          <!-- Avatar + name -->
          <div class="px-6 pb-6">
            <div class="-mt-8 mb-4">
              <% if (user.avatar?.value) { %>
              <img src="<%= user.avatar.value %>" alt="" class="w-16 h-16 rounded-md object-cover border-2 border-zinc-900 bg-zinc-800">
              <% } else { %>
              <div class="w-16 h-16 rounded-md bg-zinc-800 border-2 border-zinc-900 flex items-center justify-center">
                <iconify-icon icon="boxicons:user" width="22" style="color:#52525b;display:block"></iconify-icon>
              </div>
              <% } %>
            </div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-bold text-white text-lg m-0"><%= user.displayName?.value || user.username?.value || '—' %></p>
                <% if (user.username?.value) { %><p class="text-zinc-400 text-sm mt-0.5 mb-0">@<%= user.username.value %></p><% } %>
                <% if (user.bio?.value) { %><p class="text-zinc-400 text-sm mt-2 mb-0"><%= user.bio.value %></p><% } %>
              </div>
              <div class="flex flex-col items-end gap-1.5 shrink-0">
                <% if (user.accountStatus === 'active') { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-green-500/15 text-green-400 border border-green-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-white/8 text-zinc-400 border border-white/10">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>Onboarding
                </span>
                <% } %>
                <% if (user.idVerified) { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/25">
                  <iconify-icon icon="boxicons:shield-check" width="11" style="display:block"></iconify-icon>ID Verified
                </span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Detail rows -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Account details</p>
          </div>

          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">User ID</span>
            <span class="text-xs font-mono text-zinc-400 bg-white/5 px-2 py-1 rounded"><%= user._id %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">Email</span>
            <span class="text-sm text-white font-medium"><%= user.email?.value %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">Role</span>
            <% if (user.role === 'admin') { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-violet-500/15 text-violet-400 border border-violet-500/25">Admin</span>
            <% } else { %>
            <span class="text-sm text-zinc-400">User</span>
            <% } %>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">ID verification</span>
            <span class="text-xs font-mono text-zinc-400"><%= user.idVerificationStatus || 'none' %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">Email confirmed</span>
            <span class="text-sm text-white"><%= user.email?.confirmed ? 'Yes' : 'No' %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-white/5">
            <span class="text-sm text-zinc-400">Joined</span>
            <span class="text-sm text-white"><%= user.createdAt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between">
            <span class="text-sm text-zinc-400">Last updated</span>
            <span class="text-sm text-white"><%= user.updatedAt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
          </div>
        </div>

        <!-- ID Verification docs (if submitted) -->
        <% if (user.idSelfieUrl || user.idDocUrl) { %>
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">ID Verification documents</p>
          </div>
          <div class="p-5 grid grid-cols-2 gap-4">
            <% if (user.idSelfieUrl) { %>
            <div>
              <p class="text-sm font-semibold text-zinc-400 mb-2 m-0">Selfie with code</p>
              <img src="<%= user.idSelfieUrl %>" alt="Selfie" class="w-full rounded-md object-cover border border-white/8">
            </div>
            <% } %>
            <% if (user.idDocUrl) { %>
            <div>
              <p class="text-sm font-semibold text-zinc-400 mb-2 m-0">Government ID</p>
              <img src="<%= user.idDocUrl %>" alt="Government ID" class="w-full rounded-md object-cover border border-white/8">
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (granterRole === 'moderator' || granterRole === 'supervisor') { %>
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Set password</p>
          </div>
          <div class="px-5 pt-4 pb-2 flex items-end gap-3">
            <div class="flex flex-col gap-1.5 flex-1">
              <label class="text-xs text-zinc-400 font-medium">New password</label>
              <input type="password" id="pw-input" class="bg-zinc-800 border border-white/10 text-white text-sm rounded-md px-3 py-1.5 outline-none focus:border-white/25 w-64" placeholder="Min. 12 characters">
            </div>
            <button type="button" id="pw-btn" class="text-xs font-semibold bg-zinc-700 hover:bg-zinc-600 text-white px-3 py-1.5 rounded-md transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">Set password</button>
          </div>
          <div id="pw-reqs" class="hidden px-5 pb-3 flex-wrap gap-1.5">
            <span id="pr-length"  class="text-xs px-2 py-0.5 rounded border border-white/10 text-zinc-500">12+ chars</span>
            <span id="pr-lower"   class="text-xs px-2 py-0.5 rounded border border-white/10 text-zinc-500">3+ lowercase</span>
            <span id="pr-upper"   class="text-xs px-2 py-0.5 rounded border border-white/10 text-zinc-500">3+ uppercase</span>
            <span id="pr-digit"   class="text-xs px-2 py-0.5 rounded border border-white/10 text-zinc-500">3+ digits</span>
            <span id="pr-special" class="text-xs px-2 py-0.5 rounded border border-white/10 text-zinc-500">3+ special</span>
          </div>
          <p id="pw-error"   class="text-xs text-red-400 px-5 pb-3 m-0 hidden"></p>
          <p id="pw-success" class="text-xs text-green-400 px-5 pb-3 m-0 hidden"></p>
        </div>
        <% } %>

      </div>
    </main>
  </div>

<% if (granterRole === 'moderator' || granterRole === 'supervisor') { %>
<script>
(function () {
  var btn     = document.getElementById('pw-btn');
  var input   = document.getElementById('pw-input');
  var reqsEl  = document.getElementById('pw-reqs');
  var errEl   = document.getElementById('pw-error');
  var okEl    = document.getElementById('pw-success');
  if (!btn) return;

  var pills = {
    length:  document.getElementById('pr-length'),
    lower:   document.getElementById('pr-lower'),
    upper:   document.getElementById('pr-upper'),
    digit:   document.getElementById('pr-digit'),
    special: document.getElementById('pr-special'),
  };

  function setPill(el, met) {
    el.style.color        = met ? '#4ade80' : '';
    el.style.borderColor  = met ? 'rgba(74,222,128,0.22)' : '';
  }

  function checkReqs(pw) {
    var met = {
      length:  pw.length >= 12,
      lower:   (pw.match(/[a-z]/g) || []).length >= 3,
      upper:   (pw.match(/[A-Z]/g) || []).length >= 3,
      digit:   (pw.match(/[0-9]/g) || []).length >= 3,
      special: (pw.match(/[^a-zA-Z0-9]/g) || []).length >= 3,
    };
    reqsEl.style.display = pw.length === 0 ? 'none' : 'flex';
    Object.keys(met).forEach(function (k) { setPill(pills[k], met[k]); });
    return met.length && met.lower && met.upper && met.digit && met.special;
  }

  input.addEventListener('input', function () { checkReqs(this.value); });

  btn.addEventListener('click', function () {
    var pw = input.value;
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');
    if (!checkReqs(pw)) {
      errEl.textContent = 'Password does not meet the requirements.';
      errEl.classList.remove('hidden');
      return;
    }
    btn.disabled = true;
    fetch('/admin/users/<%= user._id %>/password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pw }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.ok) {
        okEl.textContent = 'Password updated successfully.';
        okEl.classList.remove('hidden');
        input.value = '';
        reqsEl.style.display = 'none';
        Object.keys(pills).forEach(function (k) { setPill(pills[k], false); });
      } else {
        errEl.textContent = data.error || 'Something went wrong.';
        errEl.classList.remove('hidden');
      }
    })
    .catch(function () {
      errEl.textContent = 'Request failed.';
      errEl.classList.remove('hidden');
    })
    .finally(function () { btn.disabled = false; });
  });
}());
</script>
<% } %>

</body>
</html>
