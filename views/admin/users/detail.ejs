<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-50" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'users' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Header -->
    <div class="bg-white border-b border-zinc-200 px-8 py-5 flex items-center gap-4 shrink-0">
      <a href="/admin/users" class="flex items-center gap-1.5 text-sm text-zinc-400 hover:text-zinc-700 transition-colors no-underline">
        <iconify-icon icon="lucide:chevron-left" width="14" style="display:block"></iconify-icon>
        Users
      </a>
      <span class="text-zinc-300">·</span>
      <h1 class="text-xl font-bold text-zinc-900 m-0"><%= user.username?.value ? '@' + user.username.value : user.email?.value %></h1>
    </div>

    <!-- Content -->
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-3xl flex flex-col gap-6">

        <!-- Profile card -->
        <div class="bg-white rounded-md border border-zinc-200 overflow-hidden">

          <!-- Banner -->
          <div class="h-24 bg-zinc-100 relative">
            <% if (user.banner?.value) { %>
            <img src="<%= user.banner.value %>" alt="" class="w-full h-full object-cover">
            <% } %>
          </div>

          <!-- Avatar + name -->
          <div class="px-6 pb-6">
            <div class="-mt-8 mb-4">
              <% if (user.avatar?.value) { %>
              <img src="<%= user.avatar.value %>" alt="" class="w-16 h-16 rounded-md object-cover border-2 border-white bg-zinc-100">
              <% } else { %>
              <div class="w-16 h-16 rounded-md bg-zinc-200 border-2 border-white flex items-center justify-center">
                <iconify-icon icon="lucide:user" width="22" style="color:#a1a1aa;display:block"></iconify-icon>
              </div>
              <% } %>
            </div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-bold text-zinc-900 text-lg m-0"><%= user.displayName?.value || user.username?.value || '—' %></p>
                <% if (user.username?.value) { %><p class="text-zinc-400 text-sm mt-0.5 mb-0">@<%= user.username.value %></p><% } %>
                <% if (user.bio?.value) { %><p class="text-zinc-600 text-sm mt-2 mb-0"><%= user.bio.value %></p><% } %>
              </div>
              <div class="flex flex-col items-end gap-1.5 shrink-0">
                <% if (user.accountStatus === 'active') { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-green-100 text-green-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-zinc-100 text-zinc-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>Onboarding
                </span>
                <% } %>
                <% if (user.idVerified) { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-600">
                  <iconify-icon icon="lucide:shield-check" width="11" style="display:block"></iconify-icon>ID Verified
                </span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Detail rows -->
        <div class="bg-white rounded-md border border-zinc-200 overflow-hidden">
          <div class="px-5 py-3 border-b border-zinc-100">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Account details</p>
          </div>

          <% const row = (label, value) => `<div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50 last:border-0"><span class="text-sm text-zinc-400">${label}</span><span class="text-sm text-zinc-800 font-medium">${value || '—'}</span></div>` %>

          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">User ID</span>
            <span class="text-xs font-mono text-zinc-600 bg-zinc-50 px-2 py-1 rounded"><%= user._id %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">Email</span>
            <span class="text-sm text-zinc-800 font-medium"><%= user.email?.value %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">Role</span>
            <% if (user.role === 'admin') { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-violet-100 text-violet-700">Admin</span>
            <% } else { %>
            <span class="text-sm text-zinc-500">User</span>
            <% } %>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">Onboarding status</span>
            <span class="text-xs font-mono text-zinc-800 font-medium"><%= user.onboardingStatus || '—' %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">ID verification</span>
            <span class="text-xs font-mono text-zinc-600"><%= user.idVerificationStatus || 'none' %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">Email confirmed</span>
            <span class="text-sm text-zinc-800"><%= user.email?.confirmed ? 'Yes' : 'No' %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between border-b border-zinc-50">
            <span class="text-sm text-zinc-400">Joined</span>
            <span class="text-sm text-zinc-800"><%= user.createdAt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
          </div>
          <div class="px-5 py-3.5 flex items-center justify-between">
            <span class="text-sm text-zinc-400">Last updated</span>
            <span class="text-sm text-zinc-800"><%= user.updatedAt.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
          </div>
        </div>

        <!-- ID Verification docs (if submitted) -->
        <% if (user.idSelfieUrl || user.idDocUrl) { %>
        <div class="bg-white rounded-md border border-zinc-200 overflow-hidden">
          <div class="px-5 py-3 border-b border-zinc-100">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">ID Verification documents</p>
          </div>
          <div class="p-5 grid grid-cols-2 gap-4">
            <% if (user.idSelfieUrl) { %>
            <div>
              <p class="text-xs font-semibold text-zinc-400 mb-2 m-0">Selfie with code</p>
              <img src="<%= user.idSelfieUrl %>" alt="Selfie" class="w-full rounded-md object-cover border border-zinc-200">
            </div>
            <% } %>
            <% if (user.idDocUrl) { %>
            <div>
              <p class="text-xs font-semibold text-zinc-400 mb-2 m-0">Government ID</p>
              <img src="<%= user.idDocUrl %>" alt="Government ID" class="w-full rounded-md object-cover border border-zinc-200">
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

      </div>
    </main>
  </div>

</body>
</html>
