<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="min-h-screen bg-gray-50 flex flex-col">
  <%- include('../../partials/adminNav') %>

  <main class="max-w-5xl mx-auto w-full px-6 py-10">

    <div class="mb-8">
      <h1 class="text-2xl font-bold">Users</h1>
      <p class="text-sm text-gray-400 mt-1"><%= users.length %> total</p>
    </div>

    <div class="bg-white border border-gray-200 rounded-md overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-100">
          <tr class="text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
            <th class="px-5 py-3">User</th>
            <th class="px-5 py-3">Email</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Role</th>
            <th class="px-5 py-3">Joined</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% users.forEach(function(user) { %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-5 py-3.5">
              <div class="flex items-center gap-2.5">
                <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" alt="" class="w-7 h-7 rounded-md object-cover bg-gray-100 shrink-0">
                <% } else { %>
                <div class="w-7 h-7 rounded-md bg-gray-100 shrink-0 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-300"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <% } %>
                <span class="font-medium text-gray-800"><%= user.username ? '@' + user.username : '—' %></span>
              </div>
            </td>
            <td class="px-5 py-3.5 text-gray-500"><%= user.email %></td>
            <td class="px-5 py-3.5">
              <% if (user.accountStatus === 'active') { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Active</span>
              <% } else { %>
                <% if (user.onboardingStatus === 'pending_approval') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Pending review</span>
                <% } else if (user.onboardingStatus === 'rejected') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-600">Rejected</span>
                <% } else { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Onboarding</span>
                <% } %>
              <% } %>
            </td>
            <td class="px-5 py-3.5">
              <% if (user.role === 'admin') { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">Admin</span>
              <% } else { %>
              <span class="text-gray-400 text-xs">User</span>
              <% } %>
            </td>
            <td class="px-5 py-3.5 text-gray-400 text-xs"><%= user.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
            <td class="px-5 py-3.5 text-right">
              <a href="/admin/users/<%= user._id %>" class="text-sm text-blue-500 hover:text-blue-700 font-medium">View</a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </main>
</body>
</html>
