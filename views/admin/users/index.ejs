<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'users' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Content -->
    <main class="flex-1 overflow-y-auto p-8">

      <% if (!users.length) { %>
      <div class="bg-zinc-900 border border-white/8 rounded-md p-16 text-center">
        <iconify-icon icon="boxicons:group" width="28" style="color:#3f3f46;display:block;margin:0 auto 12px"></iconify-icon>
        <p class="font-semibold text-zinc-500 m-0">No users yet</p>
      </div>
      <% } else { %>

      <div class="bg-zinc-900 border border-white/8 rounded-md overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/8 text-left">
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">User</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Email</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Status</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">ID Verified</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Joined</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% users.forEach(function(user) { %>
            <tr class="hover:bg-white/5 transition-colors">

              <td class="px-5 py-3.5">
                <div class="flex items-center gap-2.5">
                  <% if (user.avatar?.value) { %>
                  <img src="<%= user.avatar.value %>" alt="" class="w-7 h-7 rounded-md object-cover bg-zinc-800 shrink-0">
                  <% } else { %>
                  <div class="w-7 h-7 rounded-md bg-zinc-800 shrink-0 flex items-center justify-center">
                    <iconify-icon icon="boxicons:user" width="12" style="color:#52525b;display:block"></iconify-icon>
                  </div>
                  <% } %>
                  <span class="font-semibold text-white"><%= user.username?.value ? '@' + user.username.value : '—' %></span>
                </div>
              </td>

              <td class="px-5 py-3.5 text-zinc-400"><%= user.email?.value %></td>

              <td class="px-5 py-3.5">
                <% if (user.accountStatus === 'active') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-500/15 text-green-400 border border-green-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active
                </span>
                <% } else if (user.accountStatus === 'invited') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-400 border border-amber-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Invited
                </span>
                <% } else if (user.accountStatus === 'banned') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500/15 text-red-400 border border-red-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Banned
                </span>
                <% } %>
              </td>

              <td class="px-5 py-3.5">
                <% if (user.idVerified) { %>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-400">
                  <iconify-icon icon="boxicons:shield-check" width="13" style="display:block"></iconify-icon>Verified
                </span>
                <% } else { %>
                <span class="text-xs text-zinc-600">—</span>
                <% } %>
              </td>

              <td class="px-5 py-3.5 text-zinc-400 text-sm whitespace-nowrap">
                <%= user.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </td>

              <td class="px-5 py-3.5 text-right">
                <a href="/admin/users/<%= user._id %>" class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-400 hover:text-white transition-colors no-underline">
                  View
                  <iconify-icon icon="boxicons:chevron-right" width="12" style="display:block"></iconify-icon>
                </a>
              </td>

            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% } %>
    </main>
  </div>

</body>
</html>
