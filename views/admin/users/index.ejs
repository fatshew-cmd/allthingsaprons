<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="min-h-screen bg-gray-50">
  <%- include('../../partials/adminNav') %>

  <main class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-2xl font-bold mb-6">Users</h1>

    <div class="bg-white rounded-md shadow overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-100 text-left text-xs uppercase text-gray-500">
          <tr>
            <th class="px-6 py-3">Email</th>
            <th class="px-6 py-3">Admin</th>
            <th class="px-6 py-3">Created</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% users.forEach(user => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4"><%= user.email %></td>
              <td class="px-6 py-4"><%= user.isAdmin ? 'Yes' : 'No' %></td>
              <td class="px-6 py-4"><%= user.createdAt.toLocaleDateString() %></td>
              <td class="px-6 py-4 text-right">
                <a href="/admin/users/<%= user._id %>" class="text-blue-600 hover:underline">View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
