<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-50" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'users' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Header -->
    <div class="bg-white border-b border-zinc-200 px-8 py-5 flex items-center justify-between shrink-0">
      <div>
        <h1 class="text-xl font-bold text-zinc-900 m-0">User Management</h1>
        <p class="text-sm text-zinc-400 mt-0.5 mb-0"><%= users.length %> registered user<%= users.length !== 1 ? 's' : '' %></p>
      </div>
    </div>

    <!-- Content -->
    <main class="flex-1 overflow-y-auto p-8">

      <% if (!users.length) { %>
      <div class="bg-white border border-zinc-200 rounded-md p-16 text-center">
        <iconify-icon icon="lucide:users" width="28" style="color:#d4d4d8;display:block;margin:0 auto 12px"></iconify-icon>
        <p class="font-semibold text-zinc-500 m-0">No users yet</p>
      </div>
      <% } else { %>

      <div class="bg-white border border-zinc-200 rounded-md overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-100 text-left">
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">User</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Email</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Status</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">ID Verified</th>
              <th class="px-5 py-3 text-xs font-bold text-zinc-400 uppercase tracking-wider">Joined</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-50">
            <% users.forEach(function(user) { %>
            <tr class="hover:bg-zinc-50 transition-colors">

              <td class="px-5 py-3.5">
                <div class="flex items-center gap-2.5">
                  <% if (user.avatar?.value) { %>
                  <img src="<%= user.avatar.value %>" alt="" class="w-7 h-7 rounded-md object-cover bg-zinc-100 shrink-0">
                  <% } else { %>
                  <div class="w-7 h-7 rounded-md bg-zinc-100 shrink-0 flex items-center justify-center">
                    <iconify-icon icon="lucide:user" width="12" style="color:#d4d4d8;display:block"></iconify-icon>
                  </div>
                  <% } %>
                  <span class="font-semibold text-zinc-800"><%= user.username?.value ? '@' + user.username.value : '—' %></span>
                </div>
              </td>

              <td class="px-5 py-3.5 text-zinc-500"><%= user.email?.value %></td>

              <td class="px-5 py-3.5">
                <% if (user.accountStatus === 'active') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active
                </span>
                <% } else if (user.onboardingStatus === 'pending_approval') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pending review
                </span>
                <% } else if (user.onboardingStatus === 'rejected') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Rejected
                </span>
                <% } else if (user.onboardingStatus === 'pending_id_verification') { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-violet-100 text-violet-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>ID check
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>Onboarding
                </span>
                <% } %>
              </td>

              <td class="px-5 py-3.5">
                <% if (user.idVerified) { %>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-600">
                  <iconify-icon icon="lucide:shield-check" width="13" style="display:block"></iconify-icon>Verified
                </span>
                <% } else { %>
                <span class="text-xs text-zinc-400">—</span>
                <% } %>
              </td>

              <td class="px-5 py-3.5 text-zinc-400 text-xs whitespace-nowrap">
                <%= user.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </td>

              <td class="px-5 py-3.5 text-right">
                <a href="/admin/users/<%= user._id %>" class="inline-flex items-center gap-1 text-xs font-semibold text-zinc-500 hover:text-zinc-900 transition-colors no-underline">
                  View
                  <iconify-icon icon="lucide:chevron-right" width="12" style="display:block"></iconify-icon>
                </a>
              </td>

            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% } %>
    </main>
  </div>

</body>
</html>
