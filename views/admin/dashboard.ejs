<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="min-h-screen bg-gray-50 flex flex-col">
  <%- include('../partials/adminNav') %>

  <main class="max-w-5xl mx-auto w-full px-6 py-10">

    <div class="mb-8">
      <h1 class="text-2xl font-bold">Dashboard</h1>
      <p class="text-sm text-gray-400 mt-1">All Things Aprons administration</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">

      <a href="/admin/entries" class="bg-white border border-gray-200 rounded-md p-5 flex items-center gap-4 hover:border-amber-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 rounded-md bg-amber-50 flex items-center justify-center shrink-0 group-hover:bg-amber-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-amber-600"><%= pendingCount %></p>
          <p class="text-xs text-gray-400 mt-0.5">Pending reviews</p>
        </div>
      </a>

      <a href="/admin/users" class="bg-white border border-gray-200 rounded-md p-5 flex items-center gap-4 hover:border-blue-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 rounded-md bg-blue-50 flex items-center justify-center shrink-0 group-hover:bg-blue-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-blue-600"><%= totalUsers %></p>
          <p class="text-xs text-gray-400 mt-0.5">Total users</p>
        </div>
      </a>

      <div class="bg-white border border-gray-200 rounded-md p-5 flex items-center gap-4">
        <div class="w-10 h-10 rounded-md bg-green-50 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-green-600"><%= activeUsers %></p>
          <p class="text-xs text-gray-400 mt-0.5">Active users</p>
        </div>
      </div>

    </div>

    <!-- Quick links -->
    <div>
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Quick access</h2>
      <div class="flex flex-col gap-2">
        <a href="/admin/entries" class="flex items-center justify-between bg-white border border-gray-200 rounded-md px-4 py-3 hover:border-gray-300 hover:shadow-sm transition text-sm">
          <span class="font-medium">Entry Review</span>
          <span class="text-gray-400">→</span>
        </a>
        <a href="/admin/users" class="flex items-center justify-between bg-white border border-gray-200 rounded-md px-4 py-3 hover:border-gray-300 hover:shadow-sm transition text-sm">
          <span class="font-medium">User Management</span>
          <span class="text-gray-400">→</span>
        </a>
      </div>
    </div>

  </main>
</body>
</html>
