<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../partials/adminSidebar', { currentPage: 'audit-log' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-6xl mx-auto flex flex-col gap-6">

        <!-- Header -->
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-white m-0">Audit Log</h1>
            <p class="text-sm text-zinc-400 m-0 mt-1">Every admin action and user-submitted event, in order. <%= total.toLocaleString() %> total records.</p>
          </div>
        </div>

        <!-- Filters -->
        <form method="GET" action="/admin/audit-log" class="bg-zinc-900 rounded-md border border-white/8 px-5 py-4">
          <div class="grid grid-cols-3 gap-3">

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-semibold text-zinc-400 uppercase tracking-wide">Action</label>
              <select name="action"
                class="px-3 py-2 text-sm rounded-md border border-white/10 bg-zinc-800 text-white focus:outline-none focus:ring-2 focus:ring-violet-500">
                <option value="">All actions</option>
                <% actionKeys.forEach(function(key) { %>
                <option value="<%= key %>" <%= filters.action === key ? 'selected' : '' %>><%= actionLabels[key] %></option>
                <% }) %>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-semibold text-zinc-400 uppercase tracking-wide">Target user</label>
              <input type="text" name="targetUser" value="<%= filters.targetUser %>" placeholder="@username"
                class="px-3 py-2 text-sm rounded-md border border-white/10 bg-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-semibold text-zinc-400 uppercase tracking-wide">Ticket ref</label>
              <input type="text" name="ticketRef" value="<%= filters.ticketRef %>" placeholder="ATA-…"
                class="px-3 py-2 text-sm rounded-md border border-white/10 bg-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>

          </div>
          <div class="flex items-center gap-2 mt-3">
            <button type="submit"
              class="px-4 py-2 rounded-md text-sm font-semibold bg-violet-600 text-white hover:bg-violet-500 transition-colors cursor-pointer" style="border:none">
              Apply filters
            </button>
            <% if (filters.action || filters.targetUser || filters.ticketRef) { %>
            <a href="/admin/audit-log" class="px-4 py-2 rounded-md text-sm text-zinc-400 hover:text-white hover:bg-white/8 transition-colors no-underline">
              Clear
            </a>
            <% } %>
          </div>
        </form>

        <!-- Table -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">

          <% if (logs.length === 0) { %>
          <div class="px-6 py-16 flex flex-col items-center gap-3">
            <iconify-icon icon="lucide:scroll-text" width="28" style="color:#52525b;display:block"></iconify-icon>
            <p class="text-sm text-zinc-500 m-0">No events match the current filters.</p>
          </div>
          <% } else { %>

          <div class="overflow-x-auto">
            <table class="w-full text-sm" style="border-collapse:collapse">
              <thead>
                <tr class="border-b border-white/8">
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">Ticket</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">Action</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">Actor</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">Target</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">Remarks</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider whitespace-nowrap">When</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <% logs.forEach(function(log) { %>
                <%
                  var actionLabel = actionLabels[log.action] || log.action;
                  var actionColor = 'text-zinc-400 bg-zinc-800/60 border-zinc-700/50';
                  if (log.action.endsWith('_approved')) actionColor = 'text-green-400 bg-green-500/10 border-green-500/20';
                  if (log.action.endsWith('_rejected')) actionColor = 'text-red-400 bg-red-500/10 border-red-500/20';
                  if (log.action.endsWith('_submitted')) actionColor = 'text-zinc-300 bg-zinc-800/60 border-zinc-700/50';
                  if (log.action === 'user_role_changed') actionColor = 'text-amber-400 bg-amber-500/10 border-amber-500/20';

                  var roleLabel = { user: 'User', moderator: 'Moderator', supervisor: 'Supervisor', superadmin: 'Super Admin', founder: 'Founder' }[log.actorRole] || log.actorRole;

                  var actorName = log.actorId ? (log.actorId.displayName?.value || log.actorId.username?.value || log.actorId.email?.value || '—') : '—';
                  var targetName = log.targetUserId ? (log.targetUserId.username?.value ? '@' + log.targetUserId.username.value : log.targetUserId.email?.value || '—') : '—';

                  var ts = new Date(log.createdAt);
                  var timeStr = ts.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                    + ' ' + ts.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                %>
                <tr class="hover:bg-white/3 transition-colors group">

                  <!-- Ticket ref -->
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="text-xs font-mono font-bold text-zinc-400"><%= log.ticketRef %></span>
                  </td>

                  <!-- Action badge -->
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold border <%= actionColor %>">
                      <%= actionLabel %>
                    </span>
                  </td>

                  <!-- Actor -->
                  <td class="px-4 py-3 whitespace-nowrap">
                    <p class="text-sm text-white font-medium m-0 leading-tight"><%= actorName %></p>
                    <p class="text-xs text-zinc-500 m-0 mt-0.5"><%= roleLabel %></p>
                  </td>

                  <!-- Target -->
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="text-sm text-zinc-300"><%= targetName %></span>
                  </td>

                  <!-- Remarks -->
                  <td class="px-4 py-3 max-w-xs">
                    <% if (log.remarks) { %>
                    <p class="text-xs text-zinc-400 m-0 truncate" title="<%= log.remarks %>"><%= log.remarks %></p>
                    <% } else { %>
                    <span class="text-xs text-zinc-700">—</span>
                    <% } %>
                  </td>

                  <!-- Timestamp -->
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="text-xs text-zinc-500"><%= timeStr %></span>
                  </td>

                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% } %>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
          <div class="px-5 py-3 border-t border-white/8 flex items-center justify-between">
            <span class="text-xs text-zinc-500">
              Page <%= page %> of <%= totalPages %> &mdash; <%= total.toLocaleString() %> events
            </span>
            <div class="flex items-center gap-1.5">
              <% if (page > 1) { %>
              <a href="?action=<%= filters.action %>&targetUser=<%= filters.targetUser %>&ticketRef=<%= filters.ticketRef %>&page=<%= page - 1 %>"
                class="px-3 py-1.5 rounded-md text-xs font-medium text-zinc-400 hover:text-white hover:bg-white/8 transition-colors no-underline">
                Previous
              </a>
              <% } %>
              <% if (page < totalPages) { %>
              <a href="?action=<%= filters.action %>&targetUser=<%= filters.targetUser %>&ticketRef=<%= filters.ticketRef %>&page=<%= page + 1 %>"
                class="px-3 py-1.5 rounded-md text-xs font-medium text-zinc-400 hover:text-white hover:bg-white/8 transition-colors no-underline">
                Next
              </a>
              <% } %>
            </div>
          </div>
          <% } %>

        </div>

      </div>
    </main>
  </div>

</body>
</html>
