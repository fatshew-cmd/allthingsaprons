<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-50" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../partials/adminSidebar', { currentPage: 'verification' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <div class="bg-white border-b border-zinc-200 px-8 py-5 flex items-center justify-between shrink-0">
      <div>
        <h1 class="text-xl font-bold text-zinc-900 m-0">ID Verification</h1>
        <p class="text-sm text-zinc-400 mt-0.5 mb-0">Review selfie and government ID submissions before granting platform access</p>
      </div>
      <% if (pending.length > 0) { %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-bold bg-amber-500 text-stone-900">
        <iconify-icon icon="lucide:clock" width="12" style="display:block"></iconify-icon>
        <%= pending.length %> pending
      </span>
      <% } %>
    </div>

    <main class="flex-1 overflow-y-auto p-8">

      <% if (pending.length === 0) { %>
      <div class="bg-white border border-zinc-200 rounded-md p-16 text-center">
        <div class="w-12 h-12 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
          <iconify-icon icon="lucide:check-circle-2" width="22" style="color:#16a34a;display:block"></iconify-icon>
        </div>
        <p class="font-semibold text-zinc-700 m-0">All caught up</p>
        <p class="text-sm text-zinc-400 mt-1 mb-0">No ID verification submissions pending review.</p>
      </div>

      <% } else { %>

      <div class="bg-white rounded-md border border-zinc-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-100 bg-zinc-50/60">
              <th class="text-left px-5 py-3 font-semibold text-zinc-500 text-xs uppercase tracking-wide">User</th>
              <th class="text-left px-5 py-3 font-semibold text-zinc-500 text-xs uppercase tracking-wide hidden sm:table-cell">Submitted</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            <% pending.forEach(function(u) { %>
            <tr class="hover:bg-zinc-50/80 transition-colors">
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <% if (u.avatar?.value) { %>
                  <img src="<%= u.avatar.value %>" class="w-9 h-9 rounded-md object-cover shrink-0">
                  <% } else { %>
                  <div class="w-9 h-9 rounded-md bg-zinc-200 flex items-center justify-center shrink-0">
                    <iconify-icon icon="lucide:user" width="15" style="color:#a1a1aa;display:block"></iconify-icon>
                  </div>
                  <% } %>
                  <div>
                    <p class="font-semibold text-zinc-900 m-0">@<%= u.username?.value %></p>
                    <p class="text-zinc-400 text-xs m-0"><%= u.email?.value %></p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4 text-zinc-500 text-sm hidden sm:table-cell">
                <%= new Date(u.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                <span class="text-zinc-400 text-xs ml-1">
                  <%= new Date(u.createdAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) %>
                </span>
              </td>
              <td class="px-5 py-4 text-right">
                <a href="/admin/verification/<%= u._id %>"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-violet-50 text-violet-700 hover:bg-violet-100 rounded-md transition-colors no-underline">
                  <iconify-icon icon="lucide:shield-check" width="12" style="display:block"></iconify-icon>
                  Review
                </a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% } %>
    </main>

  </div>
</body>
</html>
