<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../partials/adminSidebar', { currentPage: 'settings' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <main class="flex-1 overflow-y-auto p-4">

      <div class="max-w-xl flex flex-col gap-5">

        <!-- Entry Report Thresholds (supervisor+) -->
        <%
          var _thresholds = settings?.entryReportThresholds?.length
            ? settings.entryReportThresholds
            : [{ count: 3, windowMinutes: 60 }, { count: 5, windowMinutes: 360 }, { count: 10, windowMinutes: 1440 }];
          function _fmtWindow(m) {
            if (m < 60)   return m + ' min';
            if (m < 1440) return (m / 60) + 'h';
            return (m / 1440) + 'd';
          }
        %>
        <div class="bg-zinc-900 border border-white/8 rounded-md p-5">
          <p class="text-xs font-bold text-zinc-500 uppercase tracking-widest mb-1">Entry Report Thresholds</p>
          <p class="text-xs text-zinc-600 mb-4">If this many pending reports land within the time window, the entry is automatically hidden pending admin review.</p>

          <form action="/admin/settings/entry-report-thresholds" method="POST" class="flex flex-col gap-3">
            <div class="grid grid-cols-3 gap-2 mb-1">
              <span class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">Report count</span>
              <span class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">Window (minutes)</span>
              <span class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wide text-right">Equals</span>
            </div>
            <% _thresholds.forEach(function(t) { %>
            <div class="grid grid-cols-3 gap-2 items-center">
              <input type="number" name="count" min="1" max="999" value="<%= t.count %>"
                class="bg-zinc-800 border border-white/8 rounded-md px-3 py-1.5 h-9 text-sm text-white focus:outline-none focus:border-white/20">
              <input type="number" name="windowMinutes" min="1" max="10080" value="<%= t.windowMinutes %>"
                class="bg-zinc-800 border border-white/8 rounded-md px-3 py-1.5 h-9 text-sm text-white focus:outline-none focus:border-white/20">
              <span class="text-xs text-zinc-500 text-right"><%= t.count %> in <%= _fmtWindow(t.windowMinutes) %></span>
            </div>
            <% }); %>
            <div class="pt-1">
              <button type="submit"
                class="px-5 h-9 rounded-md text-xs font-semibold bg-charm-500 hover:bg-charm-400 text-white transition-colors cursor-pointer">
                Save thresholds
              </button>
            </div>
          </form>
        </div>

        <!-- Contest Eligibility (superadmin+) -->
        <% if (['superadmin', 'founder'].includes(locals.adminRole)) { %>
        <div class="bg-zinc-900 border border-white/8 rounded-md p-5">
          <p class="text-xs font-bold text-zinc-500 uppercase tracking-widest mb-4">Contest Eligibility</p>

          <form action="/admin/settings/contest-eligibility" method="POST" class="flex flex-col gap-4">

            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-1">Minimum rated entries</label>
              <input type="number" name="minEntries" min="1" max="100"
                value="<%= settings?.contestEligibility?.minEntries ?? 3 %>"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-1.5 h-10 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
              <p class="text-[11px] text-zinc-600 mt-0.5">Number of entries that must have at least one rating.</p>
            </div>

            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-1">Minimum total ratings</label>
              <input type="number" name="minRatingCount" min="1" max="10000"
                value="<%= settings?.contestEligibility?.minRatingCount ?? 25 %>"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-1.5 h-10 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
              <p class="text-[11px] text-zinc-600 mt-0.5">Sum of all ratings across all entries.</p>
            </div>

            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-1">Minimum weighted average</label>
              <input type="number" name="minWeightedAvg" min="1" max="10" step="0.1"
                value="<%= settings?.contestEligibility?.minWeightedAvg ?? 7.4 %>"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-1.5 h-10 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
              <p class="text-[11px] text-zinc-600 mt-0.5">Weighted average across all rated entries (1–10).</p>
            </div>

            <div class="pt-1">
              <button type="submit"
                class="px-5 h-10 rounded-md text-xs font-semibold bg-charm-500 hover:bg-charm-400 text-white transition-colors cursor-pointer">
                Save changes
              </button>
            </div>

          </form>
        </div>
        <% } %>

      </div>

    </main>
  </div>

<%- include('../partials/toasts') %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var msgs = { saved: ['Settings saved.', 'success'], error: ['Something went wrong.', 'error'] };
  var flash = new URLSearchParams(window.location.search).get('flash');
  if (flash && msgs[flash]) window.showToast(msgs[flash][0], msgs[flash][1]);
  if (flash) history.replaceState(null, '', window.location.pathname);
});
</script>
</body>
</html>
