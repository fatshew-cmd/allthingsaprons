<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'tournaments' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-3xl flex flex-col gap-6">

        <a href="/admin/tournaments" class="inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors no-underline -mb-2">
          <iconify-icon icon="boxicons:chevron-left" width="14" style="display:block"></iconify-icon>
          All tournaments
        </a>

        <%
          var statusCls = {
            open:     'bg-amber-500/15 text-amber-400 border-amber-500/25',
            cooldown: 'bg-blue-500/15 text-blue-400 border-blue-500/25',
            active:   'bg-green-500/15 text-green-400 border-green-500/25',
            closed:   'bg-white/8 text-zinc-400 border-white/10',
            canceled: 'bg-red-500/15 text-red-400 border-red-500/25',
          };
        %>

        <!-- Header card -->
        <div class="bg-zinc-900 rounded-md border border-white/8 p-6">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-12 h-12 rounded-md bg-zinc-800 shrink-0 flex items-center justify-center overflow-hidden">
                <% if (tournament.thumbnailUrl) { %>
                <img src="<%= tournament.thumbnailUrl %>" class="w-full h-full object-cover" alt="">
                <% } else { %>
                <iconify-icon icon="boxicons:trophy" width="20" style="color:#52525b;display:block"></iconify-icon>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-white text-lg m-0 truncate"><%= tournament.name %></p>
                <p class="text-zinc-400 text-sm mt-0.5 mb-0">
                  Organized by <%= tournament.createdBy?.username?.value ? '@' + tournament.createdBy.username.value : '—' %>
                  <% if (tournament.createdBy?.email?.value) { %> · <%= tournament.createdBy.email.value %><% } %>
                </p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold border capitalize shrink-0 <%= statusCls[tournament.status] || 'bg-white/8 text-zinc-400 border-white/10' %>">
              <%= tournament.status %>
            </span>
          </div>
          <% if (tournament.status === 'canceled' && tournament.cancelReason) { %>
          <p class="text-xs text-red-400 mt-3 mb-0">Cancel reason: <%= tournament.cancelReason %></p>
          <% } %>
        </div>

        <!-- Stat tiles -->
        <div class="grid grid-cols-4 gap-3">
          <div class="bg-zinc-900 rounded-md border border-white/8 p-4">
            <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider m-0">Participants</p>
            <p class="text-lg font-bold text-white mt-1 mb-0"><%= approvedCount %>/<%= tournament.size %></p>
          </div>
          <div class="bg-zinc-900 rounded-md border border-white/8 p-4">
            <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider m-0">Prize Pool</p>
            <p class="text-lg font-bold text-white mt-1 mb-0"><%= (tournament.prizes.first + tournament.prizes.second + (tournament.prizes.third || 0)).toLocaleString() %> CHL</p>
          </div>
          <div class="bg-zinc-900 rounded-md border border-white/8 p-4">
            <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider m-0">Jury Size</p>
            <p class="text-lg font-bold text-white mt-1 mb-0"><%= juryCount %></p>
          </div>
          <div class="bg-zinc-900 rounded-md border border-white/8 p-4">
            <p class="text-xs font-bold text-zinc-500 uppercase tracking-wider m-0">Groups</p>
            <p class="text-lg font-bold text-white mt-1 mb-0"><%= tournament.groupCount %> &times; <%= tournament.groupSize %></p>
          </div>
        </div>

        <!-- Prize breakdown -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Prize breakdown</p>
          </div>
          <div class="divide-y divide-white/5">
            <div class="px-5 py-3 flex items-center justify-between text-sm">
              <span class="text-zinc-400">1st place</span>
              <span class="text-white font-semibold"><%= tournament.prizes.first.toLocaleString() %> CHL</span>
            </div>
            <div class="px-5 py-3 flex items-center justify-between text-sm">
              <span class="text-zinc-400">2nd place</span>
              <span class="text-white font-semibold"><%= tournament.prizes.second.toLocaleString() %> CHL</span>
            </div>
            <% if (tournament.prizes.third) { %>
            <div class="px-5 py-3 flex items-center justify-between text-sm">
              <span class="text-zinc-400">3rd place</span>
              <span class="text-white font-semibold"><%= tournament.prizes.third.toLocaleString() %> CHL</span>
            </div>
            <% } %>
            <div class="px-5 py-3 flex items-center justify-between text-sm">
              <span class="text-zinc-400">Winners decided</span>
              <span class="text-white font-semibold"><%= tournament.prizes.winnersSet ? 'Yes' : 'Not yet' %></span>
            </div>
          </div>
        </div>

        <!-- Groups / standings -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Groups &amp; standings</p>
          </div>
          <% if (!groups.length) { %>
          <p class="text-sm text-zinc-500 px-5 py-6 m-0 text-center">Groups haven't been formed yet.</p>
          <% } else { %>
          <div class="divide-y divide-white/5">
            <% groups.forEach(function (g) { %>
            <div class="px-5 py-4">
              <p class="text-sm font-semibold text-white mb-2"><%= g.label %> <span class="text-zinc-500 font-normal">— <%= g.status %></span></p>
              <table class="w-full text-sm">
                <tbody class="divide-y divide-white/5">
                  <% (g.memberIds || []).forEach(function (m) { %>
                  <tr>
                    <td class="py-1.5 text-zinc-300"><%= m.userId?.username?.value ? '@' + m.userId.username.value : 'Anonymous' %></td>
                    <td class="py-1.5 text-zinc-500 text-right whitespace-nowrap"><%= m.groupWins || 0 %>W-<%= m.groupLosses || 0 %>L &middot; <%= m.groupPoints || 0 %> pts</td>
                    <td class="py-1.5 text-right whitespace-nowrap">
                      <% if (m.groupRank) { %><span class="text-green-400 text-xs font-semibold">Advanced</span>
                      <% } else if (m.eliminated) { %><span class="text-zinc-500 text-xs font-semibold">Eliminated</span>
                      <% } else { %><span class="text-zinc-600 text-xs">—</span><% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- Match history -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
          <div class="px-5 py-3 border-b border-white/8">
            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider m-0">Match history</p>
          </div>
          <% if (!matches.length) { %>
          <p class="text-sm text-zinc-500 px-5 py-6 m-0 text-center">No matches yet.</p>
          <% } else { %>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/8 text-left">
                <th class="px-5 py-2.5 text-xs font-bold text-zinc-500 uppercase tracking-wider">Round</th>
                <th class="px-5 py-2.5 text-xs font-bold text-zinc-500 uppercase tracking-wider">Matchup</th>
                <th class="px-5 py-2.5 text-xs font-bold text-zinc-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% matches.forEach(function (m) { %>
              <%
                var mA = m.tournamentEntryIdA?.userId?.username?.value;
                var mB = m.tournamentEntryIdB?.userId?.username?.value;
                var roundLabel = m.stage === 'knockout' ? m.knockoutRound : 'Group';
                var winnerSide = m.winnerId && m.tournamentEntryIdA?.entryId?.toString() === m.winnerId.toString() ? 'A'
                                : m.winnerId && m.tournamentEntryIdB?.entryId?.toString() === m.winnerId.toString() ? 'B' : null;
              %>
              <tr>
                <td class="px-5 py-2.5 text-zinc-400 whitespace-nowrap"><%= roundLabel %></td>
                <td class="px-5 py-2.5 text-zinc-300">
                  <span class="<%= winnerSide === 'A' ? 'text-white font-semibold' : '' %>">@<%= mA || '—' %></span>
                  <span class="text-zinc-600"> vs </span>
                  <span class="<%= winnerSide === 'B' ? 'text-white font-semibold' : '' %>">@<%= mB || '—' %></span>
                </td>
                <td class="px-5 py-2.5 text-zinc-400 capitalize whitespace-nowrap"><%= m.status %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>

        <!-- Force Cancel — founder only, matches requireDomain(null) on the route itself -->
        <% if (canForceCancel && adminRole === 'founder') { %>
        <div class="bg-zinc-900 rounded-md border border-red-500/20 p-5 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-white m-0">Force Cancel</p>
            <p class="text-xs text-zinc-500 mt-0.5 mb-0">Founder-only. Refunds the prize pool to the organizer and releases jury members. For extreme cases only.</p>
          </div>
          <form method="POST" action="/admin/tournaments/<%= tournament._id %>/cancel" onsubmit="return confirm('Force cancel this tournament? This refunds the organizer and cannot be undone.');">
            <button type="submit" class="px-4 py-2 rounded-md text-sm font-semibold bg-red-500/15 text-red-400 border border-red-500/25 hover:bg-red-500/25 transition-colors cursor-pointer">
              Force Cancel
            </button>
          </form>
        </div>
        <% } %>

      </div>
    </main>
  </div>

</body>
</html>
