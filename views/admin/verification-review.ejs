<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../partials/adminSidebar', { currentPage: 'verification' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Scrollable content -->
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-4xl mx-auto flex flex-col gap-6">

        <!-- Back + user context -->
        <div class="flex items-center gap-3">
          <a href="/admin/verification"
            class="flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors no-underline shrink-0">
            <iconify-icon icon="boxicons:arrow-back" width="14" style="display:block"></iconify-icon>
            Back
          </a>
          <div class="w-px h-4 bg-white/10 shrink-0"></div>
          <% if (user.avatar?.value) { %>
          <img src="<%= user.avatar.value %>" class="w-7 h-7 rounded-md object-cover shrink-0 bg-zinc-800">
          <% } else { %>
          <div class="w-7 h-7 rounded-md bg-zinc-800 flex items-center justify-center shrink-0">
            <iconify-icon icon="boxicons:user" width="13" style="color:#52525b;display:block"></iconify-icon>
          </div>
          <% } %>
          <p class="text-sm font-semibold text-white m-0">@<%= user.username?.value %></p>
          <span class="text-zinc-400 text-sm"><%= user.email?.value %></span>
          <% if (submittedAtFormatted) { %>
          <div class="w-px h-4 bg-white/10 shrink-0"></div>
          <div class="flex items-center gap-1.5 text-xs text-zinc-400">
            <iconify-icon icon="boxicons:time" width="12" style="display:block"></iconify-icon>
            Submitted <span class="text-zinc-300 font-medium ml-1"><%= submittedAtFormatted %></span>
          </div>
          <% } %>
        </div>

        <!-- Escalation alert -->
        <% if (typeof isEscalated !== 'undefined' && isEscalated) { %>
        <div class="flex items-start gap-3 px-4 py-3.5 rounded-md bg-amber-500/10 border border-amber-500/25">
          <iconify-icon icon="boxicons:error" width="15" style="color:#f59e0b;display:block;flex-shrink:0;margin-top:1px"></iconify-icon>
          <div>
            <p class="text-sm font-semibold text-amber-300 m-0">Escalated case</p>
            <p class="text-xs text-amber-400/70 m-0 mt-0.5">This account has reached 4 failed verification attempts and has been escalated for senior review. This is attempt <strong class="text-amber-300"><%= typeof attemptNumber !== 'undefined' ? attemptNumber : '—' %></strong> of 5. A rejection here will permanently ban the account.</p>
          </div>
        </div>
        <% } %>

        <!-- Document hash conflict alert -->
        <% if (typeof docHashConflict !== 'undefined' && docHashConflict) { %>
        <div class="flex items-start gap-3 px-4 py-3.5 rounded-md bg-red-500/10 border border-red-500/25">
          <iconify-icon icon="boxicons:copy" width="15" style="color:#f87171;display:block;flex-shrink:0;margin-top:1px"></iconify-icon>
          <div>
            <p class="text-sm font-semibold text-red-300 m-0">Document already on file for another account</p>
            <p class="text-xs text-red-400/70 m-0 mt-0.5">
              The ID document submitted here matches the document on record for
              <% if (docHashConflict.username?.value) { %>
                <strong class="text-red-300">@<%= docHashConflict.username.value %></strong>
              <% } else { %>
                <strong class="text-red-300"><%= docHashConflict.email?.value || 'another account' %></strong>
              <% } %>
              (<span class="<%= docHashConflict.accountStatus === 'banned' ? 'text-red-400' : 'text-zinc-300' %>"><%= docHashConflict.accountStatus %><% if (docHashConflict.idVerified) { %>, verified<% } %></span>).
              Verify this is not a bypass attempt before approving.
            </p>
          </div>
        </div>
        <% } %>

        <!-- Document images -->
        <div class="grid grid-cols-2 gap-4">

          <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
            <div class="px-4 py-3 border-b border-white/8 flex items-center gap-2">
              <iconify-icon icon="boxicons:camera" width="13" style="color:#a78bfa;display:block"></iconify-icon>
              <p class="text-xs font-semibold text-zinc-400 m-0 uppercase tracking-wide">Verification Selfie</p>
            </div>
            <div class="p-3 bg-zinc-950/40">
              <% if (user.idSelfieUrl) { %>
              <div class="relative cursor-pointer group" id="open-viewer">
                <img src="<%= user.idSelfieUrl %>" alt="Verification selfie"
                  class="w-full rounded-md object-contain max-h-80 bg-zinc-900" style="pointer-events:none">
                <div class="absolute inset-0 rounded-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" style="background:rgba(0,0,0,0.45)">
                  <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold text-white" style="background:rgba(255,255,255,0.15)">
                    <iconify-icon icon="boxicons:expand-alt" width="13" style="display:block"></iconify-icon>
                    Open viewer
                  </div>
                </div>
              </div>
              <% } else { %>
              <div class="h-48 flex items-center justify-center text-zinc-400 text-sm">No image</div>
              <% } %>
            </div>
          </div>

          <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">
            <div class="px-4 py-3 border-b border-white/8 flex items-center gap-2">
              <iconify-icon icon="boxicons:id-card" width="13" style="color:#a78bfa;display:block"></iconify-icon>
              <p class="text-xs font-semibold text-zinc-400 m-0 uppercase tracking-wide">Government-Issued ID</p>
            </div>
            <div class="p-3 bg-zinc-950/40">
              <% if (user.idDocUrl) { %>
              <div class="relative cursor-pointer group" id="open-viewer-2">
                <img src="<%= user.idDocUrl %>" alt="ID document"
                  class="w-full rounded-md object-contain max-h-80 bg-zinc-900" style="pointer-events:none">
                <div class="absolute inset-0 rounded-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" style="background:rgba(0,0,0,0.45)">
                  <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold text-white" style="background:rgba(255,255,255,0.15)">
                    <iconify-icon icon="boxicons:expand-alt" width="13" style="display:block"></iconify-icon>
                    Open viewer
                  </div>
                </div>
              </div>
              <% } else { %>
              <div class="h-48 flex items-center justify-center text-zinc-400 text-sm">No image</div>
              <% } %>
            </div>
          </div>

        </div>

        <!-- Verification code + profile details -->
        <div class="grid grid-cols-2 gap-4">

          <div class="bg-zinc-900 rounded-md border border-white/8 px-5 py-4">
            <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wide m-0 mb-3">Expected Verification Code</p>
            <p class="text-sm text-zinc-400 m-0 mb-3 leading-relaxed">The user was instructed to write this code on paper and hold it visibly in their selfie.</p>
            <% if (user.idVerificationCode) { %>
            <p class="text-2xl font-black tracking-[0.2em] text-violet-400 m-0"><%= user.idVerificationCode %></p>
            <% } else { %>
            <p class="text-sm text-zinc-400 italic m-0">No code on record</p>
            <% } %>
          </div>

          <div class="bg-zinc-900 rounded-md border border-white/8 px-5 py-4">
            <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wide m-0 mb-3">Profile Declaration</p>
            <dl class="flex flex-col gap-2">
              <div class="flex items-center justify-between text-sm">
                <dt class="text-zinc-400">Date of birth</dt>
                <dd class="font-semibold text-white m-0"><%= birthdateFormatted %></dd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <dt class="text-zinc-400">Age</dt>
                <dd class="m-0">
                  <% if (age !== null) { %>
                  <span class="font-semibold <%= age >= 19 ? 'text-white' : 'text-red-400' %>"><%= age %> years old</span>
                  <% if (age < 19) { %><span class="text-xs text-red-500 ml-1">(below minimum)</span><% } %>
                  <% } else { %>
                  <span class="text-zinc-600">—</span>
                  <% } %>
                </dd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <dt class="text-zinc-400">Sex (declared)</dt>
                <dd class="font-semibold text-white m-0"><%= sexLabel %></dd>
              </div>
            </dl>
          </div>

        </div>

        <!-- Checklist -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden">

          <div class="px-6 py-4 border-b border-white/8 flex items-center gap-2.5">
            <iconify-icon icon="boxicons:clipboard" width="15" style="color:#a78bfa;display:block"></iconify-icon>
            <div>
              <p class="text-sm font-bold text-white m-0">Review Checklist</p>
              <p class="text-sm text-zinc-400 m-0">All items must be confirmed before you can approve this submission.</p>
            </div>
          </div>

          <div class="divide-y divide-white/5">

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">Selfie contains a handwritten note</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">The user is physically holding a piece of paper with a handwritten verification code — not typed or digitally overlaid.</p>
              </div>
            </label>

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">Written code matches the expected code</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">
                  The code visible in the selfie exactly matches <span class="font-bold text-violet-400 tracking-widest"><%= user.idVerificationCode || '—' %></span> — character for character, no ambiguous letters.
                </p>
              </div>
            </label>

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">Face is fully visible and clearly recognizable</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">The user's face is unobscured, well-lit, and identifiable — no sunglasses, masks, heavy filters, or cropping of facial features.</p>
              </div>
            </label>

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">ID document is a valid government-issued document</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">The document is a passport, driver's license, or national ID card. It is not expired, and both the name and date of birth are clearly legible.</p>
              </div>
            </label>

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">Selfie and ID document appear to be the same person</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">The facial features in the selfie are consistent with the photo on the ID document — same person, no substitution.</p>
              </div>
            </label>

            <div class="checklist-row flex items-start gap-4 px-6 py-4 hover:bg-white/5 transition-colors">
              <input type="checkbox" id="dob-check" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px" disabled>
              <div class="flex flex-col gap-3 flex-1 min-w-0">
                <div>
                  <p class="text-sm font-medium text-white m-0">Date of birth confirms minimum age requirement</p>
                  <p class="text-sm text-zinc-400 m-0 mt-0.5">Enter both dates to confirm the ID is consistent with the profile declaration and meets the minimum age.</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div class="flex flex-col gap-1.5">
                    <label for="dob-declared" class="text-xs font-semibold text-zinc-400 uppercase tracking-wide">Declared DOB (profile)</label>
                    <input type="date" id="dob-declared" max="<%= ageCutoffISO %>"
                      class="w-full px-3 py-2 text-sm rounded-md border border-white/10 bg-zinc-800 text-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label for="dob-card" class="text-xs font-semibold text-zinc-400 uppercase tracking-wide">DOB on ID card</label>
                    <input type="date" id="dob-card" max="<%= ageCutoffISO %>"
                      class="w-full px-3 py-2 text-sm rounded-md border border-white/10 bg-zinc-800 text-white focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent">
                  </div>
                </div>

                <div id="dob-age-error" class="items-center gap-2 px-3 py-2 rounded-md bg-red-500/10 border border-red-500/25" style="display:none">
                  <iconify-icon icon="boxicons:x-circle" width="13" style="color:#f87171;display:block;flex-shrink:0"></iconify-icon>
                  <p class="text-xs text-red-400 m-0">DOB on ID card does not meet the 19 years + 1 day minimum age requirement.</p>
                </div>

                <div id="dob-mismatch-warning" class="items-center gap-2 px-3 py-2 rounded-md bg-red-500/10 border border-red-500/25" style="display:none">
                  <iconify-icon icon="boxicons:x-circle" width="13" style="color:#f87171;display:block;flex-shrink:0"></iconify-icon>
                  <p class="text-xs text-red-400 m-0">Declared DOB does not match the DOB on the ID card.</p>
                </div>

                <div class="flex items-center gap-2 px-3 py-2 rounded-md bg-white/5 border border-white/10">
                  <iconify-icon icon="boxicons:calendar-check" width="13" style="color:#a78bfa;display:block;flex-shrink:0"></iconify-icon>
                  <p class="text-xs text-zinc-400 m-0">To qualify, the user must have been born <strong class="text-zinc-300">on or before <%= ageCutoffFormatted %></strong>.</p>
                </div>
              </div>
            </div>

            <label class="checklist-row flex items-start gap-4 px-6 py-4 cursor-pointer hover:bg-white/5 transition-colors">
              <input type="checkbox" class="checklist-item mt-0.5 w-4 h-4 rounded accent-violet-500 cursor-pointer shrink-0" style="margin-top:3px">
              <div>
                <p class="text-sm font-medium text-white m-0">Declared sex is consistent with submitted documents</p>
                <p class="text-sm text-zinc-400 m-0 mt-0.5">The user declared <strong class="text-zinc-300"><%= sexLabel %></strong> on their profile. The selfie and ID document are consistent with this declaration.</p>
              </div>
            </label>

          </div>

          <!-- Progress indicator -->
          <div class="px-6 py-3 bg-zinc-950/40 border-t border-white/5 flex items-center gap-2">
            <span id="check-count" class="text-xs font-bold text-zinc-400">0 / 7</span>
            <div class="flex-1 h-1.5 bg-white/8 rounded-full overflow-hidden">
              <div id="check-bar" class="h-full bg-violet-500 rounded-full transition-all duration-200" style="width:0%"></div>
            </div>
            <span id="check-label" class="text-xs text-zinc-400">Complete all items to unlock approval</span>
          </div>

        </div>

        <!-- Action area -->
        <div class="bg-zinc-900 rounded-md border border-white/8 overflow-hidden pb-4">

          <!-- Internal remarks -->
          <div class="px-6 pt-5 pb-4">
            <label for="shared-remarks" class="block text-xs font-semibold text-zinc-400 uppercase tracking-wide mb-1.5">Internal remarks <span class="text-zinc-600 font-normal normal-case">(optional — audit log only, not shown to user)</span></label>
            <textarea id="shared-remarks" rows="2" placeholder="Add any notes for the record…"
              class="w-full px-3 py-2.5 text-sm rounded-md border border-white/10 bg-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent resize-none"></textarea>
          </div>

          <div class="px-6 flex items-center justify-between gap-4">

            <button type="button" id="reject-btn"
              class="flex items-center gap-2 px-5 py-2.5 rounded-md text-sm font-semibold border border-red-500/30 text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer" style="background:transparent">
              <iconify-icon icon="boxicons:x-circle" width="14" style="display:block"></iconify-icon>
              Reject Submission
            </button>

            <form id="approve-form" action="/admin/verification/<%= user._id %>/approve" method="POST">
              <input type="hidden" name="remarks"    id="approve-remarks-input">
              <input type="hidden" name="dobDeclared" id="approve-dob-declared-input">
              <input type="hidden" name="dobOnCard"   id="approve-dob-card-input">
              <button type="submit" id="approve-btn" disabled
                class="flex items-center gap-2 px-6 py-2.5 rounded-md text-sm font-semibold bg-violet-600 text-white hover:bg-violet-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                <iconify-icon icon="boxicons:shield-check" width="14" style="display:block"></iconify-icon>
                Approve &amp; Grant Access
              </button>
            </form>

          </div>
        </div>

      </div>
    </main>
  </div>



<!-- Rejection Reasons Modal -->
<div id="reject-modal" class="fixed inset-0 hidden" style="z-index:60;background:rgba(0,0,0,0.7)">
  <div class="flex items-center justify-center h-full px-4">
  <div id="reject-panel" class="bg-zinc-900 border border-white/10 rounded-md shadow-2xl w-full max-w-lg overflow-hidden">

    <!-- Header -->
    <div class="px-6 py-4 border-b border-white/8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-md bg-red-500/10 border border-red-500/20 flex items-center justify-center shrink-0">
          <iconify-icon icon="boxicons:x-circle" width="17" style="color:#f87171;display:block"></iconify-icon>
        </div>
        <div>
          <p class="text-sm font-bold text-white m-0">Reject Submission</p>
          <p class="text-sm text-zinc-400 m-0">Select all reasons that apply — they will be shown to the user.</p>
        </div>
      </div>
      <button type="button" id="reject-modal-close"
        class="w-7 h-7 flex items-center justify-center rounded-md text-zinc-500 hover:text-white hover:bg-white/8 transition-colors cursor-pointer" style="border:none;background:transparent">
        <iconify-icon icon="boxicons:x" width="15" style="display:block"></iconify-icon>
      </button>
    </div>

    <!-- Reasons form -->
    <form action="/admin/verification/<%= user._id %>/reject" method="POST" id="reject-form">
      <input type="hidden" name="remarks" id="reject-remarks-input">
      <div class="py-2 max-h-80 overflow-y-auto">

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Selfie does not contain a handwritten note" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Selfie does not contain a handwritten note</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Written code does not match the expected code" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Written code does not match the expected code</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Face is not fully visible or not clearly recognizable" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Face is not fully visible or not clearly recognizable</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="ID document is not a valid government-issued document" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">ID document is not a valid government-issued document</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Selfie and ID document do not appear to be the same person" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Selfie and ID document do not appear to be the same person</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Date of birth does not confirm the minimum age requirement" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Date of birth does not confirm the minimum age requirement</span>
        </label>

        <label class="reason-row flex items-center gap-3 px-6 py-2.5 cursor-pointer hover:bg-white/5 transition-colors">
          <input type="checkbox" name="reasons" value="Declared sex is inconsistent with submitted documents" class="reason-check w-4 h-4 rounded accent-red-500 cursor-pointer shrink-0">
          <span class="text-sm text-zinc-300">Declared sex is inconsistent with submitted documents</span>
        </label>

      </div>

      <!-- Footer -->
      <div class="px-6 py-4 border-t border-white/8 flex items-center justify-between">
        <span id="reject-reason-count" class="text-xs text-zinc-400">No reasons selected</span>
        <div class="flex items-center gap-2">
          <button type="button" id="reject-cancel-btn"
            class="px-4 py-2 rounded-md text-sm font-semibold text-zinc-400 hover:text-white hover:bg-white/8 transition-colors cursor-pointer" style="border:none;background:transparent">
            Cancel
          </button>
          <button type="submit" id="reject-confirm-btn" disabled
            class="flex items-center gap-2 px-4 py-2 rounded-md text-sm font-semibold bg-red-600 text-white hover:bg-red-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer" style="border:none">
            <iconify-icon icon="boxicons:x-circle" width="14" style="display:block"></iconify-icon>
            Confirm Rejection
          </button>
        </div>
      </div>
    </form>

  </div>
  </div>
</div>

<!-- Image Viewer Modal -->
<div id="img-modal" class="fixed inset-0 z-50 hidden" style="background:rgba(0,0,0,0.92)">

  <!-- Backdrop (click to close) -->
  <div id="modal-backdrop" class="absolute inset-0"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full p-4 gap-3" style="pointer-events:none">

    <!-- Header bar -->
    <div class="shrink-0 flex items-center justify-between" style="pointer-events:auto">
      <p class="m-0 text-sm font-semibold text-white flex items-center gap-2">
        <iconify-icon icon="boxicons:search-alt" width="15" style="color:#a78bfa;display:block"></iconify-icon>
        Document Viewer
      </p>
      <div class="flex items-center gap-3 text-xs text-zinc-400">
        <span class="hidden sm:flex items-center gap-1.5">
          <iconify-icon icon="boxicons:mouse" width="12" style="display:block"></iconify-icon>
          Scroll to zoom · Drag to pan
        </span>
        <button id="modal-close-btn" class="vbtn flex items-center gap-1.5 px-3 py-1.5 text-white text-xs font-semibold rounded-md" style="background:rgba(255,255,255,0.12);border:none;cursor:pointer">
          <iconify-icon icon="boxicons:x" width="13" style="display:block"></iconify-icon>
          Close
        </button>
      </div>
    </div>

    <!-- Side-by-side panels -->
    <div class="flex-1 flex gap-3 min-h-0" style="pointer-events:auto">

      <!-- Selfie panel -->
      <div class="flex-1 flex flex-col rounded-md overflow-hidden border" style="background:#09090b;border-color:rgba(255,255,255,0.1)">
        <div class="shrink-0 px-4 py-2.5 flex items-center justify-between border-b" style="background:#18181b;border-color:rgba(255,255,255,0.08)">
          <div class="flex items-center gap-2">
            <iconify-icon icon="boxicons:camera" width="13" style="color:#a78bfa;display:block"></iconify-icon>
            <p class="m-0 text-xs font-bold text-zinc-300 uppercase tracking-wide">Verification Selfie</p>
          </div>
          <div class="flex items-center gap-0.5">
            <button class="vbtn viewer-btn zoom-out" data-key="selfie" title="Zoom out"><iconify-icon icon="boxicons:zoom-out" width="13" style="display:block"></iconify-icon></button>
            <span id="selfie-zoom-lbl" class="text-xs text-zinc-400 w-10 text-center tabular-nums">100%</span>
            <button class="vbtn viewer-btn zoom-in"  data-key="selfie" title="Zoom in"><iconify-icon icon="boxicons:zoom-in"  width="13" style="display:block"></iconify-icon></button>
            <button class="vbtn viewer-btn zoom-reset ml-1" data-key="selfie" title="Reset view"><iconify-icon icon="boxicons:expand-alt" width="13" style="display:block"></iconify-icon></button>
          </div>
        </div>
        <div class="flex-1 relative overflow-hidden viewer-vp" id="selfie-vp" style="cursor:grab">
          <div id="selfie-layer" class="absolute inset-0 flex items-center justify-center" style="transform-origin:center center">
            <img id="selfie-img" src="<%= user.idSelfieUrl || '' %>" alt="Verification selfie"
              class="select-none" draggable="false"
              style="max-width:90%;max-height:90%;object-fit:contain;display:block;user-select:none;pointer-events:none">
          </div>
        </div>
      </div>

      <!-- ID document panel -->
      <div class="flex-1 flex flex-col rounded-md overflow-hidden border" style="background:#09090b;border-color:rgba(255,255,255,0.1)">
        <div class="shrink-0 px-4 py-2.5 flex items-center justify-between border-b" style="background:#18181b;border-color:rgba(255,255,255,0.08)">
          <div class="flex items-center gap-2">
            <iconify-icon icon="boxicons:id-card" width="13" style="color:#a78bfa;display:block"></iconify-icon>
            <p class="m-0 text-xs font-bold text-zinc-300 uppercase tracking-wide">Government-Issued ID</p>
          </div>
          <div class="flex items-center gap-0.5">
            <button class="vbtn viewer-btn zoom-out" data-key="iddoc" title="Zoom out"><iconify-icon icon="boxicons:zoom-out" width="13" style="display:block"></iconify-icon></button>
            <span id="iddoc-zoom-lbl" class="text-xs text-zinc-400 w-10 text-center tabular-nums">100%</span>
            <button class="vbtn viewer-btn zoom-in"  data-key="iddoc" title="Zoom in"><iconify-icon icon="boxicons:zoom-in"  width="13" style="display:block"></iconify-icon></button>
            <button class="vbtn viewer-btn zoom-reset ml-1" data-key="iddoc" title="Reset view"><iconify-icon icon="boxicons:expand-alt" width="13" style="display:block"></iconify-icon></button>
          </div>
        </div>
        <div class="flex-1 relative overflow-hidden viewer-vp" id="iddoc-vp" style="cursor:grab">
          <div id="iddoc-layer" class="absolute inset-0 flex items-center justify-center" style="transform-origin:center center">
            <img id="iddoc-img" src="<%= user.idDocUrl || '' %>" alt="ID document"
              class="select-none" draggable="false"
              style="max-width:90%;max-height:90%;object-fit:contain;display:block;user-select:none;pointer-events:none">
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
.vbtn { background: transparent; border: none; cursor: pointer; color: #71717a; border-radius: 6px; padding: 5px; display: flex; align-items: center; justify-content: center; transition: background 0.15s, color 0.15s; }
.vbtn:hover { background: rgba(255,255,255,0.1); color: #fff; }
</style>

<script>
(function () {
  var modal    = document.getElementById('img-modal');
  var backdrop = document.getElementById('modal-backdrop');
  var closeBtn = document.getElementById('modal-close-btn');

  var state = {
    selfie: { scale: 1, tx: 0, ty: 0, dragging: false, sx: 0, sy: 0, stx: 0, sty: 0 },
    iddoc:  { scale: 1, tx: 0, ty: 0, dragging: false, sx: 0, sy: 0, stx: 0, sty: 0 }
  };

  function applyTransform(key) {
    var s = state[key];
    document.getElementById(key + '-layer').style.transform =
      'translate(' + s.tx + 'px,' + s.ty + 'px) scale(' + s.scale + ')';
    document.getElementById(key + '-zoom-lbl').textContent =
      Math.round(s.scale * 100) + '%';
  }

  function resetViewer(key) {
    state[key].scale = 1; state[key].tx = 0; state[key].ty = 0;
    applyTransform(key);
  }

  function openModal() {
    modal.classList.remove('hidden');
    resetViewer('selfie');
    resetViewer('iddoc');
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  ['open-viewer', 'open-viewer-2'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('click', openModal);
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });

  document.querySelectorAll('.viewer-btn').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var key    = btn.dataset.key;
      var s      = state[key];
      var newScale;
      if (btn.classList.contains('zoom-in'))    newScale = Math.min(s.scale * 1.3, 10);
      else if (btn.classList.contains('zoom-out'))  newScale = Math.max(s.scale / 1.3, 0.2);
      else { resetViewer(key); return; }
      s.scale = newScale;
      applyTransform(key);
    });
  });

  ['selfie', 'iddoc'].forEach(function (key) {
    var vp = document.getElementById(key + '-vp');

    vp.addEventListener('wheel', function (e) {
      e.preventDefault();
      var s        = state[key];
      var rect     = vp.getBoundingClientRect();
      var cx       = e.clientX - rect.left  - rect.width  / 2;
      var cy       = e.clientY - rect.top   - rect.height / 2;
      var factor   = e.deltaY < 0 ? 1.12 : 0.89;
      var newScale = Math.min(Math.max(s.scale * factor, 0.2), 10);
      var ratio    = newScale / s.scale;
      s.tx    = cx * (1 - ratio) + s.tx * ratio;
      s.ty    = cy * (1 - ratio) + s.ty * ratio;
      s.scale = newScale;
      applyTransform(key);
    }, { passive: false });

    vp.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return;
      var s = state[key];
      s.dragging = true;
      s.sx = e.clientX; s.sy = e.clientY;
      s.stx = s.tx;     s.sty = s.ty;
      vp.style.cursor = 'grabbing';
      e.preventDefault();
    });
  });

  document.addEventListener('mousemove', function (e) {
    ['selfie', 'iddoc'].forEach(function (key) {
      var s = state[key];
      if (!s.dragging) return;
      s.tx = s.stx + (e.clientX - s.sx);
      s.ty = s.sty + (e.clientY - s.sy);
      applyTransform(key);
    });
  });

  document.addEventListener('mouseup', function () {
    ['selfie', 'iddoc'].forEach(function (key) {
      if (state[key].dragging) {
        state[key].dragging = false;
        document.getElementById(key + '-vp').style.cursor = 'grab';
      }
    });
  });

}());
</script>

<script>
(function () {

  var checklist  = document.querySelectorAll('.checklist-item');
  var approveBtn = document.getElementById('approve-btn');
  var countEl    = document.getElementById('check-count');
  var barEl      = document.getElementById('check-bar');
  var labelEl    = document.getElementById('check-label');
  var total      = checklist.length;

  function updateChecklist() {
    var checked = Array.from(checklist).filter(function (c) { return c.checked; }).length;
    var pct     = Math.round((checked / total) * 100);
    countEl.textContent = checked + ' / ' + total;
    barEl.style.width   = pct + '%';
    if (checked === total) {
      barEl.classList.replace('bg-violet-500', 'bg-green-500');
      labelEl.textContent = 'All items confirmed — approval unlocked';
      labelEl.className   = 'text-xs text-green-400 font-medium';
      approveBtn.disabled = false;
    } else {
      barEl.classList.replace('bg-green-500', 'bg-violet-500');
      labelEl.textContent = 'Complete all items to unlock approval';
      labelEl.className   = 'text-xs text-zinc-400';
      approveBtn.disabled = true;
    }
  }

  checklist.forEach(function (cb) { cb.addEventListener('change', updateChecklist); });

  document.getElementById('reject-btn').addEventListener('click', function () {
    document.getElementById('reject-remarks-input').value = document.getElementById('shared-remarks').value;
    document.getElementById('reject-modal').classList.remove('hidden');
  });

  document.getElementById('approve-form').addEventListener('submit', function () {
    document.getElementById('approve-remarks-input').value     = document.getElementById('shared-remarks').value;
    document.getElementById('approve-dob-declared-input').value = document.getElementById('dob-declared').value;
    document.getElementById('approve-dob-card-input').value     = document.getElementById('dob-card').value;
  });

  var ageCutoff   = '<%= ageCutoffISO %>';
  var dobDeclared = document.getElementById('dob-declared');
  var dobCard     = document.getElementById('dob-card');
  var dobCheck    = document.getElementById('dob-check');
  var dobAgeError = document.getElementById('dob-age-error');
  var dobMismatch = document.getElementById('dob-mismatch-warning');

  function validateDob() {
    var declared = dobDeclared.value;
    var card     = dobCard.value;

    if (!declared || !card) {
      dobCheck.checked  = false;
      dobCheck.disabled = true;
      dobAgeError.style.display = 'none';
      dobMismatch.style.display = 'none';
      updateChecklist();
      return;
    }

    var cardPasses = card <= ageCutoff;

    if (cardPasses) {
      dobAgeError.style.display = 'none';
    } else {
      dobAgeError.style.display = 'flex';
    }

    dobMismatch.style.display = (declared !== card) ? 'flex' : 'none';

    if (cardPasses) {
      dobCheck.disabled = false;
    } else {
      dobCheck.checked  = false;
      dobCheck.disabled = true;
    }
    updateChecklist();
  }

  dobDeclared.addEventListener('change', validateDob);
  dobCard.addEventListener('change', validateDob);

  var rejectModal  = document.getElementById('reject-modal');
  var rejectPanel  = document.getElementById('reject-panel');
  var modalClose   = document.getElementById('reject-modal-close');
  var modalCancel  = document.getElementById('reject-cancel-btn');
  var modalConfirm = document.getElementById('reject-confirm-btn');
  var reasonCount  = document.getElementById('reject-reason-count');
  var reasonChecks = document.querySelectorAll('.reason-check');

  function closeRejectModal() {
    rejectModal.classList.add('hidden');
    reasonChecks.forEach(function (cb) { cb.checked = false; });
    syncReasons();
  }

  function syncReasons() {
    var n = Array.from(reasonChecks).filter(function (c) { return c.checked; }).length;
    modalConfirm.disabled   = n === 0;
    reasonCount.textContent = n === 0 ? 'No reasons selected'
      : n === 1 ? '1 reason selected'
      : n + ' reasons selected';
  }

  modalClose.addEventListener('click', closeRejectModal);
  modalCancel.addEventListener('click', closeRejectModal);
  rejectModal.addEventListener('click', function (e) {
    if (!rejectPanel.contains(e.target)) closeRejectModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !rejectModal.classList.contains('hidden')) closeRejectModal();
  });
  reasonChecks.forEach(function (cb) { cb.addEventListener('change', syncReasons); });

}());
</script>

<script>
(function () {
  document.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  document.addEventListener('dragstart', function (e) {
    if (e.target.tagName === 'IMG') e.preventDefault();
  });
  document.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S' || e.key === 'p' || e.key === 'P')) {
      e.preventDefault();
    }
  });
}());
</script>

</body>
</html>
