<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../partials/adminSidebar', { currentPage: 'profile' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Content -->
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-2xl flex flex-col gap-4">

        <%
        const roleLabels = { moderator: 'Moderator', supervisor: 'Supervisor', superadmin: 'Super Admin', founder: 'Founder' };
        const permLabels = { content: 'Content', chat: 'Chat', comments: 'Comments', financial: 'Financial', support: 'Support' };
        const isFullAccess = user.role === 'superadmin' || user.role === 'founder';
        %>

        <!-- Profile card -->
        <div class="bg-zinc-900 border border-white/8 rounded-md overflow-hidden">
          <div class="px-5 py-3.5 border-b border-white/8">
            <h2 class="text-sm font-bold text-white m-0">Profile</h2>
          </div>

          <div class="px-5 py-5 flex flex-col gap-5">

            <!-- Avatar -->
            <div class="flex items-center gap-4">
              <div class="shrink-0 w-14 h-14 rounded-md bg-zinc-800 border border-white/10 overflow-hidden flex items-center justify-center">
                <% if (user.avatar && user.avatar.value) { %>
                <img src="<%= user.avatar.value %>" alt="" class="w-full h-full object-cover">
                <% } else { %>
                <iconify-icon icon="lucide:user" width="20" style="color:#52525b;display:block"></iconify-icon>
                <% } %>
              </div>
              <div>
                <p class="text-sm font-semibold text-white m-0">Profile photo</p>
                <p class="text-sm text-zinc-400 mt-0.5 mb-2.5">JPG or PNG. Max 2.5 MB.</p>
                <form action="/admin/profile/avatar" method="POST" enctype="multipart/form-data">
                  <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-white/10 bg-white/5 text-xs font-medium text-zinc-300 hover:bg-white/10 hover:border-white/20 transition-colors cursor-pointer">
                    <iconify-icon icon="lucide:upload" width="12" style="display:block"></iconify-icon>
                    Upload photo
                    <input type="file" name="avatar" accept="image/*" class="hidden" onchange="this.form.submit()">
                  </label>
                </form>
              </div>
            </div>

            <!-- Display name -->
            <form action="/admin/profile/display-name" method="POST" class="flex flex-col gap-3">
              <div>
                <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Display name</label>
                <input
                  type="text"
                  name="displayName"
                  value="<%= (user.displayName && user.displayName.value) ? user.displayName.value : '' %>"
                  maxlength="50"
                  placeholder="Your name"
                  class="w-full border border-white/10 bg-zinc-800 rounded-md px-3 py-2 text-sm text-white placeholder:text-zinc-600 focus:outline-none focus:border-charm-500/50 focus:ring-1 focus:ring-charm-500/30 transition-colors"
                >
              </div>
              <div>
                <button type="submit" class="px-4 py-2 rounded-md bg-charm-500 hover:bg-charm-400 text-white text-sm font-semibold transition-colors cursor-pointer">
                  Save name
                </button>
              </div>
            </form>

          </div>
        </div>

        <!-- Account details card -->
        <div class="bg-zinc-900 border border-white/8 rounded-md overflow-hidden">
          <div class="px-5 py-3.5 border-b border-white/8">
            <h2 class="text-sm font-bold text-white m-0">Account</h2>
          </div>

          <div class="divide-y divide-white/5">

            <div class="px-5 py-3.5 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-zinc-400 m-0">Email</p>
                <p class="text-sm text-white mt-0.5 m-0"><%= user.email && user.email.value ? user.email.value : '—' %></p>
              </div>
              <span class="text-xs text-zinc-400 bg-white/5 border border-white/8 px-2 py-1 rounded">Read-only</span>
            </div>

            <div class="px-5 py-3.5 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-zinc-400 m-0">Role</p>
                <p class="text-sm text-white mt-0.5 m-0"><%= roleLabels[user.role] || user.role %></p>
              </div>
              <span class="text-xs text-zinc-400 bg-white/5 border border-white/8 px-2 py-1 rounded">Read-only</span>
            </div>

            <% if (!isFullAccess && user.permissions && user.permissions.length > 0) { %>
            <div class="px-5 py-3.5">
              <p class="text-xs font-semibold text-zinc-400 m-0 mb-2">Permissions</p>
              <div class="flex flex-wrap gap-1.5">
                <% user.permissions.forEach(function(p) { %>
                <span class="text-xs px-2.5 py-1 rounded-md bg-charm-500/10 border border-charm-500/20 text-charm-400 font-medium"><%= permLabels[p] || p %></span>
                <% }); %>
              </div>
            </div>
            <% } %>

            <% if (isFullAccess) { %>
            <div class="px-5 py-3.5">
              <p class="text-xs font-semibold text-zinc-400 m-0 mb-2">Permissions</p>
              <span class="text-xs px-2.5 py-1 rounded-md bg-charm-500/10 border border-charm-500/20 text-charm-400 font-medium">Full access</span>
            </div>
            <% } %>

            <div class="px-5 py-3.5">
              <p class="text-xs font-semibold text-zinc-400 m-0">Member since</p>
              <p class="text-sm text-white mt-0.5 m-0"><%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></p>
            </div>

            <div class="px-5 py-3.5 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-zinc-400 m-0">Account type</p>
                <% if (user.isTemporary && user.temporaryUntil) { %>
                <p class="text-sm text-white mt-0.5 m-0">Temporary — expires <%= new Date(user.temporaryUntil).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></p>
                <% } else { %>
                <p class="text-sm text-white mt-0.5 m-0">Permanent</p>
                <% } %>
              </div>
              <% if (user.isTemporary) { %>
              <span class="text-xs font-semibold text-charm-400 bg-charm-500/10 border border-charm-500/20 px-2 py-1 rounded">Temporary</span>
              <% } else { %>
              <span class="text-xs font-semibold text-green-400 bg-green-500/10 border border-green-500/20 px-2 py-1 rounded">Permanent</span>
              <% } %>
            </div>

          </div>
        </div>

        <!-- Security card -->
        <div class="bg-zinc-900 border border-white/8 rounded-md overflow-hidden">
          <div class="px-5 py-3.5 border-b border-white/8">
            <h2 class="text-sm font-bold text-white m-0">Security</h2>
          </div>

          <div class="px-5 py-5">
            <form action="/admin/profile/password" method="POST" class="flex flex-col gap-4">

              <div>
                <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Current password</label>
                <input
                  type="password"
                  name="currentPassword"
                  autocomplete="current-password"
                  class="w-full border border-white/10 bg-zinc-800 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-charm-500/50 focus:ring-1 focus:ring-charm-500/30 transition-colors"
                >
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-zinc-400 mb-1.5">New password</label>
                  <input
                    type="password"
                    name="newPassword"
                    autocomplete="new-password"
                    class="w-full border border-white/10 bg-zinc-800 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-charm-500/50 focus:ring-1 focus:ring-charm-500/30 transition-colors"
                  >
                </div>
                <div>
                  <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Confirm new password</label>
                  <input
                    type="password"
                    name="confirmPassword"
                    autocomplete="new-password"
                    class="w-full border border-white/10 bg-zinc-800 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-charm-500/50 focus:ring-1 focus:ring-charm-500/30 transition-colors"
                  >
                </div>
              </div>

              <p class="text-xs text-zinc-500 m-0">Minimum 8 characters.</p>

              <div>
                <button type="submit" class="px-4 py-2 rounded-md bg-zinc-700 hover:bg-zinc-600 text-white text-sm font-semibold transition-colors cursor-pointer">
                  Change password
                </button>
              </div>

            </form>
          </div>
        </div>

      </div>
    </main>
  </div>

<%- include('../partials/toasts') %>

<script>
(function () {
  var successMsgs = {
    name:     'Display name updated.',
    avatar:   'Avatar updated.',
    password: 'Password changed successfully.',
  };
  var errorMsgs = {
    name_empty:       'Display name cannot be empty.',
    name_failed:      'Failed to update display name.',
    avatar_missing:   'No file selected.',
    avatar_failed:    'Failed to upload avatar.',
    password_missing: 'Please fill in all password fields.',
    password_match:   'New passwords do not match.',
    password_length:  'New password must be at least 8 characters.',
    password_wrong:   'Current password is incorrect.',
    password_failed:  'Failed to update password.',
  };

  document.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    var success = params.get('success');
    var error   = params.get('error');

    if (success) window.showToast(successMsgs[success] || 'Changes saved.', 'success');
    if (error)   window.showToast(errorMsgs[error]     || 'Something went wrong.', 'error');

    if (success || error) {
      params.delete('success');
      params.delete('error');
      history.replaceState(null, '', window.location.pathname + (params.toString() ? '?' + params.toString() : ''));
    }
  });
}());
</script>

</body>
</html>
