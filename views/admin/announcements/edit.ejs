<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/head') %></head>
<body class="flex overflow-hidden bg-zinc-950" style="height:100vh;font-family:'Sofia Sans',sans-serif">

  <%- include('../../partials/adminSidebar', { currentPage: 'announcements' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <main class="flex-1 overflow-y-auto p-8">

      <div class="flex items-center gap-3 mb-6">
        <a href="/admin/announcements" class="text-zinc-500 hover:text-zinc-300 transition-colors no-underline">
          <iconify-icon icon="boxicons:arrow-back" width="16" style="display:block"></iconify-icon>
        </a>
        <div>
          <h1 class="text-xl font-bold text-white m-0">Edit Announcement</h1>
          <p class="text-sm text-zinc-400 mt-0.5 mb-0 truncate max-w-lg"><%= ann.title %></p>
        </div>
        <%
          const statusColor = { active: 'text-green-400 bg-green-400/10', draft: 'text-zinc-400 bg-zinc-700', expired: 'text-red-400 bg-red-400/10' }[ann.status] || 'text-zinc-400 bg-zinc-700';
        %>
        <span class="ml-auto text-[11px] font-semibold px-2.5 py-1 rounded-full shrink-0 <%= statusColor %>"><%= ann.status %></span>
      </div>

      <div class="bg-zinc-900 border border-white/8 rounded-md p-6">
        <form action="/admin/announcements/<%= ann._id %>/edit" method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">

          <div class="grid grid-cols-2 gap-4">

            <div class="col-span-2">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-xs font-semibold text-zinc-400">Title <span class="text-red-400">*</span></label>
                <span id="title-count" class="text-xs text-zinc-600"><%= ann.title.length %> / 50</span>
              </div>
              <input type="text" name="title" required maxlength="50" id="edit-title" value="<%= ann.title %>"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
            </div>

            <div class="col-span-2">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-xs font-semibold text-zinc-400">Description</label>
                <span id="desc-count" class="text-xs text-zinc-600"><%= (ann.description || '').length %> / 120</span>
              </div>
              <textarea name="description" rows="3" maxlength="120" id="edit-desc"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20 resize-none"><%= ann.description || '' %></textarea>
            </div>

            <!-- Thumbnail -->
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Thumbnail</label>
              <div class="flex items-stretch gap-3">

                <!-- Upload zone -->
                <div id="thumb-drop" class="relative flex flex-col items-center justify-center gap-1.5 flex-1 h-28 rounded-md border border-dashed border-white/15 bg-zinc-800 hover:border-white/25 transition-colors cursor-pointer overflow-hidden">
                  <div id="thumb-empty" class="flex flex-col items-center gap-1.5 pointer-events-none">
                    <iconify-icon icon="boxicons:image-add" width="20" style="color:rgba(255,255,255,0.2);display:block"></iconify-icon>
                    <span class="text-[11px] text-zinc-500 text-center leading-tight">Click to replace<br>JPG, PNG, WebP</span>
                  </div>
                  <input type="file" name="thumbnail" id="thumb-input" accept="image/*" class="hidden">
                </div>

                <!-- Preview — shows current or newly selected image -->
                <div id="thumb-preview-wrap" class="<%= ann.thumbnailUrl ? '' : 'hidden' %> w-36 shrink-0 relative rounded-md overflow-hidden bg-zinc-800 border border-white/8 h-28">
                  <img id="thumb-preview" src="<%= ann.thumbnailUrl || '' %>" alt="" class="w-full h-full object-contain pointer-events-none">
                  <p id="thumb-filename" class="absolute bottom-0 left-0 right-0 px-2 py-1 text-[10px] text-white/60 bg-black/50 truncate pointer-events-none"><%= ann.thumbnailUrl ? 'Current thumbnail' : '' %></p>
                  <button type="button" id="thumb-clear"
                    class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/60 hover:bg-black/80 transition-colors z-10" style="display:flex;align-items:center;justify-content:center">
                    <iconify-icon icon="boxicons:x" width="11" style="color:white;display:block"></iconify-icon>
                  </button>
                </div>

              </div>
              <!-- Hidden field set when the admin removes the existing thumbnail -->
              <input type="hidden" name="removeThumbnail" id="remove-thumbnail" value="0">
            </div>

            <div class="col-span-2">
              <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Redirect URL</label>
              <input type="url" name="redirectUrl" value="<%= ann.redirectUrl || '' %>" placeholder="https://... (optional — makes title clickable)"
                class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
            </div>

            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Publish at</label>
              <div class="flex items-center gap-2">
                <input type="datetime-local" name="publishedAt" id="edit-publishedAt"
                  value="<%= ann.publishedAt ? new Date(ann.publishedAt).toISOString().slice(0,16) : '' %>"
                  class="flex-1 bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-white/20">
                <button type="button" onclick="document.getElementById('edit-publishedAt').value=''"
                  class="text-zinc-500 hover:text-white transition-colors shrink-0" title="Clear">
                  <iconify-icon icon="boxicons:x" width="14"></iconify-icon>
                </button>
              </div>
              <p class="text-xs text-zinc-500 mt-1">Leave blank to publish immediately.</p>
            </div>

            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Expires at</label>
              <div class="flex items-center gap-2">
                <input type="datetime-local" name="expiresAt" id="edit-expiresAt"
                  value="<%= ann.expiresAt ? new Date(ann.expiresAt).toISOString().slice(0,16) : '' %>"
                  class="flex-1 bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white focus:outline-none focus:border-white/20">
                <button type="button" onclick="document.getElementById('edit-expiresAt').value=''"
                  class="text-zinc-500 hover:text-white transition-colors shrink-0" title="Clear">
                  <iconify-icon icon="boxicons:x" width="14"></iconify-icon>
                </button>
              </div>
              <p class="text-xs text-zinc-500 mt-1">Leave blank for no expiry.</p>
            </div>

          </div>

          <!-- Audience filters -->
          <div class="border-t border-white/8 pt-4">
            <p class="text-xs font-bold text-zinc-500 uppercase tracking-widest mb-3">Audience Filters <span class="normal-case font-normal text-zinc-600">(all optional — blank = show to everyone)</span></p>
            <div class="grid grid-cols-3 gap-4">

              <div>
                <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Sex</label>
                <div class="custom-dropdown relative" id="ann-sex-dropdown">
                  <input type="hidden" name="filters[sex]" id="ann-sex" value="<%= ann.filters?.sex || '' %>">
                  <button type="button" data-dropdown-trigger
                    class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-left flex items-center justify-between focus:outline-none transition-colors cursor-pointer">
                    <span class="dropdown-label text-sm <%= ann.filters?.sex ? 'text-white' : 'text-zinc-500' %>">
                      <%= ann.filters?.sex ? { male: 'Male', female: 'Female', other: 'Other', 'prefer-not-to-say': 'Prefer not to say' }[ann.filters.sex] || ann.filters.sex : 'No filter' %>
                    </span>
                    <iconify-icon data-chevron icon="boxicons:chevron-down" width="16" class="text-white/30 shrink-0" style="transition:transform 0.15s ease"></iconify-icon>
                  </button>
                  <div class="dropdown-panel absolute z-20 w-full mt-1 bg-zinc-800 border border-white/10 rounded-md shadow-xl overflow-hidden" style="display:none">
                    <% [['', 'No filter'], ['male', 'Male'], ['female', 'Female'], ['other', 'Other'], ['prefer-not-to-say', 'Prefer not to say']].forEach(([val, label]) => { %>
                      <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="<%= val %>" style="color:rgba(255,255,255,0.5)">
                        <span class="opt-label"><%= label %></span>
                        <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="<%= (ann.filters?.sex || '') === val ? 'display:flex' : 'display:none' %>;flex-shrink:0"></iconify-icon>
                      </button>
                    <% }) %>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Min age</label>
                <input type="number" name="filters[ageMin]" value="<%= ann.filters?.ageMin || '' %>" placeholder="e.g. 18" min="1" max="120"
                  class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-white/20">
              </div>

              <div>
                <label class="block text-xs font-semibold text-zinc-400 mb-1.5">Orientation</label>
                <div class="custom-dropdown relative" id="ann-orientation-dropdown">
                  <input type="hidden" name="filters[orientation]" id="ann-orientation" value="<%= ann.filters?.orientation || '' %>">
                  <button type="button" data-dropdown-trigger
                    class="w-full bg-zinc-800 border border-white/8 rounded-md px-3 py-2 text-sm text-left flex items-center justify-between focus:outline-none transition-colors cursor-pointer">
                    <span class="dropdown-label text-sm <%= ann.filters?.orientation ? 'text-white' : 'text-zinc-500' %>">
                      <%= ann.filters?.orientation ? { straight: 'Straight', gay: 'Gay', lesbian: 'Lesbian', bisexual: 'Bisexual', pansexual: 'Pansexual', other: 'Other', 'prefer-not-to-say': 'Prefer not to say' }[ann.filters.orientation] || ann.filters.orientation : 'No filter' %>
                    </span>
                    <iconify-icon data-chevron icon="boxicons:chevron-down" width="16" class="text-white/30 shrink-0" style="transition:transform 0.15s ease"></iconify-icon>
                  </button>
                  <div class="dropdown-panel absolute z-20 w-full mt-1 bg-zinc-800 border border-white/10 rounded-md shadow-xl overflow-y-auto max-h-52 overflow-hidden" style="display:none">
                    <% [['', 'No filter'], ['straight', 'Straight'], ['gay', 'Gay'], ['lesbian', 'Lesbian'], ['bisexual', 'Bisexual'], ['pansexual', 'Pansexual'], ['other', 'Other'], ['prefer-not-to-say', 'Prefer not to say']].forEach(([val, label]) => { %>
                      <button type="button" class="dropdown-option w-full flex items-center justify-between px-3 py-2.5 text-sm hover:bg-white/5 transition-colors cursor-pointer" data-value="<%= val %>" style="color:rgba(255,255,255,0.5)">
                        <span class="opt-label"><%= label %></span>
                        <iconify-icon icon="boxicons:check" width="13" class="check-icon text-charm-400" style="<%= (ann.filters?.orientation || '') === val ? 'display:flex' : 'display:none' %>;flex-shrink:0"></iconify-icon>
                      </button>
                    <% }) %>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <div class="flex items-center gap-3 pt-1">
            <button type="submit" class="px-4 py-2 rounded-md text-sm font-semibold bg-charm-500 hover:bg-charm-400 text-white transition-colors">
              Save changes
            </button>
            <a href="/admin/announcements" class="px-4 py-2 rounded-md text-sm font-semibold bg-zinc-700 hover:bg-zinc-600 text-white transition-colors no-underline">
              Cancel
            </a>
          </div>

        </form>
      </div>

    </main>
  </div>

<%- include('../../partials/toasts') %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var msgs = { 'title-required': ['Title is required.', 'error'], error: ['Something went wrong.', 'error'] };
  var flash = new URLSearchParams(window.location.search).get('flash');
  if (flash && msgs[flash]) window.showToast(msgs[flash][0], msgs[flash][1]);
  if (flash) history.replaceState(null, '', window.location.pathname);
});
</script>

</body>

<script>
(function () {
  // ── Thumbnail uploader ────────────────────────────────────────────────────
  var thumbInput       = document.getElementById('thumb-input');
  var thumbPreviewWrap = document.getElementById('thumb-preview-wrap');
  var thumbPreview     = document.getElementById('thumb-preview');
  var thumbFilename    = document.getElementById('thumb-filename');
  var thumbClear       = document.getElementById('thumb-clear');
  var removeThumbnail  = document.getElementById('remove-thumbnail');

  if (thumbInput) {
    document.getElementById('thumb-drop').addEventListener('click', function () {
      thumbInput.click();
    });

    thumbInput.addEventListener('change', function () {
      var file = this.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        thumbPreview.src = e.target.result;
        thumbFilename.textContent = file.name;
        thumbPreviewWrap.classList.remove('hidden');
        removeThumbnail.value = '0';
      };
      reader.readAsDataURL(file);
    });

    thumbClear.addEventListener('click', function () {
      thumbInput.value = '';
      thumbPreview.src = '';
      thumbFilename.textContent = '';
      thumbPreviewWrap.classList.add('hidden');
      removeThumbnail.value = '1';
    });
  }

  // ── Custom dropdowns ──────────────────────────────────────────────────────
  var allDropdownClosers = [];

  function initDropdown(containerId) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var trigger = container.querySelector('[data-dropdown-trigger]');
    var panel   = container.querySelector('.dropdown-panel');
    var label   = container.querySelector('.dropdown-label');
    var chevron = container.querySelector('[data-chevron]');
    var hidden  = container.querySelector('input[type="hidden"]');
    var options = container.querySelectorAll('.dropdown-option');
    var isOpen  = false;

    function openDropdown() {
      allDropdownClosers.forEach(function (fn) { fn(); });
      panel.style.display = 'block';
      chevron.style.transform = 'rotate(180deg)';
      trigger.style.borderColor = 'rgba(199,59,100,0.5)';
      isOpen = true;
    }
    function closeDropdown() {
      panel.style.display = 'none';
      chevron.style.transform = 'rotate(0deg)';
      trigger.style.borderColor = '';
      isOpen = false;
    }
    allDropdownClosers.push(closeDropdown);

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      isOpen ? closeDropdown() : openDropdown();
    });

    options.forEach(function (opt) {
      opt.addEventListener('click', function () {
        hidden.value = this.dataset.value;
        label.textContent = this.querySelector('.opt-label').textContent;
        label.style.color = this.dataset.value ? 'white' : '';
        options.forEach(function (o) {
          o.style.color = 'rgba(255,255,255,0.5)';
          o.querySelector('.check-icon').style.display = 'none';
        });
        this.style.color = 'white';
        this.querySelector('.check-icon').style.display = 'flex';
        closeDropdown();
      });
    });

    document.addEventListener('click', function (e) {
      if (!container.contains(e.target)) closeDropdown();
    });
  }

  initDropdown('ann-sex-dropdown');
  initDropdown('ann-orientation-dropdown');

  // ── Char counters ─────────────────────────────────────────────────────────
  function bindCounter(inputId, counterId, max) {
    var el = document.getElementById(inputId);
    var counter = document.getElementById(counterId);
    if (!el || !counter) return;
    function update() {
      var len = el.value.length;
      counter.textContent = len + ' / ' + max;
      counter.style.color = len >= max ? '#f87171' : len >= max * 0.85 ? '#fbbf24' : '';
    }
    el.addEventListener('input', update);
    update();
  }

  bindCounter('edit-title', 'title-count', 50);
  bindCounter('edit-desc',  'desc-count',  120);
}());
</script>
</html>
