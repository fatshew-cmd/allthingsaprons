<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="min-h-screen bg-shark-950 text-white">

  <header class="sticky top-0 z-10 bg-shark-950/95 backdrop-blur border-b border-white/5 px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-gochi text-charm-500 text-2xl leading-none" style="-webkit-text-stroke: 1px currentColor">AllThingsAprons</a>
    <div class="flex items-center gap-1.5">
      <iconify-icon icon="boxicons:headphone" width="15" class="text-white/30"></iconify-icon>
      <span class="text-sm text-white/40 font-medium">Support</span>
    </div>
    <form action="/logout" method="POST">
      <button type="submit" class="text-sm text-white/50 hover:text-white transition-colors cursor-pointer">Sign out</button>
    </form>
  </header>

  <div class="max-w-xl mx-auto px-4 py-8">

    <div class="mb-6">
      <h1 class="text-xl font-black text-white">Your conversations</h1>
      <p class="text-sm text-white/40 mt-1">Messages between you and our support team.</p>
    </div>

    <% if (threads.length > 0) { %>

    <!-- Thread list -->
    <div class="flex flex-col gap-2 mb-8">
      <% threads.forEach(function(t) { %>
      <a href="/contact/thread/<%= t._id %>"
        class="flex items-start gap-3 bg-shark-900 hover:bg-shark-800 border border-white/8 hover:border-white/14 rounded-md px-4 py-3.5 transition-colors no-underline">

        <!-- Topic icon -->
        <div class="shrink-0 w-9 h-9 rounded-md border flex items-center justify-center mt-0.5
          <%= t.topic === 'id_verification' ? 'bg-charm-600/15 border-charm-600/20' : 'bg-white/6 border-white/10' %>">
          <iconify-icon
            icon="<%= t.topic === 'id_verification' ? 'boxicons:shield-quarter' : 'boxicons:support' %>"
            width="17"
            class="<%= t.topic === 'id_verification' ? 'text-charm-400' : 'text-white/40' %>">
          </iconify-icon>
        </div>

        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <p class="text-sm font-semibold text-white truncate m-0"><%= t.label %></p>
              <% if (t.status === 'closed') { %>
              <span class="shrink-0 text-[10px] font-semibold px-1.5 py-0.5 rounded bg-white/8 text-white/30 uppercase tracking-wide">Closed</span>
              <% } %>
            </div>
            <% if (t.unreadCount > 0) { %>
            <span class="shrink-0 w-5 h-5 rounded-full bg-charm-500 text-white text-[10px] font-bold flex items-center justify-center leading-none">
              <%= t.unreadCount > 9 ? '9+' : t.unreadCount %>
            </span>
            <% } %>
          </div>

          <% if (t.lastMessage) { %>
          <p class="text-xs text-white/35 truncate m-0 mt-1 leading-relaxed">
            <% if (t.lastMessage.from === 'support') { %><span class="text-white/20">Support: </span><% } %>
            <%= t.lastMessage.body ? t.lastMessage.body.slice(0, 60) + (t.lastMessage.body.length > 60 ? '…' : '') : '[image]' %>
          </p>
          <p class="text-[10px] text-white/20 m-0 mt-1">
            <%= new Date(t.lastMessage.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
            · <%= new Date(t.lastMessage.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
          </p>
          <% } else { %>
          <p class="text-xs text-white/25 m-0 mt-1">No messages yet</p>
          <% } %>
        </div>

        <iconify-icon icon="boxicons:chevron-right" width="14" class="text-white/20 shrink-0 mt-2"></iconify-icon>
      </a>
      <% }); %>
    </div>

    <% } else { %>

    <!-- Empty state -->
    <div class="flex flex-col items-center gap-3 py-10 text-center mb-8">
      <div class="w-12 h-12 rounded-md bg-white/5 border border-white/8 flex items-center justify-center">
        <iconify-icon icon="boxicons:support" width="22" class="text-white/20"></iconify-icon>
      </div>
      <div>
        <p class="text-sm font-semibold text-white/60">No conversations yet</p>
        <p class="text-xs text-white/30 mt-1">Start a conversation and our team will get back to you within 24 hours.</p>
      </div>
    </div>

    <% } %>

    <!-- New conversation -->
    <div>
      <p class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-3">Start a new conversation</p>
      <div class="flex flex-col gap-2">
        <% Object.entries(TOPIC_LABELS).forEach(function(entry) {
          var topicKey   = entry[0];
          var topicLabel = entry[1];
          var icon = topicKey === 'id_verification' ? 'boxicons:shield-quarter' : 'boxicons:support';
          var iconCls = topicKey === 'id_verification' ? 'text-charm-400' : 'text-white/40';
          var iconWrapCls = topicKey === 'id_verification' ? 'bg-charm-600/15 border-charm-600/20' : 'bg-white/6 border-white/10';
        %>
        <a href="/contact/new?topic=<%= topicKey %>"
          class="flex items-center gap-3 bg-shark-900 hover:bg-shark-800 border border-white/8 hover:border-white/14 rounded-md px-4 py-3 transition-colors no-underline">
          <div class="w-8 h-8 rounded-md border flex items-center justify-center shrink-0 <%= iconWrapCls %>">
            <iconify-icon icon="<%= icon %>" width="15" class="<%= iconCls %>"></iconify-icon>
          </div>
          <span class="text-sm text-white/70 font-medium"><%= topicLabel %></span>
          <iconify-icon icon="boxicons:plus" width="14" class="text-white/25 ml-auto shrink-0"></iconify-icon>
        </a>
        <% }); %>
      </div>
    </div>

  </div>

<%- include('partials/toasts') %>

</body>
</html>
