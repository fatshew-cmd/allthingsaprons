<%- include('../partials/appStart', { title: title, activePage: 'settings' }) %>

<%
var txLabels = {
  top_up:                  'Top Up',
  contribution:            'Contribution',
  contribution_adjustment: 'Contribution Adjusted',
  contribution_withdrawal: 'Contribution Withdrawn',
  contest_payout_settled:  'Contest Payout',
  auto_payout:             'Auto-Payout',
  makeup_payout:           'Makeup Payout',
  admin_grant:             'Admin Grant',
  platform_fee:            'Platform Fee',
  manual_correction:       'Manual Correction',
};
var label    = txLabels[tx.type] || tx.type;
var isCredit = tx.direction === 'credit';
var sign     = isCredit ? '+' : '−';
var dateStr  = new Date(tx.createdAt).toLocaleString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
  hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
});
var statusColors = { completed: 'text-green-400', pending: 'text-yellow-400', reversed: 'text-red-400' };
var statusColor  = statusColors[tx.status] || 'text-white/40';
%>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Header -->
  <header class="sticky top-0 z-10 px-5 py-4 border-b border-white/10 bg-shark-950/95 backdrop-blur-sm">
    <div class="flex items-center gap-3">
      <a href="/settings?tab=wallet" class="text-white/40 hover:text-white/70 transition-colors">
        <iconify-icon icon="boxicons:arrow-back" width="18"></iconify-icon>
      </a>
      <h1 class="font-black text-lg tracking-tight">Transaction Detail</h1>
    </div>
  </header>

  <div class="px-5 py-6 max-w-lg mx-auto w-full space-y-4">

    <!-- Amount hero -->
    <div class="bg-shark-900 border border-white/10 rounded-md px-5 py-6 text-center">
      <p class="text-4xl font-black <%= isCredit ? 'text-green-400' : 'text-white/80' %>">
        <%= sign %><%= tx.amountCHL.toLocaleString() %> 🌶️
      </p>
      <p class="text-sm text-white/30 mt-1">$<%= tx.amountUSD.toFixed(2) %> USD</p>
      <p class="text-xs font-semibold text-white/50 mt-3"><%= label %></p>
    </div>

    <!-- Details -->
    <div class="bg-shark-900 border border-white/10 rounded-md divide-y divide-white/5">

      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Status</span>
        <span class="text-xs font-semibold capitalize <%= statusColor %>"><%= tx.status %></span>
      </div>

      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Date</span>
        <span class="text-xs text-white/70 text-right"><%= dateStr %></span>
      </div>

      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Balance before</span>
        <span class="text-xs text-white/70"><%= tx.balanceBefore.toLocaleString() %> 🌶️</span>
      </div>

      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Balance after</span>
        <span class="text-xs text-white/70"><%= tx.balanceAfter.toLocaleString() %> 🌶️</span>
      </div>

      <% if (tx.packageName) { %>
      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Package</span>
        <span class="text-xs text-white/70"><%= tx.packageName %></span>
      </div>
      <% } %>

      <% if (reference && reference._type === 'ContestContribution') { %>
      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Contest</span>
        <a href="/contest/<%= reference.contestId %>" class="text-xs text-charm-400 hover:text-charm-300 transition-colors">
          View contest →
        </a>
      </div>
      <% } else if (reference && tx.referenceType === 'Contest') { %>
      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40">Contest</span>
        <a href="/contest/<%= tx.referenceId %>" class="text-xs text-charm-400 hover:text-charm-300 transition-colors">
          View contest →
        </a>
      </div>
      <% } %>

      <div class="px-4 py-3.5 flex items-center justify-between gap-3">
        <span class="text-xs text-white/40 shrink-0">Transaction ID</span>
        <div class="flex items-center gap-2 min-w-0">
          <span id="tx-id-str" class="text-xs text-white/30 font-mono text-right break-all"><%= tx._id %></span>
          <button id="copy-tx-btn" type="button" class="shrink-0 text-white/70 hover:text-white transition-colors cursor-pointer" title="Copy ID">
            <iconify-icon id="copy-tx-icon" icon="boxicons:copy" width="14"></iconify-icon>
          </button>
        </div>
      </div>

    </div>

    <!-- Dispute -->
    <div class="bg-shark-900 border border-white/10 rounded-md px-4 py-4 flex items-center justify-between gap-3">
      <p class="text-sm font-semibold text-white">Something looks wrong?</p>
      <a href="/contact/new?topic=billing&txId=<%= tx._id %>"
        class="shrink-0 px-3 py-2 bg-white/8 hover:bg-white/12 border border-white/10 text-white text-xs font-semibold rounded-md transition-colors">
        Dispute
      </a>
    </div>

  </div>

</div>

<script>
(function () {
  var btn  = document.getElementById('copy-tx-btn');
  var icon = document.getElementById('copy-tx-icon');
  var txt  = document.getElementById('tx-id-str');
  if (!btn) return;
  btn.addEventListener('click', function () {
    navigator.clipboard.writeText(txt.textContent.trim()).then(function () {
      icon.setAttribute('icon', 'boxicons:copy-check');
      setTimeout(function () { icon.setAttribute('icon', 'boxicons:copy'); }, 2000);
    });
  });
})();
</script>

<%- include('../partials/appEnd') %>
