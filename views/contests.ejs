<%- include('partials/appStart', { title: title, activePage: 'contests' }) %>

<div class="flex flex-col pb-20 md:pb-0">

  <!-- Watching -->
  <% if (typeof watchedContests !== 'undefined' && watchedContests.length) { %>
  <section class="pt-5 pb-1 border-b border-white/8">
    <div class="flex items-center gap-2 px-5 mb-3">
      <iconify-icon icon="boxicons:bell-ring-filled" width="13" class="text-charm-400"></iconify-icon>
      <h2 class="text-xs font-bold text-white/40 uppercase tracking-wider m-0">Watching</h2>
    </div>
    <div class="flex gap-3 overflow-x-auto px-5 pb-4" style="scrollbar-width:none">
      <% watchedContests.forEach(function(comp) {
        var isActive  = comp.status === 'active';
        var isPending = comp.status === 'upcoming';
        var stCls = isActive  ? 'bg-green-500/20 text-green-400'
                  : isPending ? 'bg-amber-500/20 text-amber-400'
                  : 'bg-white/8 text-white/35';
        var stLbl = isActive  ? 'Live'
                  : isPending ? 'Pending'
                  : comp.status === 'closed' ? 'Ended' : 'Void';
        var lc = comp.covers[0] || null;
        var rc = comp.covers[1] || null;
        var ct1 = comp.contestants[0] || null;
        var ct2 = comp.contestants[1] || null;
      %>
      <a href="/contest/<%= comp._id %>"
        class="shrink-0 w-64 rounded-md overflow-hidden relative no-underline flex flex-col"
        style="height:200px">

        <!-- Split entry images -->
        <div class="absolute inset-0 flex">
          <div class="flex-1 relative overflow-hidden bg-shark-800">
            <% if (lc && lc.mediaUrl) { %>
              <% if (lc.mediaType === 'video') { %>
                <video src="<%= lc.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" muted preload="none"></video>
              <% } else { %>
                <img src="<%= lc.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" alt="" loading="lazy">
              <% } %>
            <% } else { %>
              <div class="absolute inset-0 flex items-center justify-center">
                <iconify-icon icon="boxicons:image" width="18" class="text-white/10"></iconify-icon>
              </div>
            <% } %>
            <div class="absolute inset-0" style="background:linear-gradient(to right, rgba(0,0,0,0.1), rgba(0,0,0,0.55))"></div>
          </div>
          <div class="flex-1 relative overflow-hidden bg-shark-900">
            <% if (rc && rc.mediaUrl) { %>
              <% if (rc.mediaType === 'video') { %>
                <video src="<%= rc.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" muted preload="none"></video>
              <% } else { %>
                <img src="<%= rc.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" alt="" loading="lazy">
              <% } %>
            <% } else { %>
              <div class="absolute inset-0 flex items-center justify-center">
                <iconify-icon icon="boxicons:user-plus" width="18" class="text-white/10"></iconify-icon>
              </div>
            <% } %>
            <div class="absolute inset-0" style="background:linear-gradient(to left, rgba(0,0,0,0.1), rgba(0,0,0,0.55))"></div>
          </div>
        </div>

        <!-- VS pill -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="rounded-full flex items-center justify-center shadow-lg" style="width:26px;height:26px;background:rgba(0,0,0,0.72);backdrop-filter:blur(4px)">
            <span style="font-size:7px;font-weight:900;letter-spacing:0.1em;color:rgba(255,255,255,0.7)">VS</span>
          </div>
        </div>

        <!-- Top bar: status badge -->
        <div class="absolute top-0 left-0 right-0 flex items-center justify-end px-2 pt-2">
          <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded-md <%= stCls %>"><%= stLbl %></span>
        </div>

        <!-- Bottom info -->
        <div class="absolute bottom-0 left-0 right-0 px-2.5 pb-2.5 pt-8" style="background:linear-gradient(to top, rgba(0,0,0,0.88) 60%, transparent)">
          <div class="flex items-center gap-1.5 min-w-0">
            <% if (ct1 && ct1.avatar) { %>
              <img src="<%= ct1.avatar %>" class="w-4 h-4 rounded-full object-cover border border-white/20 shrink-0" alt="">
            <% } %>
            <p class="text-[11px] font-semibold text-white truncate m-0 leading-none"><%= ct1 ? ct1.displayName : '—' %></p>
            <span class="text-[9px] font-bold text-white/25 shrink-0 mx-0.5">vs</span>
            <% if (ct2 && ct2.avatar) { %>
              <img src="<%= ct2.avatar %>" class="w-4 h-4 rounded-full object-cover border border-white/20 shrink-0 opacity-70" alt="">
            <% } %>
            <p class="text-[11px] text-white/60 truncate m-0 leading-none"><%= ct2 ? ct2.displayName : 'Awaiting' %></p>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- Pending Nominations -->
  <% if (typeof panelPendingNominations !== 'undefined' && panelPendingNominations.length) { %>
  <section class="px-5 pt-5 pb-4 border-b border-white/8">
    <div class="overflow-x-auto">
      <div class="grid grid-cols-2 gap-2" style="min-width:480px">
        <% panelPendingNominations.forEach(nom => { %>
          <a href="/submit?nomination=<%= nom._id %>"
            class="flex items-center gap-3 bg-white/5 border border-white/8 hover:border-charm-500/30 hover:bg-charm-600/5 rounded-md px-3 py-3 transition-colors group no-underline">
            <div class="w-14 h-14 rounded-md overflow-hidden bg-shark-900 shrink-0 flex items-center justify-center">
              <% if (nom.entry) { %>
                <% if (nom.entry.mediaType === 'video') { %>
                  <video src="<%= nom.entry.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
                <% } else { %>
                  <img src="<%= nom.entry.mediaUrl %>" class="w-full h-full object-cover" alt="" loading="lazy">
                <% } %>
              <% } else { %>
                <iconify-icon icon="boxicons:hide" width="18" style="color:rgba(255,255,255,0.2);display:block"></iconify-icon>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-white/85 truncate group-hover:text-white transition-colors m-0">
                <%= nom.nominator.displayName %> <span class="font-normal text-white/35">· @<%= nom.nominator.username %></span>
              </p>
              <p class="text-xs text-white/40 m-0">challenged you to a head-to-head</p>
              <% if (nom.message) { %>
                <p class="text-xs text-white/30 truncate m-0">"<%= nom.message %>"</p>
              <% } %>
              <p class="nom-countdown text-xs text-amber-300 font-medium tabular-nums m-0"
                data-expires="<%= nom.expiresAt.toISOString() %>"></p>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Active Contests -->
  <% const active = contests.filter(c => c.status === 'active'); %>
  <% if (active.length) { %>
  <section class="px-5 pt-6 pb-4">
    <h2 class="text-xs font-bold text-white/40 uppercase tracking-wider mb-4">Live Now</h2>
    <div class="grid grid-cols-2 gap-4">
      <% active.forEach(comp => { %>
        <a href="/contest/<%= comp._id %>" class="flex flex-col rounded-md bg-white/5 border border-white/10 overflow-hidden hover:bg-white/8 transition-colors no-underline">
          <div class="w-full aspect-square bg-shark-900 shrink-0 relative overflow-hidden">
            <% var main = comp.covers[0], pip = comp.covers[1]; %>
            <% if (main && main.mediaUrl) { %>
              <% if (main.mediaType === 'video') { %>
                <video src="<%= main.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" muted preload="none"></video>
              <% } else { %>
                <img src="<%= main.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" alt="" loading="lazy" />
              <% } %>
            <% } %>
            <% if (pip && pip.mediaUrl) { %>
              <div class="absolute bottom-2 right-2 w-1/3 aspect-square rounded-md overflow-hidden shadow-[0_4px_16px_rgba(0,0,0,0.6)]">
                <% if (pip.mediaType === 'video') { %>
                  <video src="<%= pip.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
                <% } else { %>
                  <img src="<%= pip.mediaUrl %>" class="w-full h-full object-cover" alt="" loading="lazy" />
                <% } %>
              </div>
            <% } %>
            <span class="absolute top-2 right-2 text-[9px] font-semibold uppercase tracking-wide text-green-400 bg-green-400/15 backdrop-blur-sm px-1.5 py-0.5 rounded-md">Live</span>
            <% if (comp.visibility === 'private') { %>
              <span class="absolute top-2 left-2 text-[9px] font-semibold uppercase tracking-wide text-white/60 bg-white/10 backdrop-blur-sm px-1.5 py-0.5 rounded-md">Private</span>
            <% } %>
          </div>
          <div class="p-4 flex flex-col gap-3">
            <p class="text-base font-bold leading-tight m-0"><%= comp.title %></p>
            <div class="flex flex-col gap-1">
              <% comp.contestants.forEach(function(ct, i) { %>
                <% if (i > 0) { %>
                  <div class="flex items-center gap-1.5 text-white/20">
                    <div class="flex-1 h-px bg-white/8"></div>
                    <span class="text-[9px] font-bold uppercase tracking-widest">vs</span>
                    <div class="flex-1 h-px bg-white/8"></div>
                  </div>
                <% } %>
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full overflow-hidden bg-shark-800 border border-white/10 shrink-0 flex items-center justify-center">
                    <% if (ct.avatar) { %>
                      <img src="<%= ct.avatar %>" class="w-full h-full object-cover" alt="">
                    <% } else { %>
                      <iconify-icon icon="boxicons:user" width="14" class="text-white/30"></iconify-icon>
                    <% } %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-white/85 truncate m-0"><%= ct.displayName %></p>
                    <p class="text-[10px] text-white/35 truncate m-0">@<%= ct.username %></p>
                  </div>
                  <% if (!ct.isSelf) { %>
                    <button type="button" class="follow-btn shrink-0 text-charm-400 cursor-pointer p-1"
                      data-username="<%= ct.username %>" data-following="<%= ct.isFollowing ? '1' : '0' %>"
                      title="<%= ct.isFollowing ? 'Following' : 'Follow' %>"
                      onclick="event.preventDefault(); event.stopPropagation(); handleContestFollow(this)">
                      <iconify-icon icon="<%= ct.isFollowing ? 'boxicons:user-check-filled' : 'boxicons:user-plus' %>" width="20"></iconify-icon>
                    </button>
                  <% } %>
                </div>
              <% }) %>
            </div>
            <span class="card-deadline text-xs text-green-400 font-medium" data-ts="<%= comp.votingDeadline ? new Date(comp.votingDeadline).getTime() : '' %>">...</span>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- Upcoming Contests -->
  <% const upcoming = contests.filter(c => c.status === 'upcoming'); %>
  <% if (upcoming.length) { %>
  <section class="px-5 pt-2 pb-6 border-t border-white/5">
    <h2 class="text-xs font-bold text-white/40 uppercase tracking-wider mb-4 mt-4">Coming Up</h2>
    <div class="flex flex-col gap-3">
      <% upcoming.forEach(comp => { %>
        <a href="/contest/<%= comp._id %>" class="flex items-center gap-4 p-3 rounded-md bg-white/5 border border-white/10 hover:bg-white/8 transition-colors no-underline">
          <div class="w-14 h-14 rounded-md overflow-hidden shrink-0 bg-shark-900 relative">
            <% var main = comp.covers[0], pip = comp.covers[1]; %>
            <% if (main && main.mediaUrl) { %>
              <% if (main.mediaType === 'video') { %>
                <video src="<%= main.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" muted preload="none"></video>
              <% } else { %>
                <img src="<%= main.mediaUrl %>" class="absolute inset-0 w-full h-full object-cover" alt="" loading="lazy" />
              <% } %>
            <% } %>
            <% if (pip && pip.mediaUrl) { %>
              <div class="absolute bottom-1 right-1 w-5 h-5 rounded overflow-hidden shadow-[0_2px_8px_rgba(0,0,0,0.7)]">
                <% if (pip.mediaType === 'video') { %>
                  <video src="<%= pip.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
                <% } else { %>
                  <img src="<%= pip.mediaUrl %>" class="w-full h-full object-cover" alt="" loading="lazy" />
                <% } %>
              </div>
            <% } %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-base font-bold truncate m-0"><%= comp.title %></p>
            <div class="flex flex-col gap-1.5 mt-2">
              <% comp.contestants.forEach(function(ct, i) { %>
                <% if (i > 0) { %><span class="text-white/20 text-[9px] font-bold uppercase tracking-widest">vs</span><% } %>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full overflow-hidden bg-shark-800 border border-white/10 shrink-0 flex items-center justify-center">
                    <% if (ct.avatar) { %>
                      <img src="<%= ct.avatar %>" class="w-full h-full object-cover" alt="">
                    <% } else { %>
                      <iconify-icon icon="boxicons:user" width="11" class="text-white/30"></iconify-icon>
                    <% } %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-white/85 truncate m-0"><%= ct.displayName %></p>
                    <p class="text-[10px] text-white/35 m-0">@<%= ct.username %></p>
                  </div>
                  <% if (!ct.isSelf) { %>
                    <button type="button" class="follow-btn shrink-0 text-charm-400 cursor-pointer p-1"
                      data-username="<%= ct.username %>" data-following="<%= ct.isFollowing ? '1' : '0' %>"
                      title="<%= ct.isFollowing ? 'Following' : 'Follow' %>"
                      onclick="event.preventDefault(); event.stopPropagation(); handleContestFollow(this)">
                      <iconify-icon icon="<%= ct.isFollowing ? 'boxicons:user-check-filled' : 'boxicons:user-plus' %>" width="18"></iconify-icon>
                    </button>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
          <p class="text-xs font-medium text-yellow-400/80 shrink-0 m-0">In <%= comp.daysLeft %>d</p>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (!contests || !contests.length) { %>
  <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
    <div class="w-16 h-16 rounded-md bg-white/5 flex items-center justify-center mb-4">
      <iconify-icon icon="boxicons:trophy" width="32" height="32" class="text-white/20"></iconify-icon>
    </div>
    <p class="text-white/40 text-sm">No contests yet</p>
    <p class="text-white/20 text-xs mt-1">Be the first to launch one</p>
  </div>
  <% } %>

</div>

<% if (typeof panelPendingNominations !== 'undefined' && panelPendingNominations.length) { %>
<script>
(function () {
  var els = document.querySelectorAll('.nom-countdown');
  if (!els.length) return;
  function fmt(expiresAt) {
    var diff = expiresAt - Date.now();
    if (diff <= 0) return 'Expired';
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    var p = function (n) { return n < 10 ? '0' + n : '' + n; };
    if (h > 0) return h + 'h ' + p(m) + 'm left to reply';
    if (m > 0) return m + 'm ' + p(s) + 's left to reply';
    return s + 's left to reply';
  }
  function tick() { els.forEach(function (el) { el.textContent = fmt(new Date(el.dataset.expires)); }); }
  tick();
  setInterval(tick, 1000);
})();
</script>
<% } %>

<script>
(function () {
  function updateDeadline(el) {
    var ts = parseInt(el.dataset.ts, 10);
    if (!ts) { el.textContent = ''; return; }
    var diff = ts - Date.now();
    if (diff <= 0) { el.textContent = 'ended'; return; }
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    el.textContent = d + 'd ' + h + 'h ' + m + 'm left';
  }
  var els = document.querySelectorAll('.card-deadline');
  els.forEach(updateDeadline);
  setInterval(function () { els.forEach(updateDeadline); }, 1000);
})();

function handleContestFollow(btn) {
  var username   = btn.dataset.username;
  var following  = btn.dataset.following === '1';
  var url        = following ? '/unfollow/' + username : '/follow/' + username;
  fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var nowFollowing = data.following;
      btn.dataset.following = nowFollowing ? '1' : '0';
      btn.title = nowFollowing ? 'Following' : 'Follow';
      var icon = btn.querySelector('iconify-icon');
      if (icon) icon.setAttribute('icon', nowFollowing ? 'boxicons:user-check-filled' : 'boxicons:user-plus');
    });
}
</script>

<%- include('partials/appEnd') %>
