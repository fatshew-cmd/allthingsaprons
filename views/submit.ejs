<%- include('partials/appStart', { title: 'Submit Entry', activePage: 'submit' }) %>

<div class="max-w-2xl mx-auto px-4 py-5 pb-24 md:pb-5">

  <div class="mb-4 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-black">Submit Entry</h1>
      <p class="text-sm text-white/40 mt-1">Share your apron — ratings start the moment you submit.</p>
    </div>
    <!-- Media type filter -->
    <div class="relative shrink-0 mt-1" id="media-type-wrapper">
      <button type="button" id="media-type-btn"
        class="flex items-center gap-1.5 text-xs text-white/50 bg-shark-900 border border-white/10 rounded-md px-2.5 py-1.5 hover:text-white/60 hover:border-white/20 transition-colors cursor-pointer whitespace-nowrap">
        <iconify-icon icon="boxicons:images" width="12"></iconify-icon>
        <span id="media-type-label">Pictures</span>
        <iconify-icon icon="boxicons:chevron-down" width="10" id="media-type-chevron"></iconify-icon>
      </button>
      <div id="media-type-dropdown"
        class="hidden absolute right-0 top-full mt-1 bg-shark-900 border border-white/10 rounded-md shadow-xl z-50 min-w-36 py-1 overflow-hidden">
        <label class="flex items-center gap-2.5 px-3 py-2 hover:bg-white/5 cursor-pointer text-sm text-white/70 hover:text-white transition-colors">
          <input type="radio" name="mediaTypeFilter" value="image" class="accent-charm-500" checked>
          Pictures
        </label>
        <label class="flex items-center gap-2.5 px-3 py-2 hover:bg-white/5 cursor-pointer text-sm text-white/70 hover:text-white transition-colors">
          <input type="radio" name="mediaTypeFilter" value="video" class="accent-charm-500">
          Videos
        </label>
      </div>
    </div>
  </div>

  <% if (error) { %>
  <div class="flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-4">
    <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
    <%= error %>
  </div>
  <% } %>

  <form action="/submit" method="POST" enctype="multipart/form-data" id="submit-form" novalidate>

    <!-- ── Media section ─────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-4">

      <!-- Upload zone -->
      <label id="upload-zone" class="cursor-pointer block">
        <div id="upload-placeholder"
          class="border-2 border-dashed border-white/12 rounded-md p-10 flex flex-col items-center gap-3 text-white/35 hover:border-charm-600/40 hover:text-white/55 transition-colors">
          <iconify-icon icon="boxicons:image-add" width="44"></iconify-icon>
          <div class="text-center">
            <p class="text-sm font-medium">Click to upload or drag &amp; drop</p>
            <p class="text-xs mt-1 text-white/25">
              Photo: PNG, JPG, WEBP — max 10 MB<br>
              Video: MP4, MOV — max 100 MB &nbsp;·&nbsp; max 8 s (trim available)
            </p>
          </div>
        </div>
        <input type="file" id="media-input" name="entryMedia" accept="image/*" class="hidden">
      </label>

      <!-- Image preview -->
      <div id="image-preview" class="hidden relative rounded-md overflow-hidden bg-shark-900">
        <img id="preview-img" src="" alt="" class="w-full max-h-80 object-contain">
        <button type="button" id="change-image-btn"
          class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
          <iconify-icon icon="boxicons:pencil" width="11"></iconify-icon>Change
        </button>
      </div>

      <!-- Video preview (post-trim) -->
      <div id="video-preview" class="hidden relative rounded-md overflow-hidden bg-black">
        <video id="preview-vid" class="w-full max-h-80 object-contain" controls playsinline></video>
        <button type="button" id="change-video-btn"
          class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
          <iconify-icon icon="boxicons:pencil" width="11"></iconify-icon>Change
        </button>
        <div id="trim-badge" class="hidden absolute top-2 left-2 bg-shark-950/80 rounded-md px-2 py-1 text-xs text-charm-400 items-center gap-1">
          <iconify-icon icon="boxicons:cut" width="11"></iconify-icon>Trimmed
        </div>
      </div>

      <!-- Trim panel (all videos) -->
      <div id="trim-panel" class="hidden flex-col gap-0 border border-white/10 rounded-md overflow-hidden">

        <!-- Video player -->
        <div class="bg-black relative flex items-center justify-center">
          <video id="trim-video" class="w-full max-h-48 object-contain" preload="metadata" playsinline></video>
          <button type="button" id="play-pause-btn"
            class="absolute bottom-2 left-2 w-8 h-8 flex items-center justify-center bg-shark-950/75 hover:bg-shark-950/95 rounded-md transition-colors cursor-pointer text-white/70 hover:text-white">
            <iconify-icon icon="boxicons:play-filled" width="14" id="play-icon"></iconify-icon>
          </button>
          <span id="trim-current-time" class="absolute bottom-2 left-11 h-8 flex items-center text-xs text-white/55 tabular-nums pointer-events-none">0:00.0</span>
          <button type="button" id="change-trim-btn"
            class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
            <iconify-icon icon="boxicons:pencil" width="11"></iconify-icon>Change
          </button>
        </div>

        <!-- Warning: only shown for videos > 8s -->
        <div id="trim-warning"
          class="hidden items-start gap-2 text-xs text-amber-400/90 bg-amber-400/8 border-b border-amber-400/15 px-3 py-2.5">
          <iconify-icon icon="boxicons:time" width="14" class="shrink-0 mt-0.5"></iconify-icon>
          <span>This video is longer than 8 seconds. Drag the pink window to choose your clip, then apply the trim.</span>
        </div>

        <div class="flex flex-col gap-2.5 p-3">

          <!-- Timeline with horizontal scroll -->
          <div class="flex flex-col gap-1">
            <div class="relative">
            <div id="timeline-scroll-wrap" class="overflow-x-auto overflow-y-hidden rounded-md">
              <div id="trim-timeline"
                class="relative h-14 bg-shark-800 select-none overflow-hidden cursor-col-resize"
                style="min-width:100%;">

                <!-- Thumbnail strip (position + width set by JS to cover visible area) -->
                <div id="thumb-strip" class="absolute top-0 bottom-0 pointer-events-none opacity-55" style="left:0;width:100%;position:absolute;"></div>

                <!-- Dim overlays -->
                <div id="dim-before" class="absolute top-0 left-0 h-full bg-shark-950/65 pointer-events-none"></div>
                <div id="dim-after"  class="absolute top-0 right-0 h-full bg-shark-950/65 pointer-events-none"></div>

                <!-- Selected window -->
                <div id="trim-sel" class="absolute top-0 h-full border-x-2 border-charm-500 pointer-events-none">
                  <div class="w-full h-full bg-charm-600/20"></div>
                  <!-- Left handle -->
                  <div id="handle-left"
                    class="absolute left-0 top-0 bottom-0 w-3 bg-charm-500 flex items-center justify-center cursor-ew-resize pointer-events-auto z-10">
                    <div class="w-px h-4 bg-white/60 rounded pointer-events-none"></div>
                  </div>
                  <!-- Right handle -->
                  <div id="handle-right"
                    class="absolute right-0 top-0 bottom-0 w-3 bg-charm-500 flex items-center justify-center cursor-ew-resize pointer-events-auto z-10">
                    <div class="w-px h-4 bg-white/60 rounded pointer-events-none"></div>
                  </div>
                </div>

                <!-- Time labels -->
                <span id="tick-start" class="absolute bottom-1 text-[9px] font-mono text-charm-300 pointer-events-none px-1.5 z-20"></span>
                <span id="tick-end"   class="absolute bottom-1 text-[9px] font-mono text-charm-300 pointer-events-none px-1.5 z-20"></span>

                <!-- Playhead -->
                <div id="playhead"
                  class="absolute top-0 h-full items-center justify-center cursor-ew-resize z-30"
                  style="display:none;width:16px;transform:translateX(-50%);">
                  <div class="w-0.5 h-full bg-white/75 pointer-events-none"></div>
                </div>
              </div>
            </div>
            <div id="thumb-parse-overlay"
              class="hidden absolute inset-0 rounded-md bg-shark-950/70 items-center justify-center z-50 pointer-events-none">
              <p class="text-xs text-white/50 animate-pulse tracking-wide">Parsing your video. Please wait…</p>
            </div>
            </div>

            <div class="flex justify-between text-xs text-white/25">
              <span>0:00</span>
              <span id="trim-total"></span>
            </div>
          </div>

          <!-- Apply trim -->
          <button type="button" id="apply-trim-btn"
            class="w-full bg-charm-500/10 hover:bg-charm-500/15 border border-charm-500/25 hover:border-charm-500/35 text-charm-400 hover:text-charm-300 font-semibold rounded-md py-2.5 text-sm transition-colors cursor-pointer flex items-center justify-center gap-2">
            <iconify-icon icon="boxicons:cut" width="15"></iconify-icon>
            Apply Trim <span id="apply-trim-label" class="font-normal opacity-75 ml-0.5"></span>
          </button>

          <div id="trim-loading" class="hidden flex-col items-center gap-3 py-1">
            <p id="trim-msg" class="text-sm text-white/50"></p>
            <div class="w-full bg-shark-800 rounded-full h-1 overflow-hidden">
              <div id="trim-bar" class="bg-charm-500 h-1 rounded-full transition-all duration-300" style="width:0%"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- Trim cards (up to 3) -->
      <div id="trim-cards" class="hidden gap-2"></div>

      <p id="media-error" class="text-xs text-red-400 hidden"></p>
    </div>

    <!-- ── Caption ───────────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-4">
      <label for="caption" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
        Description <span class="text-white/25 font-normal normal-case">(optional)</span>
      </label>
      <textarea id="caption" name="caption" rows="3" maxlength="280"
        placeholder="Describe your apron…"
        class="w-full bg-shark-900 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"></textarea>
      <p class="text-xs text-white/25 text-right"><span id="caption-count">0</span>/280</p>
    </div>

    <!-- ── Tags ──────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-5">
      <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">
        Tags <span class="text-white/25 font-normal normal-case">(optional, up to 6)</span>
      </label>
      <div id="tag-wrap"
        class="flex flex-wrap gap-2 items-center bg-shark-900 border border-white/10 rounded-md px-3 py-2.5 min-h-11 cursor-text focus-within:border-charm-600/50 focus-within:ring-1 focus-within:ring-charm-600/25 transition-colors">
        <input id="tag-input" type="text" placeholder="Add a tag…"
          class="flex-1 min-w-24 bg-transparent text-sm text-white placeholder:text-white/20 outline-none">
      </div>
      <p class="text-xs text-white/25"><span id="tag-count">0</span>/6 &nbsp;·&nbsp; press Enter or comma to add</p>
    </div>

    <!-- ── Audience & Options ──────────────────────────────────────── -->
    <div class="flex flex-col gap-3 mb-4 border border-white/10 rounded-md px-4 py-3.5">
      <p class="text-xs font-semibold text-white/50 uppercase tracking-wide">Options</p>

      <!-- Visibility -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Audience</span>
          <span class="text-xs text-white/35">Who can see this entry</span>
        </div>
        <div class="flex items-center gap-1.5 bg-shark-800 border border-white/10 rounded-md p-1">
          <button type="button" data-vis="public"
            class="vis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer vis-active">
            Everyone
          </button>
          <button type="button" data-vis="followers"
            class="vis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">
            Followers
          </button>
        </div>
        <input type="hidden" name="visibility" id="visibility-input" value="public">
      </div>

      <!-- Comments toggle -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Comments</span>
          <span class="text-xs text-white/35">Allow others to comment</span>
        </div>
        <button type="button" id="comments-toggle" data-on="true"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-charm-600 shrink-0">
          <span id="comments-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-7"></span>
        </button>
        <input type="hidden" name="commentsEnabled" id="comments-input" value="true">
      </div>

      <!-- Contest eligibility toggle -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Contest eligible</span>
          <span class="text-xs text-white/35">Allow nominations to contests</span>
        </div>
        <button type="button" id="contest-toggle" data-on="true"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-charm-600 shrink-0">
          <span id="contest-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-7"></span>
        </button>
        <input type="hidden" name="contestEligible" id="contest-input" value="true">
      </div>

      <!-- Mature content -->
      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Mature content</span>
          <span class="text-xs text-white/35">Flag as 18+ or sensitive</span>
        </div>
        <input type="checkbox" name="matureContent" id="mature-checkbox" value="true"
          class="w-4 h-4 accent-charm-500 cursor-pointer">
      </label>
    </div>

    <% if (pendingNominations && pendingNominations.length > 0) { %>
    <!-- ── Nominations ─────────────────────────────────────────────── -->
    <div class="flex flex-col gap-2.5 mb-4">
      <div class="flex items-center justify-between">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wide">Pending Nominations</p>
        <span class="text-xs text-white/30"><%= pendingNominations.length %> waiting</span>
      </div>
      <p class="text-xs text-white/40">Submit this entry as your response to one of these nominations.</p>
      <div class="flex flex-col gap-2" id="nominations-list">
        <% pendingNominations.forEach(function(nom) { %>
        <label class="nomination-card flex items-center gap-3 border border-white/10 rounded-md px-3 py-2.5 cursor-pointer hover:border-white/20 transition-colors has-checked:border-charm-500/50 has-checked:bg-charm-600/5">
          <input type="radio" name="nominationId" value="<%= nom._id %>"
            class="w-4 h-4 accent-charm-500 shrink-0 cursor-pointer">
          <% const nom_avatar = nom.nominatorId.avatar || '/img/default-avatar.png'; %>
          <img src="<%= nom_avatar %>" alt="" class="w-7 h-7 rounded-md object-cover bg-shark-800 shrink-0">
          <div class="flex flex-col gap-0.5 min-w-0">
            <span class="text-sm text-white/80 font-medium truncate">
              <%= nom.nominatorId.displayName || nom.nominatorId.username.value %>
              <span class="text-white/35 font-normal">nominated you</span>
            </span>
            <% if (nom.message) { %>
            <span class="text-xs text-white/40 truncate">"<%= nom.message %>"</span>
            <% } %>
            <span class="text-xs text-white/25">
              Expires <%= new Date(nom.expiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
            </span>
          </div>
        </label>
        <% }); %>
      </div>
      <input type="hidden" name="nominationId" id="nomination-id-input" value="">
    </div>
    <% } %>

    <button type="submit" id="submit-btn" disabled
      class="w-full bg-charm-600 hover:bg-charm-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
      Submit Entry
    </button>

  </form>

</div>

<style>
  .vis-active {
    background-color: rgba(221, 104, 144, 0.15);
    color: rgba(221, 104, 144, 1);
  }
  #upload-placeholder.drag-active {
    border-color: rgba(221, 104, 144, 0.5);
    background-color: rgba(221, 104, 144, 0.04);
    color: rgba(255,255,255,0.6);
  }
  #timeline-scroll-wrap {
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.18) transparent;
  }
  #timeline-scroll-wrap::-webkit-scrollbar { height: 4px; }
  #timeline-scroll-wrap::-webkit-scrollbar-track { background: transparent; }
  #timeline-scroll-wrap::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.18);
    border-radius: 9999px;
  }
  #timeline-scroll-wrap::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,0.3);
  }
</style>

<script>
(function () {
  var MAX_CLIP = 8;
  var MIN_CLIP = 0.5;

  // ── State ────────────────────────────────────────────────────────
  var rawFile        = null;
  var trimmedBlob    = null;
  var videoDuration  = 0;
  var trimStart      = 0;
  var trimEnd        = 0;
  var isPlaying      = false;
  var playTimer      = null;
  var dragMode          = null; // 'left' | 'right' | 'move' | 'playhead' | null
  var moveDragOffset    = 0;
  var autoScrollLocked  = false;
  var trimCards         = [];   // [{id, blob, start, end, url}]
  var trimNextId        = 0;
  var selectedCardId    = -1;

  // ── DOM ──────────────────────────────────────────────────────────
  var form           = document.getElementById('submit-form');
  var mediaInput     = document.getElementById('media-input');
  var uploadZone     = document.getElementById('upload-zone');
  var uploadPH       = document.getElementById('upload-placeholder');
  var imgPreview     = document.getElementById('image-preview');
  var vidPreview     = document.getElementById('video-preview');
  var previewImg     = document.getElementById('preview-img');
  var previewVid     = document.getElementById('preview-vid');
  var trimBadge      = document.getElementById('trim-badge');
  var trimPanel      = document.getElementById('trim-panel');
  var trimWarning    = document.getElementById('trim-warning');
  var trimVideo      = document.getElementById('trim-video');
  var timelineWrap   = document.getElementById('timeline-scroll-wrap');
  var trimTimeline   = document.getElementById('trim-timeline');
  var trimSel        = document.getElementById('trim-sel');
  var handleLeft     = document.getElementById('handle-left');
  var handleRight    = document.getElementById('handle-right');
  var dimBefore      = document.getElementById('dim-before');
  var dimAfter       = document.getElementById('dim-after');
  var tickStart      = document.getElementById('tick-start');
  var tickEnd        = document.getElementById('tick-end');
  var trimTotal      = document.getElementById('trim-total');
  var applyBtn       = document.getElementById('apply-trim-btn');
  var applyLabel     = document.getElementById('apply-trim-label');
  var trimLoading    = document.getElementById('trim-loading');
  var trimMsg        = document.getElementById('trim-msg');
  var trimBar        = document.getElementById('trim-bar');
  var mediaError     = document.getElementById('media-error');
  var submitBtn      = document.getElementById('submit-btn');
  var playPauseBtn   = document.getElementById('play-pause-btn');
  var playIcon       = document.getElementById('play-icon');
  var thumbStrip        = document.getElementById('thumb-strip');
  var playhead          = document.getElementById('playhead');
  var thumbParseOverlay = document.getElementById('thumb-parse-overlay');
  var trimCurrentTime   = document.getElementById('trim-current-time');
  var trimCardsEl       = document.getElementById('trim-cards');

  // ── Helpers ──────────────────────────────────────────────────────

  function fmt(s) {
    var m   = Math.floor(s / 60);
    var sec = (s % 60).toFixed(1);
    return m + ':' + (parseFloat(sec) < 10 ? '0' : '') + sec;
  }

  function fmtSize(bytes) {
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function setError(msg) {
    mediaError.textContent = msg;
    mediaError.classList.toggle('hidden', !msg);
  }

  function updateApplyBtn() {
    var atLimit = trimCards.length >= 3;
    applyBtn.disabled = atLimit;
    applyBtn.classList.toggle('opacity-50', atLimit);
    applyBtn.classList.toggle('cursor-not-allowed', atLimit);
    applyBtn.classList.toggle('cursor-pointer', !atLimit);
  }

  function syncSubmitBtn() {
    var hasImage = rawFile && rawFile.type.startsWith('image/');
    submitBtn.disabled = !(hasImage || trimCards.length > 0);
  }

  function clearTrimCards() {
    trimCards.forEach(function (tc) { URL.revokeObjectURL(tc.url); });
    trimCards = [];
    selectedCardId = -1;
    trimCardsEl.innerHTML = '';
    trimCardsEl.classList.add('hidden');
    trimCardsEl.classList.remove('flex');
    var captionEl = document.getElementById('caption');
    if (captionEl) { captionEl.value = ''; captionEl.dispatchEvent(new Event('input')); }
    if (typeof tags !== 'undefined') {
      tags.slice().forEach(function (t) {
        var chip = tagWrap.querySelector('span[data-tag="' + t + '"]');
        if (chip) removeTag(t, chip);
      });
    }
    updateApplyBtn();
    syncSubmitBtn();
  }

  function selectTrimCard(id) {
    // Save current card's caption + tags before switching
    if (selectedCardId !== -1) {
      var prev = trimCards.find(function (c) { return c.id === selectedCardId; });
      if (prev) {
        prev.caption = document.getElementById('caption').value;
        prev.tags    = tags.slice();
      }
    }

    selectedCardId = id;

    // Load the new card's caption + tags
    var tc = trimCards.find(function (c) { return c.id === id; });
    if (tc) {
      var captionEl = document.getElementById('caption');
      captionEl.value = tc.caption;
      captionEl.dispatchEvent(new Event('input'));

      tags.slice().forEach(function (t) {
        var chip = tagWrap.querySelector('span[data-tag="' + t + '"]');
        if (chip) removeTag(t, chip);
      });
      tc.tags.forEach(function (t) { addTag(t); });

      var dt = new DataTransfer();
      dt.items.add(new File([tc.blob], 'trimmed.mp4', { type: 'video/mp4' }));
      mediaInput.files = dt.files;
    }

    // Update card visuals
    trimCardsEl.querySelectorAll('.trim-card').forEach(function (cardEl) {
      var isSel = parseInt(cardEl.dataset.cardId) === id;
      var icon  = cardEl.querySelector('.card-check-icon');
      cardEl.classList.toggle('border-white/10', !isSel);
      cardEl.classList.toggle('border-charm-500/40', isSel);
      cardEl.classList.toggle('border-2', isSel);
      if (icon) {
        icon.setAttribute('icon', isSel ? 'boxicons:check-square-filled' : 'boxicons:square');
        icon.style.color = isSel ? '#dd6890' : 'rgba(255,255,255,0.25)';
      }
    });
  }

  function removeTrimCard(id, cardEl) {
    var tc = trimCards.find(function (c) { return c.id === id; });
    if (tc) URL.revokeObjectURL(tc.url);
    trimCards = trimCards.filter(function (c) { return c.id !== id; });
    cardEl.remove();
    if (trimCards.length === 0) {
      trimCardsEl.classList.add('hidden');
      trimCardsEl.classList.remove('flex');
      selectedCardId = -1;
      mediaInput.value = '';
      var captionEl = document.getElementById('caption');
      captionEl.value = '';
      captionEl.dispatchEvent(new Event('input'));
      tags.slice().forEach(function (t) {
        var chip = tagWrap.querySelector('span[data-tag="' + t + '"]');
        if (chip) removeTag(t, chip);
      });
    } else if (selectedCardId === id) {
      selectTrimCard(trimCards[trimCards.length - 1].id);
    }
    updateApplyBtn();
    syncSubmitBtn();
  }

  function createTrimCard(blob, start, end) {
    var id       = ++trimNextId;
    var url      = URL.createObjectURL(blob);
    var clipLen  = end - start;
    var estBytes = rawFile ? rawFile.size * (clipLen / videoDuration) : blob.size;
    // Snapshot current caption + tags as this card's initial data
    trimCards.push({
      id:      id,
      blob:    blob,
      start:   start,
      end:     end,
      url:     url,
      caption: document.getElementById('caption').value,
      tags:    tags.slice(),
    });

    var card = document.createElement('div');
    card.className = 'trim-card flex flex-col w-1/3 border border-white/10 rounded-md overflow-hidden bg-shark-900 transition-colors';
    card.dataset.cardId = id;

    var vid = document.createElement('video');
    vid.src = url;
    vid.className = 'w-full max-h-28 object-contain bg-black';
    vid.controls = true;
    vid.setAttribute('playsinline', '');
    card.appendChild(vid);

    var footer = document.createElement('div');
    footer.className = 'flex flex-col px-2.5 pt-2 pb-2.5 gap-2 cursor-pointer';
    footer.innerHTML =
      '<div class="flex flex-col gap-0.5 min-w-0">' +
        '<p class="text-sm font-semibold text-white/70 truncate">Trim ' + id + '</p>' +
        '<p class="text-xs text-white/30">' + clipLen.toFixed(1) + 's &nbsp;·&nbsp; ' + fmtSize(estBytes) + '</p>' +
      '</div>' +
      '<div class="flex items-center gap-1.5">' +
        '<iconify-icon class="card-check-icon shrink-0 transition-colors" icon="boxicons:square" width="1rem" style="color:rgba(255,255,255,0.25)"></iconify-icon>' +
        '<span class="text-xs text-white/35 tabular-nums">' + fmt(start) + ' – ' + fmt(end) + '</span>' +
        '<div class="flex-1"></div>' +
        '<button type="button" class="remove-trim-btn text-white/25 hover:text-red-400 transition-colors cursor-pointer p-0.5 shrink-0">' +
          '<iconify-icon icon="boxicons:trash-filled" width="1rem"></iconify-icon>' +
        '</button>' +
      '</div>';
    card.appendChild(footer);

    footer.addEventListener('click', function (e) {
      if (!e.target.closest('.remove-trim-btn')) selectTrimCard(id);
    });
    footer.querySelector('.remove-trim-btn').addEventListener('click', function (e) {
      e.stopPropagation();
      removeTrimCard(id, card);
    });

    trimCardsEl.appendChild(card);
    trimCardsEl.classList.remove('hidden');
    trimCardsEl.classList.add('flex');

    selectTrimCard(id);
    updateApplyBtn();
    syncSubmitBtn();
  }

  function stopPlayback() {
    if (isPlaying) {
      trimVideo.pause();
      isPlaying = false;
      clearInterval(playTimer);
      playTimer = null;
      playIcon.setAttribute('icon', 'boxicons:play-filled');
    }
  }

  function resetState() {
    rawFile = null;
    trimmedBlob = null;
    videoDuration = 0;
    trimStart = 0;
    trimEnd = 0;
    mediaInput.value = '';
    stopPlayback();
    thumbStrip.innerHTML = '';
    trimTimeline.style.minWidth = '100%';
    playhead.style.display = 'none';
    clearTrimCards();

    uploadZone.classList.remove('hidden');
    imgPreview.classList.add('hidden');
    vidPreview.classList.add('hidden');
    trimPanel.classList.add('hidden');
    trimPanel.classList.remove('flex');
    trimLoading.classList.add('hidden');
    trimLoading.classList.remove('flex');
    applyBtn.classList.remove('hidden');
    trimBadge.classList.add('hidden');
    trimBadge.classList.remove('flex');
    setError('');
  }

  function showImagePreview(file) {
    previewImg.src = URL.createObjectURL(file);
    uploadZone.classList.add('hidden');
    imgPreview.classList.remove('hidden');
    vidPreview.classList.add('hidden');
    trimPanel.classList.add('hidden');
    trimPanel.classList.remove('flex');
    syncSubmitBtn();
  }

  function showVideoPreview(source, wasTrimmed) {
    previewVid.src = URL.createObjectURL(source);
    uploadZone.classList.add('hidden');
    imgPreview.classList.add('hidden');
    vidPreview.classList.remove('hidden');
    trimPanel.classList.add('hidden');
    trimPanel.classList.remove('flex');
    if (wasTrimmed) {
      trimBadge.classList.remove('hidden');
      trimBadge.classList.add('flex');
    }
  }

  function showTrimPanel(file) {
    stopPlayback();
    thumbStrip.innerHTML = '';
    clearTrimCards();
    trimVideo.src = URL.createObjectURL(file);
    uploadZone.classList.add('hidden');
    imgPreview.classList.add('hidden');
    vidPreview.classList.add('hidden');
    trimPanel.classList.remove('hidden');
    trimPanel.classList.add('flex');
    applyBtn.classList.remove('hidden');
    trimLoading.classList.add('hidden');
    trimLoading.classList.remove('flex');
    trimStart = 0;
    trimEnd = 0;
    playhead.style.left = '0%';
    playhead.style.display = 'flex';
  }

  // ── File selection ───────────────────────────────────────────────

  mediaInput.addEventListener('change', function () {
    var file = this.files[0];
    if (!file) return;
    rawFile = file;
    trimmedBlob = null;
    setError('');

    if (file.type.startsWith('image/')) {
      showImagePreview(file);
      return;
    }
    if (file.type.startsWith('video/')) {
      showTrimPanel(file);
      return;
    }
    setError('Please upload a photo or video file.');
  });

  // ── Trim video ready ─────────────────────────────────────────────

  trimVideo.addEventListener('loadedmetadata', function () {
    videoDuration = trimVideo.duration;

    if (!isFinite(videoDuration) || videoDuration <= 0) {
      setError('Could not read video duration. Please try a different file.');
      resetState();
      return;
    }

    trimTotal.textContent = fmt(videoDuration);
    trimCurrentTime.textContent = fmt(0);
    trimStart = 0;
    trimEnd   = Math.min(MAX_CLIP, videoDuration);
    setTimelineWidth();

    if (videoDuration > MAX_CLIP) {
      trimWarning.classList.remove('hidden');
      trimWarning.classList.add('flex');
    } else {
      trimWarning.classList.add('hidden');
      trimWarning.classList.remove('flex');
    }

    renderTrimUI();
    generateThumbnails().catch(function (e) { console.warn('Thumbnails:', e); });
  });

  // ── Timeline width ───────────────────────────────────────────────

  function setTimelineWidth() {
    var wrapW = timelineWrap.clientWidth || 400;
    // For every 8s of video, the timeline is at least 50% of the viewport wide,
    // keeping the 8s clip window at ~50% of the visible area.
    var minW  = Math.max(wrapW, Math.round(0.5 * wrapW * videoDuration / 8));
    trimTimeline.style.minWidth = minW + 'px';
  }

  // ── Thumbnail strip ──────────────────────────────────────────────

  var thumbGenId      = 0;
  var renderedPages   = new Set();
  var thumbRenderBusy = false;

  function showParseOverlay() {
    thumbParseOverlay.classList.remove('hidden');
    thumbParseOverlay.classList.add('flex');
  }
  function hideParseOverlay() {
    thumbParseOverlay.classList.add('hidden');
    thumbParseOverlay.classList.remove('flex');
  }

  // Kick off initial render: first 4 viewports.
  async function generateThumbnails() {
    var genId = ++thumbGenId;
    thumbStrip.innerHTML = '';
    renderedPages.clear();
    thumbRenderBusy = false;

    await new Promise(function (r) { setTimeout(r, 0); });
    if (genId !== thumbGenId) return;

    await renderPageBatch(genId, 0);
  }

  // Render up to 4 viewport-sized pages starting at startPage.
  async function renderPageBatch(genId, startPage) {
    if (genId !== thumbGenId) return;

    showParseOverlay();

    var totalW    = trimTimeline.offsetWidth || 400;
    var tlH       = trimTimeline.clientHeight || 56;
    var wrapW     = timelineWrap.clientWidth || totalW;
    var totalPgs  = Math.ceil(totalW / wrapW);
    // ~4 frames per viewport width, minimum 4
    var framesPerVP = Math.max(4, Math.round(wrapW / 60));
    var frameW      = Math.max(1, Math.round(wrapW / framesPerVP));

    var canvas = document.createElement('canvas');
    canvas.width  = frameW;
    canvas.height = tlH;
    var ctx = canvas.getContext('2d');

    var endPage = Math.min(startPage + 4, totalPgs);

    for (var p = startPage; p < endPage; p++) {
      if (genId !== thumbGenId) { hideParseOverlay(); return; }
      if (renderedPages.has(p)) continue;
      renderedPages.add(p);

      var pageStartPx = p * wrapW;
      var pageEndPx   = Math.min((p + 1) * wrapW, totalW);
      var pageW       = pageEndPx - pageStartPx;
      var pageFrames  = Math.max(1, Math.round(pageW / frameW));

      for (var i = 0; i < pageFrames; i++) {
        if (genId !== thumbGenId) { hideParseOverlay(); return; }

        var framePx = pageStartPx + (i / pageFrames) * pageW;
        var t = (framePx / totalW) * videoDuration;

        await seekVideoTo(t);
        if (genId !== thumbGenId) { hideParseOverlay(); return; }

        ctx.drawImage(trimVideo, 0, 0, frameW, tlH);
        var img = document.createElement('img');
        img.src = canvas.toDataURL('image/jpeg', 0.6);
        img.style.cssText = 'position:absolute;top:0;height:100%;object-fit:cover;'
          + 'left:'  + ((framePx / totalW) * 100).toFixed(4) + '%;'
          + 'width:' + ((frameW  / totalW) * 100).toFixed(4) + '%;';
        thumbStrip.appendChild(img);
      }
    }

    hideParseOverlay();
    if (!isPlaying && !dragMode) trimVideo.currentTime = trimStart;
  }

  // On scroll: if the current viewport has unrendered pages, render the next batch.
  function scheduleThumbnailRender() {
    if (!videoDuration || thumbRenderBusy) return;

    var totalW   = trimTimeline.offsetWidth || 400;
    var wrapW    = timelineWrap.clientWidth || totalW;
    var totalPgs = Math.ceil(totalW / wrapW);
    var curPage  = Math.floor(timelineWrap.scrollLeft / wrapW);

    for (var p = curPage; p < Math.min(curPage + 4, totalPgs); p++) {
      if (!renderedPages.has(p)) {
        var currentGenId = thumbGenId;
        thumbRenderBusy  = true;
        renderPageBatch(currentGenId, p).then(function () {
          thumbRenderBusy = false;
          // Re-check in case scrolling continued during render
          scheduleThumbnailRender();
        }).catch(function () { thumbRenderBusy = false; });
        return;
      }
    }
  }

  var thumbScrollTimer = null;
  timelineWrap.addEventListener('scroll', function () {
    clearTimeout(thumbScrollTimer);
    thumbScrollTimer = setTimeout(scheduleThumbnailRender, 200);
  });

  function seekVideoTo(t) {
    return new Promise(function (resolve) {
      function onSeeked() {
        trimVideo.removeEventListener('seeked', onSeeked);
        resolve();
      }
      trimVideo.addEventListener('seeked', onSeeked);
      trimVideo.currentTime = t;
    });
  }

  // ── Render trim UI ───────────────────────────────────────────────

  function renderTrimUI() {
    if (!videoDuration) return;

    var startPct = (trimStart / videoDuration) * 100;
    var endPct   = (trimEnd   / videoDuration) * 100;

    dimBefore.style.width = startPct + '%';
    dimAfter.style.width  = (100 - endPct) + '%';
    trimSel.style.left    = startPct + '%';
    trimSel.style.width   = (endPct - startPct) + '%';

    tickStart.textContent = fmt(trimStart);
    tickStart.style.left  = startPct + '%';
    tickStart.style.right = '';

    tickEnd.textContent = fmt(trimEnd);
    if (endPct > 70) {
      tickEnd.style.left  = '';
      tickEnd.style.right = (100 - endPct) + '%';
    } else {
      tickEnd.style.left  = endPct + '%';
      tickEnd.style.right = '';
    }

    if (!isPlaying && !dragMode && trimVideo.readyState >= 1) {
      trimVideo.currentTime = trimStart;
    }

    var clipLen  = trimEnd - trimStart;
    var estBytes = rawFile ? rawFile.size * (clipLen / videoDuration) : 0;
    applyLabel.textContent = '(' + clipLen.toFixed(1) + 's · ' + fmtSize(estBytes) + ')';
  }

  function updatePlayhead(t) {
    if (!videoDuration) return;
    playhead.style.left = ((t / videoDuration) * 100) + '%';
    trimCurrentTime.textContent = fmt(t);
  }

  // ── Drag system ──────────────────────────────────────────────────

  function timeFromPointer(e) {
    var clientX  = e.touches ? e.touches[0].clientX : e.clientX;
    var wrapRect = timelineWrap.getBoundingClientRect();
    var px       = timelineWrap.scrollLeft + (clientX - wrapRect.left);
    var total    = trimTimeline.offsetWidth;
    var pct      = Math.max(0, Math.min(1, px / total));
    return pct * videoDuration;
  }

  function startHandleDrag(mode, e) {
    e.preventDefault();
    e.stopPropagation();
    stopPlayback();
    dragMode = mode;
  }

  handleLeft.addEventListener('mousedown',  startHandleDrag.bind(null, 'left'));
  handleLeft.addEventListener('touchstart', startHandleDrag.bind(null, 'left'), { passive: false });
  handleRight.addEventListener('mousedown',  startHandleDrag.bind(null, 'right'));
  handleRight.addEventListener('touchstart', startHandleDrag.bind(null, 'right'), { passive: false });

  playhead.addEventListener('mousedown', function (e) {
    e.preventDefault();
    e.stopPropagation();
    dragMode = 'playhead';
  });
  playhead.addEventListener('touchstart', function (e) {
    e.preventDefault();
    e.stopPropagation();
    dragMode = 'playhead';
  }, { passive: false });

  function startTimelineDrag(e) {
    e.preventDefault();
    stopPlayback();
    var t       = timeFromPointer(e);
    var clipLen = trimEnd - trimStart;
    dragMode    = 'move';
    if (t >= trimStart && t <= trimEnd) {
      moveDragOffset = t - trimStart;
    } else {
      trimStart      = Math.max(0, Math.min(t, videoDuration - clipLen));
      trimEnd        = trimStart + clipLen;
      moveDragOffset = t - trimStart;
      renderTrimUI();
    }
  }

  trimTimeline.addEventListener('mousedown',  startTimelineDrag);
  trimTimeline.addEventListener('touchstart', startTimelineDrag, { passive: false });

  function autoScrollTimeline(handlePx) {
    if (autoScrollLocked) return;
    var wrapW  = timelineWrap.clientWidth;
    var scroll = timelineWrap.scrollLeft;
    var edge   = Math.round(wrapW * 0.4); // keep handle 20% from the edge
    var target = -1;
    if (handlePx < scroll + edge) {
      target = Math.max(0, handlePx - edge);
    } else if (handlePx > scroll + wrapW - edge) {
      target = Math.min(trimTimeline.offsetWidth - wrapW, handlePx - wrapW + edge);
    }
    if (target < 0) return;
    autoScrollLocked = true;
    timelineWrap.scrollTo({ left: target, behavior: 'smooth' });
    setTimeout(function () { autoScrollLocked = false; }, 250);
  }

  function onDragMove(e) {
    if (!dragMode) return;
    var t = timeFromPointer(e);

    if (dragMode === 'left') {
      trimStart = Math.max(0, Math.min(t, trimEnd - MIN_CLIP));
      if (trimEnd - trimStart > MAX_CLIP) trimStart = trimEnd - MAX_CLIP;
    } else if (dragMode === 'right') {
      trimEnd = Math.min(videoDuration, Math.max(t, trimStart + MIN_CLIP));
      if (trimEnd - trimStart > MAX_CLIP) trimEnd = trimStart + MAX_CLIP;
    } else if (dragMode === 'move') {
      var len      = trimEnd - trimStart;
      var newStart = Math.max(0, Math.min(t - moveDragOffset, videoDuration - len));
      trimStart    = newStart;
      trimEnd      = newStart + len;
    } else if (dragMode === 'playhead') {
      var seekT = Math.max(0, Math.min(t, videoDuration));
      trimVideo.currentTime = seekT;
      updatePlayhead(seekT);
      autoScrollTimeline((seekT / videoDuration) * trimTimeline.offsetWidth);
      return;
    }

    renderTrimUI();

    var tw = trimTimeline.offsetWidth;
    if (dragMode === 'left') {
      autoScrollTimeline((trimStart / videoDuration) * tw);
    } else if (dragMode === 'right') {
      autoScrollTimeline((trimEnd / videoDuration) * tw);
    } else if (dragMode === 'move') {
      autoScrollTimeline((trimStart / videoDuration) * tw);
      autoScrollTimeline((trimEnd / videoDuration) * tw);
    }
  }

  document.addEventListener('mousemove',  onDragMove);
  document.addEventListener('touchmove',  function (e) { if (dragMode) { e.preventDefault(); onDragMove(e); } }, { passive: false });
  document.addEventListener('mouseup',    function () { dragMode = null; });
  document.addEventListener('touchend',   function () { dragMode = null; });

  // ── Play/pause ───────────────────────────────────────────────────

  playPauseBtn.addEventListener('click', function () {
    if (isPlaying) {
      stopPlayback();
      return;
    }
    trimVideo.currentTime = trimStart;
    trimVideo.play().then(function () {
      isPlaying = true;
      playIcon.setAttribute('icon', 'boxicons:pause-filled');
      playTimer = setInterval(function () {
        if (trimVideo.currentTime >= trimEnd) {
          stopPlayback();
          trimVideo.currentTime = trimStart;
        }
      }, 50);
    }).catch(function (err) { console.warn('Playback error:', err); });
  });

  trimVideo.addEventListener('ended', stopPlayback);

  trimVideo.addEventListener('timeupdate', function () {
    if (dragMode !== 'left' && dragMode !== 'right' && dragMode !== 'move') {
      updatePlayhead(trimVideo.currentTime);
    }
  });

  // ── Apply trim (ffmpeg.wasm) ─────────────────────────────────────

  applyBtn.addEventListener('click', function () {
    stopPlayback();
    applyBtn.classList.add('hidden');
    trimLoading.classList.remove('hidden');
    trimLoading.classList.add('flex');
    doTrim().catch(function (err) {
      console.error('Trim failed:', err);
      applyBtn.classList.remove('hidden');
      trimLoading.classList.add('hidden');
      trimLoading.classList.remove('flex');
      setError('Trim failed. Please pre-trim your video and re-upload.');
    });
  });

  async function doTrim() {
    var startSec = parseFloat(trimStart.toFixed(3));
    var clipLen  = parseFloat((trimEnd - trimStart).toFixed(3));

    trimMsg.textContent = 'Loading video trimmer…';
    trimMsg.classList.remove('animate-pulse');
    trimBar.style.width = '8%';

    var ffmpegMod = await import('https://unpkg.com/@ffmpeg/ffmpeg@0.12.10/dist/esm/index.js');
    var utilMod   = await import('https://unpkg.com/@ffmpeg/util@0.12.1/dist/esm/index.js');

    var FFmpeg    = ffmpegMod.FFmpeg;
    var fetchFile = utilMod.fetchFile;

    trimBar.style.width = '15%';
    trimMsg.textContent = 'Loading wasm (one-time download, ~30 MB)…';

    var ffmpeg = new FFmpeg();

    ffmpeg.on('progress', function (p) {
      trimBar.style.width = (55 + Math.round(p.progress * 35)) + '%';
    });

    var origin = window.location.origin;
    await ffmpeg.load({
      classWorkerURL: origin + '/wasm/ffmpeg-worker.js',
      coreURL:        origin + '/wasm/ffmpeg-core.js',
      wasmURL:        origin + '/wasm/ffmpeg-core.wasm',
    });

    trimBar.style.width = '55%';
    trimMsg.textContent = 'Trimming…';
    trimMsg.classList.add('animate-pulse');

    var ext       = (rawFile.name.match(/\.[^.]+$/) || ['.mp4'])[0].toLowerCase();
    var inputName = 'input' + ext;
    var outName   = 'out.mp4';

    await ffmpeg.writeFile(inputName, await fetchFile(rawFile));

    await ffmpeg.exec([
      '-ss', String(startSec),
      '-i',  inputName,
      '-t',  String(clipLen),
      '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '28',
      '-c:a', 'aac', '-b:a', '128k',
      '-movflags', '+faststart',
      outName,
    ]);

    var data    = await ffmpeg.readFile(outName);
    trimmedBlob = new Blob([data.buffer], { type: 'video/mp4' });

    await ffmpeg.deleteFile(inputName);
    await ffmpeg.deleteFile(outName);

    var dt = new DataTransfer();
    dt.items.add(new File([trimmedBlob], 'trimmed.mp4', { type: 'video/mp4' }));
    mediaInput.files = dt.files;

    trimBar.style.width = '100%';
    await new Promise(function (r) { setTimeout(r, 250); });

    var capturedStart = trimStart;
    var capturedEnd   = trimEnd;

    trimLoading.classList.add('hidden');
    trimLoading.classList.remove('flex');
    applyBtn.classList.remove('hidden');
    trimBar.style.width = '0%';

    // Reset handles to full range so user can make another trim
    trimStart = 0;
    trimEnd   = Math.min(MAX_CLIP, videoDuration);
    renderTrimUI();

    createTrimCard(trimmedBlob, capturedStart, capturedEnd);
  }

  // ── Drag & drop on upload zone ───────────────────────────────────

  uploadZone.addEventListener('dragover', function (e) {
    e.preventDefault();
    uploadPH.classList.add('drag-active');
  });
  uploadZone.addEventListener('dragleave', function () {
    uploadPH.classList.remove('drag-active');
  });
  uploadZone.addEventListener('drop', function (e) {
    e.preventDefault();
    uploadPH.classList.remove('drag-active');
    var file = e.dataTransfer.files[0];
    if (!file) return;
    var dt = new DataTransfer();
    dt.items.add(file);
    mediaInput.files = dt.files;
    mediaInput.dispatchEvent(new Event('change'));
  });

  function openFilePicker() {
    mediaInput.value = '';
    mediaInput.click();
  }
  document.getElementById('change-image-btn').addEventListener('click', openFilePicker);
  document.getElementById('change-video-btn').addEventListener('click', openFilePicker);
  document.getElementById('change-trim-btn').addEventListener('click', openFilePicker);

  // ── Media type dropdown ──────────────────────────────────────────

  var mediaTypeBtn      = document.getElementById('media-type-btn');
  var mediaTypeDropdown = document.getElementById('media-type-dropdown');
  var mediaTypeLabel    = document.getElementById('media-type-label');
  var mediaTypeChevron  = document.getElementById('media-type-chevron');

  mediaTypeBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var isOpen = !mediaTypeDropdown.classList.contains('hidden');
    mediaTypeDropdown.classList.toggle('hidden', isOpen);
    mediaTypeChevron.setAttribute('icon', isOpen ? 'boxicons:chevron-down' : 'boxicons:chevron-up');
  });

  document.addEventListener('click', function () {
    mediaTypeDropdown.classList.add('hidden');
    mediaTypeChevron.setAttribute('icon', 'boxicons:chevron-down');
  });

  mediaTypeDropdown.addEventListener('click', function (e) { e.stopPropagation(); });

  document.querySelectorAll('input[name="mediaTypeFilter"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      var val = this.value;
      mediaInput.accept = val === 'image' ? 'image/*' : 'video/*';
      mediaTypeLabel.textContent = val === 'image' ? 'Pictures' : 'Videos';
      mediaTypeDropdown.classList.add('hidden');
      mediaTypeChevron.setAttribute('icon', 'boxicons:chevron-down');
      if (rawFile) {
        if (val === 'image' && !rawFile.type.startsWith('image/')) resetState();
        if (val === 'video' && !rawFile.type.startsWith('video/')) resetState();
      }
    });
  });

  // Sync label + accept to whichever radio the browser restored on load
  (function () {
    var checked = document.querySelector('input[name="mediaTypeFilter"]:checked');
    if (checked && checked.value === 'video') {
      mediaInput.accept = 'video/*';
      mediaTypeLabel.textContent = 'Videos';
    }
  }());

  // ── Caption counter ──────────────────────────────────────────────

  document.getElementById('caption').addEventListener('input', function () {
    document.getElementById('caption-count').textContent = this.value.length;
  });

  // ── Tag input ────────────────────────────────────────────────────

  var MAX_TAGS   = 6;
  var tags       = [];
  var tagInput   = document.getElementById('tag-input');
  var tagWrap    = document.getElementById('tag-wrap');
  var tagCountEl = document.getElementById('tag-count');

  function updateTagUI() {
    tagCountEl.textContent = tags.length;
    tagInput.style.display = tags.length >= MAX_TAGS ? 'none' : '';
    tagInput.placeholder   = tags.length === 0 ? 'Add a tag…' : (tags.length < MAX_TAGS ? 'Add another…' : '');
  }

  function addTag(text) {
    text = text.trim().toLowerCase().replace(/,/g, '');
    if (!text || tags.includes(text) || tags.length >= MAX_TAGS) return;
    tags.push(text);

    var chip = document.createElement('span');
    chip.className   = 'inline-flex items-center gap-1 bg-shark-800 border border-white/15 rounded-md px-2 py-1 text-xs text-white/70';
    chip.dataset.tag = text;
    chip.innerHTML   = '#' + text +
      '<button type="button" class="text-white/30 hover:text-white/70 transition-colors cursor-pointer ml-0.5 leading-none">' +
      '<iconify-icon icon="boxicons:x" width="12"></iconify-icon></button>';
    chip.querySelector('button').addEventListener('click', function () { removeTag(text, chip); });
    tagWrap.insertBefore(chip, tagInput);

    var hidden = document.createElement('input');
    hidden.type        = 'hidden';
    hidden.name        = 'tags';
    hidden.value       = text;
    hidden.dataset.tag = text;
    form.appendChild(hidden);

    updateTagUI();
  }

  function removeTag(text, chip) {
    tags = tags.filter(function (t) { return t !== text; });
    chip.remove();
    var h = form.querySelector('input[type="hidden"][data-tag="' + text + '"]');
    if (h) h.remove();
    updateTagUI();
  }

  tagInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      addTag(this.value);
      this.value = '';
    } else if ((e.key === ',' || e.key === ' ') && this.value.trim()) {
      e.preventDefault();
      addTag(this.value);
      this.value = '';
    } else if (e.key === 'Backspace' && !this.value && tags.length) {
      var chips = tagWrap.querySelectorAll('span[data-tag]');
      var last  = chips[chips.length - 1];
      if (last) removeTag(last.dataset.tag, last);
    }
  });

  tagInput.addEventListener('input', function () {
    if (this.value.includes(',')) {
      this.value.split(',').forEach(function (p) { addTag(p); });
      this.value = '';
    }
  });

  tagWrap.addEventListener('click', function () { tagInput.focus(); });

  // ── Visibility toggle ────────────────────────────────────────────

  var visInput = document.getElementById('visibility-input');
  document.querySelectorAll('.vis-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var val = this.dataset.vis;
      visInput.value = val;
      document.querySelectorAll('.vis-btn').forEach(function (b) {
        var active = b.dataset.vis === val;
        b.classList.toggle('vis-active', active);
        b.classList.toggle('text-white/40', !active);
        b.classList.toggle('hover:text-white/60', !active);
      });
    });
  });

  // ── Toggle helpers ────────────────────────────────────────────────

  function makeToggle(btnId, thumbId, inputId) {
    var btn   = document.getElementById(btnId);
    var thumb = document.getElementById(thumbId);
    var input = document.getElementById(inputId);
    if (!btn) return;
    btn.addEventListener('click', function () {
      var on = btn.dataset.on !== 'true';
      btn.dataset.on = on ? 'true' : 'false';
      btn.classList.toggle('bg-charm-600', on);
      btn.classList.toggle('bg-shark-700', !on);
      thumb.classList.toggle('translate-x-7', on);
      input.value = on ? 'true' : 'false';
    });
  }

  makeToggle('comments-toggle', 'comments-thumb', 'comments-input');
  makeToggle('contest-toggle',  'contest-thumb',  'contest-input');

  // ── Nominations ──────────────────────────────────────────────────

  var nominationIdInput = document.getElementById('nomination-id-input');
  document.querySelectorAll('input[name="nominationId"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      if (nominationIdInput) nominationIdInput.value = this.checked ? this.value : '';
    });
  });

  // ── Form submit ──────────────────────────────────────────────────

  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    if (rawFile && rawFile.type.startsWith('video/') && trimCards.length === 0) {
      setError('Apply at least one trim before submitting.');
      return;
    }
    if (!rawFile) {
      setError('Please upload a photo or video.');
      return;
    }

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Submitting…';
    setError('');

    // Flush the active card's current caption + tags into trimCards before iterating
    if (selectedCardId !== -1) {
      var cur = trimCards.find(function (c) { return c.id === selectedCardId; });
      if (cur) {
        cur.caption = document.getElementById('caption').value;
        cur.tags    = tags.slice();
      }
    }

    var activeNominationId = nominationIdInput ? nominationIdInput.value : '';
    var visibility      = visInput ? visInput.value : 'public';
    var commentsEnabled = document.getElementById('comments-input') ? document.getElementById('comments-input').value : 'true';
    var contestEligible = document.getElementById('contest-input')  ? document.getElementById('contest-input').value  : 'true';
    var matureContent   = document.getElementById('mature-checkbox') && document.getElementById('mature-checkbox').checked ? 'true' : 'false';

    async function postEntry(file, caption, entryTags, nominationId) {
      var fd = new FormData();
      fd.append('entryMedia', file);
      fd.append('caption', caption || '');
      entryTags.forEach(function (t) { fd.append('tags', t); });
      fd.append('visibility',      visibility);
      fd.append('commentsEnabled', commentsEnabled);
      fd.append('contestEligible', contestEligible);
      fd.append('matureContent',   matureContent);
      if (nominationId) fd.append('nominationId', nominationId);
      var r    = await fetch('/api/entries', { method: 'POST', body: fd });
      var data = await r.json();
      if (!r.ok || data.error) throw new Error(data.error || 'Upload failed');
      return data.entryId;
    }

    try {
      var firstId;
      if (trimCards.length > 0) {
        // Only the first trim card carries the nomination — one nomination, one entry
        var ids = await Promise.all(trimCards.map(function (tc, i) {
          return postEntry(
            new File([tc.blob], 'trimmed.mp4', { type: 'video/mp4' }),
            tc.caption,
            tc.tags || [],
            i === 0 ? activeNominationId : ''
          );
        }));
        firstId = ids[0];
      } else {
        firstId = await postEntry(
          rawFile,
          document.getElementById('caption').value,
          tags.slice(),
          activeNominationId
        );
      }
      window.location.href = '/entry/' + firstId;
    } catch (err) {
      console.error('Submit error:', err);
      setError(err.message || 'Something went wrong. Please try again.');
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Submit Entry';
    }
  });

}());
</script>

<%- include('partials/appEnd') %>
