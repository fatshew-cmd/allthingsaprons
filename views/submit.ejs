<%- include('partials/appStart', { title: 'Submit Entry', activePage: 'submit' }) %>

<div class="max-w-2xl mx-auto px-3 py-3 pb-24 md:pb-3">


  <% if (locals.challengeEntry) { %>
  <% var _ce = locals.challengeEntry; var _ceOwner = _ce.userId; %>
  <div class="flex items-center gap-3 border border-charm-500/25 bg-charm-600/5 rounded-md p-3 mb-5">
    <a href="/entry/<%= _ce._id %>" class="shrink-0 w-16 h-16 rounded-md overflow-hidden bg-shark-900 block">
      <% if (_ce.mediaType === 'video') { %>
      <video src="<%= _ce.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
      <% } else { %>
      <img src="<%= _ce.mediaUrl %>" class="w-full h-full object-cover" alt="">
      <% } %>
    </a>
    <div class="flex flex-col gap-0.5 min-w-0 flex-1">
      <div class="flex items-center gap-1.5 mb-0.5">
        <iconify-icon icon="boxicons:git-compare" width="11" class="text-charm-400 shrink-0"></iconify-icon>
        <span class="text-[10px] font-bold text-charm-400 uppercase tracking-wide">Challenging</span>
      </div>
      <% if (_ce.title) { %><p class="text-sm font-semibold text-white truncate"><%= _ce.title %></p><% } %>
      <% if (_ce.caption) { %><p class="text-xs text-white/45 truncate"><%= _ce.caption %></p><% } %>
      <% if (_ce.tags && _ce.tags.length) { %>
      <div class="flex flex-wrap gap-x-2 gap-y-0">
        <% _ce.tags.forEach(function(t) { %><span class="text-xs text-charm-400/60">#<%= t %></span><% }); %>
      </div>
      <% } %>
      <% if (_ceOwner) { %><p class="text-xs text-white/30 mt-0.5">by @<%= _ceOwner.username && _ceOwner.username.value ? _ceOwner.username.value : '?' %></p><% } %>
    </div>
  </div>
  <% } %>

  <% if (locals.takeOnContest) { %>
  <% var _toc = locals.takeOnContest; %>
  <div class="flex flex-col gap-3 border border-charm-500/25 bg-charm-600/5 rounded-md px-4 py-3.5 mb-5">
    <div class="flex items-center gap-2.5">
      <iconify-icon icon="boxicons:git-compare" width="14" class="text-charm-400 shrink-0"></iconify-icon>
      <span class="text-xs font-bold text-charm-400 uppercase tracking-wide">Your Take-On</span>
      <% if (_toc.voidDeadline) { %>
      <span class="ml-auto text-xs text-amber-300 font-medium tabular-nums" id="takeon-submit-countdown" data-expires="<%= new Date(_toc.voidDeadline).toISOString() %>"></span>
      <% } %>
    </div>
    <p class="text-sm text-white/70">
      Submit your entry below to go head-to-head against
      <strong class="text-white/90"><%= _toc.opponent.displayName?.value || ('@' + _toc.opponent.username?.value) %></strong>.
    </p>
    <% if (_toc.opponentEntry) { %>
    <div class="flex items-center gap-3 border border-white/8 rounded-md p-2.5">
      <a href="/entry/<%= _toc.opponentEntry._id %>" class="shrink-0 w-14 h-14 rounded overflow-hidden bg-shark-900 block">
        <% if (_toc.opponentEntry.mediaType === 'video') { %>
        <video src="<%= _toc.opponentEntry.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
        <% } else { %>
        <img src="<%= _toc.opponentEntry.mediaUrl %>" class="w-full h-full object-cover" alt="">
        <% } %>
      </a>
      <div class="min-w-0 flex-1">
        <% if (_toc.opponentEntry.title) { %><p class="text-sm font-semibold text-white/85 truncate"><%= _toc.opponentEntry.title %></p><% } %>
        <p class="text-xs text-white/35">by @<%= _toc.opponent.username?.value %></p>
      </div>
    </div>
    <% } %>
    <input type="hidden" id="take-on-contest-id" value="<%= _toc.contestId %>">
  </div>
  <% } %>

  <% if (locals.takeOnTargetEntry) { %>
  <% var _tot = locals.takeOnTargetEntry; var _totOwner = _tot.userId; %>
  <div id="takeon-badge" class="flex items-center gap-3 border border-amber-500/25 bg-amber-500/5 rounded-md p-3 mb-5">
    <a href="/entry/<%= _tot._id %>" class="shrink-0 w-16 h-16 rounded-md overflow-hidden bg-shark-900 block">
      <% if (_tot.mediaType === 'video') { %>
      <video src="<%= _tot.mediaUrl %>" class="w-full h-full object-cover" muted preload="none"></video>
      <% } else { %>
      <img src="<%= _tot.mediaUrl %>" class="w-full h-full object-cover" alt="">
      <% } %>
    </a>
    <div class="flex flex-col gap-0.5 min-w-0 flex-1">
      <div class="flex items-center gap-1.5 mb-0.5">
        <iconify-icon icon="boxicons:git-compare" width="11" class="text-amber-400 shrink-0"></iconify-icon>
        <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wide">Taking On</span>
      </div>
      <% if (_tot.title) { %><p class="text-sm font-semibold text-white truncate"><%= _tot.title %></p><% } %>
      <% if (_tot.caption) { %><p class="text-xs text-white/45 truncate"><%= _tot.caption %></p><% } %>
      <% if (_totOwner) { %><p class="text-xs text-white/30 mt-0.5">by @<%= _totOwner.username && _totOwner.username.value ? _totOwner.username.value : '?' %></p><% } %>
    </div>
    <button type="button" id="takeon-badge-dismiss"
      class="shrink-0 w-7 h-7 flex items-center justify-center rounded-md text-white/30 hover:text-white hover:bg-white/8 transition-colors cursor-pointer">
      <iconify-icon icon="boxicons:x" width="16"></iconify-icon>
    </button>
  </div>
  <script>
  document.getElementById('takeon-badge-dismiss').addEventListener('click', function () {
    document.getElementById('takeon-badge').remove();
    var inp = document.querySelector('input[name="takeOnTargetId"]');
    if (inp) inp.remove();
  });
  </script>
  <% } %>

  <% if (error) { %>
  <div class="flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-4">
    <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
    <%= error %>
  </div>
  <% } %>

  <% if (acceptingNomination) { %>
  <!-- ── Nomination acceptance banner ──────────────────────────── -->
  <div class="flex flex-col gap-3 border border-charm-500/25 bg-charm-600/5 rounded-md px-4 py-3.5 mb-5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <img src="<%= acceptingNomination.nominator.avatar?.value || '/img/default-avatar.png' %>"
          class="w-7 h-7 rounded-full object-cover bg-shark-800 shrink-0" alt="">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-white/85 truncate">
            <%= acceptingNomination.nominator.displayName?.value || ('@' + acceptingNomination.nominator.username?.value) %>
          </p>
          <p class="text-xs text-white/40 truncate">@<%= acceptingNomination.nominator.username?.value %> · nominated you</p>
          <% if (acceptingNomination.message) { %>
          <p class="text-xs text-white/40 truncate">"<%= acceptingNomination.message %>"</p>
          <% } %>
        </div>
      </div>
      <div id="nom-countdown" class="text-xs text-amber-300 font-medium tabular-nums shrink-0"
        data-expires="<%= acceptingNomination.expiresAt.toISOString() %>"></div>
    </div>
    <% if (acceptingNomination.entry) { %>
    <div class="rounded-md overflow-hidden bg-shark-950 relative">
      <% if (acceptingNomination.entry.mediaType === 'video') { %>
      <video src="<%= acceptingNomination.entry.mediaUrl %>" class="w-full max-h-52 object-contain" controls playsinline></video>
      <% } else { %>
      <img src="<%= acceptingNomination.entry.mediaUrl %>" class="w-full max-h-52 object-contain" alt="">
      <% } %>
    </div>
    <% if (acceptingNomination.entry.title) { %>
    <p class="text-sm font-bold text-white/85"><%= acceptingNomination.entry.title %></p>
    <% } %>
    <% if (acceptingNomination.entry.caption) { %>
    <p class="text-sm text-white/60"><%= acceptingNomination.entry.caption %></p>
    <% } %>
    <% if (acceptingNomination.entry.tags && acceptingNomination.entry.tags.length) { %>
    <div class="flex flex-wrap gap-1.5">
      <% acceptingNomination.entry.tags.forEach(function(tag) { %>
      <span class="text-xs bg-shark-800 border border-white/10 rounded-md px-2 py-0.5 text-white/50">#<%= tag %></span>
      <% }); %>
    </div>
    <% } %>
    <% } else { %>
    <div class="flex items-center gap-2 text-xs text-white/35 bg-shark-900 rounded-md px-3 py-2.5">
      <iconify-icon icon="boxicons:hide" width="14"></iconify-icon>
      Entry hidden until you accept
    </div>
    <% } %>
    <div class="flex items-center gap-2 pt-0.5">
      <p class="text-xs text-white/35 flex-1">Submit your entry below to accept the nomination.</p>
      <button type="button" id="decline-nomination-btn"
        data-nomination-id="<%= acceptingNomination._id %>"
        class="h-10 flex items-center text-xs text-red-400 hover:text-red-300 transition-colors cursor-pointer border border-red-400/30 hover:border-red-400/50 rounded-md px-2.5">
        Drop nomination
      </button>
    </div>
  </div>
  <% } %>

  <form action="/submit" method="POST" enctype="multipart/form-data" id="submit-form" novalidate>
    <input type="hidden" id="accepting-nomination-id" value="<%= acceptingNomination ? acceptingNomination._id : '' %>">
    <% if (locals.takeOnTargetEntry) { %>
    <input type="hidden" name="takeOnTargetId" value="<%= locals.takeOnTargetEntry._id %>">
    <% } %>

    <!-- ── Source tabs ────────────────────────────────────────────── -->
    <div class="flex items-center gap-1 bg-shark-900 border border-white/10 rounded-md p-1 mb-3 self-start w-fit">
      <button type="button" id="tab-new"
        class="source-tab px-3 py-1.5 rounded text-xs font-medium transition-colors cursor-pointer source-tab-active">
        Upload new
      </button>
      <button type="button" id="tab-existing"
        class="source-tab px-3 py-1.5 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">
        From my profile
      </button>
    </div>

    <!-- ── Existing entry picker ──────────────────────────────────── -->
    <div id="existing-picker" class="hidden flex-col gap-2 mb-3">
      <% if (userEntries && userEntries.length > 0) { %>
      <div class="grid grid-cols-3 gap-2" id="existing-grid">
        <% userEntries.forEach(function(e) { %>
        <div class="existing-entry-card relative rounded-md overflow-hidden bg-shark-900 cursor-pointer border-2 border-transparent hover:border-white/20 transition-colors aspect-square"
          data-id="<%= e._id %>" data-media="<%= e.mediaUrl %>" data-type="<%= e.mediaType %>">
          <% if (e.mediaType === 'video') { %>
          <video src="<%= e.mediaUrl %>" class="w-full h-full object-cover pointer-events-none" muted playsinline></video>
          <div class="absolute top-1.5 left-1.5 bg-shark-950/80 rounded px-1 py-0.5 text-[9px] text-white/60 flex items-center gap-0.5">
            <iconify-icon icon="boxicons:play-filled" width="9"></iconify-icon>
          </div>
          <% } else { %>
          <img src="<%= e.mediaUrl %>" class="w-full h-full object-cover pointer-events-none" alt="">
          <% } %>
          <div class="selected-check hidden absolute inset-0 bg-charm-600/20 border-2 border-charm-500 rounded-md items-center justify-center">
            <iconify-icon icon="boxicons:check-circle-filled" width="24" class="text-charm-400"></iconify-icon>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center gap-2 py-8 text-white/30">
        <iconify-icon icon="boxicons:images" width="32"></iconify-icon>
        <p class="text-sm">No entries yet. Upload your first one above.</p>
      </div>
      <% } %>
      <input type="hidden" id="existing-entry-id" value="">
    </div>

    <!-- ── Media section ─────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-3">

      <!-- Upload zone -->
      <label id="upload-zone" class="cursor-pointer block">
        <div id="upload-placeholder"
          class="border-2 border-dashed border-white/12 rounded-md p-10 flex flex-col items-center gap-3 text-white/35 hover:border-charm-600/40 hover:text-white/55 transition-colors">
          <iconify-icon icon="boxicons:image-add" width="44"></iconify-icon>
          <div class="text-center">
            <p class="text-sm font-medium">Click to upload or drag &amp; drop</p>
            <p class="text-xs mt-1 text-white/25">
              PNG, JPG, WEBP — max 10 MB &nbsp;·&nbsp; MP4, MOV — max 100 MB (8 s, trim available)
            </p>
          </div>
        </div>
        <input type="file" id="media-input" name="entryMedia" accept="image/*,video/*" class="hidden">
      </label>

      <!-- Image preview -->
      <div id="image-preview" class="hidden relative rounded-md overflow-hidden bg-shark-900">
        <img id="preview-img" src="" alt="" class="w-full max-h-80 object-contain">
        <button type="button" id="change-image-btn"
          class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
          <iconify-icon icon="boxicons:edit-alt" width="11"></iconify-icon>Change
        </button>
      </div>

      <!-- Video preview (post-trim) -->
      <div id="video-preview" class="hidden relative rounded-md overflow-hidden bg-black">
        <video id="preview-vid" class="w-full max-h-80 object-contain" controls playsinline></video>
        <button type="button" id="change-video-btn"
          class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
          <iconify-icon icon="boxicons:edit-alt" width="11"></iconify-icon>Change
        </button>
        <div id="trim-badge" class="hidden absolute top-2 left-2 bg-shark-950/80 rounded-md px-2 py-1 text-xs text-charm-400 items-center gap-1">
          <iconify-icon icon="boxicons:cut" width="11"></iconify-icon>Trimmed
        </div>
      </div>

      <!-- Trim panel (all videos) -->
      <div id="trim-panel" class="hidden flex-col gap-0 border border-white/10 rounded-md overflow-hidden">

        <!-- Video player -->
        <div class="bg-black relative flex items-center justify-center">
          <video id="trim-video" class="w-full max-h-48 object-contain" preload="metadata" playsinline></video>
          <button type="button" id="play-pause-btn"
            class="absolute bottom-2 left-2 w-8 h-8 flex items-center justify-center bg-shark-950/75 hover:bg-shark-950/95 rounded-md transition-colors cursor-pointer text-white/70 hover:text-white">
            <iconify-icon icon="boxicons:play-filled" width="14" id="play-icon"></iconify-icon>
          </button>
          <span id="trim-current-time" class="absolute bottom-2 left-11 h-8 flex items-center text-xs text-white/55 tabular-nums pointer-events-none">0:00.0</span>
          <button type="button" id="change-trim-btn"
            class="absolute top-2 right-2 bg-shark-950/80 hover:bg-shark-800 rounded-md px-2 py-1 text-xs text-white/60 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer">
            <iconify-icon icon="boxicons:edit-alt" width="11"></iconify-icon>Change
          </button>
        </div>

        <!-- Warning: only shown for videos > 8s -->
        <div id="trim-warning"
          class="hidden items-start gap-2 text-xs text-amber-400/90 bg-amber-400/8 border-b border-amber-400/15 px-3 py-2.5">
          <iconify-icon icon="boxicons:time" width="14" class="shrink-0 mt-0.5"></iconify-icon>
          <span>This video is longer than 8 seconds. Drag the pink window to choose your clip, then apply the trim.</span>
        </div>

        <div class="flex flex-col gap-2.5 p-3">

          <!-- Timeline with horizontal scroll -->
          <div class="flex flex-col gap-1">
            <div class="relative">
            <div id="timeline-scroll-wrap" class="overflow-x-auto overflow-y-hidden rounded-md">
              <div id="trim-timeline"
                class="relative h-14 bg-shark-800 select-none overflow-hidden cursor-col-resize"
                style="min-width:100%;">

                <!-- Thumbnail strip (position + width set by JS to cover visible area) -->
                <div id="thumb-strip" class="absolute top-0 bottom-0 pointer-events-none opacity-55" style="left:0;width:100%;position:absolute;"></div>

                <!-- Dim overlays -->
                <div id="dim-before" class="absolute top-0 left-0 h-full bg-shark-950/65 pointer-events-none"></div>
                <div id="dim-after"  class="absolute top-0 right-0 h-full bg-shark-950/65 pointer-events-none"></div>

                <!-- Selected window -->
                <div id="trim-sel" class="absolute top-0 h-full border-x-2 border-charm-500 pointer-events-none">
                  <div class="w-full h-full bg-charm-600/20"></div>
                  <!-- Left handle -->
                  <div id="handle-left"
                    class="absolute left-0 top-0 bottom-0 w-3 bg-charm-500 flex items-center justify-center cursor-ew-resize pointer-events-auto z-10">
                    <div class="w-px h-4 bg-white/60 rounded pointer-events-none"></div>
                  </div>
                  <!-- Right handle -->
                  <div id="handle-right"
                    class="absolute right-0 top-0 bottom-0 w-3 bg-charm-500 flex items-center justify-center cursor-ew-resize pointer-events-auto z-10">
                    <div class="w-px h-4 bg-white/60 rounded pointer-events-none"></div>
                  </div>
                </div>

                <!-- Time labels -->
                <span id="tick-start" class="absolute bottom-1 text-[9px] font-mono text-charm-300 pointer-events-none px-1.5 z-20"></span>
                <span id="tick-end"   class="absolute bottom-1 text-[9px] font-mono text-charm-300 pointer-events-none px-1.5 z-20"></span>

                <!-- Playhead -->
                <div id="playhead"
                  class="absolute top-0 h-full items-center justify-center cursor-ew-resize z-30"
                  style="display:none;width:16px;transform:translateX(-50%);">
                  <div class="w-0.5 h-full bg-white/75 pointer-events-none"></div>
                </div>
              </div>
            </div>
            <div id="thumb-parse-overlay"
              class="hidden absolute inset-0 rounded-md bg-shark-950/70 items-center justify-center z-50 pointer-events-none">
              <p class="text-xs text-white/50 animate-pulse tracking-wide">Parsing your video. Please wait…</p>
            </div>
            </div>

            <div class="flex justify-between text-xs text-white/25">
              <span>0:00</span>
              <span id="trim-total"></span>
            </div>
          </div>

          <!-- Apply trim -->
          <button type="button" id="apply-trim-btn"
            class="w-full bg-charm-500/10 hover:bg-charm-500/15 border border-charm-500/25 hover:border-charm-500/35 text-charm-400 hover:text-charm-300 font-semibold rounded-md py-2.5 text-sm transition-colors cursor-pointer flex items-center justify-center gap-2">
            <iconify-icon icon="boxicons:cut" width="15"></iconify-icon>
            Apply Trim <span id="apply-trim-label" class="font-normal opacity-75 ml-0.5"></span>
          </button>

          <div id="trim-loading" class="hidden flex-col items-center gap-3 py-1">
            <p id="trim-msg" class="text-sm text-white/50"></p>
            <div class="w-full bg-shark-800 rounded-full h-1 overflow-hidden">
              <div id="trim-bar" class="bg-charm-500 h-1 rounded-full transition-all duration-300" style="width:0%"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- Trim cards (up to 3) -->
      <div id="trim-cards" class="hidden gap-2"></div>

      <p id="media-error" class="text-xs text-red-400 hidden"></p>
    </div>

    <!-- ── Title ────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-3">
      <label for="title" class="text-xs font-semibold text-white/50 uppercase tracking-wide">Title</label>
      <input type="text" id="title" name="title" maxlength="80" required
        placeholder="Give your entry a name…"
        class="w-full bg-shark-900 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors">
    </div>

    <!-- ── Caption ───────────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-3">
      <label for="caption" class="text-xs font-semibold text-white/50 uppercase tracking-wide">
        Description <span class="text-white/25 font-normal normal-case">(optional)</span>
      </label>
      <textarea id="caption" name="caption" rows="3"
        placeholder="Describe your entry…"
        class="w-full bg-shark-900 border border-white/10 rounded-md px-3 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors resize-none"></textarea>
      <p class="text-xs text-white/25 text-right"><span id="caption-count">0</span>/140</p>
    </div>

    <!-- ── Tags ──────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-1.5 mb-4">
      <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">
        Tags <span class="text-white/25 font-normal normal-case">(optional, up to 6)</span>
      </label>
      <div id="tag-wrap"
        class="flex flex-wrap gap-2 items-center bg-shark-900 border border-white/10 rounded-md px-3 py-2.5 min-h-11 cursor-text focus-within:border-charm-600/50 focus-within:ring-1 focus-within:ring-charm-600/25 transition-colors">
        <input id="tag-input" type="text" placeholder="Add a tag…"
          class="flex-1 min-w-24 bg-transparent text-sm text-white placeholder:text-white/20 outline-none">
      </div>
      <p class="text-xs text-white/25"><span id="tag-count">0</span>/6 &nbsp;·&nbsp; press Enter or comma to add</p>
    </div>

    <!-- ── Contest section ───────────────────────────────────────── -->
    <% if (!acceptingNomination) { %>
    <div class="flex flex-col rounded-md mb-4 border border-charm-600/30 overflow-hidden" id="contest-section">

      <!-- Challenge toggle -->
      <button type="button" id="challenge-toggle" data-on="false"
        class="flex items-center w-full gap-3 text-left cursor-pointer group bg-charm-600/10 hover:bg-charm-600/15 px-4 py-3 transition-all">
        <iconify-icon icon="boxicons:trophy" width="18" class="text-charm-400 shrink-0"></iconify-icon>
        <div class="flex flex-col gap-0.5 flex-1 min-w-0">
          <span class="text-sm font-semibold text-white transition-colors">Nominate someone</span>
          <span class="text-xs text-white/50">Challenge another user to a head-to-head contest</span>
        </div>
        <iconify-icon id="challenge-chevron" icon="boxicons:chevron-down-filled" width="16"
          class="text-white/40 group-hover:text-white/70 transition-all shrink-0"></iconify-icon>
      </button>

      <!-- Challenge fields -->
      <div id="challenge-fields" class="hidden flex-col gap-4 px-4 py-4 bg-charm-600/5 border-t border-charm-600/20">

        <!-- Username input -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/50 uppercase tracking-wide">Nominee</label>
          <div class="relative" id="challenge-user-wrap">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm pointer-events-none">@</span>
            <input type="text" id="challenge-username-input" placeholder="username" autocomplete="off"
              class="w-full bg-shark-900 border border-white/10 rounded-md pl-7 pr-8 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors">
            <button type="button" id="challenge-clear-btn"
              class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-white/30 hover:text-white/70 transition-colors cursor-pointer p-0.5">
              <iconify-icon icon="boxicons:x" width="14"></iconify-icon>
            </button>
            <!-- Dropdown -->
            <div id="challenge-dropdown"
              class="hidden absolute top-full left-0 right-0 mt-1 bg-shark-900 border border-white/10 rounded-md overflow-hidden z-50 shadow-lg">
            </div>
          </div>
          <p id="challenge-user-error" class="hidden text-xs text-red-400"></p>
          <!-- Selected nominees badges -->
          <div id="challenge-nominees" class="hidden flex-wrap gap-1.5"></div>
        </div>

        <!-- Contest visibility -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5">
            <span class="text-sm text-white/80">Contest visibility</span>
            <span class="text-xs text-white/35">Who can vote</span>
          </div>
          <div class="flex items-center gap-1.5 bg-shark-800 border border-white/10 rounded-md p-1">
            <button type="button" data-cvis="public"
              class="cvis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer cvis-active">
              Public
            </button>
            <button type="button" data-cvis="private"
              class="cvis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">
              Private
            </button>
          </div>
          <input type="hidden" id="challenge-visibility-input" value="public">
        </div>

        <!-- Designated voters (private only) -->
        <div id="voter-section" class="hidden flex-col gap-2">
          <div class="flex flex-col gap-0.5">
            <span class="text-sm text-white/80">Designated voters</span>
            <span class="text-xs text-white/35">Add at least 5 people who can vote</span>
          </div>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm pointer-events-none">@</span>
            <input type="text" id="voter-username-input" placeholder="username" autocomplete="off"
              class="w-full bg-shark-900 border border-white/10 rounded-md pl-7 py-2.5 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-charm-600/50 focus:ring-1 focus:ring-charm-600/25 transition-colors">
            <div id="voter-dropdown"
              class="hidden absolute top-full left-0 right-0 mt-1 bg-shark-900 border border-white/10 rounded-md overflow-hidden z-50 shadow-lg">
            </div>
          </div>
          <div id="voter-badges" class="hidden flex-wrap gap-1.5"></div>
          <p class="text-xs"><span id="voter-count" class="text-white/50">0</span><span class="text-white/25"> / 5 minimum</span></p>
        </div>

        <!-- Voting window -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5">
            <span class="text-sm text-white/80">Voting window</span>
            <span class="text-xs text-white/35">Starts when nominee submits</span>
          </div>
          <div class="flex items-center gap-1 bg-shark-800 border border-white/10 rounded-md p-1">
            <button type="button" data-cwin="24"  class="cwin-btn px-2 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">24h</button>
            <button type="button" data-cwin="48"  class="cwin-btn px-2 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">48h</button>
            <button type="button" data-cwin="72"  class="cwin-btn px-2 py-1 rounded text-xs font-medium transition-colors cursor-pointer cwin-active">72h</button>
            <button type="button" data-cwin="168" class="cwin-btn px-2 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">7d</button>
          </div>
          <input type="hidden" id="challenge-window-input" value="72">
        </div>

        <!-- Hide entry toggle -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex flex-col gap-0.5">
            <span class="text-sm text-white/80">Hide my entry</span>
            <span class="text-xs text-white/35">Reveal only after nominee accepts</span>
          </div>
          <button type="button" id="hide-entry-toggle" data-on="false"
            class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-shark-700 shrink-0">
            <span id="hide-entry-thumb"
              class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform"></span>
          </button>
          <input type="hidden" id="hide-entry-input" value="false">
        </div>

      </div>

      <!-- Other pending nominations -->
      <% if (pendingNominations && pendingNominations.length > 0) { %>
      <div class="flex flex-col gap-2 px-4 py-3 border-t border-charm-600/20 bg-charm-600/5" id="nominations-list">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wide">Or accept a nomination</p>
        <% pendingNominations.forEach(function(nom) { %>
        <label class="nomination-card flex items-center gap-3 border border-white/10 rounded-md px-3 py-2.5 cursor-pointer hover:border-white/20 transition-colors has-checked:border-charm-500/50 has-checked:bg-charm-600/5">
          <input type="radio" name="nominationId" value="<%= nom._id %>"
            class="nomination-radio w-4 h-4 accent-charm-500 shrink-0 cursor-pointer">
          <% const nom_avatar = nom.nominatorId.avatar?.value || '/img/default-avatar.png'; %>
          <img src="<%= nom_avatar %>" alt="" class="w-7 h-7 rounded-full object-cover bg-shark-800 shrink-0">
          <div class="flex flex-col gap-0.5 min-w-0 flex-1">
            <span class="text-sm text-white/80 font-medium truncate">
              <%= nom.nominatorId.displayName?.value || ('@' + nom.nominatorId.username?.value) %>
            </span>
            <span class="text-xs text-white/35 truncate">@<%= nom.nominatorId.username?.value %> · nominated you</span>
            <% if (nom.message) { %>
            <span class="text-xs text-white/40 truncate">"<%= nom.message %>"</span>
            <% } %>
            <span class="nom-card-countdown text-xs text-amber-300 font-medium tabular-nums" data-expires="<%= nom.expiresAt.toISOString() %>"></span>
          </div>
        </label>
        <% }); %>
      </div>
      <% } %>

    </div>
    <% } %>

    <!-- ── Audience & Options ──────────────────────────────────────── -->
    <div class="flex flex-col gap-3 mb-3">

      <!-- Visibility -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Audience</span>
          <span class="text-xs text-white/35">Who can see this entry</span>
        </div>
        <div class="flex items-center gap-1.5 bg-shark-800 border border-white/10 rounded-md p-1">
          <button type="button" data-vis="public"
            class="vis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer vis-active">
            Everyone
          </button>
          <button type="button" data-vis="followers"
            class="vis-btn px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-white/40 hover:text-white/60">
            Followers
          </button>
        </div>
        <input type="hidden" name="visibility" id="visibility-input" value="public">
      </div>

      <!-- Comments toggle -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Comments</span>
          <span class="text-xs text-white/35">Allow others to comment</span>
        </div>
        <button type="button" id="comments-toggle" data-on="true"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-charm-600 shrink-0">
          <span id="comments-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-7"></span>
        </button>
        <input type="hidden" name="commentsEnabled" id="comments-input" value="true">
      </div>

      <!-- Mature content -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Mature content</span>
          <span class="text-xs text-white/35">Flag as 18+ or sensitive</span>
        </div>
        <button type="button" id="mature-toggle" data-on="false"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-shark-700 shrink-0">
          <span id="mature-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform"></span>
        </button>
        <input type="hidden" name="matureContent" id="mature-input" value="false">
      </div>

      <!-- AI generated -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">AI generated</span>
          <span class="text-xs text-white/35">Created with AI tools</span>
        </div>
        <button type="button" id="ai-generated-toggle" data-on="false"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-shark-700 shrink-0">
          <span id="ai-generated-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform"></span>
        </button>
        <input type="hidden" name="aiGenerated" id="ai-generated-input" value="false">
      </div>

      <!-- Allow take-ons -->
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-col gap-0.5">
          <span class="text-sm text-white/80">Allow take-ons</span>
          <span class="text-xs text-white/35">Let others challenge this entry head-to-head</span>
        </div>
        <button type="button" id="allow-takeons-toggle" data-on="true"
          class="relative w-14 h-7 rounded-full transition-colors cursor-pointer bg-charm-600 shrink-0">
          <span id="allow-takeons-thumb"
            class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-7"></span>
        </button>
        <input type="hidden" name="allowTakeOns" id="allow-takeons-input" value="true">
      </div>
    </div>

    <button type="submit" id="submit-btn" disabled
      class="w-full bg-charm-600 hover:bg-charm-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
      Submit Entry
    </button>

  </form>

</div>

<style>
  .vis-active, .cvis-active, .cwin-active, .source-tab-active {
    background-color: rgba(221, 104, 144, 0.15);
    color: rgba(221, 104, 144, 1);
  }
  .existing-entry-card.selected .selected-check { display: flex; }
  .existing-entry-card.selected { border-color: rgb(221, 104, 144); }
  #upload-placeholder.drag-active {
    border-color: rgba(221, 104, 144, 0.5);
    background-color: rgba(221, 104, 144, 0.04);
    color: rgba(255,255,255,0.6);
  }
  #timeline-scroll-wrap {
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.18) transparent;
  }
  #timeline-scroll-wrap::-webkit-scrollbar { height: 4px; }
  #timeline-scroll-wrap::-webkit-scrollbar-track { background: transparent; }
  #timeline-scroll-wrap::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.18);
    border-radius: 9999px;
  }
  #timeline-scroll-wrap::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,0.3);
  }
</style>

<script>
(function () {
  var MAX_CLIP = 8;
  var MIN_CLIP = 0.5;

  // ── State ────────────────────────────────────────────────────────
  // ── Nomination countdown ─────────────────────────────────────────
  function pad2(n) { return n < 10 ? '0' + n : '' + n; }

  function formatCountdown(expiresAt) {
    var diff = expiresAt - Date.now();
    if (diff <= 0) return 'Expired';
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    if (h > 0) return h + 'h ' + pad2(m) + 'm ' + pad2(s) + 's left';
    if (m > 0) return m + 'm ' + pad2(s) + 's left';
    return s + 's left';
  }

  var countdownEls = document.querySelectorAll('#nom-countdown, .nom-card-countdown');
  if (countdownEls.length) {
    function updateCountdowns() {
      countdownEls.forEach(function (el) {
        el.textContent = formatCountdown(new Date(el.dataset.expires));
      });
    }
    updateCountdowns();
    setInterval(updateCountdowns, 1000);
  }

  // ── Drop nomination ──────────────────────────────────────────────
  var declineBtn = document.getElementById('decline-nomination-btn');
  if (declineBtn) {
    declineBtn.addEventListener('click', async function () {
      var nomId = this.dataset.nominationId;
      this.disabled = true;
      this.textContent = 'Dropping…';
      try {
        var r = await fetch('/api/nominations/' + nomId + '/decline', { method: 'POST' });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed');
        window.location.href = '/feed';
      } catch (e) {
        this.disabled = false;
        this.textContent = 'Drop nomination';
        if (window.showToast) window.showToast(e.message || 'Something went wrong.', 'error');
      }
    });
  }

  // ── Source tabs ──────────────────────────────────────────────────
  var tabNew      = document.getElementById('tab-new');
  var tabExisting = document.getElementById('tab-existing');
  var existingPicker  = document.getElementById('existing-picker');
  var existingEntryId = document.getElementById('existing-entry-id');
  var mediaSection    = document.querySelector('#upload-zone')?.closest('.flex.flex-col.gap-1\\.5.mb-3');
  var titleSection    = document.getElementById('title')?.closest('.flex.flex-col.gap-1\\.5.mb-3');
  var captionSection  = document.getElementById('caption')?.closest('.flex.flex-col.gap-1\\.5.mb-3');
  var tagsSection     = document.getElementById('tag-wrap')?.closest('.flex.flex-col.gap-1\\.5.mb-4');
  var optionsSection  = document.getElementById('comments-toggle')?.closest('.flex.flex-col.gap-3.mb-3');
  var selectedExistingId = null;

  function showNewUploadTab() {
    tabNew.classList.add('source-tab-active');
    tabNew.classList.remove('text-white/40', 'hover:text-white/60');
    tabExisting.classList.remove('source-tab-active');
    tabExisting.classList.add('text-white/40', 'hover:text-white/60');
    if (existingPicker) { existingPicker.classList.add('hidden'); existingPicker.classList.remove('flex'); }
    if (mediaSection)   mediaSection.classList.remove('hidden');
    if (titleSection)   titleSection.classList.remove('hidden');
    if (captionSection) captionSection.classList.remove('hidden');
    if (tagsSection)    tagsSection.classList.remove('hidden');
    if (optionsSection) optionsSection.classList.remove('hidden');
    selectedExistingId = null;
    if (existingEntryId) existingEntryId.value = '';
    syncSubmitBtn();
  }

  function showExistingTab() {
    tabExisting.classList.add('source-tab-active');
    tabExisting.classList.remove('text-white/40', 'hover:text-white/60');
    tabNew.classList.remove('source-tab-active');
    tabNew.classList.add('text-white/40', 'hover:text-white/60');
    if (existingPicker) { existingPicker.classList.remove('hidden'); existingPicker.classList.add('flex'); }
    if (mediaSection)   mediaSection.classList.add('hidden');
    if (titleSection)   titleSection.classList.add('hidden');
    if (captionSection) captionSection.classList.add('hidden');
    if (tagsSection)    tagsSection.classList.add('hidden');
    if (optionsSection) optionsSection.classList.add('hidden');
    rawFile = null;
    syncSubmitBtn();
  }

  if (tabNew)      tabNew.addEventListener('click', showNewUploadTab);
  if (tabExisting) tabExisting.addEventListener('click', showExistingTab);

  // ── Existing entry picker ────────────────────────────────────────
  document.querySelectorAll('.existing-entry-card').forEach(function (card) {
    card.addEventListener('click', function () {
      document.querySelectorAll('.existing-entry-card').forEach(function (c) { c.classList.remove('selected'); });
      card.classList.add('selected');
      selectedExistingId = card.dataset.id;
      if (existingEntryId) existingEntryId.value = selectedExistingId;
      syncSubmitBtn();
    });
  });

  // ── Challenge toggle ─────────────────────────────────────────────
  var challengeToggle  = document.getElementById('challenge-toggle');
  var challengeChevron = document.getElementById('challenge-chevron');
  var challengeFields  = document.getElementById('challenge-fields');

  if (challengeToggle) {
    challengeToggle.addEventListener('click', function () {
      var on = challengeToggle.dataset.on !== 'true';
      challengeToggle.dataset.on = on ? 'true' : 'false';
      if (challengeChevron) challengeChevron.style.transform = on ? 'rotate(180deg)' : '';
      if (challengeFields) {
        challengeFields.classList.toggle('hidden', !on);
        challengeFields.classList.toggle('flex', on);
      }
      // When challenge is on, deselect any nomination radio
      if (on) {
        document.querySelectorAll('.nomination-radio').forEach(function (r) { r.checked = false; });
      }
    });
  }

  // ── Contest visibility pill ──────────────────────────────────────
  var cvisInput    = document.getElementById('challenge-visibility-input');
  var voterSection = document.getElementById('voter-section');
  document.querySelectorAll('.cvis-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var val = this.dataset.cvis;
      if (cvisInput) cvisInput.value = val;
      document.querySelectorAll('.cvis-btn').forEach(function (b) {
        var active = b.dataset.cvis === val;
        b.classList.toggle('cvis-active', active);
        b.classList.toggle('text-white/40', !active);
        b.classList.toggle('hover:text-white/60', !active);
      });
      if (voterSection) {
        voterSection.classList.toggle('hidden', val !== 'private');
        voterSection.classList.toggle('flex', val === 'private');
      }
    });
  });

  // ── Voting window pill ──────────────────────────────────────────
  var cwinInput = document.getElementById('challenge-window-input');
  document.querySelectorAll('.cwin-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var val = this.dataset.cwin;
      if (cwinInput) cwinInput.value = val;
      document.querySelectorAll('.cwin-btn').forEach(function (b) {
        var active = b.dataset.cwin === val;
        b.classList.toggle('cwin-active', active);
        b.classList.toggle('text-white/40', !active);
        b.classList.toggle('hover:text-white/60', !active);
      });
    });
  });

  // ── Voter search ─────────────────────────────────────────────────
  var voterUsernameInput = document.getElementById('voter-username-input');
  var voterDropdown      = document.getElementById('voter-dropdown');
  var voterBadgesEl      = document.getElementById('voter-badges');
  var voterCountEl       = document.getElementById('voter-count');
  var voterSearchTimer   = null;
  var selectedVoters     = [];

  function hideVoterDropdown() {
    if (voterDropdown) { voterDropdown.classList.add('hidden'); voterDropdown.innerHTML = ''; }
  }

  function renderVoterBadges() {
    if (!voterBadgesEl) return;
    voterBadgesEl.innerHTML = '';
    if (voterCountEl) voterCountEl.textContent = selectedVoters.length;
    if (!selectedVoters.length) {
      voterBadgesEl.classList.add('hidden'); voterBadgesEl.classList.remove('flex'); return;
    }
    selectedVoters.forEach(function (u) {
      var badge = document.createElement('div');
      badge.className = 'inline-flex items-center gap-1.5 bg-white/5 border border-white/15 rounded-md pl-1.5 pr-1 py-1';
      badge.innerHTML =
        '<img src="' + escHtml(u.avatar || '/img/default-avatar.png') + '" class="w-5 h-5 rounded object-cover bg-shark-800 shrink-0" alt="">' +
        '<span class="text-xs text-white/70 font-medium">@' + escHtml(u.username) + '</span>' +
        '<button type="button" class="voter-remove text-white/30 hover:text-white/70 transition-colors cursor-pointer p-0.5 shrink-0" data-id="' + escHtml(u._id) + '">' +
          '<iconify-icon icon="boxicons:x" width="12"></iconify-icon>' +
        '</button>';
      badge.querySelector('.voter-remove').addEventListener('click', function () {
        var id = this.dataset.id;
        selectedVoters = selectedVoters.filter(function (x) { return x._id.toString() !== id; });
        renderVoterBadges();
      });
      voterBadgesEl.appendChild(badge);
    });
    voterBadgesEl.classList.remove('hidden'); voterBadgesEl.classList.add('flex');
  }

  function showVoterDropdown(users) {
    if (!voterDropdown) return;
    voterDropdown.innerHTML = '';
    var filtered = users.filter(function (u) {
      return !selectedVoters.some(function (s) { return s._id.toString() === u._id.toString(); });
    });
    if (!filtered.length) {
      voterDropdown.innerHTML = '<p class="px-3 py-2.5 text-xs text-white/30">No users found</p>';
      voterDropdown.classList.remove('hidden'); return;
    }
    filtered.forEach(function (u) {
      var row = document.createElement('button');
      row.type = 'button';
      row.className = 'flex items-center gap-2.5 w-full px-3 py-2 hover:bg-white/5 transition-colors text-left cursor-pointer';
      row.innerHTML =
        '<img src="' + escHtml(u.avatar || '/img/default-avatar.png') + '" class="w-7 h-7 rounded-md object-cover bg-shark-800 shrink-0" alt="">' +
        '<div class="flex flex-col gap-0 min-w-0">' +
          '<span class="text-sm text-white/80 font-medium truncate">' + escHtml(u.displayName || u.username) + '</span>' +
          '<span class="text-xs text-white/35 truncate">@' + escHtml(u.username) + '</span>' +
        '</div>';
      row.addEventListener('mousedown', function (e) {
        e.preventDefault();
        if (!selectedVoters.some(function (s) { return s._id.toString() === u._id.toString(); })) {
          selectedVoters.push(u); renderVoterBadges();
        }
        if (voterUsernameInput) voterUsernameInput.value = '';
        hideVoterDropdown();
        if (voterUsernameInput) voterUsernameInput.focus();
      });
      voterDropdown.appendChild(row);
    });
    voterDropdown.classList.remove('hidden');
  }

  if (voterUsernameInput) {
    voterUsernameInput.addEventListener('input', function () {
      clearTimeout(voterSearchTimer);
      var val = this.value.trim().replace(/^@/, '');
      if (!val) { hideVoterDropdown(); return; }
      voterSearchTimer = setTimeout(async function () {
        try {
          var r = await fetch('/api/users/search?q=' + encodeURIComponent(val));
          showVoterDropdown(await r.json());
        } catch (e) { hideVoterDropdown(); }
      }, 200);
    });
    voterUsernameInput.addEventListener('blur', function () { setTimeout(hideVoterDropdown, 150); });
  }

  // ── Hide entry toggle (wired after makeToggle is defined below) ──

  // ── Challenge username search ────────────────────────────────────
  var challengeUsernameInput = document.getElementById('challenge-username-input');
  var challengeUserError     = document.getElementById('challenge-user-error');
  var challengeDropdown      = document.getElementById('challenge-dropdown');
  var challengeClearBtn      = document.getElementById('challenge-clear-btn');
  var challengeNominees      = document.getElementById('challenge-nominees');
  var searchTimer  = null;
  var selectedNominees = []; // [{_id, username, displayName, avatar}]

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function hideDropdown() {
    if (challengeDropdown) { challengeDropdown.classList.add('hidden'); challengeDropdown.innerHTML = ''; }
  }

  function renderNomineeBadges() {
    if (!challengeNominees) return;
    challengeNominees.innerHTML = '';
    if (!selectedNominees.length) {
      challengeNominees.classList.add('hidden');
      challengeNominees.classList.remove('flex');
      return;
    }
    selectedNominees.forEach(function (u) {
      var badge = document.createElement('div');
      badge.className = 'inline-flex items-center gap-1.5 bg-charm-600/10 border border-charm-600/30 rounded-md pl-1.5 pr-1 py-1';
      badge.innerHTML =
