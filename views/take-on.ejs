<%- include('partials/appStart', { title: title, activePage: '' }) %>

<div class="max-w-xl mx-auto px-3 py-4 pb-24 md:pb-4">

  <a href="/notifications" class="inline-flex items-center gap-1.5 text-sm text-white/40 hover:text-white/70 transition-colors mb-4">
    <iconify-icon icon="boxicons:arrow-back" width="14"></iconify-icon>
    Back to notifications
  </a>

  <% if (nom.status !== 'pending' || nom.expiresAt < new Date()) { %>
  <!-- Already resolved -->
  <div class="flex flex-col items-center gap-3 py-12 text-center">
    <iconify-icon icon="boxicons:check-circle" width="40" class="text-white/20"></iconify-icon>
    <p class="text-white/50 text-sm">
      <% if (nom.status === 'accepted') { %>This take-on was already accepted.
      <% } else if (nom.status === 'void') { %>This take-on was declined or has expired.
      <% } else { %>This take-on has expired.
      <% } %>
    </p>
    <% if (nom.status === 'accepted' && contest) { %>
    <a href="/contest/<%= contest._id %>" class="mt-2 text-sm text-charm-400 hover:text-charm-300 transition-colors">View contest</a>
    <% } %>
  </div>

  <% } else { %>

  <h1 class="text-base font-bold text-white mb-1">Take-On Request</h1>
  <p class="text-sm text-white/40 mb-5">
    <strong class="text-white/70"><%= nom.nominatorId.displayName?.value || ('@' + nom.nominatorId.username?.value) %></strong>
    wants to challenge this entry to a head-to-head contest.
  </p>

  <!-- Challenger info -->
  <div class="flex items-center gap-3 mb-5">
    <a href="/<%= nom.nominatorId.username?.value %>" class="shrink-0 w-10 h-10 rounded-full overflow-hidden bg-shark-800 border border-white/10 flex items-center justify-center">
      <% if (nom.nominatorId.avatar?.value) { %>
      <img src="<%= nom.nominatorId.avatar.value %>" class="w-full h-full object-cover" alt="">
      <% } else { %>
      <iconify-icon icon="boxicons:user" width="20" class="text-white/30"></iconify-icon>
      <% } %>
    </a>
    <div class="min-w-0">
      <a href="/<%= nom.nominatorId.username?.value %>" class="block text-sm font-semibold text-white hover:text-charm-300 transition-colors truncate">
        <%= nom.nominatorId.displayName?.value || ('@' + nom.nominatorId.username?.value) %>
      </a>
      <p class="text-xs text-white/40">@<%= nom.nominatorId.username?.value %></p>
    </div>
  </div>

  <!-- Your entry being challenged -->
  <% if (targetEntry) { %>
  <p class="text-xs font-semibold text-white/35 uppercase tracking-wide mb-2">Your entry</p>
  <div class="rounded-md overflow-hidden bg-shark-950 mb-5">
    <% if (targetEntry.mediaType === 'video') { %>
    <video src="<%= targetEntry.mediaUrl %>" class="w-full max-h-64 object-contain" controls playsinline></video>
    <% } else { %>
    <img src="<%= targetEntry.mediaUrl %>" class="w-full max-h-64 object-contain" alt="">
    <% } %>
    <% if (targetEntry.title) { %>
    <p class="px-3 pt-2 pb-1 text-sm font-semibold text-white/85"><%= targetEntry.title %></p>
    <% } %>
    <% if (targetEntry.caption) { %>
    <p class="px-3 pb-2 text-xs text-white/50"><%= targetEntry.caption %></p>
    <% } %>
  </div>
  <% } %>

  <!-- Void deadline countdown -->
  <div class="flex items-center gap-2 text-xs text-white/40 mb-5">
    <iconify-icon icon="boxicons:time" width="13" class="shrink-0"></iconify-icon>
    <span>Expires in <span id="takeon-countdown" class="text-amber-300 font-semibold tabular-nums" data-expires="<%= nom.expiresAt.toISOString() %>"></span></span>
  </div>

  <!-- Error message -->
  <div id="takeon-error" class="hidden flex items-center gap-2 text-sm text-red-400 bg-red-400/8 border border-red-400/20 rounded-md px-3 py-2.5 mb-4">
    <iconify-icon icon="boxicons:error-circle" width="15" class="shrink-0"></iconify-icon>
    <span id="takeon-error-text"></span>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-3">
    <button id="takeon-accept-btn"
      data-nom-id="<%= nom._id %>"
      class="flex-1 bg-charm-600 hover:bg-charm-500 text-white font-bold rounded-md py-3 text-sm transition-colors cursor-pointer">
      Accept
    </button>
    <button id="takeon-decline-btn"
      data-nom-id="<%= nom._id %>"
      class="flex-1 border border-white/15 text-white/50 hover:border-white/30 hover:text-white/70 font-semibold rounded-md py-3 text-sm transition-colors cursor-pointer">
      Decline
    </button>
  </div>

  <% } %>
</div>

<script>
(function () {
  var countdownEl = document.getElementById('takeon-countdown');
  if (countdownEl) {
    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var diff = new Date(countdownEl.dataset.expires) - Date.now();
      if (diff <= 0) { countdownEl.textContent = 'Expired'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      countdownEl.textContent = h > 0
        ? h + 'h ' + pad2(m) + 'm ' + pad2(s) + 's'
        : (m > 0 ? m + 'm ' + pad2(s) + 's' : s + 's');
    }
    tick();
    setInterval(tick, 1000);
  }

  function showError(msg) {
    var el = document.getElementById('takeon-error');
    document.getElementById('takeon-error-text').textContent = msg;
    el.classList.remove('hidden');
    el.classList.add('flex');
  }

  var acceptBtn  = document.getElementById('takeon-accept-btn');
  var declineBtn = document.getElementById('takeon-decline-btn');

  if (acceptBtn) {
    acceptBtn.addEventListener('click', function () {
      var nomId = acceptBtn.dataset.nomId;
      acceptBtn.disabled  = true;
      declineBtn.disabled = true;
      acceptBtn.textContent = 'Accepting…';
      fetch('/api/nominations/' + nomId + '/take-on-accept', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { showError(data.error); acceptBtn.disabled = false; declineBtn.disabled = false; acceptBtn.textContent = 'Accept'; return; }
        window.location.href = '/contest/' + data.contestId;
      })
      .catch(function () { showError('Something went wrong.'); acceptBtn.disabled = false; declineBtn.disabled = false; acceptBtn.textContent = 'Accept'; });
    });
  }

  if (declineBtn) {
    declineBtn.addEventListener('click', function () {
      var nomId = declineBtn.dataset.nomId;
      acceptBtn.disabled  = true;
      declineBtn.disabled = true;
      declineBtn.textContent = 'Declining…';
      fetch('/api/nominations/' + nomId + '/decline', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { showError(data.error); acceptBtn.disabled = false; declineBtn.disabled = false; declineBtn.textContent = 'Decline'; return; }
        window.location.href = '/notifications';
      })
      .catch(function () { showError('Something went wrong.'); acceptBtn.disabled = false; declineBtn.disabled = false; declineBtn.textContent = 'Decline'; });
    });
  }
}());
</script>

<%- include('partials/appEnd') %>
